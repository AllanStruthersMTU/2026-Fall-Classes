% ============================================================
%  beamerthemeMTU.sty
%  A Beamer theme for Michigan Technological University courses
%
%  Features:
%    - Michigan Tech identification (name + optional logo) in
%      the footline and on the title slide
%    - Automatic slide counter (current / total)
%    - A manually-set lecture counter ("Lecture N")
%    - A course identifier shown on every slide
%    - A dominant forest-green color scheme
%
%  Usage (in your main .tex file):
%    \documentclass{beamer}
%    \usepackage{beamerthemeMTU}
%
%    \course{MA3160 --- Differential Equations with Linear Algebra}
%    \lecture{12}                 % sets the lecture counter
%    \title{Second-Order Linear ODEs}
%    \subtitle{Homogeneous Equations}
%    \author{Prof. Jane Doe}
%    \institute{Department of Mathematical Sciences}
%    \date{\today}
%
%    \begin{document}
%      \begin{frame}\titlepage\end{frame}
%      ...
%    \end{document}
% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeMTU}[2026/08/02 Michigan Tech Beamer Theme]
\RequirePackage{etoolbox}
\RequirePackage{tikz}
\RequirePackage{xcolor}
\RequirePackage{bm}

\mode<presentation>

% ------------------------------------------------------------
% 1. COLOR PALETTE  (dominant "Husky forest green")
% ------------------------------------------------------------
\definecolor{mtuGreen}{RGB}{0,79,42}          % primary dominant green
\definecolor{mtuGreenLight}{RGB}{60,133,90}    % lighter accent green
\definecolor{mtuGreenPale}{RGB}{223,236,227}   % very pale green for backgrounds
\definecolor{mtuGold}{RGB}{198,146,20}         % small gold accent (optional highlight)
\definecolor{mtuGray}{RGB}{88,89,91}           % neutral gray for secondary text
\definecolor{mtuWhite}{RGB}{255,255,255}

\setbeamercolor{palette primary}{bg=mtuGreen, fg=mtuWhite}
\setbeamercolor{palette secondary}{bg=mtuGreenLight, fg=mtuWhite}
\setbeamercolor{palette tertiary}{bg=mtuGreen, fg=mtuWhite}
\setbeamercolor{palette quaternary}{bg=mtuGreen, fg=mtuWhite}

\setbeamercolor{structure}{fg=mtuGreen}
\setbeamercolor{title}{fg=mtuWhite, bg=mtuGreen}
\setbeamercolor{subtitle}{fg=mtuGreenPale, bg=mtuGreen}
\setbeamercolor{frametitle}{fg=mtuWhite, bg=mtuGreen}
\setbeamercolor{framesubtitle}{fg=mtuGreenPale}
\setbeamercolor{footline}{fg=mtuWhite, bg=mtuGreen}
\setbeamercolor{author in head/foot}{fg=mtuWhite, bg=mtuGreen}
\setbeamercolor{title in head/foot}{fg=mtuWhite, bg=mtuGreenLight}
\setbeamercolor{date in head/foot}{fg=mtuWhite, bg=mtuGreen}
\setbeamercolor{block title}{fg=mtuWhite, bg=mtuGreen}
\setbeamercolor{block body}{fg=black, bg=mtuGreenPale}
\setbeamercolor{alerted text}{fg=mtuGold}
\setbeamercolor{item}{fg=mtuGreen}
\setbeamercolor{itemize item}{fg=mtuGreen}
\setbeamercolor{itemize subitem}{fg=mtuGreenLight}
\setbeamercolor{enumerate item}{fg=mtuGreen}
\setbeamercolor{page number in head/foot}{fg=mtuWhite}
\setbeamercolor{section in toc}{fg=mtuGreen}
\setbeamercolor{subsection in toc}{fg=mtuGreenLight}
\setbeamercolor{normal text}{fg=black}
\setbeamercolor{background canvas}{bg=mtuWhite}

% Mark defined terms and terms introduced ahead of a later definition.
\newcommand{\keypoint}[1]{{\color{mtuGreen}\bfseries #1}}

% Bold lowercase symbols denote vectors; bold uppercase symbols denote matrices.
\newcommand{\vect}[1]{\bm{#1}}
\newcommand{\mat}[1]{\bm{#1}}

% ------------------------------------------------------------
% 2. FONTS
% ------------------------------------------------------------
\setbeamerfont{title}{series=\bfseries, size=\Large}
\setbeamerfont{subtitle}{series=\mdseries, size=\normalsize}
\setbeamerfont{frametitle}{series=\bfseries, size=\large}
\setbeamerfont{author in head/foot}{size=\tiny}
\setbeamerfont{title in head/foot}{size=\tiny, series=\bfseries}
\setbeamerfont{date in head/foot}{size=\tiny}
\setbeamerfont{block title}{series=\bfseries}

\setbeamertemplate{itemize items}[circle]
\setbeamertemplate{enumerate items}[default]
\setbeamertemplate{bibliography item}[text]
\setbeamertemplate{navigation symbols}{}   % hide navigation icons
\setbeamertemplate{blocks}[rounded][shadow=false]

% ------------------------------------------------------------
% 3. COURSE IDENTIFIER + LECTURE COUNTER
% ------------------------------------------------------------
% \course{...}  sets the course identifier printed in the footline
\newcommand{\mtu@course}{}
\newcommand{\course}[1]{\renewcommand{\mtu@course}{#1}}

% \lecturenum{...} sets a "Lecture N" counter printed in the footline.
% (Beamer already has its own \lecture{short}{long} command used for
%  grouping frames into named lectures, so a differently-named command
%  is used here to avoid any conflict with that machinery.)
\newcounter{mtulecturenum}
\setcounter{mtulecturenum}{1}
\newcommand{\lecturenum}[1]{\setcounter{mtulecturenum}{#1}}
\newcommand{\thelecturenum}{\arabic{mtulecturenum}}
% Reference decks may replace the lecture label without changing lectures.
\newcommand{\mtu@lecturelabel}{Lecture \thelecturenum}
\newcommand{\lecturelabel}[1]{\renewcommand{\mtu@lecturelabel}{#1}}

% \mtulogo{...} lets the user supply a path to an official MTU logo
% file (e.g. a PDF/PNG downloaded from MTU brand resources). If left
% empty, a plain text wordmark is used instead so the theme still
% compiles with no extra files required.
\newcommand{\mtu@logofile}{}
\newcommand{\mtulogo}[1]{\renewcommand{\mtu@logofile}{#1}}

\newcommand{\mtu@wordmark}{%
  \ifdefempty{\mtu@logofile}{%
    {\usebeamerfont{title}\color{mtuWhite}\bfseries Michigan\,\,Tech}%
  }{%
    \includegraphics[height=1.1cm]{\mtu@logofile}%
  }%
}

% ------------------------------------------------------------
% 4. HEADLINE  (thin green identification bar)
% ------------------------------------------------------------
\setbeamertemplate{headline}{%
  \begin{beamercolorbox}[wd=\paperwidth, ht=0.55cm, dp=0.15cm, leftskip=1em, rightskip=1em]{palette primary}%
    \usebeamerfont{author in head/foot}%
    \textbf{Michigan Technological University} \hfill \mtu@course \, $\vert$ \, \mtu@lecturelabel%
  \end{beamercolorbox}%
}

% ------------------------------------------------------------
% 5. FOOTLINE  (course id, slide counter, lecture counter)
% ------------------------------------------------------------
\setbeamertemplate{footline}{%
  \leavevmode%
  \hbox{%
    \begin{beamercolorbox}[wd=.34\paperwidth, ht=2.6ex, dp=1.2ex, left, leftskip=1em]{author in head/foot}%
      \usebeamerfont{author in head/foot}\insertshortauthor
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.42\paperwidth, ht=2.6ex, dp=1.2ex, center]{title in head/foot}%
      \usebeamerfont{title in head/foot}\mtu@course
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.24\paperwidth, ht=2.6ex, dp=1.2ex, right, rightskip=1em]{date in head/foot}%
      \usebeamerfont{date in head/foot}%
      \mtu@lecturelabel \,\textbar\, \insertframenumber\,/\,\inserttotalframenumber%
    \end{beamercolorbox}%
  }%
  \vskip0pt%
}

% ------------------------------------------------------------
% 6. FRAME TITLE
% ------------------------------------------------------------
\setbeamertemplate{frametitle}{%
  \nointerlineskip%
  \begin{beamercolorbox}[wd=\paperwidth, ht=1.15cm, dp=0.35cm, leftskip=1em, rightskip=1em, vmode]{frametitle}%
    \usebeamerfont{frametitle}\insertframetitle\par%
    \ifx\insertframesubtitle\@empty\else%
      {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}%
    \fi%
  \end{beamercolorbox}%
}

% ------------------------------------------------------------
% 7. TITLE PAGE
% ------------------------------------------------------------
\defbeamertemplate*{title page}{MTU}[1][]
{
  \vbox{}
  \vfill
  \begin{beamercolorbox}[sep=0pt,center]{title}
    \vskip1em
    \mtu@wordmark
    \vskip1.4em
    \usebeamerfont{title}\inserttitle\par
    \ifx\insertsubtitle\@empty\else
      \vskip0.5em
      {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}
    \fi
    \vskip1.5em
  \end{beamercolorbox}
  \vskip1em
  \begin{beamercolorbox}[sep=8pt,center]{normal text}
    {\usebeamerfont{author}\color{mtuGreen}\insertauthor\par}
    \vskip0.3em
    {\usebeamerfont{institute}\color{mtuGray}\insertinstitute\par}
    \vskip0.3em
    {\usebeamerfont{date}\color{mtuGray}
      \mtu@course \,\textbar\, \mtu@lecturelabel \,\textbar\, \insertdate\par}
  \end{beamercolorbox}
  \vfill
}

\mode<all>
