Cell[BoxData[{
 RowBox[{
  RowBox[{"MMat", "=", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"4", "0"},
      {"0", "3"}
     }], "\[NoBreak]", ")"}]}], ";", " ", 
  RowBox[{"CMat", "=", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"3", 
       RowBox[{"-", "1"}]},
      {
       RowBox[{"-", "1"}], "1"}
     }], "\[NoBreak]", ")"}]}], " ", ";", 
  RowBox[{"KMat", "=", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"7", 
       RowBox[{"-", "3"}]},
      {
       RowBox[{"-", "3"}], "3"}
     }], "\[NoBreak]", ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"A", "=", " ", 
  RowBox[{"ArrayFlatten", "[", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"0", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]},
      {
       RowBox[{"-", 
        RowBox[{
         RowBox[{"Inverse", "[", "MMat", "]"}], ".", "KMat"}]}], 
       RowBox[{"-", 
        RowBox[{
         RowBox[{"Inverse", "[", "MMat", "]"}], ".", "CMat"}]}]}
     }], "\[NoBreak]", ")"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gf", "[", "t_", "]"}], ":=", 
  RowBox[{"Sin", "[", "t", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "[", "t_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"4", " ", 
      RowBox[{"gf", "[", "t", "]"}]}], "+", 
     RowBox[{"2", " ", 
      RowBox[{
       RowBox[{"gf", "'"}], "[", "t", "]"}]}]}], ",", "0"}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "t_", "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{"0", ",", "0", ",", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"4", " ", 
        RowBox[{"gf", "[", "t", "]"}]}], "+", 
       RowBox[{"2", " ", 
        RowBox[{
         RowBox[{"gf", "'"}], "[", "t", "]"}]}]}], ")"}], "/", "4"}], ",", 
    "0"}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "123"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ySol", "=", 
  RowBox[{"NDSolveValue", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"MMat", ".", 
         RowBox[{
          RowBox[{"y", "''"}], "[", "t", "]"}]}], "+", 
        RowBox[{"CMat", ".", 
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}]}], "+", 
        RowBox[{"KMat", ".", 
         RowBox[{"y", "[", "t", "]"}]}]}], "==", 
       RowBox[{"b", "[", "t", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"y", "[", "0", "]"}], "==", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "0", "]"}], "==", 
       RowBox[{"{", 
        RowBox[{"0", ",", "2"}], "}"}]}]}], "}"}], ",", "y", ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"zSol", "=", 
  RowBox[{"NDSolveValue", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"z", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"A", ".", 
         RowBox[{"z", "[", "t", "]"}]}], "+", 
        RowBox[{"f", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"z", "[", "0", "]"}], "==", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "1"}], ",", "0", ",", "2"}], "}"}]}]}], "}"}], ",", "z",
     ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<\!\(\*SubscriptBox[\(y\), \(1\)]\)\>\"", "->", 
