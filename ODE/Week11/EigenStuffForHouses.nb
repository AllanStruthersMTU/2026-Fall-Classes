         RowBox[{"A", ".", 
          RowBox[{"z", "[", "t", "]"}]}], "+", 
         RowBox[{"f", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"z", "[", "0", "]"}], "==", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"-", "1"}], ",", "0", ",", "2"}], "}"}]}]}], "}"}], ",", 
     "z", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], 
