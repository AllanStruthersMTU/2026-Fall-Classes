Notebook[{

Cell[CellGroupData[{
Cell["\<\
Singular Value Decomposition 
aka SVD\
\>", "Title",
 CellChangeTimes->{{3.997354396199274*^9, 3.9973544008679843`*^9}, {
   3.9973640967271757`*^9, 3.997364101554268*^9}, 3.997364137222814*^9, {
   3.9977881367147083`*^9, 
   3.9977881710199957`*^9}},ExpressionUUID->"ee41a007-0d2f-4b6e-9991-\
30a592e66adf"],

Cell[TextData[{
 "All real ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "\[Times]", "n"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3d322107-289f-486f-b4ba-30d3e5714523"],
 " matrices have a real SVD ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "=", 
    RowBox[{"U", " ", "\[CapitalSigma]", " ", 
     RowBox[{"V", "\[Transpose]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d9952e7f-25c2-496c-bf90-6a393a47514e"],
 ".  \n\tThe real square matrix ",
 Cell[BoxData[
  FormBox["U", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "26bbd149-086d-431a-a9b0-3589b421d5bd"],
 " satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"U", "\[Transpose]"}], " ", "U"}], "=", 
    SubscriptBox["I", "m"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "956e14df-610e-4bc7-97de-56c4cc262be7"],
 "\n\tThe real square matrix ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a425df4c-1dc6-4400-addf-49d7509b7c7c"],
 " satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"V", "\[Transpose]"}], " ", "V"}], "=", 
    SubscriptBox["I", "n"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b0adf1f2-f319-4a17-a950-7c16f158c081"],
 "\n\tThe real ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "\[Times]", "n"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f78651d3-1ebd-4108-82bd-6deca2b8f2eb"],
 " diagonal matrix has non-negative and non-increasing diagonal entries ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "1"], "\[GreaterEqual]", 
    SubscriptBox["\[Sigma]", "2"], "\[GreaterEqual]", "\[Ellipsis]", 
    "\[GreaterEqual]", 
    SubscriptBox["\[Sigma]", 
     RowBox[{"min", "(", 
      RowBox[{"m", ",", "n"}], ")"}]], "\[GreaterEqual]", "0"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "acf2fd05-b91a-4955-a37e-432005230410"],
 " \nThe \[Sigma]s are the singular values of the matrix.  The columns of ",
 Cell[BoxData[
  FormBox["U", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ac626d54-7491-4b47-b0eb-ae71dbc7898f"],
 " and ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5d240d73-efa0-4df1-881b-ce9197d846fc"],
 " are the left and right singular vectors respectively.  The slightly more \
involved discussion in \
https://en.wikipedia.org/wiki/Singular_value_decomposition is generalized to \
complex ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b01d05f8-a946-4260-9d8a-61db42355249"],
 "."
}], "Text",
 CellChangeTimes->{{3.997788150458186*^9, 3.9977885428715067`*^9}, {
  3.997788580173435*^9, 
  3.997788689167096*^9}},ExpressionUUID->"7cb34241-6aa4-44d6-82c9-\
0268efb0252c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"(", GridBox[{
      {"1.2", "0.1"},
      {"3.4", 
       RowBox[{"-", "1.6"}]}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"U", ",", "S", ",", "V"}], "}"}], "=", 
   RowBox[{"SingularValueDecomposition", "[", "A", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "[", 
   RowBox[{"r_", ",", "\[Theta]_"}], "]"}], ":=", " ", 
  RowBox[{"r", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
     RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
    "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ParametricPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"p", "[", 
       RowBox[{"r", ",", "\[Theta]"}], "]"}], ",", " ", 
      RowBox[{"A", ".", 
       RowBox[{"p", "[", 
        RowBox[{"r", ",", "\[Theta]"}], "]"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"r", ",", "0", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", "0", ",", " ", 
      RowBox[{"2", "\[Pi]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Mesh", "->", "Full"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Epilog", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thickness", "[", "0.01", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"Red", ",", 
         RowBox[{"Arrow", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"V", "\[LeftDoubleBracket]", 
             RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}]}], "}"}], 
          "]"}], ",", "Dashed", ",", 
         RowBox[{"Arrow", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{
             RowBox[{"S", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], 
             RowBox[{"U", "\[LeftDoubleBracket]", 
              RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}]}]}], "}"}],
           "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"Blue", ",", 
         RowBox[{"Arrow", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"V", "\[LeftDoubleBracket]", 
             RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}]}], "}"}], 
          "]"}], ",", "Dashed", ",", 
         RowBox[{"Arrow", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{
             RowBox[{"S", "\[LeftDoubleBracket]", 
              RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}], 
             RowBox[{"U", "\[LeftDoubleBracket]", 
              RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}]}]}], "}"}],
           "]"}]}], "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotLabel", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Diagonal", "[", "S", "]"}], ",", " ", 
       RowBox[{"Norm", "[", 
        RowBox[{"A", "-", 
         RowBox[{"U", ".", "S", ".", 
          RowBox[{"V", "\[Transpose]"}]}]}], "]"}]}], "}"}]}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"p", "[", 
      RowBox[{"1", ",", "\[Theta]"}], "]"}], ",", " ", 
     RowBox[{"A", ".", 
      RowBox[{"p", "[", 
       RowBox[{"1", ",", "\[Theta]"}], "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", "0", ",", " ", 
     RowBox[{"2", "\[Pi]"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Epilog", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Thickness", "[", "0.01", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Red", ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"V", "\[LeftDoubleBracket]", 
            RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}]}], "}"}], 
         "]"}], ",", "Dashed", ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{
            RowBox[{"S", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], 
            RowBox[{"U", "\[LeftDoubleBracket]", 
             RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}]}]}], "}"}], 
         "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"V", "\[LeftDoubleBracket]", 
            RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}]}], "}"}], 
         "]"}], ",", "Dashed", ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{
            RowBox[{"S", "\[LeftDoubleBracket]", 
             RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}], 
            RowBox[{"U", "\[LeftDoubleBracket]", 
             RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}]}]}], "}"}], 
         "]"}]}], "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Diagonal", "[", "S", "]"}], ",", " ", 
      RowBox[{"Norm", "[", 
       RowBox[{"A", "-", 
        RowBox[{"U", ".", "S", ".", 
         RowBox[{"V", "\[Transpose]"}]}]}], "]"}]}], "}"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9977888320729437`*^9, 3.9977894077364807`*^9}, {
