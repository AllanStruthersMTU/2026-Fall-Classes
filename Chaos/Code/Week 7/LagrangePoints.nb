Notebook[{

Cell[CellGroupData[{
Cell["CR3BP", "Title",
 CellChangeTimes->{{3.997354396199274*^9, 3.9973544008679843`*^9}, {
   3.9973640967271757`*^9, 3.997364101554268*^9}, 3.997364137222814*^9, {
   3.9977881367147083`*^9, 3.9977881710199957`*^9}, {3.997789975430049*^9, 
   3.997789995676383*^9}, {3.9983954078791037`*^9, 3.998395454346006*^9}, {
   3.9984698291933975`*^9, 3.998469829718734*^9}, {4.0009909472830315`*^9, 
   4.00099096641656*^9}},ExpressionUUID->"ee41a007-0d2f-4b6e-9991-\
30a592e66adf"],

Cell[TextData[{
 "The ODEs are \n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"x", "''"}], "-", 
      RowBox[{"2", 
       RowBox[{"y", "'"}]}], "=", "x", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Eta]"}], ")"}], 
       FractionBox[
        RowBox[{"x", " ", "+", " ", "\[Eta]"}], 
        SuperscriptBox[
         RowBox[{"(", 
          SubscriptBox["\[Rho]", "1"], ")"}], "3"]]}], "-", 
      RowBox[{"\[Eta]", 
       FractionBox[
        RowBox[{"x", " ", "-", " ", "1", " ", "+", " ", "\[Eta]"}], 
        SuperscriptBox[
         RowBox[{"(", 
          SubscriptBox["\[Rho]", "2"], ")"}], "3"]]}]},
     {
      RowBox[{"y", "''"}], "+", 
      RowBox[{"2", 
       RowBox[{"x", "'"}]}], "=", "y", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Eta]"}], ")"}], 
       FractionBox["y", 
        SuperscriptBox[
         RowBox[{"(", 
          SubscriptBox["\[Rho]", "1"], ")"}], "3"]]}], "-", 
      RowBox[{"\[Eta]", 
       FractionBox["y", 
        SuperscriptBox[
         RowBox[{"(", 
          SubscriptBox["\[Rho]", "2"], ")"}], "3"]]}]}
    }], TraditionalForm]],ExpressionUUID->
  "b69eb793-3b6a-4dc6-8d51-e6cb44e7f6e9"],
 "\nwhere \n\t",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Rho]", "1", "2"], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", "+", "\[Eta]"}], ")"}], "2"], "+", 
     SuperscriptBox["y", "2"]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Rho]", "2", "2"], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", "-", "1", "+", "\[Eta]"}], ")"}], "2"], "+", 
     SuperscriptBox["y", "2"], " "}]}], TraditionalForm]}],ExpressionUUID->
  "573a8ddc-b36d-425d-afb7-9b742710272e"],
 "\nThis is sometimes written in terms of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], "\[CapitalOmega]"}], TraditionalForm]],
  ExpressionUUID->"bdaa9936-c917-4e3d-a518-7154b982108f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "y"], 
    SubscriptBox["\[CapitalOmega]", "y"]}], TraditionalForm]],ExpressionUUID->
  "baf1c0d2-d1c7-4e31-91d6-fb8eaf822675"],
 " where\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalOmega]", "(", 
     RowBox[{"x", ",", "y"}], ")"}], "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["x", "2"], "+", 
        SuperscriptBox["y", "2"]}], ")"}]}], "+", 
     FractionBox[
      RowBox[{"1", "-", "\[Eta]"}], 
      SubscriptBox["\[Rho]", "1"]], "+", 
     FractionBox["\[Eta]", 
      SubscriptBox["\[Rho]", "2"]]}]}], TraditionalForm]],ExpressionUUID->
  "6bfd1eda-cd56-4bb8-9340-fe5759d843d2"],
 "    \nThis is easy enough to enter and solve.  I am going to do this as a \
second order system and as a first order system. "
}], "Text",
 CellChangeTimes->{{4.0009909703843594`*^9, 4.000991213585046*^9}, {
   4.0009913516004667`*^9, 4.0009916530483656`*^9}, 4.0009925559785852`*^9, {
   4.000992599619541*^9, 
   4.0009926002952814`*^9}},ExpressionUUID->"134fc682-7b6f-48bc-a168-\
1074e8d94ddd"],

Cell[CellGroupData[{

Cell["Second Order System", "Subsection",
 CellChangeTimes->{{4.000992603483049*^9, 
  4.000992609806538*^9}},ExpressionUUID->"740cedae-4aa5-46d8-bf30-\
82cf1c50ab91"],

Cell["This is a test to make sure I implemented things correctly! ", "Text",
 CellChangeTimes->{{4.00099255994657*^9, 
  4.0009925796584597`*^9}},ExpressionUUID->"1850742d-92f8-4a8e-b8de-\
1b026aaecf84"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Eta]", "=", 
   FractionBox["1", "82.45"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vy0", "=", 
   RowBox[{"-", "1.049357509830320"}]}], ";", " ", 
  RowBox[{"x0", "=", "1.2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "6.1922169331319640"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xSol", ",", "ySol"}], "}"}], "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Rho]1", "=", 
         SqrtBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "[", "t", "]"}], "+", "\[Eta]"}], ")"}], "2"], "+", 
           SuperscriptBox[
            RowBox[{"y", "[", "t", "]"}], "2"]}]]}], ";", " ", 
        RowBox[{"\[Rho]2", "=", 
         SqrtBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "[", "t", "]"}], "-", "1", "+", "\[Eta]"}], ")"}], 
            "2"], "+", 
           SuperscriptBox[
            RowBox[{"y", "[", "t", "]"}], "2"]}]]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"x", "''"}], "[", "t", "]"}], "-", 
          RowBox[{"2", 
           RowBox[{
            RowBox[{"y", "'"}], "[", "t", "]"}]}]}], "==", 
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "\[Eta]"}], ")"}], 
           FractionBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "[", "t", "]"}], "+", "\[Eta]"}], ")"}], 
            SuperscriptBox["\[Rho]1", "3"]]}], "-", 
          RowBox[{"\[Eta]", " ", 
           FractionBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "[", "t", "]"}], "-", "1", "+", "\[Eta]"}], ")"}], 
            SuperscriptBox["\[Rho]2", "3"]]}]}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"y", "''"}], "[", "t", "]"}], "+", 
         RowBox[{"2", 
          RowBox[{
           RowBox[{"x", "'"}], "[", "t", "]"}]}]}], "==", 
        RowBox[{
         RowBox[{"y", "[", "t", "]"}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "\[Eta]"}], ")"}], 
          FractionBox[
           RowBox[{"y", "[", "t", "]"}], 
           SuperscriptBox["\[Rho]1", "3"]]}], "-", 
         RowBox[{"\[Eta]", " ", 
          FractionBox[
           RowBox[{"y", "[", "t", "]"}], 
           SuperscriptBox["\[Rho]2", "3"]]}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "==", "1.2"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "0", "]"}], "==", "vy0"}]}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"xSol", "[", "t", "]"}], ",", 
     RowBox[{"ySol", "[", "t", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", 
    RowBox[{"Norm", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x0", "-", 
        RowBox[{"xSol", "[", "TMax", "]"}]}], ",", 
       RowBox[{"0", "-", 
        RowBox[{"ySol", "[", "TMax", "]"}]}]}], "}"}], "]"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{4.0009916550322723`*^9, 4.000991778824626*^9}, {
  4.0009920445005903`*^9, 4.0009925453076744`*^9}, {4.000992585672394*^9, 
  4.0009925862660074`*^9}},ExpressionUUID->"60392477-a108-4900-ac4d-\
