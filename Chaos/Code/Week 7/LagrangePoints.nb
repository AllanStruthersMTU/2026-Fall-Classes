Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "vx_", ",", "vy_"}], "}"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Rho]1", ",", "\[Rho]2", ",", 
      RowBox[{"\[Eta]", "=", 
       RowBox[{"1", "/", "82.45"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Rho]1", "=", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "+", "\[Eta]"}], ")"}], "2"], "+", 
        SuperscriptBox["y", "2"]}]]}], ";", " ", 
     RowBox[{"\[Rho]2", "=", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", "1", "+", "\[Eta]"}], ")"}], "2"], "+", 
        SuperscriptBox["y", "2"]}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"vx", ",", "vy", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"2", " ", "vy"}], "+", "x", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Eta]"}], ")"}], 
         FractionBox[
          RowBox[{"(", 
           RowBox[{"x", "+", "\[Eta]"}], ")"}], 
          SuperscriptBox["\[Rho]1", "3"]]}], "-", 
        RowBox[{"\[Eta]", " ", 
         FractionBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "1", "+", "\[Eta]"}], ")"}], 
          SuperscriptBox["\[Rho]2", "3"]]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], " ", "vx"}], "+", "y", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Eta]"}], ")"}], 
         FractionBox["y", 
          SuperscriptBox["\[Rho]1", "3"]]}], "-", 
        RowBox[{"\[Eta]", " ", 
         FractionBox["y", 
          SuperscriptBox["\[Rho]2", "3"]]}]}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Eta]", "=", 
   RowBox[{"1", "/", "82.45"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L4", " ", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"0.5", "-", "\[Eta]"}], ",", 
     RowBox[{
      SqrtBox["3"], "/", "2"}], ",", "0", ",", "0"}], "}"}]}], " ", ";", 
  RowBox[{"L5", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"0.5", "-", "\[Eta]"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SqrtBox["3"]}], "/", "2"}], ",", "0", ",", "0"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L1", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "0", ",", "0"}], "}"}], "/.", 
    RowBox[{"FindRoot", "[", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "0", ",", "0"}], "}"}], "]"}], 
        "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "==", "0"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"-", "1"}]}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L2", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "0", ",", "0"}], "}"}], "/.", 
    RowBox[{"FindRoot", "[", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "0", ",", "0"}], "}"}], "]"}], 
        "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "==", "0"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "0.5"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L3", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "0", ",", "0"}], "}"}], "/.", 
    RowBox[{"FindRoot", "[", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "0", ",", "0"}], "}"}], "]"}], 
        "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "==", "0"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "1.5"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", "L1", "]"}], ",", 
   RowBox[{"f", "[", "L2", "]"}], ",", 
   RowBox[{"f", "[", "L3", "]"}], ",", 
   RowBox[{"f", "[", "L4", "]"}], ",", 
   RowBox[{"f", "[", "L5", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{4.001059108563573*^9, 4.0010594041360617`*^9}, {
