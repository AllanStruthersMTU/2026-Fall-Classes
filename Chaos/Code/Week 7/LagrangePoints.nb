Cell[CellGroupData[{

Cell["Lagrange Points: Stability?", "Subsection",
 CellChangeTimes->{{4.0009932688375206`*^9, 4.000993272077047*^9}, {
  4.00105640866934*^9, 4.0010564150268564`*^9}, {4.001056446856591*^9, 
  4.0010564484876256`*^9}, {4.001058441914279*^9, 4.0010584454060884`*^9}, {
  4.0010590814045343`*^9, 
  4.0010590832516317`*^9}},ExpressionUUID->"b5971941-3833-4a70-8809-\
00d2b13854f7"],

Cell["\<\
The easiest way to see stability (or instability) is to plot solutions! First \
compute the equilibrium and check that they are correct!\
\>", "Text",
 CellChangeTimes->{{4.001059603611967*^9, 4.001059625388172*^9}, {
  4.0010598559279337`*^9, 4.001059900799736*^9}, {4.001059933798299*^9, 
  4.00105994763643*^9}},ExpressionUUID->"bf4bb4a6-cab7-4641-b08c-\
03c271bf2257"],

