Cell[CellGroupData[{

Cell["Lagrange Points: Stability?", "Subsection",
 CellChangeTimes->{{4.0009932688375206`*^9, 4.000993272077047*^9}, {
  4.00105640866934*^9, 4.0010564150268564`*^9}, {4.001056446856591*^9, 
  4.0010564484876256`*^9}, {4.001058441914279*^9, 4.0010584454060884`*^9}, {
  4.0010590814045343`*^9, 
  4.0010590832516317`*^9}},ExpressionUUID->"b5971941-3833-4a70-8809-\
00d2b13854f7"],

Cell["\<\
The easiest way to see stability (or instability) is to plot solutions! First \
compute the equilibrium and check that they are correct!\
\>", "Text",
 CellChangeTimes->{{4.001059603611967*^9, 4.001059625388172*^9}, {
  4.0010598559279337`*^9, 4.001059900799736*^9}, {4.001059933798299*^9, 
  4.00105994763643*^9}},ExpressionUUID->"bf4bb4a6-cab7-4641-b08c-\
03c271bf2257"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "vx_", ",", "vy_"}], "}"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Rho]1", ",", "\[Rho]2", ",", 
      RowBox[{"\[Eta]", "=", 
       RowBox[{"1", "/", "82.45"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Rho]1", "=", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "+", "\[Eta]"}], ")"}], "2"], "+", 
        SuperscriptBox["y", "2"]}]]}], ";", " ", 
     RowBox[{"\[Rho]2", "=", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", "1", "+", "\[Eta]"}], ")"}], "2"], "+", 
        SuperscriptBox["y", "2"]}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"vx", ",", "vy", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"2", " ", "vy"}], "+", "x", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Eta]"}], ")"}], 
         FractionBox[
          RowBox[{"(", 
           RowBox[{"x", "+", "\[Eta]"}], ")"}], 
          SuperscriptBox["\[Rho]1", "3"]]}], "-", 
        RowBox[{"\[Eta]", " ", 
         FractionBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "1", "+", "\[Eta]"}], ")"}], 
          SuperscriptBox["\[Rho]2", "3"]]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], " ", "vx"}], "+", "y", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Eta]"}], ")"}], 
         FractionBox["y", 
          SuperscriptBox["\[Rho]1", "3"]]}], "-", 
        RowBox[{"\[Eta]", " ", 
         FractionBox["y", 
          SuperscriptBox["\[Rho]2", "3"]]}]}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Eta]", "=", 
   RowBox[{"1", "/", "82.45"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L4", " ", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"0.5", "-", "\[Eta]"}], ",", 
     RowBox[{
      SqrtBox["3"], "/", "2"}], ",", "0", ",", "0"}], "}"}]}], " ", ";", 
  RowBox[{"L5", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"0.5", "-", "\[Eta]"}], ",", 
     RowBox[{
      RowBox[{"-", 
       SqrtBox["3"]}], "/", "2"}], ",", "0", ",", "0"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L1", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "0", ",", "0"}], "}"}], "/.", 
    RowBox[{"FindRoot", "[", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "0", ",", "0"}], "}"}], "]"}], 
        "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "==", "0"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"-", "1"}]}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L2", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "0", ",", "0"}], "}"}], "/.", 
    RowBox[{"FindRoot", "[", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "0", ",", "0"}], "}"}], "]"}], 
        "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "==", "0"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "0.5"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L3", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "0", ",", "0"}], "}"}], "/.", 
    RowBox[{"FindRoot", "[", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "0", ",", "0"}], "}"}], "]"}], 
        "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "==", "0"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "1.5"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", "L1", "]"}], ",", 
