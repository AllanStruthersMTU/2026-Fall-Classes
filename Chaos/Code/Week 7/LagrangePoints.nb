Cell[CellGroupData[{

Cell["Lagrange Points: Where and What?", "Subsection",
 CellChangeTimes->{{4.0009932688375206`*^9, 4.000993272077047*^9}, {
  4.00105640866934*^9, 
  4.0010564150268564`*^9}},ExpressionUUID->"e5a81924-3200-4d3e-a5ce-\
86d8a529c6b1"],

Cell[TextData[{
 "Equilibrium point (called Lagrange points) satisfy\n\t",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]1", "=", 
     SqrtBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "+", "\[Eta]"}], ")"}], "2"], "+", 
       SuperscriptBox["y", "2"]}]]}], ";", " ", 
    RowBox[{"\[Rho]2", "=", 
     SqrtBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", "1", "+", "\[Eta]"}], ")"}], "2"], "+", 
       SuperscriptBox["y", "2"]}]]}], ";"}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"0", "==", 
     RowBox[{"x", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Eta]"}], ")"}], 
       FractionBox[
        RowBox[{"(", 
         RowBox[{"x", "+", "\[Eta]"}], ")"}], 
        SuperscriptBox["\[Rho]1", "3"]]}], "-", 
      RowBox[{"\[Eta]", " ", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{"x", "-", "1", "+", "\[Eta]"}], ")"}], 
        SuperscriptBox["\[Rho]2", "3"]]}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"0", "==", 
     RowBox[{"y", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Eta]"}], ")"}], 
       FractionBox["y", 
        SuperscriptBox["\[Rho]1", "3"]]}], "-", 
      RowBox[{"\[Eta]", " ", 
       FractionBox["y", 
        SuperscriptBox["\[Rho]2", "3"]]}]}]}]}], TraditionalForm]}],
  FormatType->TraditionalForm,ExpressionUUID->
  "31f43f8f-0f11-4992-ae98-9479199dffb9"]
}], "Text",
 CellChangeTimes->{{4.0009932799222927`*^9, 
  4.0009934045966015`*^9}},ExpressionUUID->"a67199c3-63fe-4ccf-bebb-\
765ee8779747"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eq", "[", "\[Eta]_", "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Rho]1", ",", "\[Rho]2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Rho]1", "=", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "+", "\[Eta]"}], ")"}], "2"], "+", 
        SuperscriptBox["y", "2"]}]]}], ";", " ", 
     RowBox[{"\[Rho]2", "=", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", "1", "+", "\[Eta]"}], ")"}], "2"], "+", 
        SuperscriptBox["y", "2"]}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Eta]"}], ")"}], 
         FractionBox[
          RowBox[{"(", 
           RowBox[{"x", "+", "\[Eta]"}], ")"}], 
          SuperscriptBox["\[Rho]1", "3"]]}], "-", 
        RowBox[{"\[Eta]", " ", 
         FractionBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "1", "+", "\[Eta]"}], ")"}], 
          SuperscriptBox["\[Rho]2", "3"]]}]}], ",", 
       RowBox[{"y", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Eta]"}], ")"}], 
         FractionBox["y", 
          SuperscriptBox["\[Rho]1", "3"]]}], "-", 
        RowBox[{"\[Eta]", " ", 
         FractionBox["y", 
          SuperscriptBox["\[Rho]2", "3"]]}]}]}], "}"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Eta]", "=", 
   RowBox[{"1", "/", "82.45"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"eq", "[", "\[Eta]", "]"}], "[", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], "]"}], "\[LeftDoubleBracket]", "1", 
       "\[RightDoubleBracket]"}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"eq", "[", "\[Eta]", "]"}], "[", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], "]"}], "\[LeftDoubleBracket]", "2", 
       "\[RightDoubleBracket]"}], "==", "0"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}], ",", 
   RowBox[{"PlotPoints", "->", "100"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Epilog", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"PointSize", "[", "0.02", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Gray", ",", " ", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "\[Eta]"}], ",", "0"}], "}"}], "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "-", "\[Eta]"}], ",", "0"}], "}"}], "]"}]}], "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Pink", ",", " ", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"0.5", "-", "\[Eta]"}], ",", 
           RowBox[{
            SqrtBox["3"], "/", "2"}]}], "}"}], "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"0.5", "-", "\[Eta]"}], ",", 
           RowBox[{
            RowBox[{"-", 
             SqrtBox["3"]}], "/", "2"}]}], "}"}], "]"}]}], "}"}]}], 
     "\[IndentingNewLine]", "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.000993416808195*^9, 4.0009934206426497`*^9}, {
  4.0009934549300313`*^9, 4.000993721546801*^9}, {4.0009938026455135`*^9, 
  4.000993973288567*^9}, {4.000994005384136*^9, 4.000994037724951*^9}, {
