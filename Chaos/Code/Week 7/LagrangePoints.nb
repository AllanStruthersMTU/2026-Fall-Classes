Cell[CellGroupData[{

Cell["First Order System", "Subsection",
 CellChangeTimes->{{4.000993245273105*^9, 
  4.0009932505338955`*^9}},ExpressionUUID->"771f7c82-0a68-4bc7-b849-\
277235fa6220"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"vy0", "=", 
   RowBox[{"-", "1.049357509830320"}]}], ";", " ", 
  RowBox[{"x0", "=", "1.2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "6.1922169331319640"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "vx_", ",", "vy_"}], "}"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Rho]1", ",", "\[Rho]2", ",", 
      RowBox[{"\[Eta]", "=", 
       RowBox[{"1", "/", "82.45"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Rho]1", "=", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "+", "\[Eta]"}], ")"}], "2"], "+", 
        SuperscriptBox["y", "2"]}]]}], ";", " ", 
     RowBox[{"\[Rho]2", "=", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", "1", "+", "\[Eta]"}], ")"}], "2"], "+", 
        SuperscriptBox["y", "2"]}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"vx", ",", "vy", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"2", " ", "vy"}], "+", "x", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Eta]"}], ")"}], 
         FractionBox[
          RowBox[{"(", 
           RowBox[{"x", "+", "\[Eta]"}], ")"}], 
          SuperscriptBox["\[Rho]1", "3"]]}], "-", 
        RowBox[{"\[Eta]", " ", 
         FractionBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "1", "+", "\[Eta]"}], ")"}], 
          SuperscriptBox["\[Rho]2", "3"]]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], " ", "vx"}], "+", "y", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Eta]"}], ")"}], 
         FractionBox["y", 
          SuperscriptBox["\[Rho]1", "3"]]}], "-", 
        RowBox[{"\[Eta]", " ", 
         FractionBox["y", 
          SuperscriptBox["\[Rho]2", "3"]]}]}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"zSol", "=", 
  RowBox[{"NDSolveValue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"z", "'"}], "[", "t", "]"}], "==", 
       RowBox[{"f", "[", 
        RowBox[{"z", "[", "t", "]"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"z", "[", "0", "]"}], "==", 
       RowBox[{"{", 
        RowBox[{"x0", ",", "0", ",", "0", ",", "vy0"}], "}"}]}]}], "}"}], ",",
     "z", ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", " ", "0", ",", " ", "TMax"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"zSol", "[", "t", "]"}], "\[LeftDoubleBracket]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "\[RightDoubleBracket]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.0009916550322723`*^9, 4.000991778824626*^9}, {
  4.0009920445005903`*^9, 4.0009925453076744`*^9}, {4.000992585672394*^9, 
  4.0009925862660074`*^9}, {4.0009926400224953`*^9, 4.000992912347514*^9}, {
  4.000993206124627*^9, 4.000993233157559*^9}},
