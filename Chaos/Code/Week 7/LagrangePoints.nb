Cell[TextData[{
 "The points on the x-axis are given by the roots of the following\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "-", " ", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Eta]"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"x", "+", "\[Eta]"}], ")"}]}], 
      SuperscriptBox[
       RowBox[{"Abs", "[", 
        RowBox[{"x", "+", "\[Eta]"}], "]"}], "3"]], "-", " ", 
     FractionBox[
      RowBox[{"\[Eta]", 
       RowBox[{"(", 
        RowBox[{"x", "-", "1", "+", "\[Eta]"}], ")"}]}], 
      SuperscriptBox[
       RowBox[{"Abs", "[", 
        RowBox[{"x", "-", "1", "+", "\[Eta]"}], "]"}], "3"]]}], "==", "0"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "135e580c-4687-4614-88b8-3d786d732a2d"]
}], "Text",
 CellChangeTimes->{{4.0009943920654817`*^9, 4.0009944215916147`*^9}, {
