Cell[CellGroupData[{

Cell["Lagrange Points: Linearization?", "Subsection",
 CellChangeTimes->{{4.0009932688375206`*^9, 4.000993272077047*^9}, {
  4.00105640866934*^9, 4.0010564150268564`*^9}, {4.001056446856591*^9, 
  4.0010564484876256`*^9}, {4.001058441914279*^9, 
  4.0010584454060884`*^9}},ExpressionUUID->"bf5ce021-cba4-443a-bed1-\
bd3d82c468ce"],

Cell[TextData[{
 "The stability of an equilibrium point ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     SuperscriptBox["y", "*"], ")"}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dfc7dbca-61a5-4ee6-ab4a-94785195e249"],
 " of an ODE ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{"f", "(", "y", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8a6f16c7-c27b-4a99-9506-9d87513071f6"],
 " is determined by examining the evolution of a perturbation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "(", "t", ")"}], "=", 
    RowBox[{
     SuperscriptBox["y", "*"], "+", 
     RowBox[{"dy", "(", "t", ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d01c8647-de27-4553-8beb-05e7b2a6e2fe"],
 " starting at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dy", "(", "0", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c041c5a1-7b29-49ad-b001-b3f787c73416"],
 ".  Linearization makes this process straightforward for sufficiently smooth \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", ":", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}], "\[Rule]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5020dbf3-992e-4c52-a684-cc7fd3f669e9"],
 " near ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "*"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "761ffa9d-2e52-46d9-a99c-2026d1ee3969"],
 ".\nFirst plug into the ODE and expand\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       SuperscriptBox["y", "*"], ")"}], "'"}], "+", 
     RowBox[{
      RowBox[{"dy", "'"}], 
      RowBox[{"(", "t", ")"}]}]}], "=", 
    RowBox[{
     RowBox[{"f", "(", 
      RowBox[{
       SuperscriptBox["y", "*"], "+", 
       RowBox[{"dy", "(", "t", ")"}]}], ")"}], "=", 
     RowBox[{
      RowBox[{"f", "(", 
       SuperscriptBox["y", "*"], ")"}], "+", 
      RowBox[{
       RowBox[{"Df", "(", 
        SuperscriptBox["y", "*"], ")"}], " ", 
       RowBox[{"dy", "(", "t", ")"}]}], "+", 
      RowBox[{
       FractionBox["1", "2"], 
       SuperscriptBox["D", "2"], 
       RowBox[{"f", "(", 
        SuperscriptBox["y", "*"], ")"}], 
       SuperscriptBox[
        RowBox[{"dy", "(", "t", ")"}], "2"], "\[Ellipsis]"}]}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0aeb198b-7961-475f-8b9f-38da8c2af1c4"],
 "\nSince ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "*"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cfd2d3c1-6c74-4bf0-920b-736368a95b34"],
 " is constant and  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     SuperscriptBox["y", "*"], ")"}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "983844b2-0697-4cbb-9922-889883180113"],
 " we have \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"dy", "'"}], 
     RowBox[{"(", "t", ")"}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Df", "(", 
       SuperscriptBox["y", "*"], ")"}], " ", 
      RowBox[{"dy", "(", "t", ")"}]}], "+", 
     RowBox[{"O", "(", 
      SuperscriptBox[
       RowBox[{"dy", "(", "t", ")"}], "2"], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3ea963b9-a8a7-411f-971b-914d661f601f"],
 "\nThe linearization for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"z", "(", "t", ")"}], "=", 
    RowBox[{"dy", "(", "t", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2adae223-8e08-4c53-9b8b-861c094880e9"],
 " about the equilibrium ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "*"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eddd6b0a-28fa-4b55-b13c-dadccdb264e4"],
 " is \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"z", "'"}], "=", 
    RowBox[{"A", "  ", "z"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "66d0822a-5e50-42f4-85bf-49c45dcc241b"],
 "\nwhere the constant ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "\[Times]", "n"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b4329393-c056-4926-893d-91dcddf93b7c"],
 " matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "=", 
    RowBox[{"Df", "(", 
     SuperscriptBox["z", "*"], ")"}]}], TraditionalForm]],
  InitializationCell->True,
  FormatType->TraditionalForm,ExpressionUUID->
  "d55e5bd5-3441-421c-81b0-d4394569a1c2"],
 " has components\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "ij"], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["f", "i"]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["y", "j"]}]], 
     SubscriptBox["|", 
      RowBox[{"y", "=", 
       SuperscriptBox["y", "*"]}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "84fa17c6-0ef7-49a4-bcf4-77682f7c9932"],
 "\t"
}], "Text",
 CellChangeTimes->{{4.001056454855736*^9, 4.0010577255209923`*^9}, {
  4.0010577980110226`*^9, 4.0010579395337677`*^9}, {4.0010579842192535`*^9, 
  4.001058034003309*^9}, {4.0010580794346457`*^9, 
  4.001058393488003*^9}},ExpressionUUID->"47b3c862-7f97-4b29-b2f4-\
c6fc25181651"],

Cell[CellGroupData[{

Cell["Tensors and Order", "Subsubsection",
 CellChangeTimes->{{4.0010580539978037`*^9, 
  4.0010580611654186`*^9}},ExpressionUUID->"f1ba6ece-5c33-461a-9d37-\
d54943990f4c"],

Cell[TextData[{
 "You should realize the ellipsis and the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"dy", "(", "t", ")"}], "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ebca4958-579d-403a-9c82-a507f118f448"],
 " are problematic.  If you want to work out what the quadratic term looks ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["D", "2"], "f"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bc86e17d-4dfd-4c99-87ac-78134c918821"],
 "  has three indices.  It has one for the component ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "67d8ad4a-d0e0-424d-83cb-c79fa5bb04c7"],
 " of the vector function f and one for the first derivative ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PartialD]", 
    SubscriptBox["y", "j"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "36665ea4-955a-4ad8-9069-58c68c14b7ee"],
 " along with one for the second derivative ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PartialD]", 
    SubscriptBox["y", "k"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b9de2266-8c5b-43bc-b6f5-06615c1dea16"],
 " i.e.\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["D", "2"], 
     SubscriptBox["f", 
      RowBox[{"i", ",", "j", ",", "k"}]]}], "=", 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[PartialD]", "2"], 
      SubscriptBox["f", "i"]}], 
     RowBox[{
      RowBox[{"\[PartialD]", 
       SubscriptBox["y", "k"]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["y", "j"]}]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f090d01b-4347-4d7a-b739-857ccae21ec7"],
 "\nThe correct expression for the quadratic term is \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{
     SubsuperscriptBox["\[Sum]", 
      RowBox[{"k", "=", "1"}], "n"], 
     RowBox[{
      SubsuperscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}], "n"], 
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], 
         SubscriptBox["f", "i"]}], 
        RowBox[{
         RowBox[{"\[PartialD]", 
          SubscriptBox["y", "k"]}], 
         RowBox[{"\[PartialD]", 
          SubscriptBox["y", "j"]}]}]], 
       RowBox[{
        SubscriptBox["dy", "j"], "(", "t", ")"}], 
       RowBox[{
        SubscriptBox["dy", "k"], "(", "t", ")"}]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "73d95ffc-c16f-46d7-81b1-6e0e8c3c2cdb"],
 "\nEinstein decide that the summations signs should be invisible for \
repeated indices (this is called the Einstein summation convention) and just \
wrote\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[PartialD]", "2"], 
      SubscriptBox["f", "i"]}], 
     RowBox[{
      RowBox[{"\[PartialD]", 
       SubscriptBox["y", "k"]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["y", "j"]}]}]], 
    RowBox[{
     SubscriptBox["dy", "j"], "(", "t", ")"}], 
    RowBox[{
     SubscriptBox["dy", "k"], "(", "t", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f719d78f-d6af-4d4f-9a9b-7466082492bb"],
 ".\nWe are linearizing so we can just write \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       SuperscriptBox["y", "*"], ")"}], "'"}], "+", 
     RowBox[{
      RowBox[{"dy", "'"}], 
      RowBox[{"(", "t", ")"}]}]}], "=", 
    RowBox[{
     RowBox[{"f", "(", 
      SuperscriptBox["y", "*"], ")"}], "+", 
     RowBox[{
      RowBox[{"Df", "(", 
       SuperscriptBox["y", "*"], ")"}], " ", 
      RowBox[{"dy", "(", "t", ")"}]}], "+", 
     RowBox[{"O", "(", 
      SuperscriptBox["dy", "2"], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "74846d38-73b3-45b6-b131-0c457b73c8e5"],
 "\nThe last term at the end is pronounced \[OpenCurlyDoubleQuote]big O of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["dy", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d20f478e-aea5-4200-860a-38fd0b92ade0"],
 "\[CloseCurlyDoubleQuote].  The expression ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", "z", ")"}], "=", 
    RowBox[{"O", "(", 
     SuperscriptBox["z", "p"], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "44e680a5-9a3b-4038-a1d6-612f5896e395"],
 " means there is a constant ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "062eff05-6b64-4a5b-b105-4bfa597ca30e"],
 " satisfying\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["lim", 
     RowBox[{"z", "->", "0"}]], 
    RowBox[{"||", 
     RowBox[{"g", "(", "z", ")"}], "||", 
     RowBox[{"\[LessEqual]", "C"}], " ", "||", "z", 
     SuperscriptBox["||", "p"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4ddea3e9-bb0b-44bc-a262-386f49f082cf"],
 "."
}], "Text",
 CellChangeTimes->{{4.001056454855736*^9, 4.0010577255209923`*^9}, {
  4.0010577980110226`*^9, 4.0010579395337677`*^9}, {4.0010579842192535`*^9, 
  4.0010580157644615`*^9}},ExpressionUUID->"f7f2d5e6-46ab-4148-a823-\
fc5d895f12ac"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Linearizing our System", "Subsection",
 CellChangeTimes->{{4.0010584156269484`*^9, 4.001058420778167*^9}, {
  4.0010584566302347`*^9, 
  4.001058473521081*^9}},ExpressionUUID->"7f06c63c-c014-4df4-805d-\
6e91d184f7f4"],

Cell["I took the derivatives and made a function. ", "Text",
 CellChangeTimes->{{4.0010622208328276`*^9, 
  4.0010622392261744`*^9}},ExpressionUUID->"cd7409ff-7503-4a4f-9bdd-\
6e1ca4fcd5af"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "df", ",", "\[Eta]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "\[Eta]_", "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "vx_", ",", "vy_"}], "}"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Rho]1", ",", "\[Rho]2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Rho]1", "=", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "+", "\[Eta]"}], ")"}], "2"], "+", 
        SuperscriptBox["y", "2"]}]]}], ";", " ", 
     RowBox[{"\[Rho]2", "=", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", "1", "+", "\[Eta]"}], ")"}], "2"], "+", 
        SuperscriptBox["y", "2"]}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"vx", ",", "vy", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"2", " ", "vy"}], "+", "x", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Eta]"}], ")"}], 
         FractionBox[
          RowBox[{"(", 
           RowBox[{"x", "+", "\[Eta]"}], ")"}], 
          SuperscriptBox["\[Rho]1", "3"]]}], "-", 
        RowBox[{"\[Eta]", " ", 
         FractionBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "1", "+", "\[Eta]"}], ")"}], 
          SuperscriptBox["\[Rho]2", "3"]]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], " ", "vx"}], "+", "y", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Eta]"}], ")"}], 
         FractionBox["y", 
          SuperscriptBox["\[Rho]1", "3"]]}], "-", 
        RowBox[{"\[Eta]", " ", 
         FractionBox["y", 
          SuperscriptBox["\[Rho]2", "3"]]}]}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"df", "[", "\[Eta]_", "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "vx_", ",", "vy_"}], "}"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Rho]1", ",", "\[Rho]2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Rho]1", "=", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "+", "\[Eta]"}], ")"}], "2"], "+", 
        SuperscriptBox["y", "2"]}]]}], ";", " ", 
     RowBox[{"\[Rho]2", "=", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", "1", "+", "\[Eta]"}], ")"}], "2"], "+", 
        SuperscriptBox["y", "2"]}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1", ",", "0"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "1"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "+", 
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "\[Eta]"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "3"}], " ", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"x", "+", "\[Eta]"}], ")"}], "2"]}], "+", 
              SuperscriptBox["\[Rho]1", "2"]}], ")"}]}], 
           SuperscriptBox["\[Rho]1", "5"]], "+", 
          FractionBox[
           RowBox[{"3", " ", "\[Eta]", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", "x", "+", "\[Eta]"}], ")"}], "2"]}], 
           SuperscriptBox["\[Rho]2", "5"]], "-", 
          FractionBox["\[Eta]", 
           SuperscriptBox["\[Rho]2", "3"]]}], ",", 
         RowBox[{"3", " ", "y", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "\[Eta]"}], ")"}], " ", 
               RowBox[{"(", 
                RowBox[{"x", "+", "\[Eta]"}], ")"}]}], 
              SuperscriptBox["\[Rho]1", "5"]]}], "+", 
            FractionBox[
             RowBox[{"\[Eta]", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "x", "+", "\[Eta]"}], ")"}]}], 
             SuperscriptBox["\[Rho]2", "5"]]}], ")"}]}], ",", "0", ",", "2"}],
         "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"3", " ", "y", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "\[Eta]"}], ")"}], " ", 
               RowBox[{"(", 
                RowBox[{"x", "+", "\[Eta]"}], ")"}]}], 
              SuperscriptBox["\[Rho]1", "5"]]}], "+", 
            FractionBox[
             RowBox[{"\[Eta]", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "x", "+", "\[Eta]"}], ")"}]}], 
             SuperscriptBox["\[Rho]2", "5"]]}], ")"}]}], ",", 
         RowBox[{"1", "+", 
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "\[Eta]"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "3"}], " ", 
               SuperscriptBox["y", "2"]}], "+", 
              SuperscriptBox["\[Rho]1", "2"]}], ")"}]}], 
           SuperscriptBox["\[Rho]1", "5"]], "+", 
          FractionBox[
           RowBox[{"3", " ", 
            SuperscriptBox["y", "2"], " ", "\[Eta]"}], 
           SuperscriptBox["\[Rho]2", "5"]], "-", 
          FractionBox["\[Eta]", 
           SuperscriptBox["\[Rho]2", "3"]]}], ",", 
         RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "\[IndentingNewLine]", 
      "}"}]}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
