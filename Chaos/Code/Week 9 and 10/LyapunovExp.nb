Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "dyf", ",", "ReturnMapAndTimeAndJ"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", 
    RowBox[{"x", " ", "+", " ", 
     RowBox[{"a", " ", "y"}]}], ",", 
    RowBox[{"b", " ", "+", " ", 
     RowBox[{"z", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dyf", "[", 
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
   RowBox[{"(", GridBox[{
      {"0", 
       RowBox[{"-", "1"}], 
       RowBox[{"-", "1"}]},
      {"1", "a", "0"},
      {"z", "0", 
       RowBox[{"x", "-", "c"}]}
     }], ")"}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dcf", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"0", ",", "0", ",", 
    RowBox[{"-", "z"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ReturnMapAndTimeAndJ", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"f_", ",", "dyf_"}], "}"}]}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"u1_", ",", "u2_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y0", ",", 
      RowBox[{"TMin", "=", "0.001"}], ",", 
      RowBox[{"TMax", "=", "123"}], ",", "\[IndentingNewLine]", "tVal", ",", 
      "yVal", ",", "JVal", ",", "ySol", ",", "JSol", ",", "y", ",", "J", ",", 
      "t"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"y0", "=", 
      RowBox[{"{", 
       RowBox[{"c", ",", "u1", ",", "u2"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tVal", ",", "yVal", ",", "JVal"}], "}"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"Reap", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ySol", ",", "JSol"}], "}"}], "=", " ", 
          RowBox[{"NDSolveValue", "[", " ", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
               RowBox[{
                RowBox[{"f", "[", 
                 RowBox[{"{", 
                  RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", 
                RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
               RowBox[{
                RowBox[{
                 RowBox[{"dyf", "[", 
                  RowBox[{"{", 
                   RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", 
                 RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
                RowBox[{"J", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
              RowBox[{
               RowBox[{"J", "[", "0", "]"}], "==", 
               RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"WhenEvent", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"Indexed", "[", 
                   RowBox[{
                    RowBox[{"y", "[", "t", "]"}], ",", "1"}], "]"}], "-", 
                  "c"}], " ", "<", "0"}], ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"t", ">", "TMin"}], ",", " ", 
                  RowBox[{
                   RowBox[{"Sow", "[", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", 
                    RowBox[{"y", "[", "t", "]"}], ",", 
                    RowBox[{"J", "[", "t", "]"}]}], "}"}], "]"}], ";", " ", 
                   "\"\<StopIntegration\>\""}]}], "]"}]}], "]"}]}], 
             "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{
              "I", " ", "have", " ", "no", " ", "idea", " ", "why", " ", "I", 
               " ", "had", " ", "to", " ", "use", " ", "indexed", " ", 
               "instead", " ", 
               RowBox[{"of", " ", "[", 
                RowBox[{"[", "]"}], "]"}], " ", "in", " ", 
               RowBox[{"here", "!"}]}], " ", "*)"}], "\[IndentingNewLine]", 
             "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"y", ",", "J"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], "]"}]}], ";"}], 
        "\[IndentingNewLine]", "]"}], "\[LeftDoubleBracket]", 
       RowBox[{"2", ",", "1", ",", "1"}], "\[RightDoubleBracket]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 InitializationCell->True,
