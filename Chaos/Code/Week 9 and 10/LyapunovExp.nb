Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"pAndDp", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"f_", ",", "dcf_"}], "}"}]}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"u1_", ",", "u2_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "t", ",", "p", ",", "J", ",", "Dp", ",", "f1", ",", "f2", ",", "f3"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t", ",", "p", ",", "J"}], "}"}], "=", 
      RowBox[{
       RowBox[{"ReturnMapAndTimeAndJ", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"f", ",", "dyf"}], "}"}]}], "]"}], "[", 
       RowBox[{"{", 
        RowBox[{"u1", ",", "u2"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"f1", ",", "f2", ",", "f3"}], "}"}], "=", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", "p", "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Dp", "=", 
      RowBox[{
       RowBox[{"(", GridBox[{
          {
           RowBox[{"J", "\[LeftDoubleBracket]", 
            RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}], 
           RowBox[{"J", "\[LeftDoubleBracket]", 
            RowBox[{"2", ",", "3"}], "\[RightDoubleBracket]"}]},
          {
           RowBox[{"J", "\[LeftDoubleBracket]", 
            RowBox[{"3", ",", "2"}], "\[RightDoubleBracket]"}], 
           RowBox[{"J", "\[LeftDoubleBracket]", 
            RowBox[{"3", ",", "3"}], "\[RightDoubleBracket]"}]}
         }], ")"}], "-", 
       RowBox[{
        FractionBox["1", "f1"], 
        RowBox[{"(", GridBox[{
           {
            RowBox[{"f2", " ", 
             RowBox[{"J", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}], 
            RowBox[{"f2", " ", 
             RowBox[{"J", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "3"}], "\[RightDoubleBracket]"}]}]},
           {
            RowBox[{"f3", " ", 
             RowBox[{"J", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}], 
            RowBox[{" ", 
             RowBox[{"f3", " ", 
              RowBox[{"J", "\[LeftDoubleBracket]", 
               RowBox[{"1", ",", "3"}], "\[RightDoubleBracket]"}]}]}]}
          }], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", "\[LeftDoubleBracket]", 
        RowBox[{"2", ";;", "3"}], "\[RightDoubleBracket]"}], ",", "Dp"}], 
      "}"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
