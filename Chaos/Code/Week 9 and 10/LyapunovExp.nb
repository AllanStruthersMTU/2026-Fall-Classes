Cell[CellGroupData[{

Cell["Loops", "Subsubsection",
 CellChangeTimes->{{4.000460884491954*^9, 4.000460901648095*^9}, {
  4.000538289798253*^9, 4.0005382950039787`*^9}, {4.000538924981372*^9, 
  4.0005389289451847`*^9}, {4.0006291977359333`*^9, 4.0006292078830175`*^9}, {
  4.0007221225217295`*^9, 4.000722133123322*^9}, {4.000722860128234*^9, 
  4.0007228628644648`*^9}, {4.0007241403062162`*^9, 4.000724143723923*^9}, {
  4.000724480672349*^9, 4.0007244817540827`*^9}, {4.000726271989316*^9, 
  4.0007262748329954`*^9}},ExpressionUUID->"92f69c21-1e30-418e-8ee2-\
100816f98f8f"],

Cell[TextData[{
 "For a triple loop we want to solve \n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      SubscriptBox["u", "2"], "=", 
      RowBox[{"p", 
       RowBox[{"(", 
        SubscriptBox["u", "1"], ")"}]}]},
     {
      SubscriptBox["u", "3"], "=", 
      RowBox[{"p", "(", 
       SubscriptBox["u", "2"], ")"}]},
     {
      SubscriptBox["u", "1"], "=", 
      RowBox[{"p", "(", 
       SubscriptBox["u", "3"], ")"}]}
    }], TraditionalForm]],ExpressionUUID->
  "9e2340c9-f477-43bf-b39b-a937dbccfea3"],
 "\nfor the return map p.  Apply Newton\[CloseCurlyQuote]s method to \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", GridBox[{
       {
        SubscriptBox["u", "1"]},
       {
        SubscriptBox["u", "2"]},
       {
        SubscriptBox["u", "3"]}
      }], ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", GridBox[{
         {
          RowBox[{"p", "(", 
           SubscriptBox["u", "1"], ")"}]},
         {
          RowBox[{"p", "(", 
           SubscriptBox["u", "2"], ")"}]},
         {
          RowBox[{"p", "(", 
           SubscriptBox["u", "3"], ")"}]}
        }], ")"}], "-", 
      RowBox[{"(", GridBox[{
         {
          SubscriptBox["u", "2"]},
         {
          SubscriptBox["u", "1"]},
         {
          SubscriptBox["u", "3"]}
        }], ")"}]}], "=", 
     RowBox[{"(", GridBox[{
        {"0"},
        {"0"},
        {"0"}
       }], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "458ed390-f4d1-49a4-bad7-e61709944efe"],
 "\nto get the iteration \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "new"], "=", 
    RowBox[{
     SubscriptBox["w", "old"], "-", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Dg", "(", 
        SubscriptBox["w", "old"], ")"}], 
       RowBox[{"-", "1"}]], 
      RowBox[{"g", "(", 
       SubscriptBox["w", "old"], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"8346d542-f725-4c63-9828-41bf2d9dce4b"],
 "\nwhere \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"w", "=", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["u", "1"]},
       {
        SubscriptBox["u", "2"]},
       {
        SubscriptBox["u", "3"]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "37752341-9223-4913-98b2-c0856ea40180"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Dg", "(", 
     RowBox[{"(", GridBox[{
        {
         SubscriptBox["u", "1"]},
        {
         SubscriptBox["u", "2"]},
        {
         SubscriptBox["u", "3"]}
       }], ")"}], ")"}], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"Dp", "(", 
         SubscriptBox["u", "1"], ")"}], 
        RowBox[{"-", "Id"}], "0"},
       {"0", 
        RowBox[{"Dp", "(", 
         SubscriptBox["u", "2"], ")"}], 
        RowBox[{"-", "Id"}]},
       {
        RowBox[{"-", "Id"}], "0", 
        RowBox[{"Dp", "(", 
         SubscriptBox["u", "3"], ")"}]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "13116b85-4fe9-408f-b4ac-ae70a9f0954f"],
 "\nWe are going to build code to try to compute a general cycle starting \
from a decent initial guess. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Us", "=", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["u", "1"], ",", 
      SubscriptBox["u", "2"], ",", "\[Ellipsis]", ",", 
      SubscriptBox["u", "m"]}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "5dabf205-698c-436f-8c2e-d58fa9e1ff02"],
 " each in the coordinates given by a set of tangents. If we do this right we \
can set it up to do any number of loops in any number of dimensions! We need \
to do some planning :)  Here is a skeleton. "
}], "Text",
 CellChangeTimes->{{4.0005614722004504`*^9, 4.0005615343739376`*^9}, {
  4.000561590772004*^9, 4.000561760468672*^9}, {4.0006300071500416`*^9, 
  4.000630042159374*^9}, {4.000722137488967*^9, 4.0007223254587994`*^9}, {
  4.000722397582649*^9, 4.0007224117709045`*^9}, {4.0007238991926317`*^9, 
  4.0007239202504573`*^9}, {4.0007244893016577`*^9, 4.0007247878467426`*^9}, {
  4.0007248179118357`*^9, 4.0007248192083836`*^9}, {4.000724930330272*^9, 
  4.000724936958984*^9}, {4.000724982534488*^9, 4.0007249978034115`*^9}, {
