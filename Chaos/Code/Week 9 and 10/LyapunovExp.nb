Notebook[{

Cell[CellGroupData[{
Cell["Lyapunov Exponents. ", "Title",
 CellChangeTimes->{{3.997354396199274*^9, 3.9973544008679843`*^9}, {
  3.9999346233602753`*^9, 3.9999346251770563`*^9}, {4.0001934647115793`*^9, 
  4.000193468010045*^9}, {4.000195283391547*^9, 4.00019528985012*^9}, {
  4.001333597054736*^9, 
  4.001333605140703*^9}},ExpressionUUID->"ee41a007-0d2f-4b6e-9991-\
30a592e66adf"],

Cell[CellGroupData[{

Cell["Lyapunov Computation", "Subsection",
 CellChangeTimes->{{4.000460884491954*^9, 4.000460901648095*^9}, {
  4.000538289798253*^9, 4.0005382950039787`*^9}, {4.000538924981372*^9, 
  4.0005389289451847`*^9}, {4.0006291977359333`*^9, 4.0006292078830175`*^9}, {
  4.0007221225217295`*^9, 4.000722133123322*^9}, {4.000722860128234*^9, 
  4.0007228628644648`*^9}, {4.0007241491771555`*^9, 4.0007241502552156`*^9}, {
  4.0009028364234133`*^9, 
  4.0009028416707754`*^9}},ExpressionUUID->"bf7e7e94-08f5-4246-9b34-\
f73f178bd724"],

Cell[TextData[{
 "We have seen that the Singular values of the sensitivity matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"J", "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "43479c5c-8d3c-4b35-9f3e-a9a76c6c5574"],
 " encode the stretching and compression of directions in the system\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"y", "'"}], 
     RowBox[{"(", "t", ")"}]}], "=", 
    RowBox[{"f", "(", 
     RowBox[{"y", "(", "t", ")"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "62972ec4-50c8-4905-9251-6d465ea91697"],
 "  and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"J", "'"}], 
     RowBox[{"(", "t", ")"}]}], "=", 
    RowBox[{
     RowBox[{"Df", "(", 
      RowBox[{"y", "(", "t", ")"}], ")"}], ".", 
     RowBox[{"J", "(", "t", ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cfcc6e91-d772-4575-b6f7-658481f342a1"],
 " with initial conditions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "(", "0", ")"}], "=", "y0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7d6947e0-e18b-479f-a3b9-dc26ceded127"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"J", "(", "0", ")"}], "=", "Id"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "39d088b4-689f-4b5c-80d1-ecc22d85b3c3"],
 "\nwe also saw that for Rossller (and all the Sprott systems) it was \
numerically hard to track the tiny singular values that arise because the ODE \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{"f", "(", "y", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6776fb73-15fa-4e8e-ac0c-d0dc60485479"],
 " compresses initial conditions dramatically in one dimension.  We saw the \
straight lines (and essentially straight lines) in the log plots for the \
singular values.  The average slopes of those  straight lines are the \
Lyapunov exponents.   T"
}], "Text",
 CellChangeTimes->{{4.00090284931036*^9, 4.0009030819171286`*^9}, {
  4.000903163212902*^9, 
  4.000903405974822*^9}},ExpressionUUID->"1d3bc32c-0b77-4408-9588-\
d461019411a2"],

Cell["\<\
To avoid any of the vectors getting squished to zero (where we have problems) \
we are going to run repeatedly for a short period of time and track the \
lengths of the vectors  before rescaling the directions to have length 1.   \
The QR decomposition (aka the Modified Graham Schmidt Process) does this \
scaling.  The new directions are the Q and the scalings are the absolute \
values of the diagonal entries.  I am just going to save the diagonals of the \
Rs.   \
\>", "Text",
 CellChangeTimes->{{4.00090284931036*^9, 4.0009030819171286`*^9}, {
  4.000903163212902*^9, 4.000903555483235*^9}, {4.0009041337837195`*^9, 
  4.0009042575357723`*^9}, {4.000911855878499*^9, 
  4.000911870262354*^9}},ExpressionUUID->"0d350b95-cf57-4299-9207-\
93d945e43596"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "f", ",", "dyf", ",", "y0", ",", "dt", ",", "TMax", ",", 
   "LyapunovStretches"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LyapunovStretches", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "df_", ",", "y0_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"dt_", ",", "TMax_"}], "}"}]}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "y0", "]"}]}], ",", "Q0", ",", "R"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Q0", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"QRDecomposition", "[", 
         RowBox[{"RandomReal", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "n"}], "}"}]}], "]"}], "]"}], 
        "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
       "\[Transpose]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"returns", " ", "a", " ", "list", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"y", ",", "J"}], "}"}], ",", " ", 
         RowBox[{"{", "Stretches", "}"}]}], "}"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Reap", "[", "\[IndentingNewLine]", 
      RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
           RowBox[{"f", "[", 
            RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
           RowBox[{
            RowBox[{"df", "[", 
             RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
            RowBox[{"J", "[", "t", "]"}]}]}], ",", " ", 
          RowBox[{
           RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", " ", 
          RowBox[{
           RowBox[{"J", "[", "0", "]"}], "==", "Q0"}], ",", " ", 
          "\[IndentingNewLine]", 
          RowBox[{"WhenEvent", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"t", ",", "dt"}], "]"}], "==", "0"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"Q0", ",", " ", "R"}], "}"}], "=", 
              RowBox[{"QRDecomposition", "[", 
               RowBox[{
                RowBox[{"J", "[", "t", "]"}], ",", 
                RowBox[{"Pivoting", "->", "False"}]}], "]"}]}], ";", 
             RowBox[{"Sow", "[", 
              RowBox[{"Diagonal", "[", "R", "]"}], "]"}], ";", 
             RowBox[{
              RowBox[{"J", "[", "t", "]"}], "->", 
              RowBox[{"Q0", "\[Transpose]"}]}]}]}], "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"y", ",", "J"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}], 
      "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.000904342625908*^9, 4.0009045130329795`*^9}, {
  4.000904612015355*^9, 4.000904640543575*^9}, {4.0009047346064568`*^9, 
  4.000904739488185*^9}, {4.000904827342473*^9, 4.000904937741478*^9}, {
  4.0009049690155606`*^9, 4.000904969582247*^9}, {4.0009051384242477`*^9, 
  4.0009051494133997`*^9}, {4.0009053450255322`*^9, 4.0009054028192577`*^9}, {
  4.0009056401183453`*^9, 4.000905648444276*^9}, {4.000906097983429*^9, 
  4.000906125091796*^9}, {4.000908479061401*^9, 4.000908491797946*^9}, {
  4.00090855929982*^9, 4.0009086911723304`*^9}, {4.0009087377247334`*^9, 
  4.000908860076598*^9}, {4.0009117552394905`*^9, 4.0009118266611814`*^9}, {
  4.000911911239241*^9, 4.0009120899819345`*^9}, {4.0009125222623835`*^9, 
  4.00091253135845*^9}, {4.00091287313315*^9, 4.0009128784812813`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"ad79f743-0e2b-4b87-9f6d-5da13613d439"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", " ", 
    RowBox[{"x", "+", " ", 
     RowBox[{"a", " ", "y"}]}], ",", " ", 
    RowBox[{"b", " ", "+", " ", 
     RowBox[{"z", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dyf", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "a", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", 
      RowBox[{
       RowBox[{"-", "c"}], "+", "x"}]}], "}"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "3.186401426467017`"}], ",", "7.375915969931288`", ",", 
     "0.02906709913139469`"}], "}"}]}], ";", " ", 
  RowBox[{"p", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{"0.2", ",", "0.2", ",", "5.7"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dt", ",", " ", "TMax"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"0.05", ",", "123"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ySol", ",", "JSol"}], "}"}], ",", 
     RowBox[{"{", "Rs", "}"}]}], "}"}], "=", 
   RowBox[{"LyapunovStretches", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f", "[", "p", "]"}], ",", 
       RowBox[{"dyf", "[", "p", "]"}], ",", "y0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"dt", ",", " ", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<3Dy\>\"", "->", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"ySol", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<\[Sigma]\>\"", "->", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"SingularValueList", "[", 
        RowBox[{"JSol", "[", "t", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<Rs\>\"", "->", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"Rs", "\[Transpose]"}], "]"}], ",", 
       RowBox[{"DataRange", "->", 
        RowBox[{"{", 
         RowBox[{"0", ",", "TMax"}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}], "}"}], 
  "]"}]}], "Input",
