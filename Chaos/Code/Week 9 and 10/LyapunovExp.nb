Cell["\<\
One more piece of code to collect section points from a start point and throw \
away the first batch.\
\>", "Text",
 CellChangeTimes->{{4.000285289193366*^9, 
  4.000285361751034*^9}},ExpressionUUID->"d5ad8f4d-8e05-498b-81c6-\
3ffc0238b9f6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CollectSectionPoints", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], ",", 
     RowBox[{"{", "f_", "}"}]}], "]"}], "[", "u0_", "]"}], ":=", " ", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y0", " ", "=", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "c", "}"}], ",", "u0"}], "]"}]}], ",", "y", ",", "t", 
      ",", 
      RowBox[{"TMin", "=", 
       SuperscriptBox["10", "3"]}], ",", 
      RowBox[{"TMax", "=", 
       SuperscriptBox["10", "4"]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Reap", "[", 
      RowBox[{"NDSolveValue", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
           RowBox[{
            RowBox[{"f", "[", 
             RowBox[{"{", 
              RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", 
            RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", " ", 
          "\[IndentingNewLine]", 
          RowBox[{"WhenEvent", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Indexed", "[", 
               RowBox[{
                RowBox[{"y", "[", "t", "]"}], ",", "1"}], "]"}], "-", "c"}], 
             "<", "0"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"t", ">", "TMin"}], ",", " ", 
              RowBox[{"Sow", "[", 
               RowBox[{"y", "[", "t", "]"}], "]"}]}], "]"}]}], "]"}]}], " ", 
         "}"}], ",", "\[IndentingNewLine]", "y", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}], "]"}], 
     "\[LeftDoubleBracket]", 
     RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.0001250648763638`*^9, 4.000125272054468*^9}, {
   4.000125794960424*^9, 4.000125798707283*^9}, {4.0001260468672113`*^9, 
   4.000126070483937*^9}, {4.0001261408243656`*^9, 4.0001261612422314`*^9}, {
   4.0001262196277313`*^9, 4.000126228479369*^9}, {4.000126302148667*^9, 
