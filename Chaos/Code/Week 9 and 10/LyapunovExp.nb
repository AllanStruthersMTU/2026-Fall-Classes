Cell[CellGroupData[{

Cell["Single Loop", "Subsubsection",
 CellChangeTimes->{{4.000460884491954*^9, 4.000460901648095*^9}, {
  4.000538289798253*^9, 4.0005382950039787`*^9}, {4.000538924981372*^9, 
  4.0005389289451847`*^9}, {4.0006291977359333`*^9, 4.0006292078830175`*^9}, {
  4.0007221225217295`*^9, 4.000722133123322*^9}, {4.000722860128234*^9, 
  4.0007228628644648`*^9}, {4.0007241403062162`*^9, 
  4.000724143723923*^9}},ExpressionUUID->"c61fa6f4-db42-4ad2-a08b-\
fed2ccc6ef83"],

Cell[TextData[{
 "Some code got lost!  The following code computes the first return time, \
map, full sensitivity, and Section sensitivity for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{"f", "(", "y", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eda0158c-2197-41bc-8d26-59755acb3fdd"],
 ".  I am going to demo h  "
}], "Text",
 InitializationCell->True,
 CellChangeTimes->{{4.00218773802742*^9, 4.0021877494992423`*^9}, {
  4.0021878242019825`*^9, 4.002187896696285*^9}, {4.0021879321154203`*^9, 
  4.0021879343831906`*^9}, {4.0021880423969145`*^9, 
  4.00218804931354*^9}},ExpressionUUID->"534be659-f02c-4c19-8d51-\
e52b61e6d9f0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Tau]pJDpSection", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "dyf_", ",", "y0_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"T_", ",", "n_", ",", "p0_"}], "}"}], ",", "TMax_"}], "]"}], ":=",
   " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]"}]}]}]], "Input",
 CellChangeTimes->{{4.00218775706437*^9, 
  4.0021878191030407`*^9}},ExpressionUUID->"1a89cb69-b521-4db3-ac73-\
634a8f802835"],

Cell[TextData[{
 "For a single loop we want to solve \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"u", "=", 
    RowBox[{"p", "(", "u", ")"}]}], TraditionalForm]],ExpressionUUID->
  "25262669-4699-4966-bde5-220142e597f3"],
 "\nfor the return map p.  We can compute the derivative of P with respect to \
the parameters u.   We apply Newton\[CloseCurlyQuote]s method to \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", "u", ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"p", "(", "u", ")"}], "-", "u"}], "=", "0"}]}], 
   TraditionalForm]],ExpressionUUID->"fbbbea63-d9b4-409f-acb9-e5b239efe6e9"],
 "\nto get the iteration \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "new"], "=", 
    RowBox[{
     SubscriptBox["u", "old"], "-", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Dg", "(", 
        SubscriptBox["u", "old"], ")"}], 
       RowBox[{"-", "1"}]], 
      RowBox[{"g", "(", 
       SubscriptBox["u", "old"], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"c2dd8aa4-d0b3-4d08-8cf6-a2e94df78721"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Dg", "=", 
    RowBox[{"Dp", "-", 
     SubscriptBox["I", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "1cfa610a-94e3-43dd-9659-be4795f042da"],
 ".  Computing the return loop we saw above with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "1.0"}], TraditionalForm]],ExpressionUUID->
  "73598593-a9ff-4070-9a4f-a089f828e8df"],
 " looks something like this."
}], "Text",
 CellChangeTimes->{{4.0005614722004504`*^9, 4.0005615343739376`*^9}, {
  4.000561590772004*^9, 4.000561760468672*^9}, {4.0006300071500416`*^9, 
  4.000630042159374*^9}, {4.000722137488967*^9, 4.0007223254587994`*^9}, {
  4.000722397582649*^9, 4.0007224117709045`*^9}, {4.0007238991926317`*^9, 
  4.0007239202504573`*^9}},ExpressionUUID->"de0ab977-944f-4d05-9c00-\
bcdbc3502a90"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "dyf"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", " ", 
    RowBox[{"x", "+", " ", 
     RowBox[{"a", " ", "y"}]}], ",", " ", 
    RowBox[{"b", " ", "+", " ", 
     RowBox[{"z", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dyf", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "a", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", 
      RowBox[{
       RowBox[{"-", "c"}], "+", "x"}]}], "}"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.2", ",", "0.2", ",", "1.0"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}], ";", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"t1", ",", "t2"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";", 
  RowBox[{"T", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t1", ",", "t2"}], "}"}], "\[Transpose]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p0", "=", 
   RowBox[{"{", 
    RowBox[{"c", ",", "0", ",", "0"}], "}"}]}], ";", " ", 
  RowBox[{"u", "=", 
   RowBox[{"{", 
    RowBox[{"0.9", ",", "1.7"}], "}"}]}], ";", 
  RowBox[{"y0", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", "c", "}"}], ",", "u"}], "]"}]}], ";", " ", 
  RowBox[{"TMax", "=", "123"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Tau]", ",", "p", ",", "J", ",", "Dp"}], "}"}], "=", 
   RowBox[{"\[Tau]pJDpSection", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", 
       RowBox[{"dyf", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", "y0"}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"T", ",", "n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "=", 
     RowBox[{"u", "-", 
      RowBox[{"LinearSolve", "[", 
       RowBox[{
        RowBox[{"Dp", "-", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", 
        RowBox[{
         RowBox[{"p", "\[LeftDoubleBracket]", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}], "\[RightDoubleBracket]"}], "-", 
         "u"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Tau]", ",", "p", ",", "J", ",", "Dp"}], "}"}], "=", 
     RowBox[{"\[Tau]pJDpSection", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", 
         RowBox[{"dyf", "[", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", "c", "}"}], ",", "u"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"T", ",", "n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"Norm", "[", 
      RowBox[{
       RowBox[{"p", "\[LeftDoubleBracket]", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], "\[RightDoubleBracket]"}], "-", 
       "u"}], "]"}], "]"}]}], ",", "\[IndentingNewLine]", "2"}], 
  "]"}]}], "Input",
