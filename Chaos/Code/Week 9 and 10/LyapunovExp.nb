  4.0007244817540827`*^9}},ExpressionUUID->"2d860bc0-d79d-4890-bd75-\
d18e56501489"],

Cell[TextData[{
 "For a double loop we want to solve \n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      SubscriptBox["u", "2"], "=", 
      RowBox[{"p", 
       RowBox[{"(", 
        SubscriptBox["u", "1"], ")"}]}]},
     {
      SubscriptBox["u", "1"], "=", 
      RowBox[{"p", "(", 
       SubscriptBox["u", "2"], ")"}]}
    }], TraditionalForm]],ExpressionUUID->
  "82806e9b-3cc8-4e05-9e4d-b91de1dafbb8"],
 "\nfor the return map p.  Apply Newton\[CloseCurlyQuote]s method to \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", GridBox[{
       {
        SubscriptBox["u", "1"]},
       {
        SubscriptBox["u", "2"]}
      }], ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", GridBox[{
         {
          RowBox[{"p", "(", 
           SubscriptBox["u", "1"], ")"}]},
         {
          RowBox[{"p", "(", 
           SubscriptBox["u", "2"], ")"}]}
        }], ")"}], "-", 
      RowBox[{"(", GridBox[{
         {
          SubscriptBox["u", "2"]},
         {
          SubscriptBox["u", "1"]}
        }], ")"}]}], "=", 
     RowBox[{"(", GridBox[{
        {"0"},
        {"0"}
       }], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "96cb2ef7-c439-4b8a-981e-66644a52861d"],
 "\nto get the iteration \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "new"], "=", 
    RowBox[{
     SubscriptBox["w", "old"], "-", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Dg", "(", 
        SubscriptBox["w", "old"], ")"}], 
       RowBox[{"-", "1"}]], 
      RowBox[{"g", "(", 
       SubscriptBox["w", "old"], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"2a51a797-2a60-408b-ace8-5f65199c37ea"],
 "\nwhere \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"w", "=", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["u", "1"]},
       {
        SubscriptBox["u", "2"]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "e5196f42-64c7-488e-b750-20b74ee79e35"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Dg", "(", 
     RowBox[{"(", GridBox[{
        {
         SubscriptBox["u", "1"]},
        {
         SubscriptBox["u", "2"]}
       }], ")"}], ")"}], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"Dp", "(", 
         SubscriptBox["u", "1"], ")"}], 
        RowBox[{"-", "Id"}]},
       {
        RowBox[{"-", "Id"}], 
        RowBox[{"Dp", "(", 
         SubscriptBox["u", "2"], ")"}]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "42cf0229-5325-4d28-8ab0-e7aeca931bb2"],
 "\nAccurately computing the visible double return loop with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "3.3"}], TraditionalForm]],ExpressionUUID->
  "53faa9b1-b376-4d09-866c-d62152c5b9d7"],
 " looks something like this.  First find a point on an approximate double \
cycle. The double point section test is what we have been looking at. "
}], "Text",
 CellChangeTimes->{{4.0005614722004504`*^9, 4.0005615343739376`*^9}, {
  4.000561590772004*^9, 4.000561760468672*^9}, {4.0006300071500416`*^9, 
  4.000630042159374*^9}, {4.000722137488967*^9, 4.0007223254587994`*^9}, {
  4.000722397582649*^9, 4.0007224117709045`*^9}, {4.0007238991926317`*^9, 
  4.0007239202504573`*^9}, {4.0007244893016577`*^9, 4.0007247878467426`*^9}, {
  4.0007248179118357`*^9, 4.0007248192083836`*^9}, {4.000724930330272*^9, 
  4.000724936958984*^9}, {4.000724982534488*^9, 4.0007249978034115`*^9}, {
  4.000725087861233*^9, 4.000725125129575*^9}, {4.0007252773778286`*^9, 
  4.000725283524063*^9}},ExpressionUUID->"355c5d99-082c-425d-8e7f-\
e2c10b7abed2"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "dyf"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", " ", 
    RowBox[{"x", "+", " ", 
     RowBox[{"a", " ", "y"}]}], ",", " ", 
    RowBox[{"b", " ", "+", " ", 
     RowBox[{"z", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dyf", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "a", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", 
      RowBox[{
       RowBox[{"-", "c"}], "+", "x"}]}], "}"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.2", ",", "0.2", ",", "3.3"}], "}"}]}], ";", " ", 
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], ";", " ", 
  RowBox[{"TMax", "=", "80"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"-", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0", ",", "0"}], "}"}]}]}], ";", " ", 
  RowBox[{"p0", "=", 
   RowBox[{"{", 
    RowBox[{"c", ",", "0", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ySol", ",", 
     RowBox[{"{", "yPts", "}"}]}], "}"}], "=", 
   RowBox[{"BasicSectionSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", "y0"}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot3D", "[", 
  RowBox[{
   RowBox[{"ySol", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", 
     RowBox[{"0.8", "TMax"}], ",", " ", "TMax"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"yPts", "\[LeftDoubleBracket]", 
     RowBox[{
      RowBox[{"-", "3"}], ";;", 
      RowBox[{"-", "1"}]}], "\[RightDoubleBracket]"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.00072483087323*^9, 4.000725023802205*^9}, {
  4.0007250793020053`*^9, 4.0007250797238655`*^9}, {4.0007251594736567`*^9, 
  4.000725263254676*^9}, {4.00072530344304*^9, 4.0007253999282355`*^9}, {
  4.0007254727395372`*^9, 4.0007254939422607`*^9}},
 CellLabel->
  "In[1256]:=",ExpressionUUID->"7a5ace61-c4ec-4f45-9060-ee406b597a66"],

Cell[TextData[{
 "I am going to guess ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "1"], "\[TildeTilde]", 
    RowBox[{"{", 
     RowBox[{"2.2", ",", "7.3"}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "98f0164b-f706-498c-9386-6e3533f4532f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "2"], "\[TildeTilde]", 
    RowBox[{"{", 
     RowBox[{"2.7", ",", "1.4"}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "72507f1d-5b71-4555-87e6-76ae081e6b73"],
 " .  the following implements Newtons method. "
}], "Text",
 CellChangeTimes->{{4.0007250374397955`*^9, 4.000725070255596*^9}, {
  4.0007254149739914`*^9, 4.0007254572872725`*^9}, {4.0007255049374533`*^9, 
  4.000725527592436*^9}, {4.0007256538509865`*^9, 4.0007256572236958`*^9}, {
  4.000726209630411*^9, 
  4.0007262253484898`*^9}},ExpressionUUID->"15beec8c-5f53-44d3-ae21-\
b894273d51d9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"u1", ",", "u2"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2.2", ",", "7.3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2.7", ",", "1.4"}], "}"}]}], "}"}]}], ";", " ", 
  RowBox[{"Id", "=", 
   RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Tau]1", ",", "p1", ",", "J1", ",", "Dp1"}], "}"}], "=", 
     RowBox[{"\[Tau]pJDpSection", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", 
         RowBox[{"dyf", "[", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", "c", "}"}], ",", "u1"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"T", ",", "n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Tau]2", ",", "p2", ",", "J2", ",", "Dp2"}], "}"}], "=", 
     RowBox[{"\[Tau]pJDpSection", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", 
         RowBox[{"dyf", "[", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", "c", "}"}], ",", "u2"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"T", ",", "n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"Dg", "=", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{"(", "\[NoBreak]", GridBox[{
         {"Dp1", 
          RowBox[{"-", "Id"}]},
         {
          RowBox[{"-", "Id"}], "Dp2"}
        }], "\[NoBreak]", ")"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u1", ",", "u2"}], "}"}], "=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u1", ",", "u2"}], "}"}], "-", 
      RowBox[{"Partition", "[", 
       RowBox[{
        RowBox[{"LinearSolve", "[", 
         RowBox[{"Dg", ",", 
          RowBox[{"Flatten", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"p1", "\[LeftDoubleBracket]", 
               RowBox[{"{", 
                RowBox[{"2", ",", "3"}], "}"}], "\[RightDoubleBracket]"}], 
              "-", "u2"}], ",", 
             RowBox[{
              RowBox[{"p2", "\[LeftDoubleBracket]", 
               RowBox[{"{", 
                RowBox[{"2", ",", "3"}], "}"}], "\[RightDoubleBracket]"}], 
              "-", "u1"}]}], "}"}], "]"}]}], "]"}], ",", "2"}], "]"}]}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{"u2", "-", 
         RowBox[{"p1", "\[LeftDoubleBracket]", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}], "\[RightDoubleBracket]"}]}], "]"}],
        ",", 
       RowBox[{"Norm", "[", 
        RowBox[{"u1", "-", 
         RowBox[{"p2", "\[LeftDoubleBracket]", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}], "\[RightDoubleBracket]"}]}], 
        "]"}]}], "}"}], "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", "5", "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.000561914421625*^9, 4.0005620711882334`*^9}, {
   4.0005621059675007`*^9, 4.0005621527408237`*^9}, {4.000562186701093*^9, 
   4.000562727659698*^9}, {4.0005628904047956`*^9, 4.0005629001965404`*^9}, {
   4.000564278138647*^9, 4.0005642788337193`*^9}, {4.0005643790890193`*^9, 
   4.000564390642763*^9}, {4.0005644207461276`*^9, 4.0005644469543457`*^9}, {
   4.0005682655887847`*^9, 4.000568329670134*^9}, {4.000568413503501*^9, 
   4.0005684326531377`*^9}, {4.000629665383424*^9, 4.0006296698215485`*^9}, {
   4.000629777040538*^9, 4.0006297884932365`*^9}, {4.0006298446646605`*^9, 
   4.000629864017414*^9}, 4.0006299337165146`*^9, {4.000630095438695*^9, 
   4.0006301661331635`*^9}, {4.00063024880593*^9, 4.0006302847726183`*^9}, {
   4.0006303272121625`*^9, 4.000630391586757*^9}, {4.000630422408266*^9, 
   4.000630435540986*^9}, {4.000630649071435*^9, 4.0006306752419243`*^9}, {
   4.0007193966343822`*^9, 4.0007194145358796`*^9}, {4.000719448083576*^9, 
   4.000719680573032*^9}, {4.000719748255134*^9, 4.000719783661954*^9}, {
   4.00071986147358*^9, 4.0007198687262077`*^9}, {4.0007199445047445`*^9, 
   4.000719977208847*^9}, {4.0007204196298847`*^9, 4.000720421034003*^9}, {
   4.0007204573965287`*^9, 4.0007204799037747`*^9}, {4.000720513349847*^9, 
   4.0007207386069856`*^9}, {4.0007207862397375`*^9, 4.000720812989341*^9}, {
   4.000720871583178*^9, 4.000720885707925*^9}, {4.00072244375463*^9, 
   4.000722795192465*^9}, {4.000723939510356*^9, 4.000724060766159*^9}, {
   4.0007255503283544`*^9, 4.0007257620652485`*^9}, {4.0007258274519787`*^9, 
   4.0007261932084355`*^9}},
 CellLabel->
