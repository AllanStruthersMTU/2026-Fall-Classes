Cell["Here are our two solvers. ", "Text",
 CellChangeTimes->{{4.0002848505952387`*^9, 
  4.000284856645384*^9}},ExpressionUUID->"c5c7f5be-2976-44bf-8c0a-\
99604cab947a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"FPNewt", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"f_", ",", "dyf_"}], "}"}], ",", "Tol_"}], "]"}], "[", "u0_", 
   "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "=", "u0"}], ",", "p", ",", "Dp", ",", "err", ",", 
      RowBox[{"n", "=", "0"}], ",", 
      RowBox[{"nMax", "=", "10"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"While", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", "Dp"}], "}"}], "=", 
         RowBox[{
          RowBox[{"pAndDp", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"f", ",", "dyf"}], "}"}]}], "]"}], "[", "u", "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"err", "=", 
         RowBox[{"Norm", "[", 
          RowBox[{"p", "-", "u"}], "]"}]}], ";", 
        RowBox[{"And", "[", 
         RowBox[{
          RowBox[{"err", ">", "Tol"}], ",", 
          RowBox[{"n", "<", "nMax"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"n", "++"}], ";", 
        RowBox[{"u", "=", 
         RowBox[{"u", "-", 
          RowBox[{"LinearSolve", "[", 
           RowBox[{
            RowBox[{"Dp", "-", 
             RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", 
            RowBox[{"p", "-", "u"}]}], "]"}]}]}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"n", ",", "u", ",", "err"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FPNonNewt", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"f_", ",", "dyf_"}], "}"}], ",", "Tol_"}], "]"}], "[", "u0_", 
   "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "=", "u0"}], ",", "p", ",", "Dp", ",", "err", ",", 
      RowBox[{"n", "=", "0"}], ",", 
      RowBox[{"nMax", "=", "100"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"While", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", "Dp"}], "}"}], "=", 
         RowBox[{
          RowBox[{"pAndDp", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"f", ",", "dyf"}], "}"}]}], "]"}], "[", "u", "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"err", "=", 
         RowBox[{"Norm", "[", 
          RowBox[{"p", "-", "u"}], "]"}]}], ";", 
        RowBox[{"And", "[", 
         RowBox[{
          RowBox[{"err", ">", "Tol"}], ",", 
          RowBox[{"n", "<", "nMax"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"n", "++"}], ";", 
        RowBox[{"u", "=", "p"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"n", ",", "u", ",", "err"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.0001250648763638`*^9, 4.000125272054468*^9}, {
