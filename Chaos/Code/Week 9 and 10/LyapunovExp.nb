Cell[CellGroupData[{

Cell["QR Lyapunov Computation", "Subsection",
 CellChangeTimes->{{4.000460884491954*^9, 4.000460901648095*^9}, {
  4.000538289798253*^9, 4.0005382950039787`*^9}, {4.000538924981372*^9, 
  4.0005389289451847`*^9}, {4.0006291977359333`*^9, 4.0006292078830175`*^9}, {
  4.0007221225217295`*^9, 4.000722133123322*^9}, {4.000722860128234*^9, 
  4.0007228628644648`*^9}, {4.0007241491771555`*^9, 4.0007241502552156`*^9}, {
  4.0009028364234133`*^9, 4.0009028416707754`*^9}, {4.001329143398018*^9, 
  4.0013291443559947`*^9}},ExpressionUUID->"9abda390-76c7-4d33-adb0-\
ce270807066e"],

Cell[TextData[{
 "A standard (but quite fancy) trick to avoid stopping the simulation all the \
time and doing a QR decomposition is to build the ODEs for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"J", "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{"Q", "(", "t", ")"}], ".", 
     RowBox[{"R", "(", "t", ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fdd619cc-fdaf-4004-b41e-6fe7959e00ad"],
 " where \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"Q", "\[Transpose]"}], ".", "Q"}], "=", "Id"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "657d44a0-01cc-4cb2-bb19-4dbee2b2b13a"],
 "\nand we really want to track only the diagonals of the upper triangular \
factor ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4dcf660f-7039-41b1-97a1-ec12147d72c5"],
 ". From our product rule\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"J", "'"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Q", "'"}], ".", "R"}], "+", 
     RowBox[{"Q", ".", 
      RowBox[{"R", "'"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0cec8ed9-4485-4ce0-b380-f1b53eb84aeb"],
 "  and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Q", "'"}], ")"}], "\[Transpose]"}], ".", "Q"}], "+", 
     RowBox[{
      RowBox[{"Q", "\[Transpose]"}], ".", 
      RowBox[{"Q", "'"}]}]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dffa850b-30a6-44dd-a971-7774acc0c809"],
 "\nAnother way to say the second is that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"W", "=", 
    RowBox[{
     RowBox[{"Q", "\[Transpose]"}], ".", 
     RowBox[{"Q", "'"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a47a090b-40ed-4f41-8a00-7783250cd28d"],
 " is skew i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"W", "\[Transpose]"}], "=", 
    RowBox[{"-", "W", " "}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4d286e59-3d8d-45f3-aaeb-725b661481b3"],
 ".   If we plug into our ODE ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"J", "'"}], "=", 
    RowBox[{"A", ".", "J"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2071116b-a132-417a-b6a4-5903a81b6c2b"],
 " we get \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Q", "'"}], ".", "R"}], "+", 
     RowBox[{"Q", ".", 
      RowBox[{"R", "'"}]}]}], "=", 
    RowBox[{"A", ".", "Q", ".", "R"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e0775d64-7d2e-45ce-8c6b-e0a8b2cf5fd7"],
 "\nIf we multiply by Q\[Transpose] we get\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Q", "\[Transpose]"}], ".", 
      RowBox[{"Q", "'"}], ".", "R"}], "+", 
     RowBox[{
      RowBox[{"Q", "\[Transpose]"}], ".", "Q", ".", 
      RowBox[{"R", "'"}]}]}], "=", 
    RowBox[{
     RowBox[{"Q", "\[Transpose]"}], ".", "A", ".", "Q", ".", "R"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "287268fc-28d6-4a5c-8843-48f4d083d9ff"],
 "\nIf we define ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "=", 
    RowBox[{
     RowBox[{"Q", "\[Transpose]"}], ".", "A", ".", "Q"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aedb7881-b336-468d-8bc0-fdf44a0208d0"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"L", "=", 
    RowBox[{"tril", "(", 
     RowBox[{"B", ",", 
      RowBox[{"-", "1"}]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c1c0aa15-31c6-4142-a790-b453c5b331b7"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", "=", 
    RowBox[{"L", "-", 
     RowBox[{"L", "\[Transpose]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "521efe97-cb53-4f86-815b-61a3e13be5fb"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "=", 
    RowBox[{"B", "-", "\[CapitalOmega]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d3935c14-1832-4118-965f-8ed229fb86f0"],
 " then  \n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"Q", "'"}], "=", 
      RowBox[{"Q", ".", 
       RowBox[{"(", 
        RowBox[{"L", "-", 
         RowBox[{"L", "\[Transpose]"}]}], ")"}]}]},
     {
      RowBox[{"R", "'"}], "=", 
      RowBox[{"T", ".", "R"}]}
    }], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5e79d345-2d5d-474c-9fad-f987cc186342"],
 "\nThis decomposition works because ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d66a4fe7-5425-4298-9058-c2aafd69999f"],
 "is upper triangular and the strictly lower triangular part of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "759eade6-8f34-4491-b1ea-a34dc04393cd"],
 " is zero!   If we only want the diagonal of R then we do not need to track \
the whole of R.  We can track logarithms of the diagonals to avoid \
catastrophic growth"
}], "Text",
 CellChangeTimes->{{4.00090284931036*^9, 4.0009030819171286`*^9}, {
  4.000903163212902*^9, 4.000903405974822*^9}, {4.0013291694576674`*^9, 
  4.0013296672661147`*^9}, {4.001329848850322*^9, 
  4.0013301477182074`*^9}},ExpressionUUID->"43e92634-2c0d-4872-b5ce-\
23eabb8d017c"]
}, Closed]],

Cell[CellGroupData[{

Cell["Stabilized Lyapunov Computation?", "Subsection",
 CellChangeTimes->{{4.000460884491954*^9, 4.000460901648095*^9}, {
  4.000538289798253*^9, 4.0005382950039787`*^9}, {4.000538924981372*^9, 
  4.0005389289451847`*^9}, {4.0006291977359333`*^9, 4.0006292078830175`*^9}, {
  4.0007221225217295`*^9, 4.000722133123322*^9}, {4.000722860128234*^9, 
  4.0007228628644648`*^9}, {4.0007241491771555`*^9, 4.0007241502552156`*^9}, {
  4.0009028364234133`*^9, 4.0009028416707754`*^9}, {4.001329143398018*^9, 
  4.0013291443559947`*^9}, {4.0013335354861755`*^9, 
  4.0013335452199655`*^9}},ExpressionUUID->"7d881191-e4e7-48ca-b30b-\
de3333ae8180"],

Cell[TextData[{
 "A possibly new way to track the full orthogonal basis is to track ",
 Cell[BoxData[
  FormBox["J", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8d46db3f-e638-4f42-aefd-9e788de5168c"],
 " and an approximation M to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["J", 
    RowBox[{"-", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "077c5af6-7f7a-4578-9816-ddb49e0fd1d1"],
 " simultaneously.  If ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{"f", "(", "y", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d9a2fac3-249e-426d-8e08-ee283e68a317"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"J", "'"}], "=", 
    RowBox[{"A", ".", "J"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d88ce1d5-485e-42f6-b8f2-347bef5dd90f"],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", "(", "t", ")"}], "=", 
    RowBox[{"df", "(", 
     RowBox[{"y", "(", "t", ")"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ad035365-b1e0-43cc-90ee-c9fa7ccacfa8"],
 " then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"M", "(", "t", ")"}], "=", 
    RowBox[{
     SuperscriptBox["J", 
      RowBox[{"-", "1"}]], "(", "t", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9021a46d-c65e-43bd-85bc-dc0dde184941"],
 " satisfies\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"M", ".", "J"}], "=", "Id"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4b7147f0-6fb5-48bb-a51d-01ef85651bca"],
 " \[DoubleLongRightArrow] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"M", "'"}], ".", "J"}], "+", 
     RowBox[{"M", ".", 
      RowBox[{"J", "'"}]}]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "37345d24-e47b-4b68-9f64-a2c066cdcc11"],
 " \[DoubleLongRightArrow] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"M", "'"}], ".", "J"}], "+", 
     RowBox[{"M", ".", "A", ".", "J"}]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e59bb23e-40bf-4ee4-849c-5ad87f0bb48d"],
 " \[DoubleLongRightArrow] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"M", "'"}], "=", 
    RowBox[{"-", 
     RowBox[{"M", ".", "A"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "99ff27bb-0dff-4abb-ad6d-772ca2ae8535"],
 "\nThe J will develop problems when the compressed subspace gets to small.  \
The ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "618aed1a-55e4-4c6f-a2a2-e577bb9f7fa5"],
 " will develop problems when the expanding subspace gets too small in \
negative time! \t"
}], "Text",
 CellChangeTimes->{{4.00090284931036*^9, 4.0009030819171286`*^9}, {
  4.000903163212902*^9, 4.000903405974822*^9}, {4.0013291694576674`*^9, 
  4.0013296672661147`*^9}, {4.001329848850322*^9, 4.0013303968608704`*^9}, {
  4.001330505899652*^9, 4.001330798710226*^9}, {4.001331190608367*^9, 
  4.0013312303582296`*^9}},ExpressionUUID->"47c34e27-cfcf-49f6-813a-\
9169db1aceff"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "dyf"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", " ", 
    RowBox[{"x", "+", " ", 
     RowBox[{"a", " ", "y"}]}], ",", " ", 
    RowBox[{"b", " ", "+", " ", 
     RowBox[{"z", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dyf", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "a", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", 
      RowBox[{
       RowBox[{"-", "c"}], "+", "x"}]}], "}"}]}], 
