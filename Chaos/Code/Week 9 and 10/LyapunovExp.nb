Cell[TextData[{
 "We can try to keep the system satisfying ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"J", ".", "M"}], "=", "Id"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b8b545ed-f698-438f-a820-facee7b1cbd3"],
 " by penalizing with the residual ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Z", "=", 
    RowBox[{
     RowBox[{"J", ".", "M"}], "-", "Id"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "08b41226-33c0-42d2-bc67-644b5ca61ae5"],
 ".  The simplest version is \n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"J", "'"}], "=", 
      RowBox[{"    ", 
       RowBox[{"A", ".", "J"}]}], "-", 
      RowBox[{"\[Gamma]", " ", "\[Theta]", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"J", ".", "M"}], "-", "Id"}], ")"}], ".", "J", 
        "             "}]}]},
     {
      RowBox[{"M", "'"}], "=", 
      RowBox[{"-", 
       RowBox[{"M", ".", "A"}]}], "-", 
      RowBox[{
       RowBox[{"\[Gamma]", "(", 
        RowBox[{"1", "-", "\[Theta]"}], ")"}], 
       RowBox[{"M", ".", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"J", ".", "M"}], "-", "Id"}], ")"}]}]}]}
    }], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "593368a5-a03f-4fcf-bec7-1b6076616982"],
 "\nThe simplest version actually works a bit!  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Theta]", "=", 
    RowBox[{"1", "/", "2", " "}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7ab1c98c-0aac-427c-9166-0f5d8234e288"],
 "provides equal correction to both versions.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Making", " ", "\[Gamma]", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b3a9535c-e914-4b6d-b400-87530fb189e1"],
 "bigger increases the correct factor. "
}], "Text",
 CellChangeTimes->{{4.00090284931036*^9, 4.0009030819171286`*^9}, {
  4.000903163212902*^9, 4.000903405974822*^9}, {4.0013291694576674`*^9, 
  4.0013296672661147`*^9}, {4.001329848850322*^9, 4.0013303968608704`*^9}, {
  4.001330505899652*^9, 4.001330798710226*^9}, {4.001331190608367*^9, 
  4.0013312303582296`*^9}, {4.0013316594350004`*^9, 4.0013317110936275`*^9}, {
  4.0013318604348164`*^9, 4.001331866230684*^9}, {4.001331914221342*^9, 
  4.0013321070983934`*^9}, {4.0013334407419395`*^9, 
  4.0013335147519903`*^9}},ExpressionUUID->"96807438-dbd7-405e-8a3f-\
6c7880487758"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "dyf"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", " ", 
    RowBox[{"x", "+", " ", 
     RowBox[{"a", " ", "y"}]}], ",", " ", 
    RowBox[{"b", " ", "+", " ", 
     RowBox[{"z", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dyf", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "a", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", 
      RowBox[{
       RowBox[{"-", "c"}], "+", "x"}]}], "}"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", " ", 
    RowBox[{"{", 
     RowBox[{"0.2", ",", "0.2", ",", "5.7"}], "}"}]}]}], ";", " ", 
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"1.2", ",", "1.3", ",", "3.4"}], "}"}]}], ";", " ", 
  RowBox[{"Id", "=", 
   RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ";", " ", 
  RowBox[{"TMax", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Gamma]", ",", "\[Theta]"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0.5"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ySol", ",", " ", "JSol", ",", " ", "MSol"}], "}"}], "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"f", "[", "p", "]"}], "[", 
         RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"A", "=", 
         RowBox[{
          RowBox[{"dyf", "[", "p", "]"}], "[", 
          RowBox[{"y", "[", "t", "]"}], "]"}]}], ";", " ", 
        RowBox[{"JMminusId", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"J", "[", "t", "]"}], ".", 
           RowBox[{"M", "[", "t", "]"}]}], "-", "Id"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
         RowBox[{
          RowBox[{"A", ".", 
           RowBox[{"J", "[", "t", "]"}]}], "-", 
          RowBox[{"\[Gamma]", " ", "\[Theta]", " ", "JMminusId"}]}]}]}], ",", 
       " ", 
       RowBox[{
        RowBox[{"J", "[", "0", "]"}], "==", "Id"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"M", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"M", "[", "t", "]"}], ".", "A"}]}], "-", 
         RowBox[{"\[Gamma]", " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", "\[Theta]"}], ")"}], "JMminusId"}]}]}], ",", 
       RowBox[{
        RowBox[{"M", "[", "0", "]"}], "==", "Id"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"y", ",", "J", ",", "M"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<\[Sigma](J)\>\"", "->", 
     RowBox[{"LogPlot", "[", " ", 
      RowBox[{
       RowBox[{"SingularValueList", "[", 
        RowBox[{"JSol", "[", "t", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<1/\[Sigma](M)\>\"", "->", 
     RowBox[{"LogPlot", "[", " ", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"SingularValueList", "[", 
         RowBox[{"MSol", "[", "t", "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<||J.M-Id||\>\"", "->", 
     RowBox[{"LogPlot", "[", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"JSol", "[", "t", "]"}], ".", 
          RowBox[{"MSol", "[", "t", "]"}]}], "-", "Id"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "}"}], "]"}]}], "Input",
 CellChangeTimes->{{4.0013308331630545`*^9, 4.001331061409604*^9}, {
  4.0013311300603223`*^9, 4.0013311824149494`*^9}, {4.001331237097946*^9, 
