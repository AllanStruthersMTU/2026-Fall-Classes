Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"g3", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Sin", "[", 
    RowBox[{"c", " ", "+", "  ", 
     RowBox[{"Cos", "[", " ", 
      RowBox[{"a", " ", "+", " ", 
       RowBox[{"b", "^", "2"}]}], "]"}], "+", " ", "\[IndentingNewLine]", 
     RowBox[{"Cos", "[", 
      RowBox[{"a", " ", "+", " ", 
       RowBox[{"b", " ", "c"}]}], "]"}]}], "]"}], "-", " ", 
   RowBox[{
    RowBox[{"ArcTan", "[", 
     RowBox[{"a", " ", "-", " ", 
      SuperscriptBox["b", "2"]}], "]"}], "/", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"c", "^", "2"}]}], ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"SliceContourPlot3D", "[", 
  RowBox[{
   RowBox[{"g3", "[", 
    RowBox[{"a", ",", "b", ",", "c"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", " ", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"b", ",", " ", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"c", ",", " ", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.003839728571705*^9, 4.003839857706628*^9}, {
  4.0038398942771015`*^9, 4.003839954757829*^9}, {4.003840124379186*^9, 
  4.0038401250040703`*^9}, {4.0038401571254435`*^9, 4.003840162984522*^9}, {
  4.0038402310196767`*^9, 4.003840268739645*^9}, {4.00384035804523*^9, 
  4.003840363546407*^9}},
