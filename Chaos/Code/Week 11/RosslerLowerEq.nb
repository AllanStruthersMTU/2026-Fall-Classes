Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "Ross", ",", "dRoss", ",", "HRoss", ",", "dHRoss", ",", "Lor", ",", " ", 
    "dLor"}], "]"}], "\n", 
  RowBox[{"(*", " ", "Rossler", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}], " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{"0.2", ",", "0.2", ",", "5.7"}], "}"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ross", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", 
    RowBox[{"x", "+", 
     RowBox[{"a", " ", "y"}]}], ",", 
    RowBox[{"b", "+", 
     RowBox[{"z", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dRoss", "[", 
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "a", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", 
       RowBox[{"x", "-", "c"}]}], "}"}]}], "}"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Hyperchaotic", " ", "Rossler"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{"0.25", ",", "3", ",", "0.5", ",", "0.05"}], "}"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HRoss", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_", ",", "w_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", 
    RowBox[{"x", "+", 
     RowBox[{"a", " ", "y"}], "+", "w"}], ",", 
    RowBox[{"b", "+", 
     RowBox[{"x", " ", "z"}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "c"}], " ", "z"}], "+", 
     RowBox[{"d", " ", "w"}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dHRoss", "[", 
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "}"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_", ",", "w_"}], "}"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "a", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", "x", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{"-", "c"}], ",", "d"}], "}"}]}], "}"}]}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "Lorenz", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sigma", ",", " ", "rho", ",", " ", "beta"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{"10", ",", "28", ",", 
      RowBox[{"8", "/", "3"}]}], "}"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Lor", "[", 
     RowBox[{"{", 
      RowBox[{"sigma_", ",", "rho_", ",", "beta_"}], "}"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"sigma", " ", 
      RowBox[{"(", 
       RowBox[{"y", "-", "x"}], ")"}]}], ",", 
     RowBox[{
      RowBox[{"x", " ", 
       RowBox[{"(", 
        RowBox[{"rho", "-", "z"}], ")"}]}], "-", "y"}], ",", 
     RowBox[{
      RowBox[{"x", " ", "y"}], "-", 
      RowBox[{"beta", " ", "z"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dLor", "[", 
     RowBox[{"{", 
      RowBox[{"sigma_", ",", "rho_", ",", "beta_"}], "}"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "sigma"}], ",", "sigma", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rho", "-", "z"}], ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "x"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "x", ",", 
       RowBox[{"-", "beta"}]}], "}"}]}], "}"}]}], ";"}]}], "Input",
