   4.003227651964718*^9}},ExpressionUUID->"549eacdb-a2d4-c544-b29f-\
89ed941799af"],

Cell["\<\
The plan is lower and upper side by side.  Transitions cc+r \
\[LeftRightArrow]3r.  Sign transitions on rs and re[ccs]. \
\>", "Text",
 CellChangeTimes->{{4.0035815689136343`*^9, 
  4.003581619855007*^9}},ExpressionUUID->"9ee4eaf7-b5cc-4a8c-ad7d-\
fddd87ea57ab"],

Cell["\<\
We want to compute, plot  and understand manifolds etc. How they change when \
we mess with the parameters (a,b,c) . \
\>", "Text",
 CellChangeTimes->{{4.0032281219116764`*^9, 4.0032281483408585`*^9}, 
   4.00323140477763*^9, {4.003402448973322*^9, 4.0034024640884967`*^9}, 
   4.0034031320208225`*^9, {4.0035752448902006`*^9, 
   4.0035752485463266`*^9}},ExpressionUUID->"a53feaa2-aa36-ef48-a88a-\
06718c817a5e"],

Cell[TextData[{
 "The equilibria are\n\n",
 Cell[BoxData[
  TagBox[
   TagBox[GridBox[{
      {
       StyleBox["\[Null]",
        ShowStringCharacters->False], 
       SubscriptBox["y", "1"], 
       SubscriptBox["y", "2"], 
       SubscriptBox["y", "3"]},
      {"lower", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"c", "-", 
          SqrtBox[
           RowBox[{
            RowBox[{
             RowBox[{"-", "4"}], " ", "a", " ", "b"}], "+", 
            SuperscriptBox["c", "2"]}]]}], ")"}]}], 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["c", "a"]}], "+", 
          FractionBox[
           SqrtBox[
            RowBox[{
             RowBox[{
              RowBox[{"-", "4"}], " ", "a", " ", "b"}], "+", 
             SuperscriptBox["c", "2"]}]], "a"]}], ")"}]}], 
       FractionBox[
        RowBox[{"c", "-", 
         SqrtBox[
          RowBox[{
           RowBox[{
            RowBox[{"-", "4"}], " ", "a", " ", "b"}], "+", 
           SuperscriptBox["c", "2"]}]]}], 
        RowBox[{"2", " ", "a"}]]},
      {"upper", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"c", "+", 
          SqrtBox[
           RowBox[{
            RowBox[{
             RowBox[{"-", "4"}], " ", "a", " ", "b"}], "+", 
            SuperscriptBox["c", "2"]}]]}], ")"}]}], 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["c", "a"]}], "-", 
          FractionBox[
           SqrtBox[
            RowBox[{
             RowBox[{
              RowBox[{"-", "4"}], " ", "a", " ", "b"}], "+", 
             SuperscriptBox["c", "2"]}]], "a"]}], ")"}]}], 
       FractionBox[
        RowBox[{"c", "+", 
         SqrtBox[
          RowBox[{
           RowBox[{
            RowBox[{"-", "4"}], " ", "a", " ", "b"}], "+", 
           SuperscriptBox["c", "2"]}]]}], 
        RowBox[{"2", " ", "a"}]]}
     },
     GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
     GridBoxDividers->{
      "Columns" -> {False, True, {False}, False}, 
       "Rows" -> {False, True, {False}, False}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[2.0999999999999996`]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}],
    {OutputFormsDump`HeadedRows, OutputFormsDump`HeadedColumns}],
   Function[BoxForm`e$, 
    TableForm[BoxForm`e$, TableHeadings -> Automatic]]]],
  CellChangeTimes->{{4.0035752087999563`*^9, 4.0035752246992106`*^9}, {
   4.003575639588114*^9, 4.003575654895632*^9}},ExpressionUUID->
  "d4c2a1d9-8b73-4533-b367-2cedeb5a677a"],
 "\nThere are two real equilibria if ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "4"}], " ", "a", " ", "b"}], "+", 
      SuperscriptBox["c", "2"]}], ">", "0"}]}], TraditionalForm]],
  ExpressionUUID->"10cb39ba-5ff0-472b-ac79-157f12fcc8e1"],
 ".  The equilibria are complex (and thus not relevant for our real ODE) if ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "<", "0"}], TraditionalForm]],ExpressionUUID->
  "fa44e1be-0f42-4543-9aad-7f4998a94c51"],
 ".  We are going to build a 3D picture of the behavior.   When the \
equilibria are real the ones with the  "
}], "Text",
 CellChangeTimes->{{4.003227533738573*^9, 4.003227540214775*^9}, {
  4.0034031356139336`*^9, 4.0034031396480613`*^9}, {4.0034043871282444`*^9, 
