Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"a", ",", "b", ",", "c", ",", "x", ",", "y", ",", "z"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pqSub", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"c", "-", 
       SqrtBox[
        RowBox[{
         RowBox[{
          RowBox[{"-", "4"}], "a", " ", "b"}], "+", 
         SuperscriptBox["c", "2"]}]]}], "->", 
      RowBox[{"2", "a", " ", "p"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "c"}], "+", 
       SqrtBox[
        RowBox[{
         RowBox[{
          RowBox[{"-", "4"}], "a", " ", "b"}], "+", 
         SuperscriptBox["c", "2"]}]]}], "->", 
      RowBox[{
       RowBox[{"-", "2"}], "a", " ", "p"}]}], ",", "  ", 
     RowBox[{
      RowBox[{"c", "+", 
       SqrtBox[
        RowBox[{
         RowBox[{
          RowBox[{"-", "4"}], "a", " ", "b"}], "+", 
         SuperscriptBox["c", "2"]}]]}], "->", 
      RowBox[{"2", "a", " ", "q"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EqSub", "=", 
   RowBox[{"Solve", "[", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Ross", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}], "]"}], "==", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z"}], "}"}], "/.", 
   RowBox[{"Simplify", "[", "EqSub", "]"}]}], "/.", "pqSub"}]}], "Input",
 CellChangeTimes->{{4.003832383870606*^9, 4.003832509232649*^9}, {
