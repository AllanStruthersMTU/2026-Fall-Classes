Cell[TextData[{
 "We decided that the equilibria would look cleaner in terms of new \
parameters. \n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"c", "-", 
       SqrtBox[
        RowBox[{
         RowBox[{
          RowBox[{"-", "4"}], "a", " ", "b"}], "+", 
         SuperscriptBox["c", "2"]}]]}], "=", 
      RowBox[{"2", "a", " ", "p"}]},
     {
      RowBox[{"c", "+", 
       SqrtBox[
        RowBox[{
         RowBox[{
          RowBox[{"-", "4"}], "a", " ", "b"}], "+", 
         SuperscriptBox["c", "2"]}]]}], "=", 
      RowBox[{"2", "a", " ", "q"}]}
    }], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b0be62f3-db60-4df6-9a57-87994a0b60a7"],
 "\nIn terms of these parameters the equilibria are simply\n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      SubscriptBox["eq", "l"], "=", 
      RowBox[{"p", 
       RowBox[{"{", 
        RowBox[{"a", " ", ",", 
         RowBox[{"-", "1"}], ",", "1"}], "}"}]}]},
     {
      SubscriptBox["eq", "u"], "=", 
      RowBox[{"q", 
       RowBox[{"{", 
        RowBox[{"a", " ", ",", 
         RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}
    }], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3e97cb8a-388b-4148-84a0-58292b7e7981"],
 "\nThe labelling u for upper and l for lower is appropriate because\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "a", " ", "p"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{GridBox[{
         {
          RowBox[{"c", "-", 
           SqrtBox[
            RowBox[{
             RowBox[{
              RowBox[{"-", "4"}], "a", " ", "b"}], "+", 
             SuperscriptBox["c", "2"]}]]}], "<"}
        }], "c"}], "+", 
      SqrtBox[
       RowBox[{
        RowBox[{
         RowBox[{"-", "4"}], "a", " ", "b"}], "+", 
        SuperscriptBox["c", "2"]}]]}], "=", 
     RowBox[{"2", "a", " ", "q"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "82c332a3-8ffc-4a30-9766-c01e1464354d"],
 ".\nNote, the parameter ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
