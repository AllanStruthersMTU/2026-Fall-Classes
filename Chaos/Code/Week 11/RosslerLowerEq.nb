Cell["\<\
The roots of these characteristic polynomials are the eigenvalues of the \
linear approximation matrices at the equilibria.  Is this a good picture of \
the lower polynomial\
\>", "Text",
 CellChangeTimes->{{4.00357741331441*^9, 
  4.0035775082851443`*^9}},ExpressionUUID->"d189e161-8dd7-44e2-b061-\
5d2f8ed83d57"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "a", ",", "b", ",", "c", ",", "\[Delta]", ",", "fL", ",", " ", "fU", ",", 
   "\[Lambda]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"0.2", ",", "0.2", ",", "2.8"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Delta]", "=", 
   SqrtBox[
    RowBox[{
     RowBox[{
      RowBox[{"-", "4"}], " ", "a", " ", "b"}], "+", 
     SuperscriptBox["c", "2"]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fL", "[", "\[Lambda]_", "]"}], "=", 
   RowBox[{
    RowBox[{"-", "\[Delta]"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "-", 
       FractionBox["c", 
        RowBox[{"2", " ", "a"}]], "+", 
       FractionBox[
        RowBox[{"a", " ", "c"}], "2"], "+", 
       FractionBox["\[Delta]", 
        RowBox[{"2", " ", "a"}]], "+", 
       FractionBox[
        RowBox[{"a", " ", "\[Delta]"}], "2"]}], ")"}], " ", "\[Lambda]"}], 
    "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"a", "-", 
       FractionBox["c", "2"], "-", 
       FractionBox["\[Delta]", "2"]}], ")"}], " ", 
     SuperscriptBox["\[Lambda]", "2"]}], "-", 
    SuperscriptBox["\[Lambda]", "3"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fU", "[", "\[Lambda]_", "]"}], "=", 
  RowBox[{"\[Delta]", "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{"a", " ", "c"}], "-", 
      FractionBox[
       RowBox[{"c", "+", "\[Delta]"}], 
       RowBox[{"2", " ", "a"}]], "-", 
      RowBox[{
       FractionBox["1", "2"], " ", "a", " ", 
       RowBox[{"(", 
        RowBox[{"c", "+", "\[Delta]"}], ")"}]}]}], ")"}], " ", "\[Lambda]"}], 
   "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"a", "-", "c", "+", 
      FractionBox[
       RowBox[{"c", "+", "\[Delta]"}], "2"]}], ")"}], " ", 
    SuperscriptBox["\[Lambda]", "2"]}], "-", 
   SuperscriptBox["\[Lambda]", "3"]}]}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"fU", "[", "\[Lambda]", "]"}], "==", "0"}], ",", "\[Lambda]"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"fL", "[", "\[Lambda]", "]"}], ",", 
     RowBox[{"fU", "[", "\[Lambda]", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Lambda]", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.003577207248926*^9, 4.003577346449111*^9}, {
   4.0035773969731045`*^9, 4.003577404226639*^9}, {4.003579913438489*^9, 
