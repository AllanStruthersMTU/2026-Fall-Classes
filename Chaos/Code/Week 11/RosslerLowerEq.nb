Cell[TextData[{
 "The eigenvalues  are the roots of \n\n",
 Cell[BoxData[
  TagBox[
   TagBox[GridBox[{
      {
       TagBox["\"\<lower\>\"",
        HoldForm], 
       RowBox[{
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"c", "-", 
               SqrtBox[
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "4"}], " ", "a", " ", "b"}], "+", 
                 SuperscriptBox["c", "2"]}]]}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"a", "-", "\[Lambda]"}], ")"}]}], "a"], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"c", "+", 
              SqrtBox[
               RowBox[{
                RowBox[{
                 RowBox[{"-", "4"}], " ", "a", " ", "b"}], "+", 
                SuperscriptBox["c", "2"]}]], "+", 
              RowBox[{"2", " ", "\[Lambda]"}]}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", 
              RowBox[{"a", " ", "\[Lambda]"}], "-", 
              SuperscriptBox["\[Lambda]", "2"]}], ")"}]}]}], ")"}]}], 
        "\[Equal]", "0"}]},
      {
       TagBox["\"\<upper\>\"",
        HoldForm], 
       RowBox[{
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"c", "+", 
               SqrtBox[
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "4"}], " ", "a", " ", "b"}], "+", 
                 SuperscriptBox["c", "2"]}]]}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"a", "-", "\[Lambda]"}], ")"}]}], "a"], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"c", "-", 
              SqrtBox[
               RowBox[{
                RowBox[{
                 RowBox[{"-", "4"}], " ", "a", " ", "b"}], "+", 
                SuperscriptBox["c", "2"]}]], "+", 
              RowBox[{"2", " ", "\[Lambda]"}]}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", 
              RowBox[{"a", " ", "\[Lambda]"}], "-", 
              SuperscriptBox["\[Lambda]", "2"]}], ")"}]}]}], ")"}]}], 
        "\[Equal]", "0"}]}
     },
     GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
     GridBoxDividers->{
      "Columns" -> {False, {True}, False}, "Rows" -> {{False}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.5599999999999999]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}],
    OutputFormsDump`HeadedColumn],
   Function[BoxForm`e$, 
    TableForm[BoxForm`e$, TableHeadings -> {{"lower", "upper"}}]]]],
  CellChangeTimes->{{4.003575890172555*^9, 4.00357600599438*^9}},
  ExpressionUUID->"3ff4abc2-247b-46fb-8a6f-fea6bc370b3e"],
 "\nThis would look a lot cleaner if we gave ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{
     RowBox[{
      RowBox[{"-", "4"}], " ", "a", " ", "b"}], "+", 
     SuperscriptBox["c", "2"]}]], TraditionalForm]],ExpressionUUID->
  "69abd971-1a8a-4224-9cf6-9949a16a3cf1"],
 " a name.  It makes sense to tidy up as we go along. I am going to call\n\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "=", 
    SqrtBox[
     RowBox[{
      RowBox[{
       RowBox[{"-", "4"}], " ", "a", " ", "b"}], "+", 
      SuperscriptBox["c", "2"]}]]}], TraditionalForm]],ExpressionUUID->
  "6e767413-5658-4c9a-9c2e-507c0feb62ca"],
 "\nWe should look at what we have and decide if we can make it cleaner!"
}], "Text",
 CellChangeTimes->{{4.0035756093567505`*^9, 4.003575617599211*^9}, {
  4.0035757410140476`*^9, 4.003575753469698*^9}, {4.0035760225545864`*^9, 
  4.0035760507892065`*^9}, {4.003576590769701*^9, 4.0035767164852867`*^9}, {
  4.003576963958992*^9, 
  4.0035769824052515`*^9}},ExpressionUUID->"fe4ed30d-c4b9-4a92-88fe-\
d513f8e9c32c"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{4.003587795279389*^9, 
  4.0035877987044888`*^9}},ExpressionUUID->"eaa02abf-da74-4f60-ade7-\
1be7de002e05"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TidierSub", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"c", "-", 
       SqrtBox[
        RowBox[{
         RowBox[{
          RowBox[{"-", "4"}], " ", "a", " ", "b"}], "+", 
         SuperscriptBox["c", "2"]}]]}], "->", 
      RowBox[{"2", "a", " ", "p"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "c"}], "+", 
       SqrtBox[
        RowBox[{
         RowBox[{
          RowBox[{"-", "4"}], " ", "a", " ", "b"}], "+", 
         SuperscriptBox["c", "2"]}]]}], "->", 
      RowBox[{
       RowBox[{"-", "2"}], "a", " ", "p"}]}], ",", " ", 
     RowBox[{
      RowBox[{"c", "+", 
       SqrtBox[
        RowBox[{
         RowBox[{
          RowBox[{"-", "4"}], " ", "a", " ", "b"}], "+", 
         SuperscriptBox["c", "2"]}]]}], "->", 
      RowBox[{"2", "a", " ", "q"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EqSub", "=", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Ross", "[", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}], "]"}], "==", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "]"}], "/.", 
    "TidierSub"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Map", "[", 
   RowBox[{"MatrixForm", ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"AL", ",", "AU"}], "}"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"dRoss", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}], "]"}], "/.", "EqSub"}]}]}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"pL", "[", "\[Lambda]_", "]"}], ",", 
     RowBox[{"pU", "[", "\[Lambda]_", "]"}]}], "}"}], "=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"CharacteristicPolynomial", "[", 
       RowBox[{"#", ",", "\[Lambda]"}], "]"}], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{"AL", ",", "AU"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Collect", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"pL", "[", "\[Lambda]", "]"}], ",", 
     RowBox[{"pU", "[", "\[Lambda]", "]"}]}], "}"}], ",", "\[Lambda]"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dL", ",", "dU"}], "}"}], "=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Discriminant", "[", 
       RowBox[{"#", ",", "\[Lambda]"}], "]"}], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"pL", "[", "\[Lambda]", "]"}], ",", 
       RowBox[{"pU", "[", "\[Lambda]", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.0035876775763226`*^9, 4.0035877241366415`*^9}, {
  4.003587755862134*^9, 4.0035884190100527`*^9}, {4.0035884819956284`*^9, 
  4.0035885732439723`*^9}, {4.0035887803019876`*^9, 4.003588832492176*^9}},
 CellLabel->
  "In[190]:=",ExpressionUUID->"b66f5282-9a14-47b6-85bd-42f7c69017d1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "c"}], "+", 
    RowBox[{"2", " ", "a", " ", "p"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"a", " ", "c"}], "-", "p", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], " ", "p"}]}], ")"}], " ", "\[Lambda]"}], 
    "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"a", "-", "c", "+", 
       RowBox[{"a", " ", "p"}]}], ")"}], " ", 
     SuperscriptBox["\[Lambda]", "2"]}], "-", 
    SuperscriptBox["\[Lambda]", "3"]}], ",", 
   RowBox[{
    RowBox[{"-", "c"}], "+", 
    RowBox[{"2", " ", "a", " ", "q"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"a", " ", "c"}], "-", "q", "-", 
       RowBox[{
        SuperscriptBox["a", "2"], " ", "q"}]}], ")"}], " ", "\[Lambda]"}], 
    "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"a", "-", "c", "+", 
       RowBox[{"a", " ", "q"}]}], ")"}], " ", 
     SuperscriptBox["\[Lambda]", "2"]}], "-", 
    SuperscriptBox["\[Lambda]", "3"]}]}], "}"}]], "Output",
 CellChangeTimes->{4.00358883308506*^9},
 CellLabel->
  "Out[194]=",ExpressionUUID->"c8755b7e-5b65-4b90-ae21-a0292c076809"]
}, Open  ]],

