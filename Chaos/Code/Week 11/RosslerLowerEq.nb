Cell[TextData[{
 "We can use this to plot where we have transitions between eigenvalue types. \
Remember\n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"c", "-", 
       SqrtBox[
        RowBox[{
         RowBox[{
          RowBox[{"-", "4"}], "a", " ", "b"}], "+", 
         SuperscriptBox["c", "2"]}]]}], "=", 
      RowBox[{"2", "a", " ", "p"}]},
     {
      RowBox[{"c", "+", 
       SqrtBox[
        RowBox[{
         RowBox[{
          RowBox[{"-", "4"}], "a", " ", "b"}], "+", 
         SuperscriptBox["c", "2"]}]]}], "=", 
      RowBox[{"2", "a", " ", "q"}]}
    }], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c33e57b4-2280-4d1e-90e3-89ac888da79f"]
}], "Text",
