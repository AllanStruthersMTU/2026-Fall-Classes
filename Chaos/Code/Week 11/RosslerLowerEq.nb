Cell[CellGroupData[{

Cell["R\[ODoubleDot]ssler Equilibrium", "Section",
 CellChangeTimes->{{4.002883860734691*^9, 4.002883898334796*^9}, {
   4.0028841256306577`*^9, 4.0028841392501163`*^9}, {4.002884267379197*^9, 
   4.002884267379197*^9}, {4.0028846924296675`*^9, 4.0028846924296675`*^9}, {
   4.002885949347213*^9, 4.0028860166136165`*^9}, {4.003224284704777*^9, 
   4.003224292104061*^9}, 4.0032243918584538`*^9, {4.003224726216793*^9, 
