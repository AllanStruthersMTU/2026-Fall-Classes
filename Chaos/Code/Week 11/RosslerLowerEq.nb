Cell[BoxData[{
 RowBox[{
  RowBox[{"g", "[", 
   RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Sin", "[", " ", 
    RowBox[{
     RowBox[{"Cos", "[", " ", 
      RowBox[{"a", " ", "+", " ", 
       RowBox[{"b", "^", "2"}]}], "]"}], "+", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"a", " ", "+", " ", "b"}], "]"}]}], "]"}], "-", " ", 
   RowBox[{"ArcTan", "[", 
    RowBox[{"a", " ", "-", " ", 
     SuperscriptBox["b", "2"]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"a", ",", "b"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", " ", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"b", ",", " ", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"ContourLabels", "->", "True"}]}], "]"}]}], "Input",
