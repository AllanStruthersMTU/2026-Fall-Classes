Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "EqCartoon", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"EqCartoon", "[", "A_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"vals", ",", "vecs", ",", 
      RowBox[{"tol", "=", 
       RowBox[{"10", "^", 
        RowBox[{"-", "8"}]}]}], ",", "glyph"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vals", ",", "vecs"}], "}"}], "=", 
      RowBox[{"Chop", "[", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{"N", "[", "A", "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"glyph", "[", 
       RowBox[{"lam_", ",", "v_"}], "]"}], ":=", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Im", "[", "lam", "]"}], "==", "0"}], ",", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"e", "=", 
             RowBox[{"Normalize", "[", 
              RowBox[{"Re", "[", "v", "]"}], "]"}]}], ",", 
            RowBox[{"s", "=", 
             RowBox[{"Sign", "[", 
              RowBox[{"Re", "[", "lam", "]"}], "]"}]}]}], "}"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"s", "==", "0"}], ",", 
            RowBox[{"{", 
             RowBox[{"Gray", ",", "Dashed", ",", 
              RowBox[{"Line", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "e"}], ",", "e"}], "}"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Blue", ",", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"Arrow", "[", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"s", ">", "0"}], ",", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{".15", " ", "k", " ", "e"}], ",", 
                    RowBox[{"k", " ", "e"}]}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"k", " ", "e"}], ",", 
                    RowBox[{".15", " ", "k", " ", "e"}]}], "}"}]}], "]"}], 
                 "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"k", ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], "]"}]}],
              "}"}]}], "]"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"Im", "[", "lam", "]"}], ">", "0"}], ",", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"p", "=", 
             RowBox[{"Normalize", "[", 
              RowBox[{"Re", "[", "v", "]"}], "]"}]}], ",", 
            RowBox[{"q", "=", 
             RowBox[{"Normalize", "[", 
              RowBox[{"Im", "[", "v", "]"}], "]"}]}], ",", 
            RowBox[{"s", "=", 
             RowBox[{"Sign", "[", 
              RowBox[{"Re", "[", "lam", "]"}], "]"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"Orange", ",", 
            RowBox[{"Arrow", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{".5", " ", 
                RowBox[{"Exp", "[", 
                 RowBox[{".06", " ", "s", " ", 
                  RowBox[{"(", 
                   RowBox[{"t", "-", 
                    RowBox[{"2", " ", "Pi"}]}], ")"}]}], "]"}], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Cos", "[", "t", "]"}], " ", "p"}], "-", 
                  RowBox[{
                   RowBox[{"Sin", "[", "t", "]"}], " ", "q"}]}], ")"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"t", ",", "0", ",", 
                 RowBox[{"4", " ", "Pi"}], ",", 
                 RowBox[{"Pi", "/", "40"}]}], "}"}]}], "]"}], "]"}]}], 
           "}"}]}], "]"}], ",", "True", ",", "Nothing"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Thick", ",", 
         RowBox[{"Arrowheads", "[", ".04", "]"}], ",", 
         RowBox[{"MapThread", "[", 
          RowBox[{"glyph", ",", 
           RowBox[{"{", 
            RowBox[{"vals", ",", "vecs"}], "}"}]}], "]"}], ",", "Black", ",", 
         RowBox[{"PointSize", "[", ".025", "]"}], ",", 
         RowBox[{"Point", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "0"}], "}"}], "]"}]}], "}"}], ",", 
       RowBox[{"Boxed", "->", "False"}], ",", 
       RowBox[{"PlotRange", "->", "1.2"}], ",", 
       RowBox[{"ImageSize", "->", "250"}]}], "]"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EqCartoon", "[", 
   RowBox[{"A_", ",", "p_", ",", "s_"}], "]"}], ":=", 
  RowBox[{"Graphics3D", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GeometricTransformation", "[", 
     RowBox[{
      RowBox[{"First", "[", 
       RowBox[{"EqCartoon", "[", "A", "]"}], "]"}], ",", 
      RowBox[{"AffineTransform", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"s", " ", 
          RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ",", "p"}], "}"}], 
       "]"}]}], "]"}], ",", 
    RowBox[{"Boxed", "->", "False"}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"ImageSize", "->", "250"}]}], "]"}]}]}], "Input",
 InitializationCell->True,
