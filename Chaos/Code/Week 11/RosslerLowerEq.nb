Cell[TextData[{
 "We are interested in the type spiral-in/spiral-out and line-in/line-out at \
the equilibria. The Jacobian derivative for the R\[ODoubleDot]ssler system is\
\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"df", "=", 
    RowBox[{"A", "=", 
     RowBox[{"(", "\[NoBreak]", GridBox[{
        {"0", 
         RowBox[{"-", "1"}], 
         RowBox[{"-", "1"}]},
        {"1", "a", "0"},
        {"z", "0", 
         RowBox[{
          RowBox[{"-", "c"}], "+", "x"}]}
       },
       GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[0.7]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}], "\[NoBreak]", ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0032c16e-d23b-4be0-be86-d7d7cf809d46"],
 "\nThe behavior near each equilibria is governed by the eigenvalues of the \
Jacobian.  These are the roots of the characteristic polynomial \n\t",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Det", 
    RowBox[{"(", 
     RowBox[{"A", "-", 
      StyleBox[
       RowBox[{
        StyleBox["\[Lambda]",
         FontColor->RGBColor[1, 0, 0]], "I"}]]}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"z", " ", 
      RowBox[{"(", 
       RowBox[{"a", "-", 
        StyleBox["\[Lambda]",
         FontColor->RGBColor[1, 0, 0]]}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "c"}], "+", "x", "-", 
        StyleBox["\[Lambda]",
         FontColor->RGBColor[1, 0, 0]]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"a", " ", 
         StyleBox["\[Lambda]",
          FontColor->RGBColor[1, 0, 0]]}], "+", 
        SuperscriptBox[
         StyleBox["\[Lambda]",
          FontColor->RGBColor[1, 0, 0]], "2"]}], ")"}]}]}], "=", "0"}]}]],
  CellChangeTimes->{4.003831620928721*^9, 4.0038317244045105`*^9},
  ExpressionUUID->"18ff04eb-86c7-4c3a-89f2-2853faf4f086"],
 "\nwhich is \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "c"}], "+", "x", "+", 
       RowBox[{"a", " ", "z"}]}], ")"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"a", " ", "c"}], "-", 
        RowBox[{"a", " ", "x"}], "-", "z"}], ")"}], " ", 
      StyleBox["\[Lambda]",
       FontColor->RGBColor[1, 0, 0]]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "-", "c", "+", "x"}], ")"}], " ", 
      SuperscriptBox[
       StyleBox["\[Lambda]",
        FontColor->RGBColor[1, 0, 0]], "2"]}], "-", 
     SuperscriptBox[
      StyleBox["\[Lambda]",
       FontColor->RGBColor[1, 0, 0]], "3"]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5ffc0eec-cc47-4720-903e-960c63376214"],
 "\nThe discriminant (which gives info about the roots) is \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"disc", "=", 
    RowBox[{
     RowBox[{"-", "4"}], "+", 
     SuperscriptBox["a", "2"], "-", 
     RowBox[{"8", " ", "a", " ", "c"}], "+", 
     RowBox[{"2", " ", 
      SuperscriptBox["a", "3"], " ", "c"}], "-", 
     RowBox[{"8", " ", 
      SuperscriptBox["c", "2"]}], "-", 
     RowBox[{"2", " ", 
      SuperscriptBox["a", "2"], " ", 
      SuperscriptBox["c", "2"]}], "+", 
     RowBox[{
      SuperscriptBox["a", "4"], " ", 
      SuperscriptBox["c", "2"]}], "-", 
     RowBox[{"8", " ", "a", " ", 
      SuperscriptBox["c", "3"]}], "+", 
     RowBox[{"2", " ", 
      SuperscriptBox["a", "3"], " ", 
      SuperscriptBox["c", "3"]}], "-", 
     RowBox[{"4", " ", 
      SuperscriptBox["c", "4"]}], "+", 
     RowBox[{
      SuperscriptBox["a", "2"], " ", 
      SuperscriptBox["c", "4"]}], "+", 
     RowBox[{"8", " ", "a", " ", "x"}], "-", 
     RowBox[{"2", " ", 
      SuperscriptBox["a", "3"], " ", "x"}], "+", 
     RowBox[{"16", " ", "c", " ", "x"}], "+", 
     RowBox[{"4", " ", 
      SuperscriptBox["a", "2"], " ", "c", " ", "x"}], "-", 
     RowBox[{"2", " ", 
      SuperscriptBox["a", "4"], " ", "c", " ", "x"}], "+", 
     RowBox[{"24", " ", "a", " ", 
      SuperscriptBox["c", "2"], " ", "x"}], "-", 
     RowBox[{"6", " ", 
      SuperscriptBox["a", "3"], " ", 
      SuperscriptBox["c", "2"], " ", "x"}], "+", 
     RowBox[{"16", " ", 
      SuperscriptBox["c", "3"], " ", "x"}], "-", 
     RowBox[{"4", " ", 
      SuperscriptBox["a", "2"], " ", 
      SuperscriptBox["c", "3"], " ", "x"}], "-", 
     RowBox[{"8", " ", 
      SuperscriptBox["x", "2"]}], "-", 
     RowBox[{"2", " ", 
      SuperscriptBox["a", "2"], " ", 
      SuperscriptBox["x", "2"]}], "+", 
     RowBox[{
      SuperscriptBox["a", "4"], " ", 
      SuperscriptBox["x", "2"]}], "-", 
     RowBox[{"24", " ", "a", " ", "c", " ", 
      SuperscriptBox["x", "2"]}], "+", 
     RowBox[{"6", " ", 
      SuperscriptBox["a", "3"], " ", "c", " ", 
      SuperscriptBox["x", "2"]}], "-", 
     RowBox[{"24", " ", 
      SuperscriptBox["c", "2"], " ", 
      SuperscriptBox["x", "2"]}], "+", 
     RowBox[{"6", " ", 
      SuperscriptBox["a", "2"], " ", 
      SuperscriptBox["c", "2"], " ", 
      SuperscriptBox["x", "2"]}], "+", 
     RowBox[{"8", " ", "a", " ", 
      SuperscriptBox["x", "3"]}], "-", 
     RowBox[{"2", " ", 
      SuperscriptBox["a", "3"], " ", 
      SuperscriptBox["x", "3"]}], "+", 
     RowBox[{"16", " ", "c", " ", 
      SuperscriptBox["x", "3"]}], "-", 
     RowBox[{"4", " ", 
      SuperscriptBox["a", "2"], " ", "c", " ", 
      SuperscriptBox["x", "3"]}], "-", 
     RowBox[{"4", " ", 
      SuperscriptBox["x", "4"]}], "+", 
     RowBox[{
      SuperscriptBox["a", "2"], " ", 
      SuperscriptBox["x", "4"]}], "-", 
     RowBox[{"12", " ", "z"}], "+", 
     RowBox[{"20", " ", 
      SuperscriptBox["a", "2"], " ", "z"}], "-", 
     RowBox[{"4", " ", 
      SuperscriptBox["a", "4"], " ", "z"}], "+", 
     RowBox[{"38", " ", "a", " ", "c", " ", "z"}], "-", 
     RowBox[{"8", " ", 
      SuperscriptBox["a", "3"], " ", "c", " ", "z"}], "+", 
     RowBox[{"20", " ", 
      SuperscriptBox["c", "2"], " ", "z"}], "-", 
     RowBox[{"2", " ", 
      SuperscriptBox["a", "2"], " ", 
      SuperscriptBox["c", "2"], " ", "z"}], "+", 
     RowBox[{"2", " ", "a", " ", 
      SuperscriptBox["c", "3"], " ", "z"}], "-", 
     RowBox[{"38", " ", "a", " ", "x", " ", "z"}], "+", 
     RowBox[{"8", " ", 
      SuperscriptBox["a", "3"], " ", "x", " ", "z"}], "-", 
     RowBox[{"40", " ", "c", " ", "x", " ", "z"}], "+", 
     RowBox[{"4", " ", 
      SuperscriptBox["a", "2"], " ", "c", " ", "x", " ", "z"}], "-", 
     RowBox[{"6", " ", "a", " ", 
      SuperscriptBox["c", "2"], " ", "x", " ", "z"}], "+", 
     RowBox[{"20", " ", 
      SuperscriptBox["x", "2"], " ", "z"}], "-", 
     RowBox[{"2", " ", 
      SuperscriptBox["a", "2"], " ", 
      SuperscriptBox["x", "2"], " ", "z"}], "+", 
     RowBox[{"6", " ", "a", " ", "c", " ", 
      SuperscriptBox["x", "2"], " ", "z"}], "-", 
     RowBox[{"2", " ", "a", " ", 
      SuperscriptBox["x", "3"], " ", "z"}], "-", 
     RowBox[{"12", " ", 
      SuperscriptBox["z", "2"]}], "-", 
     RowBox[{"8", " ", 
      SuperscriptBox["a", "2"], " ", 
      SuperscriptBox["z", "2"]}], "-", 
     RowBox[{"8", " ", "a", " ", "c", " ", 
      SuperscriptBox["z", "2"]}], "+", 
     RowBox[{
      SuperscriptBox["c", "2"], " ", 
      SuperscriptBox["z", "2"]}], "+", 
     RowBox[{"8", " ", "a", " ", "x", " ", 
      SuperscriptBox["z", "2"]}], "-", 
     RowBox[{"2", " ", "c", " ", "x", " ", 
      SuperscriptBox["z", "2"]}], "+", 
     RowBox[{
      SuperscriptBox["x", "2"], " ", 
      SuperscriptBox["z", "2"]}], "-", 
     RowBox[{"4", " ", 
      SuperscriptBox["z", "3"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "15d6861c-f073-4fbe-913e-c78973985ecf"],
 "\nFrom ",
 ButtonBox["Wiki",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Discriminant"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Discriminant"],
 " for a cubic \[OpenCurlyDoubleQuote]If the coefficients are real numbers, \
and the discriminant is not zero, the discriminant is positive if the roots \
are three distinct real numbers, and negative if there is one real root and \
two complex conjugate roots.\[CloseCurlyDoubleQuote]"
}], "Text",
 CellChangeTimes->{{4.0038314744038363`*^9, 4.003831482013748*^9}, {
  4.003831532470042*^9, 4.0038317541843863`*^9}, {4.0038317851527805`*^9, 
  4.0038318898160677`*^9}, {4.0038319394330735`*^9, 4.0038319520497704`*^9}, {
  4.0038320571314974`*^9, 4.003832074506765*^9}, {4.0038328444683685`*^9, 
  4.0038329510434504`*^9}},ExpressionUUID->"511061f5-fccd-45d7-9775-\
ef822c7cbd21"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"EqSub", "=", 
   RowBox[{"Solve", "[", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Ross", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}], "]"}], "==", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xzDisc", "=", 
   RowBox[{"Discriminant", "[", 
    RowBox[{
     RowBox[{"CharacteristicPolynomial", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"dRoss", "[", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], "]"}], ",", "\[Lambda]"}], 
      "]"}], ",", "\[Lambda]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", "xzDisc", "]"}]}], "Input",
 CellChangeTimes->{{4.0038316180850835`*^9, 4.003831620334641*^9}, {
  4.003831711500179*^9, 4.003831723624702*^9}, {4.0038317597023335`*^9, 
  4.003831779450832*^9}, {4.003831895175895*^9, 4.003831959618919*^9}, {
  4.0038320955716424`*^9, 4.0038321793883247`*^9}, {4.0038329863452272`*^9, 
  4.003833014601935*^9}, {4.003833446517351*^9, 
  4.0038334493501863`*^9}},ExpressionUUID->"4646c584-1f8b-4523-9a74-\
130e4ffdc668"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "4"}], "-", 
  RowBox[{"4", " ", 
   SuperscriptBox["c", "4"]}], "+", 
  RowBox[{"16", " ", 
   SuperscriptBox["c", "3"], " ", "x"}], "-", 
  RowBox[{"8", " ", 
   SuperscriptBox["x", "2"]}], "-", 
  RowBox[{"4", " ", 
   SuperscriptBox["x", "4"]}], "+", 
  RowBox[{
   SuperscriptBox["a", "4"], " ", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["c", "2"], "-", 
     RowBox[{"2", " ", "c", " ", "x"}], "+", 
     SuperscriptBox["x", "2"], "-", 
     RowBox[{"4", " ", "z"}]}], ")"}]}], "+", 
  RowBox[{"2", " ", 
   SuperscriptBox["a", "3"], " ", 
   RowBox[{"(", 
    RowBox[{"c", "-", "x"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     SuperscriptBox["c", "2"], "-", 
     RowBox[{"2", " ", "c", " ", "x"}], "+", 
     SuperscriptBox["x", "2"], "-", 
     RowBox[{"4", " ", "z"}]}], ")"}]}], "-", 
  RowBox[{"12", " ", "z"}], "+", 
  RowBox[{"20", " ", 
   SuperscriptBox["x", "2"], " ", "z"}], "-", 
  RowBox[{"12", " ", 
   SuperscriptBox["z", "2"]}], "+", 
  RowBox[{
   SuperscriptBox["x", "2"], " ", 
   SuperscriptBox["z", "2"]}], "-", 
  RowBox[{"4", " ", 
   SuperscriptBox["z", "3"]}], "+", 
  RowBox[{"2", " ", "a", " ", 
   RowBox[{"(", 
    RowBox[{"c", "-", "x"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "4"}], "+", 
     RowBox[{
      SuperscriptBox["c", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "4"}], "+", "z"}], ")"}]}], "-", 
     RowBox[{"2", " ", "c", " ", "x", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "4"}], "+", "z"}], ")"}]}], "+", 
     RowBox[{
      SuperscriptBox["x", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "4"}], "+", "z"}], ")"}]}], "+", 
     RowBox[{"19", " ", "z"}], "-", 
     RowBox[{"4", " ", 
      SuperscriptBox["z", "2"]}]}], ")"}]}], "+", 
  RowBox[{"2", " ", "c", " ", "x", " ", 
   RowBox[{"(", 
    RowBox[{"8", "+", 
     RowBox[{"8", " ", 
      SuperscriptBox["x", "2"]}], "-", 
     RowBox[{"20", " ", "z"}], "-", 
     SuperscriptBox["z", "2"]}], ")"}]}], "+", 
  RowBox[{
   SuperscriptBox["c", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "8"}], "-", 
     RowBox[{"24", " ", 
      SuperscriptBox["x", "2"]}], "+", 
