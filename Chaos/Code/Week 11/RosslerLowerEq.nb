Cell[CellGroupData[{

Cell["Determinant and Trace", "Subsection",
 CellChangeTimes->{{4.0038350727627354`*^9, 
  4.003835078156808*^9}},ExpressionUUID->"f4fd2b48-f365-46bb-90de-\
8ff7a3e39050"],

Cell[TextData[{
 "The sum of the eigenvalues is the trace of the matrix. \n",
 ButtonBox["Wiki",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Trace_(linear_algebra)"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Trace_(linear_algebra)"],
 "\nThe product of the eigenvalues is the determinant of the matrix. \n",
 ButtonBox["Wiki",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Eigenvalues_and_eigenvectors"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Eigenvalues_and_eigenvectors"],
 " \nThese recipes are very clean. "
}], "Text",
 CellChangeTimes->{{4.003835089254635*^9, 4.0038351251691284`*^9}, {
  4.003835185397794*^9, 4.003835196522964*^9}, {4.0038352536122465`*^9, 
  4.0038352769301476`*^9}, {4.003835543586463*^9, 
  4.0038355651031065`*^9}},ExpressionUUID->"204a5fbf-145e-4fed-8e8a-\
48344185d9be"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Tr", "[", 
  RowBox[{
   RowBox[{"dRoss", "[", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z"}], "}"}], "]"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Det", "[", 
  RowBox[{
   RowBox[{"dRoss", "[", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z"}], "}"}], "]"}], "]"}]}], "Input",
 CellChangeTimes->{{4.003835129392047*^9, 4.003835180453084*^9}},
 CellLabel->
  "In[105]:=",ExpressionUUID->"9976c050-89fe-47a3-b6d1-b2d32f12f37e"],

Cell[BoxData[
 RowBox[{"a", "-", "c", "+", "x"}]], "Output",
 CellChangeTimes->{{4.0038351576875763`*^9, 4.0038351810855923`*^9}},
 CellLabel->
  "Out[105]=",ExpressionUUID->"0ba981bc-4f1a-4737-b605-e8f80a84974f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "c"}], "+", "x", "+", 
  RowBox[{"a", " ", "z"}]}]], "Output",
 CellChangeTimes->{{4.0038351576875763`*^9, 4.003835181090647*^9}},
 CellLabel->
  "Out[106]=",ExpressionUUID->"c356a4f1-180e-4084-bc71-a7f2e879ba7f"]
}, Open  ]],

Cell[TextData[{
 "Can I do anything useful with these simple exp[ressions?  If I know I have\n\
\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", "1"], "=", "r"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5326c5fc-ed31-4e44-ae4b-109a54a06e29"],
 "  and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", "2"], "=", 
    RowBox[{"\[Alpha]", "+", 
     RowBox[{"\[Beta]", " ", "\[ImaginaryI]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "800f7c25-eedc-4ca4-9981-1ba9b62f53b3"],
 "  and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", "3"], "=", 
    RowBox[{"\[Alpha]", "-", 
     RowBox[{"\[Beta]", " ", "\[ImaginaryI]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "12e836ab-24c7-4909-a61e-517bcabe5f5e"],
 "\nThe recipes may not even be that bad if I substitute in the expressions\n\
\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"c", "-", 
       SqrtBox[
        RowBox[{
         RowBox[{
          RowBox[{"-", "4"}], "a", " ", "b"}], "+", 
         SuperscriptBox["c", "2"]}]]}], "=", 
      RowBox[{"2", "a", " ", "p"}]},
     {
      RowBox[{"c", "+", 
       SqrtBox[
        RowBox[{
         RowBox[{
          RowBox[{"-", "4"}], "a", " ", "b"}], "+", 
         SuperscriptBox["c", "2"]}]]}], "=", 
      RowBox[{"2", "a", " ", "q"}]}
    }], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2ca629a1-0bd3-4947-ae0b-68fdcfdafa7a"],
 "\nthat define the equilibria. "
}], "Text",
 InitializationCell->True,
 CellChangeTimes->{{4.0038355818369436`*^9, 4.003835721839605*^9}, {
  4.0038357620249033`*^9, 4.003835794341638*^9}, {4.0038358806138177`*^9, 
  4.003835908985566*^9}},ExpressionUUID->"c09ce1bb-049e-4046-9980-\
1b427030a52f"]
}, Open  ]]
}, Closed]],

