}, Open  ]],

Cell[TextData[{
 "The plan here is to leave it in terms of x and z (note there is no y) and a \
and c (note there is no b) for as long as possible.  We are of course \
interested in the eigenvalue at the equilibria\n\t\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      SubscriptBox["eq", "l"], "=", 
      RowBox[{"p", 
       RowBox[{"{", 
        RowBox[{"a", " ", ",", 
         RowBox[{"-", "1"}], ",", "1"}], "}"}]}]},
     {
      SubscriptBox["eq", "u"], "=", 
      RowBox[{"q", 
       RowBox[{"{", 
        RowBox[{"a", " ", ",", 
         RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}
    }], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "294ba46d-d8fe-452a-a4ca-2efdad6627dc"],
 "\nSince the recipes are the same (one just has a q where the other has a p) \
we can build a single function "
}], "Text",
 CellChangeTimes->{{4.0038331992155423`*^9, 4.003833318437954*^9}, {
  4.003833460271332*^9, 4.003833499046171*^9}, {4.003833596013365*^9, 
  4.0038336231457024`*^9}, {4.003833656815119*^9, 
  4.0038336680696435`*^9}},ExpressionUUID->"59b729a3-0ffa-4e1c-b37c-\
6d23bc29d6fb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Expand", "[", 
  RowBox[{"xzDisc", "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "->", 
      RowBox[{"p", " ", "a"}]}], ",", 
     RowBox[{"z", "->", "p"}]}], "}"}]}], "]"}]], "Input",
