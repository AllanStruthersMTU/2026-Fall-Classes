      SuperscriptBox["z", "2"]}], "-", 
     RowBox[{"2", " ", 
      SuperscriptBox["x", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "z"}], ")"}]}], "+", 
     RowBox[{"4", " ", "c", " ", "x", " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"], "+", "z"}], ")"}]}], "+", 
     RowBox[{
      SuperscriptBox["c", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"6", " ", 
         SuperscriptBox["x", "2"]}], "-", 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "z"}], ")"}]}]}], ")"}]}]}], ")"}]}]}]], "Output",
