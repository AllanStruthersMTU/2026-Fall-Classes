         RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "y2"}]}], "}"}], ",", "y", ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", " ", ",", 
       RowBox[{"10", "TMax"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
