Notebook[{

Cell[CellGroupData[{
Cell["\<\
Finite Differencing
what is h small?\
\>", "Title",
 CellChangeTimes->{{3.997354396199274*^9, 3.9973544008679843`*^9}, {
  3.9999346233602753`*^9, 3.9999346251770563`*^9}, {3.9999443196371984`*^9, 
  3.9999443385256505`*^9}},ExpressionUUID->"ee41a007-0d2f-4b6e-9991-\
30a592e66adf"],

Cell[TextData[{
 "The idea behind Finite Difference approximations to derivatives is simple.  \
Since \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{
     SubscriptBox["lim", 
      RowBox[{"h", "->", "0"}]], 
     FractionBox[
      RowBox[{
       RowBox[{"f", 
        RowBox[{"(", 
         RowBox[{"x", "+", "h"}], ")"}]}], "-", 
       RowBox[{"f", "(", "x", ")"}]}], "h"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "50aa8359-9ea2-4da9-8eef-dbe51e4905df"],
 "\nwe should be able to choose ",
 Cell[BoxData[
  FormBox["h", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "53df5c65-e3c5-4dec-9b52-0ca26038e9a2"],
 " small and use the approximation \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "\[TildeTilde]", 
    FractionBox[
     RowBox[{
      RowBox[{"f", 
       RowBox[{"(", 
        RowBox[{"x", "+", "h"}], ")"}]}], "-", 
      RowBox[{"f", "(", "x", ")"}]}], "h"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1ca7ed7d-2423-4f29-ba76-5aca4e7253e4"],
 ".\nThere are lots of other possibilities\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "\[TildeTilde]", 
    FractionBox[
     RowBox[{
      RowBox[{"f", 
       RowBox[{"(", 
        RowBox[{"x", "+", "h"}], ")"}]}], "-", 
      RowBox[{"f", "(", 
       RowBox[{"x", "-", "h"}], ")"}]}], 
     RowBox[{"2", "h"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "615caec6-114a-4c9d-b4a0-e32bbd5e11e1"],
 "\nThere are wider symmetric possibilities\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "\[TildeTilde]", 
    FractionBox[
     RowBox[{
      RowBox[{"-", 
       RowBox[{"f", "(", 
        RowBox[{"x", "+", 
         RowBox[{"2", "h"}]}], ")"}]}], "+", 
      RowBox[{"8", 
       RowBox[{"f", "(", 
        RowBox[{"x", "+", "h"}], ")"}]}], " ", "-", " ", 
      RowBox[{"8", 
       RowBox[{"f", "(", 
        RowBox[{"x", "-", "h"}], ")"}]}], "+", 
      RowBox[{"f", "(", 
       RowBox[{"x", "-", 
        RowBox[{"2", "h"}]}], ")"}]}], 
     RowBox[{"12", "h"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a57da2a8-70fe-452b-8e64-a1c2e5077d6c"],
 "\nand \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "\[TildeTilde]", 
    FractionBox[
     RowBox[{
      RowBox[{"f", "(", 
       RowBox[{"x", "+", 
        RowBox[{"3", "h"}]}], ")"}], "-", 
      RowBox[{"9", 
       RowBox[{"f", "(", 
        RowBox[{"x", "+", 
         RowBox[{"2", "h"}]}], ")"}]}], "+", " ", 
      RowBox[{"45", " ", 
       RowBox[{"f", "(", 
        RowBox[{"x", "+", "h"}], ")"}]}], "-", 
      RowBox[{"45", " ", 
       RowBox[{"f", "(", 
        RowBox[{"x", "-", "h"}], ")"}]}], " ", "+", " ", 
      RowBox[{"9", 
       RowBox[{"f", "(", 
        RowBox[{"x", "-", "h"}], ")"}]}], "+", 
      RowBox[{"f", "(", 
       RowBox[{"x", "-", 
        RowBox[{"3", "h"}]}], ")"}]}], 
     RowBox[{"60", "h"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5c41782c-0a23-40d7-871f-604fba78bf6c"],
 "\nThe question is how should we choose ",
 Cell[BoxData[
  FormBox["h", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c2c42af3-3f68-4b9d-bbb6-54112333d71a"],
 " small"
}], "Text",
 CellChangeTimes->{{3.999855743934202*^9, 3.999855893891206*^9}, {
  3.9999443430280647`*^9, 3.999944527380969*^9}, {3.9999445634729137`*^9, 
  3.9999447318202324`*^9}, {3.999944790658431*^9, 
  3.9999448105474653`*^9}},ExpressionUUID->"6804a1f1-275c-43ae-8189-\
fe9d33960021"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"x", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{
        SuperscriptBox["x", "2"], "+", " ", 
        RowBox[{"3", " ", "x"}], "+", "1"}], "]"}], "+", " ", 
      RowBox[{"Tan", "[", 
       RowBox[{"2", 
        RowBox[{"x", "/", "2"}]}], "]"}]}], "]"}]}], "+", 
   RowBox[{"2", "x"}], " ", "+", 
   SuperscriptBox["x", "3"]}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{
      RowBox[{"f", "'"}], "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.999944737030918*^9, 3.9999447802386193`*^9}, {
  3.9999449414807425`*^9, 3.9999449639438825`*^9}},
 CellLabel->
  "In[901]:=",ExpressionUUID->"0a418c4e-54c4-49a7-8a08-d02c85484f75"],

