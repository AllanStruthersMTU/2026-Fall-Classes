Cell[TextData[{
 "The rounding error in each formula is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"~", 
    FractionBox[
     SubscriptBox["\[Epsilon]", "m"], "h"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "436d3b00-4480-4210-b43a-92fd60e5b398"],
 ".  The crude heuristic power for the optimal ",
 Cell[BoxData[
  FormBox["h", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "639e146d-09ad-40e8-8d27-1c039019a838"],
 " is obtained by balancing these errors assuming that all the coefficients \
in the truncations and rounding are 1. \n\t ",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      FractionBox[
       SubscriptBox["\[Epsilon]", "m"], 
       SubscriptBox["h", "FD"]], "\[TildeTilde]", 
      SubscriptBox["h", "FD"], "\[Implies]", 
      SubscriptBox["h", "FD"], "\[TildeTilde]", 
      SubsuperscriptBox["\[Epsilon]", "m", 
       RowBox[{"1", "/", "2"}]]},
     {
      FractionBox[
       SubscriptBox["\[Epsilon]", "m"], 
       SubscriptBox["h", 
        SubscriptBox["CD", "3"]]], "\[TildeTilde]", 
      SubsuperscriptBox["h", 
       SubscriptBox["CD", "3"], "2"], "\[Implies]", 
      SubscriptBox["h", 
       SubscriptBox["CD", "3"]], "\[TildeTilde]", 
      SubsuperscriptBox["\[Epsilon]", "m", 
       RowBox[{"1", "/", "3"}]]},
     {
      FractionBox[
       SubscriptBox["\[Epsilon]", "m"], 
       SubscriptBox["h", 
        SubscriptBox["CD", "5"]]], "\[TildeTilde]", 
      SubsuperscriptBox["h", 
       SubscriptBox["CD", "5"], "4"], "\[Implies]", 
      SubscriptBox["h", 
       SubscriptBox["CD", "5"]], "\[TildeTilde]", 
      SubsuperscriptBox["\[Epsilon]", "m", 
       RowBox[{"1", "/", "5"}]]},
     {
      FractionBox[
       SubscriptBox["\[Epsilon]", "m"], 
       SubscriptBox["h", 
        SubscriptBox["CD", "7"]]], "\[TildeTilde]", 
      SubsuperscriptBox["h", 
       SubscriptBox["CD", "7"], "6"], "\[Implies]", 
      SubscriptBox["h", 
       SubscriptBox["CD", "7"]], "\[TildeTilde]", 
      SubsuperscriptBox["\[Epsilon]", "m", 
       RowBox[{"1", "/", "7"}]]}
    }], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1c9ccf0d-bc12-426d-aa1c-2eb87bbfeeb9"]
}], "Text",
 CellChangeTimes->{{3.999955467904768*^9, 3.999955854398081*^9}, {
