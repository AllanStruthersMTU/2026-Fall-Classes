Cell["You can compute the truncation error with series.", "Text",
 CellChangeTimes->{{3.9999551655155544`*^9, 3.999955212346729*^9}, {
  3.9999554370693307`*^9, 
  3.999955451027975*^9}},ExpressionUUID->"a4169822-f124-418a-94ac-\
1564e8fdbbf8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "x0", ",", "h"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Series", "[", " ", 
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x0", "+", "h"}], "]"}], "-", 
     RowBox[{"f", "[", "x0", "]"}]}], "h"], ",", 
   RowBox[{"{", 
    RowBox[{"h", ",", "0", ",", " ", "1"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Series", "[", " ", 
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x0", "+", "h"}], "]"}], "-", 
     RowBox[{"f", "[", 
      RowBox[{"x0", "-", "h"}], "]"}]}], 
    RowBox[{"2", "h"}]], ",", 
   RowBox[{"{", 
    RowBox[{"h", ",", "0", ",", " ", "3"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Series", "[", 
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"-", 
      RowBox[{"f", "[", 
       RowBox[{"x0", "+", 
        RowBox[{"2", "h"}]}], "]"}]}], "+", 
     RowBox[{"8", 
      RowBox[{"f", "[", 
       RowBox[{"x0", "+", "h"}], "]"}]}], " ", "-", " ", 
     RowBox[{"8", 
      RowBox[{"f", "[", 
       RowBox[{"x0", "-", "h"}], "]"}]}], "+", 
     RowBox[{"f", "[", 
      RowBox[{"x0", "-", 
       RowBox[{"2", "h"}]}], "]"}]}], 
    RowBox[{"12", "h"}]], ",", 
   RowBox[{"{", 
    RowBox[{"h", ",", "0", ",", " ", "5"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Series", "[", 
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x0", "+", 
       RowBox[{"3", "h"}]}], "]"}], "-", 
     RowBox[{"9", 
      RowBox[{"f", "[", 
       RowBox[{"x0", "+", 
        RowBox[{"2", "h"}]}], "]"}]}], "+", " ", 
     RowBox[{"45", " ", 
      RowBox[{"f", "[", 
       RowBox[{"x0", "+", "h"}], "]"}]}], "-", 
     RowBox[{"45", " ", 
      RowBox[{"f", "[", 
       RowBox[{"x0", "-", "h"}], "]"}]}], " ", "+", " ", 
     RowBox[{"9", 
      RowBox[{"f", "[", 
       RowBox[{"x0", "-", 
        RowBox[{"2", "h"}]}], "]"}]}], "-", 
     RowBox[{"f", "[", 
      RowBox[{"x0", "-", 
       RowBox[{"3", "h"}]}], "]"}]}], 
    RowBox[{"60", "h"}]], ",", 
   RowBox[{"{", 
    RowBox[{"h", ",", "0", ",", "7"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9999552292897367`*^9, 3.999955426328163*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"214cb8e2-ec6f-49aa-9172-2ab0b44fd963"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["f", "\[Prime]",
     MultilineFunction->None], "[", "x0", "]"}], "+", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{
     SuperscriptBox["f", "\[Prime]\[Prime]",
      MultilineFunction->None], "[", "x0", "]"}], " ", "h"}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "h", "]"}], "2"],
    SeriesData[$CellContext`h, 0, {}, 0, 2, 1],
    Editable->False]}],
  SeriesData[$CellContext`h, 0, {
    Derivative[1][$CellContext`f][$CellContext`x0], Rational[1, 2] 
    Derivative[2][$CellContext`f][$CellContext`x0]}, 0, 2, 1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.999955280573193*^9, 3.999955304929914*^9}, {
  3.9999553948400917`*^9, 3.9999554278075542`*^9}},
 CellLabel->"Out[37]=",ExpressionUUID->"301cd60e-29ac-4ce7-bbdb-bf023777d140"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["f", "\[Prime]",
     MultilineFunction->None], "[", "x0", "]"}], "+", 
   RowBox[{
    FractionBox["1", "6"], " ", 
    RowBox[{
     SuperscriptBox["f", 
      TagBox[
       RowBox[{"(", "3", ")"}],
       Derivative],
      MultilineFunction->None], "[", "x0", "]"}], " ", 
    SuperscriptBox["h", "2"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "h", "]"}], "4"],
    SeriesData[$CellContext`h, 0, {}, 0, 4, 1],
    Editable->False]}],
  SeriesData[$CellContext`h, 0, {
    Derivative[1][$CellContext`f][$CellContext`x0], 0, Rational[1, 6] 
    Derivative[3][$CellContext`f][$CellContext`x0]}, 0, 4, 1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.999955280573193*^9, 3.999955304929914*^9}, {
  3.9999553948400917`*^9, 3.9999554278075542`*^9}},
 CellLabel->"Out[38]=",ExpressionUUID->"3fa47cde-87e9-4d65-949d-487fbf763686"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["f", "\[Prime]",
     MultilineFunction->None], "[", "x0", "]"}], "-", 
   RowBox[{
