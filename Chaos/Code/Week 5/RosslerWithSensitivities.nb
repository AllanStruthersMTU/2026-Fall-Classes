5bb133b9cf13"],

Cell[TextData[{
 "Our parameterization is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"u", "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["u", "1"], ",", 
       SubscriptBox["u", "2"]}], "}"}], "->", 
     RowBox[{"{", 
      RowBox[{"c", ",", 
       SubscriptBox["u", "1"], ",", 
       SubscriptBox["u", "2"]}], "}"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d4ab4eea-3358-4925-994b-84fdf9835be2"],
 ".   I modified the system to collect section points. I cheated by starting \
it on the section "
}], "Text",
 CellChangeTimes->{{3.9999350340008497`*^9, 3.999935038245531*^9}, {
  3.9999354879125786`*^9, 3.9999355145346603`*^9}, {3.999936077474027*^9, 
  3.9999361647196674`*^9}},ExpressionUUID->"261de1fa-9240-421c-9cc1-\
858079aed5e1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "dyf", ",", " ", "dpf"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", 
    RowBox[{"x", " ", "+", " ", 
     RowBox[{"a", " ", "y"}]}], ",", 
    RowBox[{"b", " ", "+", " ", 
     RowBox[{"z", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dyf", "[", 
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
   RowBox[{"(", GridBox[{
      {"0", 
       RowBox[{"-", "1"}], 
       RowBox[{"-", "1"}]},
      {"1", "a", "0"},
      {"z", "0", 
       RowBox[{"x", "-", "c"}]}
     }], ")"}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dpf", "[", 
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
   RowBox[{"(", GridBox[{
      {"0", "0", "0"},
      {"y", "0", "0"},
      {"0", "1", 
       RowBox[{"-", "z"}]}
     }], ")"}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{"0.2", ",", "0.2", ",", "2.6"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "123"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"5", ",", "0", ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"J0", "=", 
   RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S0", "=", 
   RowBox[{"(", GridBox[{
      {"0", "0", "0"},
      {"0", "0", "0"},
      {"0", "0", "0"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", "ySol", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SectionData", " ", "=", " ", 
   RowBox[{
    RowBox[{"Reap", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ySol", ",", "JSol", ",", "SSol"}], "}"}], "=", " ", 
       RowBox[{"NDSolveValue", "[", " ", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
            RowBox[{
             RowBox[{"f", "[", "p", "]"}], "[", 
             RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
            RowBox[{
             RowBox[{
              RowBox[{"dyf", "[", "p", "]"}], "[", 
              RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
             RowBox[{"J", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"S", "'"}], "[", "t", "]"}], "==", 
            RowBox[{
             RowBox[{
              RowBox[{"dpf", "[", "p", "]"}], "[", 
              RowBox[{"y", "[", "t", "]"}], "]"}], "+", 
             RowBox[{
              RowBox[{
               RowBox[{"dyf", "[", "p", "]"}], "[", 
               RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
              RowBox[{"S", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
           RowBox[{
            RowBox[{"J", "[", "0", "]"}], "==", "J0"}], ",", 
           RowBox[{
            RowBox[{"S", "[", "0", "]"}], "==", "S0"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"WhenEvent", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Indexed", "[", 
                RowBox[{
                 RowBox[{"y", "[", "t", "]"}], ",", "1"}], "]"}], "-", "c"}], 
              " ", "<", "0"}], ",", 
             RowBox[{"Sow", "[", 
              RowBox[{"{", 
               RowBox[{"t", ",", 
                RowBox[{"y", "[", "t", "]"}], ",", 
                RowBox[{"J", "[", "t", "]"}]}], "}"}], "]"}]}], "]"}]}], 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "I", " ", "have", " ", "no", " ", "idea", " ", "whay", " ", "I", 
            " ", "had", " ", "to", " ", "use", " ", "indexed", " ", "instead",
             " ", 
            RowBox[{"of", " ", "[", 
             RowBox[{"[", "]"}], "]"}], " ", "in", " ", 
            RowBox[{"here", "!"}]}], " ", "*)"}], "\[IndentingNewLine]", 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", "J", ",", "S"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], "]"}]}], ";"}], 
     "\[IndentingNewLine]", "]"}], "\[LeftDoubleBracket]", "2", 
    "\[RightDoubleBracket]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tVals", "=", 
   RowBox[{"SectionData", "\[LeftDoubleBracket]", 
    RowBox[{"1", ",", "All", ",", "1"}], "\[RightDoubleBracket]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"yVals", "=", 
   RowBox[{"SectionData", "\[LeftDoubleBracket]", 
    RowBox[{"1", ",", "All", ",", "2"}], "\[RightDoubleBracket]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"JVals", "=", 
   RowBox[{"SectionData", "\[LeftDoubleBracket]", 
    RowBox[{"1", ",", "All", ",", "3"}], "\[RightDoubleBracket]"}]}], 
  ";"}], "\n", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"ySol", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", ",", "u1", ",", "u2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"u1", ",", 
       RowBox[{"-", "2"}], ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"u2", ",", "0", ",", "8"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"Opacity", "[", "0.5", "]"}]}], ",", 
     RowBox[{"Mesh", "->", "None"}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Graphics3D", "[", 
    RowBox[{"{", 
     RowBox[{"Red", ",", " ", 
      RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
      RowBox[{"Point", "[", "yVals", "]"}]}], "}"}], "]"}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.9999347480842705`*^9, 3.9999348321501694`*^9}, {
