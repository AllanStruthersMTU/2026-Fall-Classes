Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TStart", "=", 
   RowBox[{"0.96", " ", "TMax"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<Phase Plot\>\"", "->", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"ySol", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "TStart", ",", " ", "TMax"}], "}"}]}], "]"}]}],
     ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<\!\(\*SubscriptBox[\(y\), \(1\)]\)\>\"", "->", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
