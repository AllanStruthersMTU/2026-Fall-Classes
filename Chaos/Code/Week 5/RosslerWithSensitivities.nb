Cell["\<\
There is a once around loop in there.  We want to compute it! \
\>", "Text",
 CellChangeTimes->{{3.9999416983981028`*^9, 3.9999417120726705`*^9}, {
  3.9999417824850206`*^9, 
  3.999941792749264*^9}},ExpressionUUID->"34e4d7fd-d9b3-4f63-99ef-\
