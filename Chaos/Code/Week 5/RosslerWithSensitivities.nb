Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "2.6"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "65268507-5586-4e5f-a3e7-e47da6577c63"],
 " the downward point on this last loop is roughly  {2.6, 2.30017, 3.3664}.  \
The question is how can we compute the accurately and/or without running the \
ODE solver out to infinity!  "
}], "Text",
 CellChangeTimes->{{3.9999423575714087`*^9, 3.999942368796576*^9}, {
  3.9999426221128445`*^9, 3.999942676222969*^9}, {3.999942714215048*^9, 
  3.999942832553757*^9}},ExpressionUUID->"c1f0246a-1bc6-4968-85af-\
272ba8b56419"],

Cell["\<\
The answer is Newton\[CloseCurlyQuote]s method on for fixed points of the \
return map.  To do this we need to parameterize our section surface, build \
the return map and construct the gradient of the in-plane component of the \
return map in the parameterization.    \
\>", "Text",
 CellChangeTimes->{{3.9999428348148727`*^9, 
  3.9999429396933727`*^9}},ExpressionUUID->"c3e32713-e09d-4162-89bf-\
cb253acca885"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Rossler return map and gradient\nSection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalSigma]", "-"], "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["y", "1"], "=", "c"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          SubscriptBox["y", "2"]}], "-", 
         SubscriptBox["y", "3"]}], "<", "0"}]}], "}"}], "\[Subset]", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "3"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "38d64d53-d18c-4945-8087-9a88ff042c24"],
 "!"
}], "Subsection",
 CellChangeTimes->{{3.9998557312934685`*^9, 3.9998557347141314`*^9}, {
  3.99985592353244*^9, 3.999855930985836*^9}, {3.9998562764285994`*^9, 
  3.9998562820218644`*^9}, {3.9998573174884915`*^9, 3.9998573364776707`*^9}, {
  3.9998672224335775`*^9, 3.999867267442823*^9}, {3.999934648033987*^9, 
  3.999934649974858*^9}, {3.9999355222384105`*^9, 3.999935525772505*^9}, {
  3.9999360057418118`*^9, 3.999936068269951*^9}, {3.9999418080169415`*^9, 
  3.9999418314846706`*^9}},ExpressionUUID->"cee76b23-c8e0-4afb-81d4-\
40cb48cc1442"],

Cell[TextData[{
 "The parameterization is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"u", "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["u", "1"], ",", 
       SubscriptBox["u", "2"]}], "}"}], "->", 
     RowBox[{"{", 
      RowBox[{"c", ",", 
       SubscriptBox["u", "1"], ",", 
       SubscriptBox["u", "2"]}], "}"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8809d13b-3547-40dd-a435-51aea4973770"],
 ".   The ODE system is modified to collect time t, position y, and \
sensitivity J after the first return. The parameterization make sure it \
starts on the section.  Here is how I developed the code.  "
}], "Text",
 CellChangeTimes->{{3.9999350340008497`*^9, 3.999935038245531*^9}, {
  3.9999354879125786`*^9, 3.9999355145346603`*^9}, {3.999936077474027*^9, 
  3.9999361647196674`*^9}, {3.999941837383747*^9, 3.999941901634136*^9}, {
  3.9999422592658553`*^9, 3.999942269456954*^9}, {3.999942959657153*^9, 
  3.9999430482773542`*^9}},ExpressionUUID->"2208142d-829e-414d-884c-\
8ca7b4a50685"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "dyf"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", 
    RowBox[{"x", " ", "+", " ", 
     RowBox[{"a", " ", "y"}]}], ",", 
    RowBox[{"b", " ", "+", " ", 
     RowBox[{"z", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dyf", "[", 
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
