Notebook[{

Cell[CellGroupData[{
Cell["Rossler", "Title",
 CellChangeTimes->{{3.997354396199274*^9, 3.9973544008679843`*^9}, {
  3.9999346233602753`*^9, 
  3.9999346251770563`*^9}},ExpressionUUID->"ee41a007-0d2f-4b6e-9991-\
30a592e66adf"],

Cell[TextData[{
 "The ODE is\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"y", "'''"}], "[", "t", "]"}], "==", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "0.5"}], 
      RowBox[{
       RowBox[{"y", "''"}], "[", "t", "]"}]}], "-", 
     RowBox[{
      RowBox[{"y", "'"}], "[", "t", "]"}], "+", 
     RowBox[{"y", "[", "t", "]"}], "-", 
     RowBox[{"Sign", "[", 
      RowBox[{"y", "[", "t", "]"}], "]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7fe7af36-16a1-4f1e-8ec1-8ade334b936e"],
 "\nIt (and it\[CloseCurlyQuote]s companion #11) are not quite smooth enough \
for our standard \[OpenCurlyDoubleQuote]Lipschitz\[CloseCurlyDoubleQuote] \
existence and uniqueness theorem!  This was addressed in a lecture. For now \
we are just going to approximate the solution numerically."
}], "Text",
 CellChangeTimes->{{3.999855743934202*^9, 
  3.999855893891206*^9}},ExpressionUUID->"6804a1f1-275c-43ae-8189-\
fe9d33960021"],

Cell[CellGroupData[{

Cell[TextData[{
 "Rossler with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"J", "=", 
    RowBox[{
     SubscriptBox["\[Del]", "x"], "y"}]}], TraditionalForm]],ExpressionUUID->
  "4d2d68aa-f0e1-429b-b7b0-0b3b366f6021"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "=", 
    RowBox[{
     SubscriptBox["D", "params"], "y"}]}], TraditionalForm]],ExpressionUUID->
  "2de1110b-dd9e-4e61-800a-1915e2ca46e7"],
 "\nNo Section!"
}], "Subsection",
 CellChangeTimes->{{3.9998557312934685`*^9, 3.9998557347141314`*^9}, {
  3.99985592353244*^9, 3.999855930985836*^9}, {3.9998562764285994`*^9, 
  3.9998562820218644`*^9}, {3.9998573174884915`*^9, 3.9998573364776707`*^9}, {
  3.9998672224335775`*^9, 3.999867267442823*^9}, {3.999934648033987*^9, 
  3.999934649974858*^9}, {3.9999355222384105`*^9, 
  3.999935525772505*^9}},ExpressionUUID->"b513dcad-09e7-4e46-bfee-\
f41725aa49a5"],

Cell["\<\
Our system with a bunch of sensitivities but no section crossings is\
\>", "Text",
 CellChangeTimes->{{3.9999350340008497`*^9, 3.999935038245531*^9}, {
  3.9999354879125786`*^9, 
  3.9999355145346603`*^9}},ExpressionUUID->"a3a4ae23-9ee8-4573-8fe8-\
6773562d4eca"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "dyf", ",", " ", "dpf"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", 
    RowBox[{"x", " ", "+", " ", 
     RowBox[{"a", " ", "y"}]}], ",", 
    RowBox[{"b", " ", "+", " ", 
     RowBox[{"z", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dyf", "[", 
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
   RowBox[{"(", GridBox[{
      {"0", 
       RowBox[{"-", "1"}], 
       RowBox[{"-", "1"}]},
      {"1", "a", "0"},
      {"z", "0", 
       RowBox[{"x", "-", "c"}]}
     }], ")"}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dpf", "[", 
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
   RowBox[{"(", GridBox[{
      {"0", "0", "0"},
      {"y", "0", "0"},
      {"0", "1", 
       RowBox[{"-", "z"}]}
     }], ")"}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{"{", 
    RowBox[{"0.2", ",", "0.2", ",", "2.6"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "123"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"5", ",", "0", ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"J0", "=", 
   RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S0", "=", 
   RowBox[{"(", GridBox[{
      {"0", "0", "0"},
      {"0", "0", "0"},
      {"0", "0", "0"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ySol", ",", "JSol", ",", "SSol"}], "}"}], "=", " ", 
   RowBox[{"NDSolveValue", "[", " ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"f", "[", "p", "]"}], "[", 
         RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"dyf", "[", "p", "]"}], "[", 
          RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
         RowBox[{"J", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"S", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"dpf", "[", "p", "]"}], "[", 
          RowBox[{"y", "[", "t", "]"}], "]"}], "+", 
         RowBox[{
          RowBox[{
           RowBox[{"dyf", "[", "p", "]"}], "[", 
           RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
          RowBox[{"S", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
       RowBox[{
        RowBox[{"J", "[", "0", "]"}], "==", "J0"}], ",", 
       RowBox[{
        RowBox[{"S", "[", "0", "]"}], "==", "S0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "J", ",", "S"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot3D", "[", 
  RowBox[{
   RowBox[{"ySol", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\"\<J-3D\>\"", "->", 
      RowBox[{"ParametricPlot3D", "[", 
       RowBox[{
        RowBox[{"SingularValueList", "[", 
         RowBox[{"JSol", "[", "t", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "TMax"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"BoxRatios", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}]}], "]"}]}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<S-3D\>\"", "->", 
      RowBox[{"ParametricPlot3D", "[", 
       RowBox[{
        RowBox[{"SingularValueList", "[", 
         RowBox[{"SSol", "[", "t", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "TMax"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"BoxRatios", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}]}], "]"}]}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<J\>\"", "->", 
      RowBox[{"LogPlot", "[", 
       RowBox[{
        RowBox[{"SingularValueList", "[", 
         RowBox[{
          RowBox[{"JSol", "[", "t", "]"}], ",", 
          RowBox[{"Tolerance", "\[Rule]", "0"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<S\>\"", "->", 
      RowBox[{"LogPlot", "[", 
       RowBox[{
        RowBox[{"SingularValueList", "[", 
         RowBox[{"SSol", "[", "t", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "}"}], ",", "3"}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9999347480842705`*^9, 3.9999348321501694`*^9}, {
  3.9999349255868273`*^9, 3.9999351569467325`*^9}, {3.9999352480481567`*^9, 
