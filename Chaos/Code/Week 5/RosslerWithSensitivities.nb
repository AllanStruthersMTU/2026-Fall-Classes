Cell[CellGroupData[{

Cell[TextData[{
 "Rossler with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"J", "=", 
    RowBox[{
     SubscriptBox["\[Del]", "x"], "y"}]}], TraditionalForm]],ExpressionUUID->
  "12afd42b-22df-4a8e-8acd-38f92f4cea35"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "=", 
    RowBox[{
     SubscriptBox["D", "params"], "y"}]}], TraditionalForm]],ExpressionUUID->
  "f876f3a2-530c-4d6f-9fc3-54787b540095"],
 "\nSection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalSigma]", "-"], "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["y", "1"], "=", "c"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          SubscriptBox["y", "2"]}], "-", 
         SubscriptBox["y", "3"]}], "<", "0"}]}], "}"}], "\[Subset]", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "3"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c71cf120-88ad-4b20-9005-6d9faf3a0e50"],
 "!"
}], "Subsection",
 CellChangeTimes->{{3.9998557312934685`*^9, 3.9998557347141314`*^9}, {
  3.99985592353244*^9, 3.999855930985836*^9}, {3.9998562764285994`*^9, 
  3.9998562820218644`*^9}, {3.9998573174884915`*^9, 3.9998573364776707`*^9}, {
  3.9998672224335775`*^9, 3.999867267442823*^9}, {3.999934648033987*^9, 
