Cell[TextData[{
 "So we know an accurate value for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "20b59f86-059b-43d4-aca6-ac0935019a0d"],
 ". This will give a reasonable guess for the value for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "2.05"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "301e101d-e2b2-43de-ad75-7026e5565fb5"]
}], "Text",
