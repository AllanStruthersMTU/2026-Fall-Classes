          }], "\[NoBreak]", ")"}], "]"}], "-", 
       RowBox[{"IdentityMatrix", "[", "4", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"u", "=", 
      RowBox[{"u", "-", 
       RowBox[{"LinearSolve", "[", 
        RowBox[{"A", ",", " ", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"p1", "-", "q2", "-", "q1"}], ",", 
           RowBox[{"p2", "-", "q1", "-", "q2"}]}], "]"}]}], "]"}]}]}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", "2", "}"}]}], "]"}], "//", "TableForm"}]}], "Input",
