    RowBox[{"0.2", ",", "0.2", ",", "3.5"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"u", "=", 
  RowBox[{"{", 
   RowBox[{"2.2", ",", "8.2", ",", "2.8", ",", "1.2"}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Table", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p1", ",", "Df1"}], "}"}], "=", 
      RowBox[{
       RowBox[{"pAndDp", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"f", ",", "dyf"}], "}"}]}], "]"}], "[", 
       RowBox[{"u", "\[LeftDoubleBracket]", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], "\[RightDoubleBracket]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p2", ",", "Df2"}], "}"}], "=", 
      RowBox[{
       RowBox[{"pAndDp", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"f", ",", "dyf"}], "}"}]}], "]"}], "[", 
       RowBox[{"u", "\[LeftDoubleBracket]", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], "\[RightDoubleBracket]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"A", "=", 
      RowBox[{
       RowBox[{"ArrayFlatten", "[", 
        RowBox[{"(", "\[NoBreak]", GridBox[{
           {"Df1", 
            RowBox[{"-", 
