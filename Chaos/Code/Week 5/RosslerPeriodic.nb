Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"0.2", ",", "0.2", ",", "2.6"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FixedPointSweep", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", "p", ",", "J"}], "}"}], "=", 
       RowBox[{
        RowBox[{"ReturnMapAndTimeAndJ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"f", ",", "dyf"}], "}"}]}], "]"}], "[", 
        RowBox[{"{", 
         RowBox[{"u1", ",", "u2"}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"p", "-", 
       RowBox[{"{", 
        RowBox[{"c", ",", "u1", ",", "u2"}], "}"}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"u1", ",", "1", ",", "5", ",", "0.25"}], "}"}], ",", 
