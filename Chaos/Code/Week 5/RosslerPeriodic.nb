Cell[TextData[{
 "The fixed point iteration \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", 
     RowBox[{"k", "+", "1"}]], "=", 
    RowBox[{"p", "(", 
     SubscriptBox["u", "k"], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "50d7e235-b9ea-4a1b-a52b-1104f0c6281a"],
 "\nis an easier way to compute this fixed point. "
}], "Text",
 CellChangeTimes->{{4.00020240211191*^9, 4.000202475991728*^9}, {
