  ";"}], "\n", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "\"\<\!\(\*StyleBox[SubscriptBox[\"p\", \"1\"],FontColor->RGBColor[1, 0, \
0]]\)\!\(\*StyleBox[\"-\",FontColor->RGBColor[1, 0, \
0]]\)\!\(\*StyleBox[SubscriptBox[\"u\", \"1\"],FontColor->RGBColor[1, 0, \
0]]\) & \!\(\*StyleBox[SubscriptBox[\"p\", \"2\"],FontColor->RGBColor[0, 0, \
1]]\)\!\(\*StyleBox[\"-\",FontColor->RGBColor[0, 0, \
1]]\)\!\(\*StyleBox[SubscriptBox[\"u\", \"2\"],FontColor->RGBColor[0, 0, \
1]]\)\>\"", "->", 
     RowBox[{"Show", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ListContourPlot", "[", 
        RowBox[{
         RowBox[{"FixedPointSweep", "\[LeftDoubleBracket]", 
          RowBox[{"All", ",", "All", ",", "2"}], "\[RightDoubleBracket]"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"Contours", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.5"}], ",", "0", ",", "0.5"}], "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"DataRange", "->", 
          RowBox[{"{", 
           RowBox[{
