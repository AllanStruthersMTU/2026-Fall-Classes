Cell[TextData[{
 "To find the fixed point accurately I need to derivative in the surface \
accounting for the change in the return time.  We worked this all out for the \
vertical section ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "1"], "=", "c"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "025e05a0-2483-40b0-80bf-364e0fe08828"],
 ".  All we have to do is implement the operations from the slides.  The \
recipe form the slides is \n\t",
 Cell[BoxData[
  FormBox[
   FrameBox[
    RowBox[{GridBox[{
       {
        RowBox[{"Dp", "(", 
         RowBox[{
          SubscriptBox["u", "1"], ",", 
          SubscriptBox["u", "2"]}], ")"}], "=", 
        RowBox[{"(", GridBox[{
           {
            SubscriptBox["J", "22"], 
            SubscriptBox["J", "23"]},
           {
            SubscriptBox["J", "32"], 
            SubscriptBox["J", "33"]}
          }], ")"}]}
      }], "+", 
     RowBox[{
      FractionBox["1", 
       RowBox[{
        SubscriptBox["p", "1"], "+", 
        SubscriptBox["p", "2"]}]], 
      RowBox[{"(", GridBox[{
         {
          RowBox[{
           RowBox[{"(", 
            RowBox[{"c", "+", 
             RowBox[{"a", " ", 
              SubscriptBox["p", "1"]}]}], ")"}], 
           SubscriptBox["J", "12"]}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"c", "+", 
             RowBox[{"a", " ", 
              SubscriptBox["p", "1"]}]}], ")"}], 
           SubscriptBox["J", "13"]}]},
         {
          RowBox[{"b", " ", 
           SubscriptBox["J", "12"]}], 
          RowBox[{"b", " ", 
           SubscriptBox["J", "13"]}]}
        }], ")"}]}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ac2a5aa0-c9f7-44cc-ba98-b8a865776549"],
 "  \nThe first term is full sensitivity restricted to the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "408c3b4b-a46e-464b-bb49-9af368ef042e"],
 " (aka ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bdc471b4-61f6-4593-8cd4-dbfd756f62b5"],
 ") and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bfa0e17e-5509-4e09-bd29-5ee422fcca0c"],
 " (aka ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7a19bd5f-c5b6-4492-be66-fcb6e25f1aec"],
 ") plane.  The second term is the correction due to the variation in the \
return time.  I am going to make a new function that returns the updated \
position and this gradient.  "
}], "Text",
 CellChangeTimes->{{3.9999431234496303`*^9, 3.9999431499028683`*^9}, {
  4.000124410652434*^9, 4.0001245157775326`*^9}, {4.000124617641138*^9, 
  4.0001250427337017`*^9}, {4.0001261046938157`*^9, 
  4.0001261322252264`*^9}},ExpressionUUID->"f3c68f9f-b7eb-4248-942b-\
2ca8ad21b070"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"pAndDp", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"f_", ",", "dyf_"}], "}"}]}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"u1_", ",", "u2_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t", ",", "p", ",", "J", ",", "Dp"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t", ",", "p", ",", "J"}], "}"}], "=", 
      RowBox[{
       RowBox[{"ReturnMapAndTimeAndJ", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"f", ",", "dyf"}], "}"}]}], "]"}], "[", 
       RowBox[{"{", 
        RowBox[{"u1", ",", "u2"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"t", ",", "p"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Dp", "=", 
      RowBox[{
       RowBox[{"(", GridBox[{
          {
           RowBox[{"J", "\[LeftDoubleBracket]", 
            RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}], 
           RowBox[{"J", "\[LeftDoubleBracket]", 
            RowBox[{"2", ",", "3"}], "\[RightDoubleBracket]"}]},
          {
           RowBox[{"J", "\[LeftDoubleBracket]", 
            RowBox[{"3", ",", "2"}], "\[RightDoubleBracket]"}], 
           RowBox[{"J", "\[LeftDoubleBracket]", 
            RowBox[{"3", ",", "3"}], "\[RightDoubleBracket]"}]}
         }], ")"}], "+", 
       RowBox[{
        FractionBox["1", 
         RowBox[{
          RowBox[{"p", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
           "+", 
          RowBox[{
          "p", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}]], 
        RowBox[{"(", GridBox[{
           {
            RowBox[{
             RowBox[{"(", 
              RowBox[{"c", "+", " ", 
               RowBox[{"a", " ", 
                RowBox[{
                "p", "\[LeftDoubleBracket]", "2", 
                 "\[RightDoubleBracket]"}]}]}], ")"}], 
             RowBox[{"J", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"c", "+", " ", 
               RowBox[{"a", " ", 
                RowBox[{
                "p", "\[LeftDoubleBracket]", "2", 
                 "\[RightDoubleBracket]"}]}]}], ")"}], 
