Cell[TextData[{
 "To find the fixed point accurately I need to derivative in the surface \
accounting for the change in the return time.  We worked this all out for the \
vertical section ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "1"], "=", "c"}], TraditionalForm]],ExpressionUUID->
  "025e05a0-2483-40b0-80bf-364e0fe08828"],
 ".  All we have to do is implement the operations from the slides.  The \
recipe from the slides is \n\t",
 Cell[BoxData[
  FormBox[
   FrameBox[
    RowBox[{GridBox[{
       {
        RowBox[{"Dp", "(", 
         RowBox[{
          SubscriptBox["u", "1"], ",", 
          SubscriptBox["u", "2"]}], ")"}], "=", 
        RowBox[{"(", GridBox[{
           {
            SubscriptBox["J", "22"], 
            SubscriptBox["J", "23"]},
           {
            SubscriptBox["J", "32"], 
            SubscriptBox["J", "33"]}
          }], ")"}]}
      }], "-", 
     RowBox[{
      FractionBox["1", 
       SubscriptBox["f", "1"]], 
      RowBox[{"(", GridBox[{
         {
          RowBox[{
           SubscriptBox["f", "2"], 
           SubscriptBox["J", "12"]}], 
          RowBox[{
           SubscriptBox["f", "2"], 
           SubscriptBox["J", "13"]}]},
         {
          RowBox[{
           SubscriptBox["f", "3"], 
           SubscriptBox["J", "12"]}], 
          RowBox[{
           SubscriptBox["f", "3"], 
           SubscriptBox["J", "13"]}]}
        }], ")"}]}]}]], TraditionalForm]],ExpressionUUID->
  "ac2a5aa0-c9f7-44cc-ba98-b8a865776549"],
 "  \nwhere ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b81a461f-274e-4e10-a7d6-2049e9410229"],
 " is the right hand side function evaluated at the end point. \nThe first \
term is full sensitivity restricted to the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "408c3b4b-a46e-464b-bb49-9af368ef042e"],
 " (aka ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", "1"], TraditionalForm]],ExpressionUUID->
  "bdc471b4-61f6-4593-8cd4-dbfd756f62b5"],
 ") and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "3"], TraditionalForm]],ExpressionUUID->
  "bfa0e17e-5509-4e09-bd29-5ee422fcca0c"],
 " (aka ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", "2"], TraditionalForm]],ExpressionUUID->
  "7a19bd5f-c5b6-4492-be66-fcb6e25f1aec"],
 ") plane.  The second term is the correction due to the variation in the \
return time.  I am going to make a new function that returns the updated \
position and this gradient.  "
}], "Text",
 CellChangeTimes->{{3.9999431234496303`*^9, 3.9999431499028683`*^9}, {
   4.000124410652434*^9, 4.0001245157775326`*^9}, {4.000124617641138*^9, 
   4.0001250427337017`*^9}, {4.0001261046938157`*^9, 
   4.0001261322252264`*^9}, {4.0001979992665405`*^9, 4.000198238858725*^9}, 
   4.0002005862343335`*^9, {4.000207476070673*^9, 
   4.0002074820107293`*^9}},ExpressionUUID->"f3c68f9f-b7eb-4248-942b-\
2ca8ad21b070"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"pAndDp", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"f_", ",", "dyf_"}], "}"}]}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"u1_", ",", "u2_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "t", ",", "p", ",", "J", ",", "Dp", ",", "f1", ",", "f2", ",", "f3"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t", ",", "p", ",", "J"}], "}"}], "=", 
      RowBox[{
       RowBox[{"ReturnMapAndTimeAndJ", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"f", ",", "dyf"}], "}"}]}], "]"}], "[", 
       RowBox[{"{", 
        RowBox[{"u1", ",", "u2"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"f1", ",", "f2", ",", "f3"}], "}"}], "=", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", "p", "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Dp", "=", 
      RowBox[{
       RowBox[{"(", GridBox[{
          {
           RowBox[{"J", "\[LeftDoubleBracket]", 
            RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}], 
           RowBox[{"J", "\[LeftDoubleBracket]", 
            RowBox[{"2", ",", "3"}], "\[RightDoubleBracket]"}]},
          {
           RowBox[{"J", "\[LeftDoubleBracket]", 
            RowBox[{"3", ",", "2"}], "\[RightDoubleBracket]"}], 
           RowBox[{"J", "\[LeftDoubleBracket]", 
            RowBox[{"3", ",", "3"}], "\[RightDoubleBracket]"}]}
         }], ")"}], "-", 
       RowBox[{
        FractionBox["1", "f1"], 
        RowBox[{"(", GridBox[{
           {
            RowBox[{"f2", " ", 
             RowBox[{"J", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}], 
            RowBox[{"f2", " ", 
             RowBox[{"J", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "3"}], "\[RightDoubleBracket]"}]}]},
           {
            RowBox[{"f3", " ", 
             RowBox[{"J", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}], 
            RowBox[{" ", 
             RowBox[{"f3", " ", 
              RowBox[{"J", "\[LeftDoubleBracket]", 
               RowBox[{"1", ",", "3"}], "\[RightDoubleBracket]"}]}]}]}
          }], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", "\[LeftDoubleBracket]", 
        RowBox[{"2", ";;", "3"}], "\[RightDoubleBracket]"}], ",", "Dp"}], 
      "}"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.0001250648763638`*^9, 4.000125272054468*^9}, {
  4.000125794960424*^9, 4.000125798707283*^9}, {4.0001260468672113`*^9, 
  4.000126070483937*^9}, {4.0001261408243656`*^9, 4.0001261612422314`*^9}, {
  4.0001262196277313`*^9, 4.000126228479369*^9}, {4.000126302148667*^9, 
  4.0001263118275824`*^9}, {4.000198250223615*^9, 4.000198306197538*^9}, {
  4.000198354493696*^9, 4.000198358019432*^9}, {4.0001987353502913`*^9, 
  4.0001987356938105`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"7c721a84-480a-4612-9f46-7811ccd0c466"],

Cell[TextData[{
 "Lots of complicated Calculus III chain rule computations went into this \
formula.  We need to check we did not mess up!  We basically need to check \
the formula and the implementation.  We need to turn the fixed point problem\n\
\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"p", "(", "q", ")"}], "=", "q"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3a025e36-bd19-45d2-bc55-6e98092943f2"],
 "\nfor ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "79b69644-6cf4-4dec-9dcf-7ace987db1a9"],
 " on our section i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", "\[Element]", "\[CapitalSigma]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3eadb901-0bb6-4097-8af5-35a4919a28d7"],
 " into a Newton ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", "u", ")"}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "37fea15d-bd0e-4126-afa3-c3d873ba9193"],
 " problem for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"u", "\[Element]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e58eb737-0555-4ad8-b973-a4bb7d4a59b3"],
 ".  With all the stuff we built all we have to do is define\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", "u", ")"}], "=", 
    RowBox[{
     RowBox[{"p", "(", "u", ")"}], "-", "u"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e7e569d5-4451-43ad-a9c2-ff60173b8822"],
 "\n The function here is doing some double duty in terms of its domain, \
range etc.  To be explicit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", ":", 
     RowBox[{"U", "\[Subset]", 
      SuperscriptBox["\[DoubleStruckCapitalR]", "2"]}]}], "->", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bfd1396a-c93b-4fe6-8f91-78d486c1b404"],
 " and we have a formula\n \t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Del]", 
     RowBox[{"g", "(", "u", ")"}]}], "=", 
    RowBox[{
     RowBox[{"Dp", "(", "u", ")"}], "-", 
     SubscriptBox["I", "2"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e2319274-b921-4c28-ad7c-6db315a45833"],
 "\t\n  (hopefully correct) for its gradient.  Newton\[CloseCurlyQuote]s \
method\n  \t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", 
     RowBox[{"k", "+", "1"}]], "=", 
    RowBox[{
     RowBox[{"g", "(", 
      SubscriptBox["u", "k"], ")"}], "-", 
     RowBox[{
      RowBox[{"\[Del]", 
       SuperscriptBox[
        RowBox[{"g", "(", 
         SubscriptBox["u", "k"], ")"}], 
        RowBox[{"-", "1"}]]}], 
      RowBox[{"g", "(", 
       SubscriptBox["u", "k"], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cac09933-c709-417e-bd31-274f1caf45b7"],
 "\n  should converge rapidly from a decent initial condition! Here is a \
manual version.   We need to decide how to measure how good an approximate \
answer is.  We need to decide how to measure convergence.  We need to wrap \
this up in a function!  "
}], "Text",
