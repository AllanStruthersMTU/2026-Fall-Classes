Notebook[{

Cell[CellGroupData[{
Cell["Rossler", "Title",
 CellChangeTimes->{{3.997354396199274*^9, 3.9973544008679843`*^9}, {
  3.9999346233602753`*^9, 
  3.9999346251770563`*^9}},ExpressionUUID->"ee41a007-0d2f-4b6e-9991-\
30a592e66adf"],

Cell[TextData[{
 "The previous notebook implemented Rossler + sensitivities on the vertical \
section  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalSigma]", "-"], "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["y", "1"], "=", "c"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          SubscriptBox["y", "2"]}], "-", 
         SubscriptBox["y", "3"]}], "<", "0"}]}], "}"}], "\[Subset]", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "3"]}]}], TraditionalForm]],
  ExpressionUUID->"3f1e56a4-c867-43be-bd6b-c04868b91d85"],
 ".  The plan is to use these tools to find periodic orbits for a range of \
values for c.   We have seen a single once around periodic orbit for c small, \
a single twice around orbit for c slightly larger and a bunch of \
\[OpenCurlyDoubleQuote]almost periodic orbits\[CloseCurlyDoubleQuote] for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", " ", 
    RowBox[{"larger", ".", " "}]}], TraditionalForm]],ExpressionUUID->
  "dbc2f3e9-ca87-4e28-9cae-8c22d4a372da"],
 "  "
}], "Text",
 CellChangeTimes->{{3.999855743934202*^9, 3.999855893891206*^9}, {
  4.000123071232369*^9, 
  4.0001232343900614`*^9}},ExpressionUUID->"6804a1f1-275c-43ae-8189-\
fe9d33960021"],

Cell[CellGroupData[{

Cell[TextData[{
 "Rossler return map and gradient: Function\nSection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalSigma]", "-"], "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["y", "1"], "=", "c"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          SubscriptBox["y", "2"]}], "-", 
         SubscriptBox["y", "3"]}], "<", "0"}]}], "}"}], "\[Subset]", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "3"]}]}], TraditionalForm]],
  ExpressionUUID->"3cc14a62-86b8-4091-b659-22bb6691ff3f"],
 "!"
}], "Subsection",
 CellChangeTimes->{{3.9998557312934685`*^9, 3.9998557347141314`*^9}, {
  3.99985592353244*^9, 3.999855930985836*^9}, {3.9998562764285994`*^9, 
  3.9998562820218644`*^9}, {3.9998573174884915`*^9, 3.9998573364776707`*^9}, {
  3.9998672224335775`*^9, 3.999867267442823*^9}, {3.999934648033987*^9, 
  3.999934649974858*^9}, {3.9999355222384105`*^9, 3.999935525772505*^9}, {
  3.9999360057418118`*^9, 3.999936068269951*^9}, {3.9999418080169415`*^9, 
  3.9999418314846706`*^9}, {4.0000331306472225`*^9, 
  4.00003313241997*^9}},ExpressionUUID->"38b140e0-595d-46e9-868c-\
7c5df0318fb8"],

Cell[TextData[{
 "A once around orbit satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", "=", 
    RowBox[{"p", "(", "q", ")"}]}], TraditionalForm]],ExpressionUUID->
  "4af3b22c-6888-4078-97fd-6b71881d0d0b"],
 ".  In words, a once around orbit is a fixed point of the forward poincare \
map p.  Here is our omnibus function for the return time \[Tau], first return \
map p, and full fixed-time sensitivity ",
 Cell[BoxData[
  FormBox["J", TraditionalForm]],ExpressionUUID->
  "fe39e76a-0b1d-462f-878c-1fb88551b744"],
 ".  "
}], "Text",
 CellChangeTimes->{{4.0001232767404585`*^9, 
  4.000123435557107*^9}},ExpressionUUID->"fbc9fd1e-afd6-44c2-bbfa-\
a8c628076286"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "dyf", ",", "ReturnMapAndTimeAndJ"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", 
    RowBox[{"x", " ", "+", " ", 
     RowBox[{"a", " ", "y"}]}], ",", 
    RowBox[{"b", " ", "+", " ", 
     RowBox[{"z", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dyf", "[", 
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
   RowBox[{"(", GridBox[{
      {"0", 
       RowBox[{"-", "1"}], 
       RowBox[{"-", "1"}]},
      {"1", "a", "0"},
      {"z", "0", 
       RowBox[{"x", "-", "c"}]}
     }], ")"}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ReturnMapAndTimeAndJ", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"f_", ",", "dyf_"}], "}"}]}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"u1_", ",", "u2_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y0", ",", 
      RowBox[{"TMin", "=", "0.001"}], ",", 
      RowBox[{"TMax", "=", "123"}], ",", "\[IndentingNewLine]", "tVal", ",", 
      "yVal", ",", "JVal", ",", "ySol", ",", "JSol", ",", "y", ",", "J", ",", 
      "t"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"y0", "=", 
      RowBox[{"{", 
       RowBox[{"c", ",", "u1", ",", "u2"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tVal", ",", "yVal", ",", "JVal"}], "}"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"Reap", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ySol", ",", "JSol"}], "}"}], "=", " ", 
          RowBox[{"NDSolveValue", "[", " ", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
               RowBox[{
                RowBox[{"f", "[", 
                 RowBox[{"{", 
                  RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", 
                RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
               RowBox[{
                RowBox[{
                 RowBox[{"dyf", "[", 
                  RowBox[{"{", 
                   RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", 
                 RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
                RowBox[{"J", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
              RowBox[{
               RowBox[{"J", "[", "0", "]"}], "==", 
               RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"WhenEvent", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"Indexed", "[", 
                   RowBox[{
                    RowBox[{"y", "[", "t", "]"}], ",", "1"}], "]"}], "-", 
                  "c"}], " ", "<", "0"}], ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"t", ">", "TMin"}], ",", " ", 
                  RowBox[{
                   RowBox[{"Sow", "[", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", 
                    RowBox[{"y", "[", "t", "]"}], ",", 
                    RowBox[{"J", "[", "t", "]"}]}], "}"}], "]"}], ";", " ", 
                   "\"\<StopIntegration\>\""}]}], "]"}]}], "]"}]}], 
             "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{
              "I", " ", "have", " ", "no", " ", "idea", " ", "why", " ", "I", 
               " ", "had", " ", "to", " ", "use", " ", "indexed", " ", 
               "instead", " ", 
               RowBox[{"of", " ", "[", 
                RowBox[{"[", "]"}], "]"}], " ", "in", " ", 
               RowBox[{"here", "!"}]}], " ", "*)"}], "\[IndentingNewLine]", 
             "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"y", ",", "J"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], "]"}]}], ";"}], 
        "\[IndentingNewLine]", "]"}], "\[LeftDoubleBracket]", 
       RowBox[{"2", ",", "1", ",", "1"}], "\[RightDoubleBracket]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9999347480842705`*^9, 3.9999348321501694`*^9}, {
   3.9999349255868273`*^9, 3.9999351569467325`*^9}, {3.9999352480481567`*^9, 
   3.9999353441143*^9}, {3.9999353986570697`*^9, 3.99993545758632*^9}, {
   3.999935939225483*^9, 3.999935939695939*^9}, {3.99993653267871*^9, 
   3.999936777101043*^9}, {3.9999369130065727`*^9, 3.9999369306867266`*^9}, {
   3.999936986210805*^9, 3.9999370081329412`*^9}, {3.999937044356206*^9, 
   3.9999370445888453`*^9}, {3.999937093899308*^9, 3.999937157995822*^9}, {
   3.9999372352396164`*^9, 3.999937352062668*^9}, {3.999937448127112*^9, 
   3.999937452080411*^9}, {3.999937603432396*^9, 3.99993782845669*^9}, {
   3.9999378627471995`*^9, 3.9999378716714315`*^9}, {3.9999416464821672`*^9, 
   3.999941693828122*^9}, {3.999941909638445*^9, 3.9999422424174166`*^9}, {
   3.9999422759495277`*^9, 3.999942276833937*^9}, 3.9999430575942993`*^9, {
   4.000033153154664*^9, 4.0000334409453025`*^9}, {4.0000335021540604`*^9, 
   4.0000335196219215`*^9}, {4.0000336726615186`*^9, 4.00003388106031*^9}, {
   4.0000339335979333`*^9, 4.0000340100421352`*^9}, {4.0000340604023924`*^9, 
   4.000034134948395*^9}, 4.000123449968033*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"0aa1c5ae-4c54-4899-936f-58ea83a54b75"],

Cell["We are looking for the visible fixed point", "Text",
 CellChangeTimes->{{4.000123501521014*^9, 4.0001235517703676`*^9}, {
  4.000199958544743*^9, 
  4.000199963842433*^9}},ExpressionUUID->"1aeb32c0-65cc-4e63-bb6e-\
f78166e7ed20"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"t", ",", "ySol"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "123"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"0.2", ",", "0.2", ",", "2.6"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u0", "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}]}], ";", 
  RowBox[{"y0", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", "c", "}"}], ",", "u0"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"yData", "=", 
   RowBox[{
    RowBox[{"Reap", "[", "\[IndentingNewLine]", 
     RowBox[{"ySol", "=", 
      RowBox[{"NDSolveValue", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
           RowBox[{
            RowBox[{"f", "[", 
             RowBox[{"{", 
              RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", 
            RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
          RowBox[{"WhenEvent", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Indexed", "[", 
               RowBox[{
                RowBox[{"y", "[", "t", "]"}], ",", "1"}], "]"}], "-", "c"}], 
             "<", "0"}], ",", 
            RowBox[{"Sow", "[", 
             RowBox[{"y", "[", "t", "]"}], "]"}]}], "]"}]}], "}"}], ",", "y", 
        ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], 
     "\[IndentingNewLine]", "]"}], "\[LeftDoubleBracket]", 
    RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<3D\>\"", "->", 
     RowBox[{"Show", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ParametricPlot3D", "[", 
        RowBox[{
         RowBox[{"ySol", "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", 
           RowBox[{"0.9", " ", "TMax"}], ",", " ", "TMax"}], "}"}], ",", 
         RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
         RowBox[{"PlotPoints", "->", 
          SuperscriptBox["10", "2"]}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ListPointPlot3D", "[", "yData", "]"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<\[CapitalSigma]\>\"", "->", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"yData", "\[Transpose]"}], ",", 
       RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}]}]}], "}"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{4.0001264000425763`*^9, 4.0001264973222747`*^9}, {
  4.000126559738222*^9, 4.0001265625860567`*^9}, {4.000198396872021*^9, 
