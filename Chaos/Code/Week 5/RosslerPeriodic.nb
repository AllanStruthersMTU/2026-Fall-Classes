             RowBox[{"1", ",", "5"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "4"}], "}"}]}], "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"ContourStyle", "\[Rule]", "Red"}], ",", 
         RowBox[{"ContourLabels", "->", "True"}], ",", 
         RowBox[{"ContourShading", "\[Rule]", "False"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ListContourPlot", "[", 
        RowBox[{
         RowBox[{"FixedPointSweep", "\[LeftDoubleBracket]", 
          RowBox[{"All", ",", "All", ",", "3"}], "\[RightDoubleBracket]"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"Contours", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.5"}], ",", "0", ",", "0.5"}], "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"DataRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "5"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "4"}], "}"}]}], "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"ContourStyle", "\[Rule]", "Blue"}], ",", 
         RowBox[{"ContourLabels", "->", "True"}], ",", 
         RowBox[{"ContourShading", "\[Rule]", "False"}]}], "]"}]}], 
      "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<||p-u||\>\"", "->", 
     RowBox[{"ListContourPlot", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{"Norm", ",", 
         RowBox[{"FixedPointSweep", "\[LeftDoubleBracket]", 
          RowBox[{"All", ",", "All", ",", 
           RowBox[{"2", ";;", "3"}]}], "\[RightDoubleBracket]"}], ",", 
