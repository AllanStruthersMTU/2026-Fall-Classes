Notebook[{

Cell[CellGroupData[{
Cell["Rossller System", "Title",
 CellChangeTimes->{{3.997354396199274*^9, 3.9973544008679843`*^9}, {
   3.9973640967271757`*^9, 3.997364101554268*^9}, 
   3.997364137222814*^9},ExpressionUUID->"ee41a007-0d2f-4b6e-9991-\
30a592e66adf"],

Cell[TextData[{
 "The Rossller system is\n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"x", "'"}], "=", 
      RowBox[{
       RowBox[{"-", "y"}], "-", "z"}]},
     {
      RowBox[{"y", "'"}], "=", 
      RowBox[{"x", "+", 
       RowBox[{"a", " ", "y"}]}]},
     {
      RowBox[{"z", "'"}], "=", 
      RowBox[{"b", "+", 
       RowBox[{"z", "(", 
        RowBox[{"x", "-", "c"}], ")"}]}]}
    }], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f4b5cd3d-7569-4ed6-aff1-ad6192d0651d"],
 "\nThe std parameters are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", 
    RowBox[{"b", "=", "0.2"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1265eb83-5ce1-4039-bfb9-c59a8a1e8bef"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "5.7"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c4f7e62a-3d68-49de-a662-054273d1d568"]
}], "Text",
 CellChangeTimes->{{3.9973641202215724`*^9, 
  3.9973642574753475`*^9}},ExpressionUUID->"7bab88ac-22cf-4a44-8da6-\
7fcdf24807d3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "Ross", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "123"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ross", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", 
    RowBox[{"x", "+", 
     RowBox[{"a", " ", "y"}]}], ",", " ", 
    RowBox[{"b", " ", "+", " ", 
     RowBox[{"z", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"0.2", ",", "0.2", ",", "5.7"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wSol", "=", " ", 
   RowBox[{"NDSolveValue", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"w", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"Ross", "[", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", 
         RowBox[{"w", "[", "t", "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"w", "[", "0", "]"}], "==", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "3"}], "}"}]}]}], "}"}], ",", "w", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot3D", "[", 
  RowBox[{
   RowBox[{"wSol", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
   RowBox[{"PlotPoints", "->", "100"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9973561272664976`*^9, 3.9973561584379663`*^9}, {
  3.9973561972985973`*^9, 3.997356366972727*^9}, {3.9973565111319265`*^9, 
  3.997356640103677*^9}, {3.997356677807105*^9, 3.99735668691706*^9}, {
  3.997364260943674*^9, 3.997364409836938*^9}},
 CellLabel->
  "In[100]:=",ExpressionUUID->"63d877aa-110e-4be5-a816-57a9ed8232c6"],

