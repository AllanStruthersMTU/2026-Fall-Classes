Cell[TextData[{
 "Think about this as \n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"y", "'"}], "=", 
      RowBox[{"f", "(", "y", ")"}], "with", 
      RowBox[{
       RowBox[{"y", "(", "0", ")"}], "=", "x"}]}
    }], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ebbcdb78-a73d-48a6-abd8-989f344a365e"],
 "\nThis defines a function of t and x say  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "(", 
    RowBox[{"t", ",", "x"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f67b1e6d-8ea6-4776-b72c-bffce6598861"],
 " which we can partial differentiate with respect to x!  \nWe can \
differentiate the ODE with respect to the vector of initial conditions ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "be9473e0-95ad-4cd6-a44c-3c4d44f9aaea"],
 ".   We are going to work through this slowly!\n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{
       SubscriptBox["\[Del]", "x"], 
       RowBox[{"y", "'"}]}], "=", 
      RowBox[{
       SubscriptBox["\[Del]", "x"], 
       RowBox[{"(", 
        RowBox[{"f", "(", "y", ")"}], ")"}]}], "with", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "x"], 
        RowBox[{"y", "(", "0", ")"}]}], "=", 
       RowBox[{
        SubscriptBox["\[Del]", "x"], "x"}]}]}
    }], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "851d7015-4d4b-4cd3-bf46-ad526234d7ea"],
 ".\nIf we interchange the order of differentiation, apply the chain rule and \
think about the initial conditions we get\n\t ",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Del]", "x"], "y"}], ")"}], "'"}], "=", 
      RowBox[{
       RowBox[{"Df", "(", "y", ")"}], 
       RowBox[{
        SubscriptBox["\[Del]", "x"], 
        RowBox[{"(", "y", ")"}]}]}], "with", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "x"], 
        RowBox[{"y", "(", "0", ")"}]}], "=", "Id"}]}
    }], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "537fe658-3901-4435-bb19-32c00c08fa85"],
 ".\nAll we have to do now is decide to call the Jacobian ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", "x"], "y"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1b879d46-5054-4706-8474-05b6d786967e"],
 " a reasonable name like ",
 Cell[BoxData[
  FormBox["J", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5913403a-85d6-451e-91de-679f1a9190ac"],
 " to get\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{GridBox[{
      {
       RowBox[{"J", "'"}], "=", 
       RowBox[{
        RowBox[{"Df", "(", "y", ")"}], "J"}], "with", 
       RowBox[{
        RowBox[{"J", "(", "0", ")"}], "=", "Id"}]}
     }], "."}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3260abee-fae9-49b2-bf0a-3d29808aada7"],
 "\nThis is an IVP for the sensitivity of the solution at any time t with \
respect to the initial condition x. "
}], "Text",
 CellChangeTimes->{{3.9973644262440987`*^9, 3.99736460959132*^9}, {
  3.99736542715547*^9, 3.997365748113763*^9}, {3.997365895321313*^9, 
  3.997365945134696*^9}, {3.9973659931984158`*^9, 
  3.997366189438364*^9}},ExpressionUUID->"3952da3b-be6c-44e7-a5cf-\
5d1a983dff38"],

Cell["Shockingly it is called the \[OpenCurlyDoubleQuote]sensitivity equation\
\[CloseCurlyDoubleQuote].", "Text",
 CellChangeTimes->{{3.9973661954051175`*^9, 
  3.9973662118102484`*^9}},ExpressionUUID->"0b285856-5f95-45d8-a751-\
7878542ad334"],

Cell[BoxData[""], "Input",ExpressionUUID->"1bdb7f44-4b42-4ea2-b1ce-dbc5f1642376"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "Ross", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "22"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ross", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", 
    RowBox[{"x", "+", 
     RowBox[{"a", " ", "y"}]}], ",", " ", 
    RowBox[{"b", " ", "+", " ", 
     RowBox[{"z", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dRoss", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "a", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", 
      RowBox[{
       RowBox[{"-", "c"}], "+", "x"}]}], "}"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"0.2", ",", "0.2", ",", "5.7"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Id", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wSol", "=", " ", 
   RowBox[{"NDSolveValue", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"w", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"Ross", "[", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", 
         RowBox[{"w", "[", "t", "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"w", "[", "0", "]"}], "==", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "3"}], "}"}]}]}], "}"}], ",", "w", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"JSol", "=", 
  RowBox[{"NDSolveValue", "[", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{
         RowBox[{"dRoss", "[", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", 
         RowBox[{"wSol", "[", "t", "]"}], "]"}], ".", 
        RowBox[{"J", "[", "t", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"J", "[", "0", "]"}], "==", "Id"}]}], "}"}], ",", "J", ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot3D", "[", 
  RowBox[{
   RowBox[{"wSol", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
   RowBox[{"PlotPoints", "->", "100"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"wSol", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
   RowBox[{"PlotPoints", "->", "100"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"LogPlot", "[", 
  RowBox[{
   RowBox[{"SingularValueList", "[", 
    RowBox[{"JSol", "[", "t", "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9973561272664976`*^9, 3.9973561584379663`*^9}, {
  3.9973561972985973`*^9, 3.997356366972727*^9}, {3.9973565111319265`*^9, 
