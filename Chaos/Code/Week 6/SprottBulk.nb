Cell["\<\
I put them in an association rather than a list.  The delayed assignment \
\[RuleDelayed] means the right hand side is not evaluated until called. An \
association means you can call things out by name.  This matches up directly \
with dictionaries in Julia, Python, and MATLAB.   All also have some type of \
lower level \[OpenCurlyDoubleQuote]struct\[CloseCurlyDoubleQuote] \
construction. \
\>", "Text",
 CellChangeTimes->{{4.0001956970688405`*^9, 4.0001957540613422`*^9}, {
  4.0001969109263287`*^9, 4.000196941961935*^9}, {4.000202689793105*^9, 
  4.0002027411719456`*^9}, {4.0002027882734413`*^9, 
  4.000202828254903*^9}},ExpressionUUID->"1f01e76b-f404-4cab-a833-\
79d24c910925"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"hmm", "=", 
  RowBox[{"Sprott", "[", "22", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"hmm", "[", "\"\<par\>\"", "]"}]}], "Input",
 CellChangeTimes->{{4.000195355264862*^9, 4.0001953670954103`*^9}, {
  4.0001956512945194`*^9, 4.0001956678187666`*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"40d7fa3a-d1e7-42c5-a31d-3fab8c5b0c97"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"fun\"\>", "\[RuleDelayed]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "a"}], " ", 
      RowBox[{"y", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], 
     "-", 
     RowBox[{"b", " ", 
      RowBox[{"y", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
     "+", 
     RowBox[{"c", " ", 
      RowBox[{"y", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
     "+", 
     RowBox[{"d", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"y", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
       "]"}]}]}]}], ",", 
   RowBox[{"\<\"par\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.2`", ",", "1", ",", "0", ",", "1", ",", "50"}], "}"}]}], ",", 
   RowBox[{"\<\"IC\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "0"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{{4.0001953677668724`*^9, 4.0001953901787972`*^9}, {
  4.000195632058817*^9, 4.0001956687239695`*^9}},
 CellLabel->"Out[21]=",ExpressionUUID->"ab1cf211-ecc8-4c8e-ae4c-7c5ee101d723"],

