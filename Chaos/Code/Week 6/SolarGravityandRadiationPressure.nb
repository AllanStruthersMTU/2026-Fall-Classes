Cell[CellGroupData[{

Cell["Solar Gravity", "Section",
 CellChangeTimes->{{4.00108033028469*^9, 
  4.001080335223317*^9}},ExpressionUUID->"790675c4-669c-4f6d-ae64-\
58fab50f8c45"],

Cell["\<\
The excess gravitation from the sun oscillates on the lunar time scale  It \
has eigenvalues 2 and -1.  The net effect is outwards but it is at times \
inwards.   \
\>", "Text",
 CellChangeTimes->{{4.0010802054706917`*^9, 
  4.0010803190633297`*^9}},ExpressionUUID->"e39199d5-eafa-463b-82a6-\
