  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dt", ",", " ", "TMax"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"0.1", ",", "234"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ySolP", ",", "JSolP"}], "}"}], ",", 
    RowBox[{"{", "RsP", "}"}]}], "}"}], "=", 
  RowBox[{"LyapunovExpsP", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"f", "[", "p", "]"}], ",", 
      RowBox[{"dyf", "[", "p", "]"}], ",", "y0"}], "}"}], ",", 
    RowBox[{"{", 
