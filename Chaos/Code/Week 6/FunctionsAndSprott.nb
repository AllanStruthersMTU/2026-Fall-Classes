Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"a", ",", "b", ",", "c", ",", "y", ",", "t"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"sol", "=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
       RowBox[{"a", "[", "t", "]"}]}], ",", 
      RowBox[{"WhenEvent", "[", 
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{"t", ",", "1"}], "]"}], ",", 
        RowBox[{
         RowBox[{"a", "[", "t", "]"}], "->", 
         RowBox[{"y", "[", "t", "]"}]}]}], "]"}], ",", 
      RowBox[{
       RowBox[{"y", "[", "0", "]"}], "==", "1"}], ",", 
      RowBox[{
       RowBox[{"a", "[", "0", "]"}], "==", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", "a"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "4"}], "}"}], ",", 
    RowBox[{"DiscreteVariables", "->", 
     RowBox[{"{", "a", "}"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.0009072151881323`*^9, 4.0009072280385036`*^9}},
 CellLabel->
