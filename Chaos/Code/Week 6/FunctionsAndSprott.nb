Cell[CellGroupData[{

Cell["Loops", "Subsubsection",
 CellChangeTimes->{{4.000460884491954*^9, 4.000460901648095*^9}, {
  4.000538289798253*^9, 4.0005382950039787`*^9}, {4.000538924981372*^9, 
  4.0005389289451847`*^9}, {4.0006291977359333`*^9, 4.0006292078830175`*^9}, {
  4.0007221225217295`*^9, 4.000722133123322*^9}, {4.000722860128234*^9, 
  4.0007228628644648`*^9}, {4.0007241403062162`*^9, 4.000724143723923*^9}, {
  4.000724480672349*^9, 4.0007244817540827`*^9}, {4.000726271989316*^9, 
  4.0007262748329954`*^9}},ExpressionUUID->"8ff7f7dc-6845-419e-b0f7-\
292b30a13701"],

Cell[TextData[{
 "For a triple loop we want to solve \n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      SubscriptBox["u", "2"], "=", 
      RowBox[{"p", 
       RowBox[{"(", 
        SubscriptBox["u", "1"], ")"}]}]},
     {
      SubscriptBox["u", "3"], "=", 
      RowBox[{"p", "(", 
       SubscriptBox["u", "2"], ")"}]},
     {
      SubscriptBox["u", "1"], "=", 
      RowBox[{"p", "(", 
       SubscriptBox["u", "3"], ")"}]}
    }], TraditionalForm]],ExpressionUUID->
  "ef3925dc-5a78-4f43-b861-a1a5ca00528b"],
 "\nfor the return map p.  Apply Newton\[CloseCurlyQuote]s method to \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", GridBox[{
       {
        SubscriptBox["u", "1"]},
       {
        SubscriptBox["u", "2"]},
       {
        SubscriptBox["u", "3"]}
      }], ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", GridBox[{
         {
          RowBox[{"p", "(", 
           SubscriptBox["u", "1"], ")"}]},
         {
          RowBox[{"p", "(", 
           SubscriptBox["u", "2"], ")"}]},
         {
          RowBox[{"p", "(", 
           SubscriptBox["u", "3"], ")"}]}
        }], ")"}], "-", 
      RowBox[{"(", GridBox[{
         {
          SubscriptBox["u", "2"]},
         {
          SubscriptBox["u", "1"]},
         {
          SubscriptBox["u", "3"]}
        }], ")"}]}], "=", 
     RowBox[{"(", GridBox[{
        {"0"},
        {"0"},
        {"0"}
       }], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "65d9843f-8b8c-446c-954a-af88f4826f78"],
 "\nto get the iteration \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "new"], "=", 
    RowBox[{
     SubscriptBox["w", "old"], "-", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Dg", "(", 
        SubscriptBox["w", "old"], ")"}], 
       RowBox[{"-", "1"}]], 
      RowBox[{"g", "(", 
       SubscriptBox["w", "old"], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"98a88c7b-3ab6-463c-a0b1-1c0e66e2a6ba"],
 "\nwhere \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"w", "=", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["u", "1"]},
       {
        SubscriptBox["u", "2"]},
       {
        SubscriptBox["u", "3"]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "46cce751-b52e-4ccb-b45c-32a2050eb070"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Dg", "(", 
     RowBox[{"(", GridBox[{
        {
         SubscriptBox["u", "1"]},
        {
         SubscriptBox["u", "2"]},
        {
         SubscriptBox["u", "3"]}
       }], ")"}], ")"}], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"Dp", "(", 
         SubscriptBox["u", "1"], ")"}], 
        RowBox[{"-", "Id"}], "0"},
       {"0", 
        RowBox[{"Dp", "(", 
         SubscriptBox["u", "2"], ")"}], 
        RowBox[{"-", "Id"}]},
       {
        RowBox[{"-", "Id"}], "0", 
        RowBox[{"Dp", "(", 
         SubscriptBox["u", "3"], ")"}]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "716b5a99-037d-415b-b0d4-1cd4be867d7a"],
 "\nWe are going to build code to try to compute a general cycle starting \
from a decent initial guess. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Us", "=", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["u", "1"], ",", 
      SubscriptBox["u", "2"], ",", "\[Ellipsis]", ",", 
      SubscriptBox["u", "m"]}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "e1c90b15-4b64-467b-ade9-f526e87e152e"],
 " each in the coordinates given by a set of tangents. If we do this right we \
can set it up to do any number of loops in any number of dimensions! We need \
to do some planning :)  Here is a skeleton. "
}], "Text",
 CellChangeTimes->{{4.0005614722004504`*^9, 4.0005615343739376`*^9}, {
  4.000561590772004*^9, 4.000561760468672*^9}, {4.0006300071500416`*^9, 
  4.000630042159374*^9}, {4.000722137488967*^9, 4.0007223254587994`*^9}, {
  4.000722397582649*^9, 4.0007224117709045`*^9}, {4.0007238991926317`*^9, 
  4.0007239202504573`*^9}, {4.0007244893016577`*^9, 4.0007247878467426`*^9}, {
  4.0007248179118357`*^9, 4.0007248192083836`*^9}, {4.000724930330272*^9, 
  4.000724936958984*^9}, {4.000724982534488*^9, 4.0007249978034115`*^9}, {
  4.000725087861233*^9, 4.000725125129575*^9}, {4.0007252773778286`*^9, 
  4.000725283524063*^9}, {4.0007262816487904`*^9, 4.000726474818097*^9}, {
  4.000726550552108*^9, 4.0007265512709856`*^9}, {4.0007266624579535`*^9, 
  4.000726687411171*^9}, {4.000902415651455*^9, 4.000902445489445*^9}, {
  4.000902554385575*^9, 4.0009026050486784`*^9}, {4.000902803999735*^9, 
  4.000902808559183*^9}},ExpressionUUID->"a5ceab86-bf55-48a3-ac29-\
75a38ae38f04"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NewtonCycle", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "dyf_", ",", "Us_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"T_", ",", "n_", ",", "p0_"}], "}"}], ",", " ", "MaxIter_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m", "=", 
       RowBox[{"Length", "[", "Us", "]"}]}], ",", "err", ",", 
      RowBox[{"TMax", "=", 
       SuperscriptBox["10", "3"]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "We", " ", "need", " ", "to", " ", "compute", " ", "the", " ", "steps", 
      " ", "for", " ", "each", " ", "u", " ", "in", " ", "Us"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\[Tau]pJDpSection", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"f", ",", "dyf", ",", 
           RowBox[{"p0", "+", 
            RowBox[{"T", ".", 
             RowBox[{
             "Us", "\[LeftDoubleBracket]", "i", 
              "\[RightDoubleBracket]"}]}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"T", ",", "n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "We", " ", "need", " ", "to", " ", "build", " ", "the", " ", "big", 
         " ", "matrix"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Dg", " ", "=", " ", 
        RowBox[{"ArrayFlatten", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "we", " ", "need", " ", "to", " ", "assemble", " ", "the", " ", 
        "right", " ", "hand", " ", "side"}], " ", "*)"}], ";"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "We", " ", "need", " ", "to", " ", "update", " ", "the", " ", "u", " ", 
       "values"}], " ", "*)"}], ";"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "We", " ", "need", " ", "to", " ", "return", " ", "the", " ", "updated", 
     " ", "and", " ", "assembledd", " ", "Us"}], " ", "*)"}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{4.0007264830644083`*^9, 4.0007266018764806`*^9}, {
  4.000733786802075*^9, 4.0007338188649406`*^9}, {4.0007338549429398`*^9, 
  4.0007338661464996`*^9}, {4.000733930770252*^9, 4.0007341453752227`*^9}, {
  4.000734298837468*^9, 4.0007342996467075`*^9}, {4.000734333381173*^9, 
  4.0007343409736395`*^9}, {4.0007344955525484`*^9, 4.0007345109116488`*^9}, {
  4.000902630301996*^9, 
  4.000902800632558*^9}},ExpressionUUID->"b2060319-9aca-4d55-8ee5-\
bb923103ed18"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Lyapunov Computation", "Subsection",
 CellChangeTimes->{{4.000460884491954*^9, 4.000460901648095*^9}, {
  4.000538289798253*^9, 4.0005382950039787`*^9}, {4.000538924981372*^9, 
  4.0005389289451847`*^9}, {4.0006291977359333`*^9, 4.0006292078830175`*^9}, {
  4.0007221225217295`*^9, 4.000722133123322*^9}, {4.000722860128234*^9, 
