Cell[CellGroupData[{

Cell["Plane Section Solvers", "Subsection",
 CellChangeTimes->{{4.000460884491954*^9, 4.000460901648095*^9}, {
  4.000538289798253*^9, 4.0005382950039787`*^9}, {4.000538924981372*^9, 
  4.0005389289451847`*^9}},ExpressionUUID->"d5d6a403-15dd-4a1c-ab21-\
b4f0c0d64341"],

Cell[TextData[{
 "These return a solution function y and all the points on the plane ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", ".", 
     RowBox[{"(", 
      RowBox[{"p", "-", 
       SubscriptBox["p", "0"]}], ")"}]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"b8fb7d61-8713-4833-962f-b624c4f10415"],
 " for any IVP (defined by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{"f", "(", "y", ")"}]}], TraditionalForm]],ExpressionUUID->
  "59208d77-8a01-42a8-982f-b53b8f9d50b1"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"y", "(", "0", ")"}], "=", "IC"}], ")"}], " "}], 
   TraditionalForm]],ExpressionUUID->"8120c482-c23d-494b-8fa1-4c2ad91b203d"],
 "and TMax.  We are going to assume ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"||", "n", "||"}], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6d4f11ad-a263-4562-a6a4-879cfaeaf5b7"],
 ". Discard early points to see the long time behavior.  The output of the \
first is a list comprised of the interpolating function and a list (with an \
extra set of curly braces) of the points."
}], "Text",
 CellChangeTimes->{{4.000538297491363*^9, 4.0005384531031184`*^9}, {
  4.0005395717279882`*^9, 4.000539693066451*^9}, {4.00053980810003*^9, 
  4.000539838622551*^9}, {4.0005401538776417`*^9, 4.000540179357362*^9}, {
  4.0006284409460254`*^9, 4.000628452256837*^9}, {4.0006291100555634`*^9, 
  4.0006291251918736`*^9}},ExpressionUUID->"1ed00efe-5f92-42d7-a801-\
19bf9943a284"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BasicSectionSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "y0_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"n_", ",", "p0_"}], "}"}], ",", "TMax_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "y", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Reap", "[", 
     RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"f", "[", 
           RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", " ", 
         RowBox[{"WhenEvent", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"n", ".", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"y", "[", "t", "]"}], "-", "p0"}], ")"}]}], ">", "0"}],
            ",", " ", 
           RowBox[{"Sow", "[", 
            RowBox[{"y", "[", "t", "]"}], "]"}]}], "]"}]}], "}"}], ",", " ", 
       "\[IndentingNewLine]", "y", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}], " ", 
     "]"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.000538459847807*^9, 4.0005386125703583`*^9}, {
   4.000538667823256*^9, 4.0005386716851063`*^9}, {4.000538792318755*^9, 
   4.0005387939292984`*^9}, {4.0005394944534883`*^9, 
   4.0005395046432047`*^9}, {4.000539698860812*^9, 4.0005397995590596`*^9}, 
   4.000539842862174*^9, {4.000561434973567*^9, 4.000561456917763*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"4428a872-ea9c-4c81-8aa0-10b674b7052d"],

Cell["\<\
Different planes are good for different ones of our Sprott problems.\
\>", "Text",
 CellChangeTimes->{{4.000629269665199*^9, 
  4.000629306786192*^9}},ExpressionUUID->"6098c988-e901-4b4d-9982-\
5fb35c2df5db"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"k", "=", "1"}], ";", 
   RowBox[{"y0", "=", 
    RowBox[{
     RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<IC\>\"", "]"}]}], ";", 
   RowBox[{"p", "=", 
    RowBox[{
     RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<par\>\"", "]"}]}], ";", 
   RowBox[{"f", "=", 
    RowBox[{"fSprott", "[", 
     RowBox[{"k", ",", "p"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Testing", " ", "new", " ", "code"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "123"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"-", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "/", 
       SqrtBox["2"]}], ",", 
      RowBox[{"1", "/", 
       SqrtBox["2"]}], ",", "0"}], "}"}]}]}], ";", " ", 
  RowBox[{"p0", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SectionPic", "=", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"n", ".", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}], "-", "p0"}], ")"}]}], "==",
       "0"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
     RowBox[{"ContourStyle", "\[Rule]", 
      RowBox[{"Opacity", "[", "0.5", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ySol", ",", 
     RowBox[{"{", "yPts", "}"}]}], "}"}], "=", 
   RowBox[{"BasicSectionSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f", ",", "y0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"SectionPic", ",", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"ySol", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ListPointPlot3D", "[", 
    RowBox[{"yPts", ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.000538767544372*^9, 4.000538782613161*^9}, {
   4.0005388140933943`*^9, 4.0005388660330963`*^9}, {4.0005398498297863`*^9, 
