5066b4dbc66b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TMax", "=", "123"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"-", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "0"}], "}"}]}]}], ";", " ", 
  RowBox[{"p0", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SectionPic", "=", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"n", ".", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}], "-", "p0"}], ")"}]}], "==",
       "0"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
     RowBox[{"ContourStyle", "\[Rule]", 
      RowBox[{"Opacity", "[", "0.5", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k", "=", "1"}], ";", 
  RowBox[{"y0", "=", 
   RowBox[{
    RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<IC\>\"", "]"}]}], ";", 
  RowBox[{"p", "=", 
   RowBox[{
    RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<par\>\"", "]"}]}], ";", 
  RowBox[{"f", "=", 
   RowBox[{"fSprott", "[", 
    RowBox[{"k", ",", "p"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ySol", ",", 
     RowBox[{"{", "yPts", "}"}]}], "}"}], "=", 
   RowBox[{"BasicSectionSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f", ",", "y0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"SectionPic", ",", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"ySol", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ListPointPlot3D", "[", 
    RowBox[{"yPts", ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.000538767544372*^9, 4.000538782613161*^9}, {
   4.0005388140933943`*^9, 4.0005388660330963`*^9}, {4.0005398498297863`*^9, 
   4.000540110092603*^9}, {4.0005401439763775`*^9, 4.000540147010435*^9}, {
