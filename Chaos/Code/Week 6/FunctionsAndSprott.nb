Cell[TextData[{
 "There is only one equilibrium point for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'''"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "c"}], " ", "y"}], "+", 
     RowBox[{"b", " ", "yp"}], "+", 
     RowBox[{"d", " ", 
      SuperscriptBox["yp", "2"]}], "-", 
     RowBox[{"a", " ", "ypp", " "}]}]}], TraditionalForm]],ExpressionUUID->
  "ed45663f-3265-4b55-8eba-703e00947d1a"],
 " it is at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], TraditionalForm]],
  ExpressionUUID->"3348c2d1-3fbc-4c58-96b9-0c0f0a1e8e5c"],
 "!  The linearized system about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], TraditionalForm]],
  ExpressionUUID->"7f856f3a-671c-4683-b530-82a380c90f32"],
 " is\n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"w", "'"}], "=", 
      RowBox[{
       RowBox[{"(", "\[NoBreak]", GridBox[{
          {"0", "1", "0"},
          {"0", "0", "1"},
          {
           RowBox[{"-", "c"}], "b", 
           RowBox[{"-", "a"}]}
         }], "\[NoBreak]", ")"}], "w"}]}
