Cell["\<\
Different sections and ranges are going to get good pictures.  Here is some \
idea of the long term behavior\
\>", "Text",
 CellChangeTimes->{{4.000540693148052*^9, 
  4.0005408101016045`*^9}},ExpressionUUID->"d42d72cc-ea56-417a-9d98-\
ca8a3aacda81"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TMax", "=", 
   SuperscriptBox["10", "4"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k", "=", "1"}], ";", 
  RowBox[{"y0", "=", 
   RowBox[{
    RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<IC\>\"", "]"}]}], ";", 
  RowBox[{"p", "=", 
   RowBox[{
    RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<par\>\"", "]"}]}], ";", 
  RowBox[{"f", "=", 
   RowBox[{"fSprott", "[", 
    RowBox[{"k", ",", "p"}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<fun\>\"", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"-", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "0"}], "}"}]}]}], ";", " ", 
  RowBox[{"p0", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ySol", ",", 
     RowBox[{"{", "yPts", "}"}]}], "}"}], "=", 
   RowBox[{"BasicSectionSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f", ",", "y0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"M", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SectionPic", "=", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"n", ".", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}], "-", "p0"}], ")"}]}], "==",
       "0"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "M"}], ",", "M"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "M"}], ",", "M"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{"-", "M"}], ",", "M"}], "}"}], ",", 
     RowBox[{"ContourStyle", "\[Rule]", 
      RowBox[{"Opacity", "[", "0.5", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<Sol\>\"", "->", 
     RowBox[{"Show", "[", 
      RowBox[{"SectionPic", ",", 
       RowBox[{"ParametricPlot3D", "[", 
        RowBox[{
         RowBox[{"ySol", "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "TMax"}], "}"}], ",", 
         RowBox[{"PlotPoints", "->", 
          SuperscriptBox["10", "3"]}], ",", 
         RowBox[{"PlotStyle", "->", "Thin"}]}], "]"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<3D Section\>\"", "->", 
     RowBox[{"Show", "[", 
      RowBox[{"SectionPic", ",", "\[IndentingNewLine]", 
       RowBox[{"ListPointPlot3D", "[", 
        RowBox[{"yPts", ",", 
         RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotLabel", "\[Rule]", 
        RowBox[{"StringForm", "[", 
         RowBox[{"\"\<`` points\>\"", ",", 
          RowBox[{"Length", "[", "yPts", "]"}]}], "]"}]}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<2D Section\>\"", "->", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"yPts", "\[LeftDoubleBracket]", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3"}], "}"}]}], "\[RightDoubleBracket]"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"AxesLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "\"\<\!\(\*SubscriptBox[\(y\), \(1\)]\)\>\"", ",", 
          "\"\<\!\(\*SubscriptBox[\(y\), \(3\)]\)\>\""}], "}"}]}]}], "]"}]}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<2D Section\>\"", "->", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"yPts", "\[LeftDoubleBracket]", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "\[RightDoubleBracket]"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"AxesLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "\"\<\!\(\*SubscriptBox[\(y\), \(2\)]\)\>\"", ",", 
          "\"\<\!\(\*SubscriptBox[\(y\), \(3\)]\)\>\""}], "}"}]}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "}"}], "]"}]}], "Input",
 CellChangeTimes->{{4.000540819130955*^9, 4.0005408480232153`*^9}, {
  4.000540879211157*^9, 4.0005413509277153`*^9}, {4.000541698580592*^9, 
  4.0005417121976724`*^9}},
 CellLabel->
  "In[466]:=",ExpressionUUID->"a7e731c9-423f-4f93-9160-35bfd7d1eb43"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", "c"}], " ", "y"}], "+", 
  RowBox[{"b", " ", "yp"}], "+", 
  RowBox[{"d", " ", 
   SuperscriptBox["yp", "2"]}], "-", 
  RowBox[{"a", " ", "ypp"}]}]], "Output",
