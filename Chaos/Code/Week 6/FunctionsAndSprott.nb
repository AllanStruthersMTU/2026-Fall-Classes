Cell[BoxData[
 RowBox[{
  RowBox[{"NewtonCycle", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "dyf_", ",", "Us_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"T_", ",", "n_", ",", "p0_"}], "}"}], ",", " ", "MaxIter_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m", "=", 
       RowBox[{"Length", "[", "Us", "]"}]}], ",", "err", ",", 
      RowBox[{"TMax", "=", 
       SuperscriptBox["10", "3"]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Tau]pJDPs", "=", " ", 
      RowBox[{"Table", "[", " ", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Tau]pJDpSection", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"f", ",", "dyf", ",", 
            RowBox[{"p0", "+", 
             RowBox[{"T", ".", 
              RowBox[{
              "Us", "\[LeftDoubleBracket]", "i", 
               "\[RightDoubleBracket]"}]}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"T", ",", "n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", "m"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ps", ",", " ", "DPs"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Tau]pJDs", "\[LeftDoubleBracket]", 
         RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
        RowBox[{"\[Tau]pJDs", "\[LeftDoubleBracket]", 
         RowBox[{"All", ",", "4"}], "\[RightDoubleBracket]"}]}], "}"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{4.0007264830644083`*^9, 4.0007266018764806`*^9}, {
