          RowBox[{"Sow", "[", 
           RowBox[{"Diagonal", "[", "R", "]"}], "]"}], ";", 
          RowBox[{
           RowBox[{"J", "[", "t", "]"}], "->", 
           RowBox[{"Q", "\[Transpose]"}]}]}]}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
