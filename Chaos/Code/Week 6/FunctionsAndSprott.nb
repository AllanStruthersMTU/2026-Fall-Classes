        RowBox[{"J", "[", "0", "]"}], "==", "Id"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"WhenEvent", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"t", ",", "dt"}], "]"}], "==", "0"}], ",", 
