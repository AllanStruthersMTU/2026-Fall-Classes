Cell[CellGroupData[{

Cell["Loops", "Subsubsection",
 CellChangeTimes->{{4.000460884491954*^9, 4.000460901648095*^9}, {
  4.000538289798253*^9, 4.0005382950039787`*^9}, {4.000538924981372*^9, 
  4.0005389289451847`*^9}, {4.0006291977359333`*^9, 4.0006292078830175`*^9}, {
  4.0007221225217295`*^9, 4.000722133123322*^9}, {4.000722860128234*^9, 
  4.0007228628644648`*^9}, {4.0007241403062162`*^9, 4.000724143723923*^9}, {
  4.000724480672349*^9, 4.0007244817540827`*^9}, {4.000726271989316*^9, 
  4.0007262748329954`*^9}},ExpressionUUID->"8ff7f7dc-6845-419e-b0f7-\
292b30a13701"],

Cell[TextData[{
 "For a triple loop we want to solve \n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      SubscriptBox["u", "2"], "=", 
      RowBox[{"p", 
       RowBox[{"(", 
        SubscriptBox["u", "1"], ")"}]}]},
     {
      SubscriptBox["u", "3"], "=", 
      RowBox[{"p", "(", 
       SubscriptBox["u", "2"], ")"}]},
     {
      SubscriptBox["u", "1"], "=", 
      RowBox[{"p", "(", 
       SubscriptBox["u", "3"], ")"}]}
    }], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ef3925dc-5a78-4f43-b861-a1a5ca00528b"],
 "\nfor the return map p.  Apply Newton\[CloseCurlyQuote]s method to \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", GridBox[{
       {
        SubscriptBox["u", "1"]},
       {
        SubscriptBox["u", "2"]},
       {
        SubscriptBox["u", "3"]}
      }], ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", GridBox[{
         {
          RowBox[{"p", "(", 
           SubscriptBox["u", "1"], ")"}]},
         {
          RowBox[{"p", "(", 
           SubscriptBox["u", "2"], ")"}]},
         {
          RowBox[{"p", "(", 
           SubscriptBox["u", "3"], ")"}]}
        }], ")"}], "-", 
      RowBox[{"(", GridBox[{
         {
          SubscriptBox["u", "2"]},
         {
          SubscriptBox["u", "1"]},
         {
          SubscriptBox["u", "3"]}
        }], ")"}]}], "=", 
     RowBox[{"(", GridBox[{
        {"0"},
        {"0"},
        {"0"}
       }], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "65d9843f-8b8c-446c-954a-af88f4826f78"],
 "\nto get the iteration \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "new"], "=", 
    RowBox[{
     SubscriptBox["w", "old"], "-", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Dg", "(", 
        SubscriptBox["w", "old"], ")"}], 
       RowBox[{"-", "1"}]], 
      RowBox[{"g", "(", 
       SubscriptBox["w", "old"], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "98a88c7b-3ab6-463c-a0b1-1c0e66e2a6ba"],
 "\nwhere \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"w", "=", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["u", "1"]},
       {
        SubscriptBox["u", "2"]},
       {
        SubscriptBox["u", "3"]}
      }], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "46cce751-b52e-4ccb-b45c-32a2050eb070"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Dg", "(", 
     RowBox[{"(", GridBox[{
        {
         SubscriptBox["u", "1"]},
        {
         SubscriptBox["u", "2"]},
        {
         SubscriptBox["u", "3"]}
       }], ")"}], ")"}], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"Dp", "(", 
         SubscriptBox["u", "1"], ")"}], 
        RowBox[{"-", "Id"}], "0"},
       {"0", 
        RowBox[{"Dp", "(", 
         SubscriptBox["u", "2"], ")"}], 
        RowBox[{"-", "Id"}]},
       {
        RowBox[{"-", "Id"}], "0", 
        RowBox[{"Dp", "(", 
         SubscriptBox["u", "3"], ")"}]}
      }], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "716b5a99-037d-415b-b0d4-1cd4be867d7a"],
 "\nWe are going to build code to try to compute a general cycle starting \
from a decent initial guess. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Us", "=", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["u", "1"], ",", 
      SubscriptBox["u", "2"], ",", "\[Ellipsis]", ",", 
      SubscriptBox["u", "m"]}], "}"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e1c90b15-4b64-467b-ade9-f526e87e152e"],
 "."
}], "Text",
 CellChangeTimes->{{4.0005614722004504`*^9, 4.0005615343739376`*^9}, {
  4.000561590772004*^9, 4.000561760468672*^9}, {4.0006300071500416`*^9, 
  4.000630042159374*^9}, {4.000722137488967*^9, 4.0007223254587994`*^9}, {
  4.000722397582649*^9, 4.0007224117709045`*^9}, {4.0007238991926317`*^9, 
