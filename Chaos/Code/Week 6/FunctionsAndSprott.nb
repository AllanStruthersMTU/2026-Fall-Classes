         RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<par\>\"", "]"}]}], 
       "]"}], "[", 
      RowBox[{"{", 
       RowBox[{"y", ",", "yp", ",", "ypp"}], "}"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"dyfSprott", "[", "k", "]"}], "[", 
      RowBox[{"{", 
