Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"LyapunovExpsNP", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "df_", ",", "y0_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"dt_", ",", "TMax_"}], "}"}]}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "y0", "]"}]}], ",", "Q0", ",", "R"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Q0", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"QRDecomposition", "[", 
         RowBox[{"RandomReal", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "n"}], "}"}]}], "]"}], "]"}], 
        "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
       "\[Transpose]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Reap", "[", "\[IndentingNewLine]", 
      RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
           RowBox[{"f", "[", 
            RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
           RowBox[{
            RowBox[{"df", "[", 
             RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
            RowBox[{"J", "[", "t", "]"}]}]}], ",", " ", 
          RowBox[{
           RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", " ", 
          RowBox[{
           RowBox[{"J", "[", "0", "]"}], "==", "Q0"}], ",", " ", 
          "\[IndentingNewLine]", 
          RowBox[{"WhenEvent", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"t", ",", "dt"}], "]"}], "==", "0"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"Q0", ",", " ", "R"}], "}"}], "=", 
              RowBox[{"QRDecomposition", "[", 
               RowBox[{
                RowBox[{"J", "[", "t", "]"}], ",", 
                RowBox[{"Pivoting", "->", "False"}]}], "]"}]}], ";", 
             RowBox[{"Sow", "[", 
              RowBox[{"Diagonal", "[", "R", "]"}], "]"}], ";", 
             RowBox[{
              RowBox[{"J", "[", "t", "]"}], "->", 
              RowBox[{"Q0", "\[Transpose]"}]}]}]}], "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"y", ",", "J"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}], 
      "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LyapunovExpsNP", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "df_", ",", "y0_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"dt_", ",", "TMax_"}], "}"}]}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "y0", "]"}]}], ",", "Q0", ",", "R", ",", "P"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Q0", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"QRDecomposition", "[", 
         RowBox[{"RandomReal", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "n"}], "}"}]}], "]"}], "]"}], 
        "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
       "\[Transpose]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Reap", "[", "\[IndentingNewLine]", 
      RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
           RowBox[{"f", "[", 
            RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
           RowBox[{
            RowBox[{"df", "[", 
             RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
            RowBox[{"J", "[", "t", "]"}]}]}], ",", " ", 
          RowBox[{
           RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", " ", 
          RowBox[{
           RowBox[{"J", "[", "0", "]"}], "==", "Q0"}], ",", " ", 
          "\[IndentingNewLine]", 
          RowBox[{"WhenEvent", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"t", ",", "dt"}], "]"}], "==", "0"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"Q0", ",", " ", "R", ",", "P"}], "}"}], "=", 
              RowBox[{"QRDecomposition", "[", 
               RowBox[{
                RowBox[{"J", "[", "t", "]"}], ",", 
                RowBox[{"Pivoting", "->", "True"}]}], "]"}]}], ";", 
             RowBox[{"Sow", "[", 
              RowBox[{"Diagonal", "[", "R", "]"}], "]"}], ";", 
             RowBox[{
              RowBox[{"J", "[", "t", "]"}], "->", 
              RowBox[{"Q0", "\[Transpose]"}]}]}]}], "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"y", ",", "J"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}], 
      "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", 
  RowBox[{"y", ",", "f", ",", "dyf", ",", "dt"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
