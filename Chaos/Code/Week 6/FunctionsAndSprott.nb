Cell["Naturally, we are going to automate this process. ", "Text",
 CellChangeTimes->{{4.0007244428418727`*^9, 
  4.000724464543273*^9}},ExpressionUUID->"c727dbda-ec30-4174-83de-\
de40f9556efd"]
