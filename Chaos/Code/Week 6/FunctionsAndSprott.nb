Cell[CellGroupData[{

Cell["Plane Section Solvers", "Subsection",
 CellChangeTimes->{{4.000460884491954*^9, 4.000460901648095*^9}, {
  4.000538289798253*^9, 4.0005382950039787`*^9}, {4.000538924981372*^9, 
  4.0005389289451847`*^9}},ExpressionUUID->"d5d6a403-15dd-4a1c-ab21-\
b4f0c0d64341"],

Cell[TextData[{
 "These return a solution function y and all the points on the plane ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", ".", 
     RowBox[{"(", 
      RowBox[{"p", "-", 
       SubscriptBox["p", "0"]}], ")"}]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"b8fb7d61-8713-4833-962f-b624c4f10415"],
 " for any IVP (defined by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{"f", "(", "y", ")"}]}], TraditionalForm]],ExpressionUUID->
  "59208d77-8a01-42a8-982f-b53b8f9d50b1"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"y", "(", "0", ")"}], "=", "IC"}], ")"}], " "}], 
   TraditionalForm]],ExpressionUUID->"8120c482-c23d-494b-8fa1-4c2ad91b203d"],
 "and TMax.  Discard early points to see the long time behavior.  The output \
is a list of the interpolating function and a list (with an extra set of \
curly braces) of the points."
}], "Text",
 CellChangeTimes->{{4.000538297491363*^9, 4.0005384531031184`*^9}, {
  4.0005395717279882`*^9, 4.000539693066451*^9}, {4.00053980810003*^9, 
  4.000539838622551*^9}, {4.0005401538776417`*^9, 
  4.000540179357362*^9}},ExpressionUUID->"1ed00efe-5f92-42d7-a801-\
19bf9943a284"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BasicSectionSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "y0_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"n_", ",", "p0_"}], "}"}], ",", "TMax_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "y", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Reap", "[", 
     RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"f", "[", 
           RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", " ", 
         RowBox[{"WhenEvent", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"n", ".", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"y", "[", "t", "]"}], "-", "p0"}], ")"}]}], ">", "0"}],
            ",", " ", 
           RowBox[{"Sow", "[", 
            RowBox[{"y", "[", "t", "]"}], "]"}]}], "]"}]}], "}"}], ",", " ", 
       "\[IndentingNewLine]", "y", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}], " ", 
     "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.000538459847807*^9, 4.0005386125703583`*^9}, {
   4.000538667823256*^9, 4.0005386716851063`*^9}, {4.000538792318755*^9, 
   4.0005387939292984`*^9}, {4.0005394944534883`*^9, 
   4.0005395046432047`*^9}, {4.000539698860812*^9, 4.0005397995590596`*^9}, 
   4.000539842862174*^9},
 CellLabel->"In[14]:=",ExpressionUUID->"4428a872-ea9c-4c81-8aa0-10b674b7052d"],

Cell["As always test a bit.   ", "Text",
 CellChangeTimes->{{4.0005394491401935`*^9, 4.0005394640729237`*^9}, {
  4.000540646680301*^9, 
  4.000540646837597*^9}},ExpressionUUID->"6e2a6fd4-26e6-4d9f-9cd9-\
eb71ff97fd5e"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"Sprott", "  ", "#1"}], TraditionalForm]],ExpressionUUID->
  "c6305470-5154-4f29-ba0b-8b4dc20bd618"],
 "\t"
}], "Subsubsection",
 CellChangeTimes->{{4.000460884491954*^9, 4.000460901648095*^9}, {
  4.000538289798253*^9, 4.0005382950039787`*^9}, {4.000538924981372*^9, 
