Cell[CellGroupData[{

Cell["Plane Section Solvers", "Subsection",
 CellChangeTimes->{{4.000460884491954*^9, 4.000460901648095*^9}, {
  4.000538289798253*^9, 4.0005382950039787`*^9}, {4.000538924981372*^9, 
  4.0005389289451847`*^9}},ExpressionUUID->"d5d6a403-15dd-4a1c-ab21-\
b4f0c0d64341"],

Cell[TextData[{
 "These return a solution function y and all the points on the plane ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", ".", 
     RowBox[{"(", 
      RowBox[{"p", "-", 
       SubscriptBox["p", "0"]}], ")"}]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"b8fb7d61-8713-4833-962f-b624c4f10415"],
 " for any IVP (defined by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{"f", "(", "y", ")"}]}], TraditionalForm]],ExpressionUUID->
  "59208d77-8a01-42a8-982f-b53b8f9d50b1"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"y", "(", "0", ")"}], "=", "IC"}], ")"}], " "}], 
   TraditionalForm]],ExpressionUUID->"8120c482-c23d-494b-8fa1-4c2ad91b203d"],
 "and TMax.  We are going to assume ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"||", "n", "||"}], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6d4f11ad-a263-4562-a6a4-879cfaeaf5b7"],
 ". Discard early points to see the long time behavior.  The output of the \
first is a list comprised of the interpolating function and a list (with an \
extra set of curly braces) of the points."
}], "Text",
 CellChangeTimes->{{4.000538297491363*^9, 4.0005384531031184`*^9}, {
  4.0005395717279882`*^9, 4.000539693066451*^9}, {4.00053980810003*^9, 
  4.000539838622551*^9}, {4.0005401538776417`*^9, 4.000540179357362*^9}, {
  4.0006284409460254`*^9, 4.000628452256837*^9}, {4.0006291100555634`*^9, 
  4.0006291251918736`*^9}},ExpressionUUID->"1ed00efe-5f92-42d7-a801-\
19bf9943a284"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BasicSectionSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "y0_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"n_", ",", "p0_"}], "}"}], ",", "TMax_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "y", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Reap", "[", 
     RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"f", "[", 
           RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", " ", 
         RowBox[{"WhenEvent", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"n", ".", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"y", "[", "t", "]"}], "-", "p0"}], ")"}]}], ">", "0"}],
            ",", " ", 
           RowBox[{"Sow", "[", 
            RowBox[{"y", "[", "t", "]"}], "]"}]}], "]"}]}], "}"}], ",", " ", 
       "\[IndentingNewLine]", "y", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}], " ", 
     "]"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.000538459847807*^9, 4.0005386125703583`*^9}, {
   4.000538667823256*^9, 4.0005386716851063`*^9}, {4.000538792318755*^9, 
   4.0005387939292984`*^9}, {4.0005394944534883`*^9, 
   4.0005395046432047`*^9}, {4.000539698860812*^9, 4.0005397995590596`*^9}, 
   4.000539842862174*^9, {4.000561434973567*^9, 4.000561456917763*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"4428a872-ea9c-4c81-8aa0-10b674b7052d"],

Cell["\<\
Different planes are good for different ones of our Sprott problems.\
\>", "Text",
 CellChangeTimes->{{4.000629269665199*^9, 
  4.000629306786192*^9}},ExpressionUUID->"6098c988-e901-4b4d-9982-\
5fb35c2df5db"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"k", "=", "1"}], ";", 
   RowBox[{"y0", "=", 
    RowBox[{
     RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<IC\>\"", "]"}]}], ";", 
   RowBox[{"p", "=", 
    RowBox[{
     RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<par\>\"", "]"}]}], ";", 
   RowBox[{"f", "=", 
    RowBox[{"fSprott", "[", 
     RowBox[{"k", ",", "p"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Testing", " ", "new", " ", "code"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "123"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"-", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "/", 
       SqrtBox["2"]}], ",", 
      RowBox[{"1", "/", 
       SqrtBox["2"]}], ",", "0"}], "}"}]}]}], ";", " ", 
  RowBox[{"p0", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SectionPic", "=", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"n", ".", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}], "-", "p0"}], ")"}]}], "==",
       "0"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
     RowBox[{"ContourStyle", "\[Rule]", 
      RowBox[{"Opacity", "[", "0.5", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ySol", ",", 
     RowBox[{"{", "yPts", "}"}]}], "}"}], "=", 
   RowBox[{"BasicSectionSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f", ",", "y0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"SectionPic", ",", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"ySol", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ListPointPlot3D", "[", 
    RowBox[{"yPts", ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.000538767544372*^9, 4.000538782613161*^9}, {
   4.0005388140933943`*^9, 4.0005388660330963`*^9}, {4.0005398498297863`*^9, 
   4.000540110092603*^9}, {4.0005401439763775`*^9, 4.000540147010435*^9}, {
   4.000540185397132*^9, 4.000540323847415*^9}, {4.0005404160126457`*^9, 
   4.0005404355783205`*^9}, {4.000540473464484*^9, 4.000540475216011*^9}, {
   4.000540524814898*^9, 4.0005405387043095`*^9}, {4.0005405811430163`*^9, 
   4.000540672521304*^9}, {4.0005408673028965`*^9, 4.0005408733749275`*^9}, 
   4.0005521218358226`*^9, 4.000552168848342*^9, {4.000629342719471*^9, 
   4.0006293805355415`*^9}, {4.0006295499692965`*^9, 4.000629554479293*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"0d32f391-a391-43aa-94b0-819242f4a0a0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"k", "=", "12"}], ";", 
   RowBox[{"y0", "=", 
    RowBox[{
     RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<IC\>\"", "]"}]}], ";", 
   RowBox[{"p", "=", 
    RowBox[{
     RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<par\>\"", "]"}]}], ";", 
   RowBox[{"f", "=", 
    RowBox[{"fSprott", "[", 
     RowBox[{"k", ",", "p"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Testing", " ", "new", " ", "code"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "123"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "/", 
    SqrtBox["3"]}]}], ";", " ", 
  RowBox[{"p0", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0.1"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"R", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SectionPic", "=", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"n", ".", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}], "-", "p0"}], ")"}]}], "==",
       "0"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", 
     RowBox[{"ContourStyle", "\[Rule]", 
      RowBox[{"Opacity", "[", "0.5", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ySol", ",", 
     RowBox[{"{", "yPts", "}"}]}], "}"}], "=", 
   RowBox[{"BasicSectionSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f", ",", "y0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"SectionPic", ",", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"ySol", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ListPointPlot3D", "[", 
    RowBox[{"yPts", ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.000538767544372*^9, 4.000538782613161*^9}, {
   4.0005388140933943`*^9, 4.0005388660330963`*^9}, {4.0005398498297863`*^9, 
   4.000540110092603*^9}, {4.0005401439763775`*^9, 4.000540147010435*^9}, {
   4.000540185397132*^9, 4.000540323847415*^9}, {4.0005404160126457`*^9, 
   4.0005404355783205`*^9}, {4.000540473464484*^9, 4.000540475216011*^9}, {
   4.000540524814898*^9, 4.0005405387043095`*^9}, {4.0005405811430163`*^9, 
   4.000540672521304*^9}, {4.0005408673028965`*^9, 4.0005408733749275`*^9}, 
   4.0005521218358226`*^9, 4.000552168848342*^9, {4.000629342719471*^9, 
   4.00062957747759*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"d07f17c7-1ca6-4e1c-9655-672c0bdb6a1d"]
}, Closed]],

Cell[CellGroupData[{

Cell["Plane Section Sensitivities", "Subsection",
 CellChangeTimes->{{4.000460884491954*^9, 4.000460901648095*^9}, {
  4.000538289798253*^9, 4.0005382950039787`*^9}, {4.000538924981372*^9, 
  4.0005389289451847`*^9}, {4.0006291977359333`*^9, 
  4.0006292078830175`*^9}},ExpressionUUID->"ca5a0b28-1ae7-4fc8-9219-\
a7d8763a5240"],

Cell[TextData[{
 "We also want to be able to compute return time, forward map, and \
sensitivity on a single loop for a point y0 starting on the section i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", ".", 
     RowBox[{"(", 
      RowBox[{"y0", "-", "p0"}], ")"}]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"38bf1ff6-0f50-47ae-a27b-2274149a17a9"],
 ".  \nTMin is in case ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", ".", 
     RowBox[{"(", 
      RowBox[{"y0", "-", "p0"}], ")"}]}], "\[TildeTilde]", "0"}], 
   TraditionalForm]],ExpressionUUID->"1cf19efa-c2a7-435d-a9b8-38ac2f47f555"],
 ".  TMax is in case the orbit does not return.   If the orbit does not \
return there are no points.  I had to decide what to do to signal that!   "
}], "Text",
 CellChangeTimes->{{4.0005614722004504`*^9, 4.0005615343739376`*^9}, {
  4.000561590772004*^9, 4.000561760468672*^9}, {4.0006300071500416`*^9, 
  4.000630042159374*^9}},ExpressionUUID->"7fd63b15-89f1-41f6-8d14-\
08c05ddb11a3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Tau]pJSection", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "dyf_", ",", "y0_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"n_", ",", "p0_"}], "}"}], ",", "TMax_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y", ",", "J", ",", 
      RowBox[{"tMin", "=", 
       SuperscriptBox["10.0", 
        RowBox[{"-", "12"}]]}], ",", "\[Tau]pJ"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Tau]pJ", "=", 
      RowBox[{
       RowBox[{"Reap", "[", 
        RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
             RowBox[{"f", "[", 
              RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
             RowBox[{
              RowBox[{"dyf", "[", 
               RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
              RowBox[{"J", "[", "t", "]"}]}]}], ",", " ", 
            RowBox[{
             RowBox[{"J", "[", "0", "]"}], "==", 
             RowBox[{"IdentityMatrix", "[", 
              RowBox[{"Length", "[", "y0", "]"}], "]"}]}], ",", 
            RowBox[{"WhenEvent", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"n", ".", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"y", "[", "t", "]"}], "-", "p0"}], ")"}]}], ">", 
               "0"}], ",", " ", 
              RowBox[{
               RowBox[{"Sow", "[", 
                RowBox[{"{", 
                 RowBox[{"t", ",", 
                  RowBox[{"y", "[", "t", "]"}], ",", 
                  RowBox[{"J", "[", "t", "]"}]}], "}"}], "]"}], ";", 
               "\"\<StopIntegration\>\""}]}], "]"}]}], "}"}], ",", " ", 
          "\[IndentingNewLine]", "y", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}], " ", 
        "]"}], "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"\[Tau]pJ", "==", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"{", "}"}], ",", " ", 
       RowBox[{"\[Tau]pJ", "\[LeftDoubleBracket]", 
        RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.000561558174469*^9, 4.0005615764128513`*^9}, {
  4.0005617662467732`*^9, 4.0005619006863265`*^9}, {4.000562048132938*^9, 
  4.0005620496774564`*^9}, {4.0006278445746336`*^9, 4.0006279262402472`*^9}, {
  4.00062975966434*^9, 4.0006297676028104`*^9}, {4.000629809352606*^9, 
  4.0006298273371525`*^9}, {4.0006298773836384`*^9, 4.0006299411809015`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"04ecf427-5087-4710-8fee-1d66b5652fcf"],

Cell[TextData[{
 "We want to be able to compute the derivative (in the planar section) with \
respect to parameters describing the plane.  This is going to use orthonormal \
tangent vectors ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "=", 
    RowBox[{"[", GridBox[{
       {"t1", "|", "t2"}
      }], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9e540d91-826f-487a-ac34-813e4ee0d8d2"],
 " stacked up as a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "2", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5e6fe538-3fdc-4aca-a813-e8cdbb5a2358"],
 "matrix to describe the plane. In the case of a plane in 3D orthonormal \
means  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"T", "\[Transpose]"}], ".", "T"}], "=", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{
          SubscriptBox["t", "1"], ".", 
          SubscriptBox["t", "1"]}], 
         RowBox[{
          SubscriptBox["t", "1"], ".", 
          SubscriptBox["t", "2"]}]},
        {
         RowBox[{
          SubscriptBox["t", "2"], ".", 
          SubscriptBox["t", "1"]}], 
         RowBox[{
          SubscriptBox["t", "2"], ".", 
          SubscriptBox["t", "2"]}]}
       }], ")"}], "=", 
     SubscriptBox["I", "2"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d937d8fa-1329-457d-9f36-50b5d993a5a5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["t", "1"], ".", "n"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["t", "2"], ".", "n"}], "=", "0"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "06ee0277-f2ed-4339-bee3-dee63a03add6"],
 ". We are assuming that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "=", 
    RowBox[{"[", 
     RowBox[{"n", ",", 
      SubscriptBox["t", "1"], ",", 
      SubscriptBox["t", "2"]}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "88548968-6d70-4019-948c-e6bcc98389e6"],
 " satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"M", "\[Transpose]"}], ".", "M"}], "=", 
    SubscriptBox["I", "3"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a2a31f43-31e1-4b14-9108-52c339b72508"],
 ".  In words, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"n", ",", 
     SubscriptBox["t", "1"], ",", 
     SubscriptBox["t", "2"]}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "06db3822-aded-48c6-89e9-60bb78d9254c"],
 " is an orthonormal basis for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "43fa4691-8380-4f91-9da3-bfa705a92fa0"],
 ".   This is the same formula we built for the section  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "1"], "=", "c"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4ee58068-2638-489e-b764-eddb75ceeeae"],
 " rotated into the new plane.  I continued the no-return decision!"
}], "Text",
 CellChangeTimes->{{4.0006279293611298`*^9, 4.000628117305332*^9}, {
  4.000628238632457*^9, 4.0006284241966906`*^9}, {4.000628462556553*^9, 
  4.0006285544924965`*^9}, {4.0006289819314637`*^9, 4.000629039939474*^9}, {
  4.0006300515084724`*^9, 
  4.0006300765088873`*^9}},ExpressionUUID->"2f9b6a5f-7761-426f-aed8-\
caa0805575dd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Tau]pJDpSection", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "dyf_", ",", "y0_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"T_", ",", "n_", ",", "p0_"}], "}"}], ",", "TMax_"}], "]"}], ":=",
   " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Tau]", ",", "p", ",", "J", ",", "\[Tau]pJ", ",", 
      RowBox[{"Id", "=", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"Length", "[", "y0", "]"}], "]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Tau]pJ", "=", 
      RowBox[{"\[Tau]pJSection", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"f", ",", "dyf", ",", "y0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"\[Tau]pJ", "==", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Tau]", ",", "p", ",", "J"}], "}"}], "=", "\[Tau]pJ"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "returns", " ", "a", " ", "list", " ", "with", " ", "the", " ", 
          "new", " ", "in", " ", "plane", " ", "sensitivity", " ", "last"}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"\[Tau]", ",", "p", ",", "J", ",", 
          RowBox[{
           RowBox[{"T", "\[Transpose]"}], ".", 
           RowBox[{"(", 
            RowBox[{"Id", "-", 
             FractionBox[
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{
                RowBox[{"f", "[", "p", "]"}], ",", "n"}], "]"}], 
              RowBox[{
               RowBox[{"f", "[", "p", "]"}], ".", "n"}]]}], ")"}], ".", "J", 
           ".", "T"}]}], "}"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.000561558174469*^9, 4.0005615764128513`*^9}, {
  4.0005617662467732`*^9, 4.0005619006863265`*^9}, {4.000562048132938*^9, 
  4.0005620496774564`*^9}, {4.0006278445746336`*^9, 4.0006279262402472`*^9}, {
  4.0006285610587535`*^9, 4.0006285707635136`*^9}, {4.0006288085246735`*^9, 
  4.000628975367673*^9}, {4.0006299642440214`*^9, 4.0006299981180735`*^9}, {
  4.000630186993165*^9, 4.000630220524619*^9}, {4.0007185873344316`*^9, 
  4.000718621286147*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"baf1b334-309e-4466-bfe7-15643da0e6af"],

Cell[TextData[{
 "As always test a bit.  I think in this case testing the second function \
automatically tests the first one!  Here is a test on our Rosseller problem \
with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "1.0"}], TraditionalForm]],ExpressionUUID->
  "a6da2eef-69e9-4998-afab-e5725f50442d"]
}], "Text",
 CellChangeTimes->{{4.0005394491401935`*^9, 4.0005394640729237`*^9}, {
  4.000540646680301*^9, 4.000540646837597*^9}, {4.0005642965617495`*^9, 
  4.000564342447689*^9}, {4.000629621783513*^9, 4.000629718462285*^9}, {
  4.000722420802178*^9, 
  4.000722421190958*^9}},ExpressionUUID->"6e2a6fd4-26e6-4d9f-9cd9-\
eb71ff97fd5e"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "dyf"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", " ", 
    RowBox[{"x", "+", " ", 
     RowBox[{"a", " ", "y"}]}], ",", " ", 
    RowBox[{"b", " ", "+", " ", 
     RowBox[{"z", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dyf", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "a", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", 
      RowBox[{
       RowBox[{"-", "c"}], "+", "x"}]}], "}"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.2", ",", "0.2", ",", "1.0"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}], ";", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"t1", ",", "t2"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";", 
  RowBox[{"T", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t1", ",", "t2"}], "}"}], "\[Transpose]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p0", "=", 
   RowBox[{"{", 
    RowBox[{"c", ",", "0", ",", "0"}], "}"}]}], ";", " ", 
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"c", ",", "0.9", ",", "1.7"}], "}"}]}], ";", " ", 
  RowBox[{"TMax", "=", "123"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Tau]", ",", "p", ",", "J", ",", "Dp"}], "}"}], "=", 
   RowBox[{"\[Tau]pJDpSection", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", 
       RowBox[{"dyf", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", "y0"}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"T", ",", "n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ySol", "=", 
   RowBox[{"BasicIVPSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", "y0"}], "}"}], 
     ",", "\[Tau]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"epsilon", "=", "0.2"}], ";", " ", 
  RowBox[{"CutPic", "=", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"n", ".", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}], "-", "p0"}], ")"}]}], "==",
       "0"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", " ", "3"}], "}"}], ",", 
     RowBox[{"ContourStyle", "->", 
      RowBox[{"Opacity", "[", "0.2", "]"}]}], ",", 
     RowBox[{"Mesh", "->", "None"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<3D\>\"", "->", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ParametricPlot3D", "[", 
        RowBox[{
         RowBox[{"ySol", "[", "t", "]"}], ",", 
         RowBox[{"{", 
