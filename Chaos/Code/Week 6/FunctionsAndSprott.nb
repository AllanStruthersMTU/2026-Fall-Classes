    RowBox[{"0.8", ",", "1.4"}], "}"}]}], ";", 
  RowBox[{"y0", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", "c", "}"}], ",", "u"}], "]"}]}], ";", " ", 
  RowBox[{"TMax", "=", "123"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Tau]", ",", "p", ",", "J", ",", "Dp"}], "}"}], "=", 
   RowBox[{"\[Tau]pJDpSection", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", 
