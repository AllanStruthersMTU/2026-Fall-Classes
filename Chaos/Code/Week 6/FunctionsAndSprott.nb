Cell["\<\
Lets look for Equilibrium points!  We are going to do some algebra. \
\>", "Text",
 CellChangeTimes->{{4.0005484225552397`*^9, 4.0005484398214836`*^9}, {
  4.00054859853744*^9, 
  4.0005486045088053`*^9}},ExpressionUUID->"96a6205e-81ea-4164-91d7-\
20b4135872a3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "m", ",", "k"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k", "=", "12"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "m"}], "}"}], "=", 
   RowBox[{
    RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<par\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"EqEq", "=", 
  RowBox[{
   RowBox[{"0", "==", 
    RowBox[{
     RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<fun\>\"", "]"}]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"yp", "->", "0"}], ",", 
     RowBox[{"ypp", "->", "0"}]}], "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", 
  RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "m", ",", "k"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"y", "-", 
    RowBox[{"Tanh", "[", 
     RowBox[{"50", " ", "y"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.000548266891349*^9, 4.0005485834742956`*^9}},
 CellLabel->
  "In[422]:=",ExpressionUUID->"4f3036b7-0674-4890-914c-04e03e9f91ae"],

Cell[BoxData[
 RowBox[{"0", "\[Equal]", 
  RowBox[{"0.`", "\[VeryThinSpace]", "+", "y", "-", 
   RowBox[{"Tanh", "[", 
    RowBox[{"50", " ", "y"}], "]"}]}]}]], "Output",
