Cell[TextData[{
 "For a double loop we want to solve \n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      SubscriptBox["u", "2"], "=", 
      RowBox[{"p", 
       RowBox[{"(", 
        SubscriptBox["u", "1"], ")"}]}]},
     {
      SubscriptBox["u", "1"], "=", 
      RowBox[{"p", "(", 
       SubscriptBox["u", "2"], ")"}]}
    }], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2d05b511-bfeb-4d5a-abe9-b831a02e80ba"],
 "\nfor the return map p.  Apply Newton\[CloseCurlyQuote]s method to \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", GridBox[{
       {
        SubscriptBox["u", "1"]},
       {
        SubscriptBox["u", "2"]}
      }], ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", GridBox[{
         {
          RowBox[{"p", "(", 
           SubscriptBox["u", "1"], ")"}]},
         {
          RowBox[{"p", "(", 
           SubscriptBox["u", "2"], ")"}]}
        }], ")"}], "-", 
      RowBox[{"(", GridBox[{
         {
          SubscriptBox["u", "2"]},
         {
          SubscriptBox["u", "1"]}
        }], ")"}]}], "=", 
     RowBox[{"(", GridBox[{
        {"0"},
        {"0"}
       }], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9aa84235-4130-4cbe-be90-e591125e9052"],
 "\nto get the iteration \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "new"], "=", 
    RowBox[{
     SubscriptBox["w", "old"], "-", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Dg", "(", 
        SubscriptBox["w", "old"], ")"}], 
       RowBox[{"-", "1"}]], 
      RowBox[{"g", "(", 
       SubscriptBox["w", "old"], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "627f6fbe-e82e-4847-86ec-ec637850b4cf"],
 "\nwhere \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"w", "=", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["u", "1"]},
       {
        SubscriptBox["u", "2"]}
      }], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a1f2530b-e5ec-4d2b-bb50-aa8954741205"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Dg", "(", 
     RowBox[{"(", GridBox[{
        {
         SubscriptBox["u", "1"]},
        {
         SubscriptBox["u", "2"]}
       }], ")"}], ")"}], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"Dp", "(", 
         SubscriptBox["u", "1"], ")"}], 
        RowBox[{"-", "Id"}]},
       {
        RowBox[{"-", "Id"}], 
        RowBox[{"Dp", "(", 
         SubscriptBox["u", "2"], ")"}]}
      }], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c651908a-966d-4d5d-a3c0-2a52c3f39bc9"],
 "\nAccurately computing the visible double return loop with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "3.3"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "537f81d2-5896-4213-8f17-e057ecc2f00b"],
 " looks something like this.  First find a point on an approximate double \
cycle. The double point section test is what we have been looking at. "
}], "Text",
 CellChangeTimes->{{4.0005614722004504`*^9, 4.0005615343739376`*^9}, {
  4.000561590772004*^9, 4.000561760468672*^9}, {4.0006300071500416`*^9, 
  4.000630042159374*^9}, {4.000722137488967*^9, 4.0007223254587994`*^9}, {
  4.000722397582649*^9, 4.0007224117709045`*^9}, {4.0007238991926317`*^9, 
  4.0007239202504573`*^9}, {4.0007244893016577`*^9, 4.0007247878467426`*^9}, {
  4.0007248179118357`*^9, 4.0007248192083836`*^9}, {4.000724930330272*^9, 
  4.000724936958984*^9}, {4.000724982534488*^9, 4.0007249978034115`*^9}, {
  4.000725087861233*^9, 4.000725125129575*^9}, {4.0007252773778286`*^9, 
  4.000725283524063*^9}},ExpressionUUID->"c70c8282-bfef-4d04-a9a0-\
c79a1ef2a461"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "dyf"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", " ", 
    RowBox[{"x", "+", " ", 
     RowBox[{"a", " ", "y"}]}], ",", " ", 
    RowBox[{"b", " ", "+", " ", 
     RowBox[{"z", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dyf", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "a", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", 
      RowBox[{
       RowBox[{"-", "c"}], "+", "x"}]}], "}"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.2", ",", "0.2", ",", "3.3"}], "}"}]}], ";", " ", 
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], ";", " ", 
  RowBox[{"TMax", "=", "80"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"-", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0", ",", "0"}], "}"}]}]}], ";", " ", 
  RowBox[{"p0", "=", 
   RowBox[{"{", 
    RowBox[{"c", ",", "0", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ySol", ",", 
     RowBox[{"{", "yPts", "}"}]}], "}"}], "=", 
   RowBox[{"BasicSectionSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", "y0"}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot3D", "[", 
  RowBox[{
   RowBox[{"ySol", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", 
     RowBox[{"0.8", "TMax"}], ",", " ", "TMax"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"yPts", "\[LeftDoubleBracket]", 
     RowBox[{
      RowBox[{"-", "3"}], ";;", 
      RowBox[{"-", "1"}]}], "\[RightDoubleBracket]"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.00072483087323*^9, 4.000725023802205*^9}, {
  4.0007250793020053`*^9, 4.0007250797238655`*^9}, {4.0007251594736567`*^9, 
  4.000725263254676*^9}, {4.00072530344304*^9, 4.0007253999282355`*^9}, {
