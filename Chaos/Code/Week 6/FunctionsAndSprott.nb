Cell[TextData[{
 "I am going to guess ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "1"], "\[TildeTilde]", 
    RowBox[{"{", 
     RowBox[{"2.2", ",", "7.3"}], "}"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8131f6b6-6fd9-4723-b40d-c3aa5114b02a"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "2"], "\[TildeTilde]", 
    RowBox[{"{", 
     RowBox[{"2.7", ",", "1.4"}], "}"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a1a37233-7d2d-44c2-ae8a-08d376d78fe0"],
 " .  the following implements Newtons method. "
}], "Text",
 CellChangeTimes->{{4.0007250374397955`*^9, 4.000725070255596*^9}, {
  4.0007254149739914`*^9, 4.0007254572872725`*^9}, {4.0007255049374533`*^9, 
  4.000725527592436*^9}, {4.0007256538509865`*^9, 4.0007256572236958`*^9}, {
  4.000726209630411*^9, 
  4.0007262253484898`*^9}},ExpressionUUID->"46129a9e-90cc-45ba-9eb4-\
9db48906c12e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"u1", ",", "u2"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2.2", ",", "7.3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2.7", ",", "1.4"}], "}"}]}], "}"}]}], ";", " ", 
  RowBox[{"Id", "=", 
   RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Tau]1", ",", "p1", ",", "J1", ",", "Dp1"}], "}"}], "=", 
     RowBox[{"\[Tau]pJDpSection", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", 
         RowBox[{"dyf", "[", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", "c", "}"}], ",", "u1"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"T", ",", "n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Tau]2", ",", "p2", ",", "J2", ",", "Dp2"}], "}"}], "=", 
     RowBox[{"\[Tau]pJDpSection", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", 
         RowBox[{"dyf", "[", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", "c", "}"}], ",", "u2"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"T", ",", "n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"Dg", "=", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{"(", "\[NoBreak]", GridBox[{
         {"Dp1", 
          RowBox[{"-", "Id"}]},
         {
          RowBox[{"-", "Id"}], "Dp2"}
        }], "\[NoBreak]", ")"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u1", ",", "u2"}], "}"}], "=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u1", ",", "u2"}], "}"}], "-", 
      RowBox[{"Partition", "[", 
       RowBox[{
        RowBox[{"LinearSolve", "[", 
         RowBox[{"Dg", ",", 
          RowBox[{"Flatten", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"p1", "\[LeftDoubleBracket]", 
               RowBox[{"{", 
                RowBox[{"2", ",", "3"}], "}"}], "\[RightDoubleBracket]"}], 
              "-", "u2"}], ",", 
             RowBox[{
              RowBox[{"p2", "\[LeftDoubleBracket]", 
               RowBox[{"{", 
                RowBox[{"2", ",", "3"}], "}"}], "\[RightDoubleBracket]"}], 
              "-", "u1"}]}], "}"}], "]"}]}], "]"}], ",", "2"}], "]"}]}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{"u2", "-", 
         RowBox[{"p1", "\[LeftDoubleBracket]", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}], "\[RightDoubleBracket]"}]}], "]"}],
        ",", 
       RowBox[{"Norm", "[", 
        RowBox[{"u1", "-", 
         RowBox[{"p2", "\[LeftDoubleBracket]", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}], "\[RightDoubleBracket]"}]}], 
        "]"}]}], "}"}], "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", "5", "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.000561914421625*^9, 4.0005620711882334`*^9}, {
   4.0005621059675007`*^9, 4.0005621527408237`*^9}, {4.000562186701093*^9, 
   4.000562727659698*^9}, {4.0005628904047956`*^9, 4.0005629001965404`*^9}, {
   4.000564278138647*^9, 4.0005642788337193`*^9}, {4.0005643790890193`*^9, 
   4.000564390642763*^9}, {4.0005644207461276`*^9, 4.0005644469543457`*^9}, {
   4.0005682655887847`*^9, 4.000568329670134*^9}, {4.000568413503501*^9, 
   4.0005684326531377`*^9}, {4.000629665383424*^9, 4.0006296698215485`*^9}, {
   4.000629777040538*^9, 4.0006297884932365`*^9}, {4.0006298446646605`*^9, 
   4.000629864017414*^9}, 4.0006299337165146`*^9, {4.000630095438695*^9, 
   4.0006301661331635`*^9}, {4.00063024880593*^9, 4.0006302847726183`*^9}, {
   4.0006303272121625`*^9, 4.000630391586757*^9}, {4.000630422408266*^9, 
   4.000630435540986*^9}, {4.000630649071435*^9, 4.0006306752419243`*^9}, {
   4.0007193966343822`*^9, 4.0007194145358796`*^9}, {4.000719448083576*^9, 
   4.000719680573032*^9}, {4.000719748255134*^9, 4.000719783661954*^9}, {
   4.00071986147358*^9, 4.0007198687262077`*^9}, {4.0007199445047445`*^9, 
   4.000719977208847*^9}, {4.0007204196298847`*^9, 4.000720421034003*^9}, {
   4.0007204573965287`*^9, 4.0007204799037747`*^9}, {4.000720513349847*^9, 
   4.0007207386069856`*^9}, {4.0007207862397375`*^9, 4.000720812989341*^9}, {
   4.000720871583178*^9, 4.000720885707925*^9}, {4.00072244375463*^9, 
   4.000722795192465*^9}, {4.000723939510356*^9, 4.000724060766159*^9}, {
   4.0007255503283544`*^9, 4.0007257620652485`*^9}, {4.0007258274519787`*^9, 
