Cell[CellGroupData[{

Cell["Basic Solvers", "Subsection",
 CellChangeTimes->{{4.000460884491954*^9, 4.000460901648095*^9}, {
  4.000538289798253*^9, 
  4.0005382950039787`*^9}},ExpressionUUID->"00255133-2c14-444b-ab0e-\
e9a9cf1a19ec"],

Cell[TextData[{
 "These return a solution function y (and sensitivity J if given ",
 Cell[BoxData[
  FormBox["dyf", TraditionalForm]],ExpressionUUID->
  "0e17e9ac-93a9-47c3-a373-026653b5a150"],
 ") for any IVP (defined by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{"f", "(", "y", ")"}]}], TraditionalForm]],ExpressionUUID->
  "3beadd8e-b5ef-4b77-b4aa-cf167953307d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"y", "(", "0", ")"}], "=", "IC"}], ")"}], " "}], 
   TraditionalForm]],ExpressionUUID->"fd4f761f-010e-4fcd-a8ff-7d45b8f0328e"],
 "and TMax."
}], "Text",
 CellChangeTimes->{{4.000538297491363*^9, 
  4.0005384531031184`*^9}},ExpressionUUID->"eac80cf9-7cd8-4907-a026-\
b247dea3fee5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"BasicIVPSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "y0_"}], "}"}], ",", "TMax_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "y", "}"}], ",", 
    RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"f", "[", 
          RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], "}"}], ",", " ", "y", 
      ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], " ", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BasicIVPSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "dyf_", ",", "y0_"}], "}"}], ",", "TMax_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "J", ",", " ", 
      RowBox[{"n", "=", " ", 
       RowBox[{"Length", "[", "y0", "]"}]}]}], "}"}], ",", 
    RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"f", "[", 
          RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
         RowBox[{
          RowBox[{"dyf", "[", 
           RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
          RowBox[{"J", "[", "t", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", " ", 
        RowBox[{
         RowBox[{"J", "[", "0", "]"}], "==", 
         RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"y", ",", "J"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], " ", 
   "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.000538459847807*^9, 4.0005386125703583`*^9}, {
  4.000538667823256*^9, 4.0005386716851063`*^9}, {4.000538792318755*^9, 
  4.0005387939292984`*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"c47b8e1d-e320-4e55-a355-134ebb9473c5"],

Cell["I am going to test both versions. First the just y solver. ", "Text",
 CellChangeTimes->{{4.00053862563384*^9, 4.0005386387081575`*^9}, {
  4.000549822883442*^9, 
  4.000549839371134*^9}},ExpressionUUID->"ee4c0fd5-ba88-4558-ab6f-\
66b21d981cf2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TMax", "=", "123"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", "\[IndentingNewLine]", 
  RowBox[{"Table", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"y0", "=", 
      RowBox[{
       RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<IC\>\"", "]"}]}], ";", 
     RowBox[{"p", "=", 
      RowBox[{
       RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<par\>\"", "]"}]}], ";", 
     RowBox[{"f", "=", 
      RowBox[{"fSprott", "[", 
       RowBox[{"k", ",", "p"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ySol", "=", 
      RowBox[{"BasicIVPSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"f", ",", "y0"}], "}"}], ",", "TMax"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
