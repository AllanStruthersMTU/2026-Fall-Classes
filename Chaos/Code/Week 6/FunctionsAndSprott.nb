Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ySol", ",", "JSol"}], "}"}], ",", 
    RowBox[{"{", "Js", "}"}]}], "}"}], "=", 
  RowBox[{"Reap", "[", "\[IndentingNewLine]", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"f", "[", 
         RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"df", "[", 
          RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
         RowBox[{"J", "[", "t", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
       RowBox[{
        RowBox[{"J", "[", "0", "]"}], "==", "Id"}], ",", 
       RowBox[{"WhenEvent", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"t", ",", "dt"}], "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"y", "[", "t", "]"}], "->", 
           RowBox[{"t", " ", "y0"}]}], ";", 
          RowBox[{
           RowBox[{"J", "[", "t", "]"}], "->", "Id"}], ";", " ", 
          RowBox[{"Sow", "[", 
           RowBox[{"J", "[", "t", "]"}], "]"}]}]}], "]"}]}], " ", "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"y", ",", "J"}], "}"}], ",", 
