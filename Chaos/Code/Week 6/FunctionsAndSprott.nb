Cell[CellGroupData[{

Cell["Plane Section Sensitivities", "Subsection",
 CellChangeTimes->{{4.000460884491954*^9, 4.000460901648095*^9}, {
  4.000538289798253*^9, 4.0005382950039787`*^9}, {4.000538924981372*^9, 
  4.0005389289451847`*^9}, {4.0006291977359333`*^9, 
  4.0006292078830175`*^9}},ExpressionUUID->"ca5a0b28-1ae7-4fc8-9219-\
a7d8763a5240"],

Cell[TextData[{
 "We also want to be able to compute return time, forward map, and \
sensitivity on a single loop for a point y0 starting on the section i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", ".", 
     RowBox[{"(", 
      RowBox[{"y0", "-", "p0"}], ")"}]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"38bf1ff6-0f50-47ae-a27b-2274149a17a9"],
 ".  \nTMin is in case ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", ".", 
     RowBox[{"(", 
      RowBox[{"y0", "-", "p0"}], ")"}]}], "\[TildeTilde]", "0"}], 
   TraditionalForm]],ExpressionUUID->"1cf19efa-c2a7-435d-a9b8-38ac2f47f555"],
 ".  TMax is in case the orbit does not return.   If the orbit does not \
return there are no points.  I had to decide what to do to signal that!   "
}], "Text",
 CellChangeTimes->{{4.0005614722004504`*^9, 4.0005615343739376`*^9}, {
  4.000561590772004*^9, 4.000561760468672*^9}, {4.0006300071500416`*^9, 
  4.000630042159374*^9}},ExpressionUUID->"7fd63b15-89f1-41f6-8d14-\
08c05ddb11a3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Tau]pJSection", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "dyf_", ",", "y0_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"n_", ",", "p0_"}], "}"}], ",", "TMax_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y", ",", "J", ",", 
      RowBox[{"tMin", "=", 
       SuperscriptBox["10.0", 
        RowBox[{"-", "12"}]]}], ",", "\[Tau]pJ"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Tau]pJ", "=", 
      RowBox[{
       RowBox[{"Reap", "[", 
        RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
             RowBox[{"f", "[", 
              RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
             RowBox[{
              RowBox[{"dyf", "[", 
               RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
              RowBox[{"J", "[", "t", "]"}]}]}], ",", " ", 
            RowBox[{
             RowBox[{"J", "[", "0", "]"}], "==", 
             RowBox[{"IdentityMatrix", "[", 
              RowBox[{"Length", "[", "y0", "]"}], "]"}]}], ",", 
            RowBox[{"WhenEvent", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"n", ".", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"y", "[", "t", "]"}], "-", "p0"}], ")"}]}], ">", 
               "0"}], ",", " ", 
              RowBox[{
               RowBox[{"Sow", "[", 
                RowBox[{"{", 
                 RowBox[{"t", ",", 
                  RowBox[{"y", "[", "t", "]"}], ",", 
                  RowBox[{"J", "[", "t", "]"}]}], "}"}], "]"}], ";", 
               "\"\<StopIntegration\>\""}]}], "]"}]}], "}"}], ",", " ", 
          "\[IndentingNewLine]", "y", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}], " ", 
        "]"}], "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"\[Tau]pJ", "==", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"{", "}"}], ",", " ", 
       RowBox[{"\[Tau]pJ", "\[LeftDoubleBracket]", 
        RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.000561558174469*^9, 4.0005615764128513`*^9}, {
  4.0005617662467732`*^9, 4.0005619006863265`*^9}, {4.000562048132938*^9, 
  4.0005620496774564`*^9}, {4.0006278445746336`*^9, 4.0006279262402472`*^9}, {
  4.00062975966434*^9, 4.0006297676028104`*^9}, {4.000629809352606*^9, 
  4.0006298273371525`*^9}, {4.0006298773836384`*^9, 4.0006299411809015`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"04ecf427-5087-4710-8fee-1d66b5652fcf"],

Cell[TextData[{
 "We want to be able to compute the derivative (in the planar section) with \
respect to parameters describing the plane.  This is going to use orthonormal \
tangent vectors ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "=", 
    RowBox[{"[", GridBox[{
       {"t1", "|", "t2"}
      }], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9e540d91-826f-487a-ac34-813e4ee0d8d2"],
 " stacked up as a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "2", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5e6fe538-3fdc-4aca-a813-e8cdbb5a2358"],
 "matrix to describe the plane. In the case of a plane in 3D orthonormal \
means  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"T", "\[Transpose]"}], ".", "T"}], "=", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{
          SubscriptBox["t", "1"], ".", 
          SubscriptBox["t", "1"]}], 
         RowBox[{
          SubscriptBox["t", "1"], ".", 
          SubscriptBox["t", "2"]}]},
        {
         RowBox[{
          SubscriptBox["t", "2"], ".", 
          SubscriptBox["t", "1"]}], 
         RowBox[{
          SubscriptBox["t", "2"], ".", 
          SubscriptBox["t", "2"]}]}
       }], ")"}], "=", 
     SubscriptBox["I", "2"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d937d8fa-1329-457d-9f36-50b5d993a5a5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["t", "1"], ".", "n"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["t", "2"], ".", "n"}], "=", "0"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "06ee0277-f2ed-4339-bee3-dee63a03add6"],
 ". We are assuming that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "=", 
    RowBox[{"[", 
     RowBox[{"n", ",", 
      SubscriptBox["t", "1"], ",", 
      SubscriptBox["t", "2"]}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "88548968-6d70-4019-948c-e6bcc98389e6"],
 " satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"M", "\[Transpose]"}], ".", "M"}], "=", 
    SubscriptBox["I", "3"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a2a31f43-31e1-4b14-9108-52c339b72508"],
 ".  In words, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"n", ",", 
     SubscriptBox["t", "1"], ",", 
     SubscriptBox["t", "2"]}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "06db3822-aded-48c6-89e9-60bb78d9254c"],
 " is an orthonormal basis for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "43fa4691-8380-4f91-9da3-bfa705a92fa0"],
 ".   This is the same formula we built for the section  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "1"], "=", "c"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4ee58068-2638-489e-b764-eddb75ceeeae"],
 " rotated into the new plane.  I continued the no-return decision!"
}], "Text",
 CellChangeTimes->{{4.0006279293611298`*^9, 4.000628117305332*^9}, {
  4.000628238632457*^9, 4.0006284241966906`*^9}, {4.000628462556553*^9, 
  4.0006285544924965`*^9}, {4.0006289819314637`*^9, 4.000629039939474*^9}, {
  4.0006300515084724`*^9, 
  4.0006300765088873`*^9}},ExpressionUUID->"2f9b6a5f-7761-426f-aed8-\
caa0805575dd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Tau]pJDpSection", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "dyf_", ",", "y0_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"T_", ",", "n_", ",", "p0_"}], "}"}], ",", "TMax_"}], "]"}], ":=",
   " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Tau]", ",", "p", ",", "J", ",", "\[Tau]pJ", ",", 
      RowBox[{"Id", "=", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"Length", "[", "y0", "]"}], "]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Tau]pJ", "=", 
      RowBox[{"\[Tau]pJSection", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"f", ",", "dyf", ",", "y0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"\[Tau]pJ", "==", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Tau]", ",", "p", ",", "J"}], "}"}], "=", "\[Tau]pJ"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "returns", " ", "a", " ", "list", " ", "with", " ", "the", " ", 
          "new", " ", "in", " ", "plane", " ", "sensitivity", " ", "last"}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"\[Tau]", ",", "p", ",", "J", ",", 
          RowBox[{
           RowBox[{"T", "\[Transpose]"}], ".", 
           RowBox[{"(", 
            RowBox[{"Id", "-", 
             FractionBox[
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{
                RowBox[{"f", "[", "p", "]"}], ",", "n"}], "]"}], 
              RowBox[{
               RowBox[{"f", "[", "p", "]"}], ".", "n"}]]}], ")"}], ".", "J", 
           ".", "T"}]}], "}"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.000561558174469*^9, 4.0005615764128513`*^9}, {
  4.0005617662467732`*^9, 4.0005619006863265`*^9}, {4.000562048132938*^9, 
  4.0005620496774564`*^9}, {4.0006278445746336`*^9, 4.0006279262402472`*^9}, {
  4.0006285610587535`*^9, 4.0006285707635136`*^9}, {4.0006288085246735`*^9, 
  4.000628975367673*^9}, {4.0006299642440214`*^9, 4.0006299981180735`*^9}, {
  4.000630186993165*^9, 4.000630220524619*^9}, {4.0007185873344316`*^9, 
  4.000718621286147*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"baf1b334-309e-4466-bfe7-15643da0e6af"],

Cell[TextData[{
 "As always test a bit.  I think in this case testing the second function \
automatically tests the first one!  Here is a test on our Rosseller problem \
with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "1.0"}], TraditionalForm]],ExpressionUUID->
  "a6da2eef-69e9-4998-afab-e5725f50442d"]
}], "Text",
 CellChangeTimes->{{4.0005394491401935`*^9, 4.0005394640729237`*^9}, {
  4.000540646680301*^9, 4.000540646837597*^9}, {4.0005642965617495`*^9, 
  4.000564342447689*^9}, {4.000629621783513*^9, 4.000629718462285*^9}, {
  4.000722420802178*^9, 
  4.000722421190958*^9}},ExpressionUUID->"6e2a6fd4-26e6-4d9f-9cd9-\
eb71ff97fd5e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "dyf"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", " ", 
    RowBox[{"x", "+", " ", 
     RowBox[{"a", " ", "y"}]}], ",", " ", 
    RowBox[{"b", " ", "+", " ", 
     RowBox[{"z", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dyf", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "a", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", 
      RowBox[{
       RowBox[{"-", "c"}], "+", "x"}]}], "}"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.2", ",", "0.2", ",", "1.0"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}], ";", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"t1", ",", "t2"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";", 
  RowBox[{"T", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t1", ",", "t2"}], "}"}], "\[Transpose]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p0", "=", 
   RowBox[{"{", 
    RowBox[{"c", ",", "0", ",", "0"}], "}"}]}], ";", " ", 
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"c", ",", "0.9", ",", "1.7"}], "}"}]}], ";", " ", 
  RowBox[{"TMax", "=", "123"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Tau]", ",", "p", ",", "J", ",", "Dp"}], "}"}], "=", 
   RowBox[{"\[Tau]pJDpSection", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", 
       RowBox[{"dyf", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", "y0"}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"T", ",", "n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ySol", "=", 
   RowBox[{"BasicIVPSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", "y0"}], "}"}], 
     ",", "\[Tau]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"epsilon", "=", "0.2"}], ";", " ", 
  RowBox[{"CutPic", "=", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"n", ".", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}], "-", "p0"}], ")"}]}], "==",
       "0"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", " ", "3"}], "}"}], ",", 
     RowBox[{"ContourStyle", "->", 
      RowBox[{"Opacity", "[", "0.2", "]"}]}], ",", 
     RowBox[{"Mesh", "->", "None"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<3D\>\"", "->", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ParametricPlot3D", "[", 
        RowBox[{
         RowBox[{"ySol", "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", " ", "\[Tau]"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{
           "\"\<\!\(\*SubscriptBox[\(y\), \(1\)]\)\>\"", ",", 
            "\"\<\!\(\*SubscriptBox[\(y\), \(2\)]\)\>\"", ",", 
            "\"\<\!\(\*SubscriptBox[\(y\), \(3\)]\)\>\""}], "}"}]}]}], "]"}], 
       ",", "\[IndentingNewLine]", "CutPic", ",", 
       RowBox[{"Graphics3D", "[", 
