Notebook[{

Cell[CellGroupData[{
Cell["Sprott: Bulk Implementation", "Title",
 CellChangeTimes->{{3.997354396199274*^9, 3.9973544008679843`*^9}, {
  3.9999346233602753`*^9, 3.9999346251770563`*^9}, {4.0001934647115793`*^9, 
  4.000193468010045*^9}, {4.000195283391547*^9, 
  4.00019528985012*^9}},ExpressionUUID->"ee41a007-0d2f-4b6e-9991-\
30a592e66adf"],

Cell[CellGroupData[{

Cell["Sprott Problem Definitions", "Subsection",
 CellChangeTimes->{{4.000460884491954*^9, 
  4.000460901648095*^9}},ExpressionUUID->"9347d7cb-f261-4f5f-8dca-\
ed935df64727"],

Cell[TextData[{
 "These use the top ",
 Cell[BoxData[
  FormBox["\[PlusMinus]", TraditionalForm]],ExpressionUUID->
  "7aa2f3fa-0417-409a-8333-390080a104ec"],
 " definition from Sprott when there is a choice. The only exception here is \
#4 where there is a typo in the table.The ancillary functions and derivatives \
are defined.  Jump discontinuities are smoothed using ",
 Cell[BoxData[
  FormBox[
   RowBox[{"tanh", "(", 
    RowBox[{"m", " ", "x"}], ")"}], TraditionalForm]],ExpressionUUID->
  "2dbd71ea-f7bb-488d-813c-e3a491e63c47"],
 " with a default value of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "50."}], TraditionalForm]],ExpressionUUID->
  "361f9b39-d604-4ef7-9059-933a4cd73e72"],
 "  All problems have parameters ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "m"}], "}"}], 
   TraditionalForm]],ExpressionUUID->"d6211ecb-b299-4deb-bb7b-6cdf17fce4e4"],
 ".  The smoothing parameter is only active in problems 11, 12, and 13.  The \
functions fSprott[p][y], dyfSprott[p][y] and dpfSprott[p][y] are defined and \
protected at the bottom of the initialization cell.  "
}], "Text",
 CellChangeTimes->{{4.000383818225066*^9, 4.0003838442348366`*^9}, {
   4.000383884718256*^9, 4.0003838999221478`*^9}, {4.0003841876964064`*^9, 
   4.0003842200577126`*^9}, 4.000459383028818*^9, {4.0004609111993303`*^9, 
   4.000461240209152*^9}, {4.0005378767765026`*^9, 
   4.0005379013050985`*^9}},ExpressionUUID->"5d815fe6-a259-4548-96f8-\
bf405ea420a7"],

Cell["\<\
Note:  There is an inconsistency in the choices of \[PlusMinus] signs in the \
4th IVP in the paper.  The given IC diverge rapidly. I changed the IC to \
(0,-1,0)\
\>", "Text",
 CellChangeTimes->{{4.0004860536585894`*^9, 
  4.0004861429939933`*^9}},ExpressionUUID->"1b14f65f-2714-45e7-bf00-\
e426b9078aed"],

