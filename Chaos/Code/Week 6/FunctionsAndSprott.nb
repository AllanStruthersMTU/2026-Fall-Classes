Cell[TextData[{
 "These return a solution function y (and sensitivity J if given ",
 Cell[BoxData[
  FormBox["dyf", TraditionalForm]],ExpressionUUID->
  "0e17e9ac-93a9-47c3-a373-026653b5a150"],
 ") for any IVP (defined by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{"f", "(", "y", ")"}]}], TraditionalForm]],ExpressionUUID->
  "3beadd8e-b5ef-4b77-b4aa-cf167953307d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"y", "(", "0", ")"}], "=", "IC"}], ")"}], " "}], 
   TraditionalForm]],ExpressionUUID->"fd4f761f-010e-4fcd-a8ff-7d45b8f0328e"],
 "and TMax."
}], "Text",
 CellChangeTimes->{{4.000538297491363*^9, 
  4.0005384531031184`*^9}},ExpressionUUID->"eac80cf9-7cd8-4907-a026-\
b247dea3fee5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"BasicIVPSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "y0_"}], "}"}], ",", "TMax_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "y", "}"}], ",", 
    RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"f", "[", 
          RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], "}"}], ",", " ", "y", 
      ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], " ", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BasicIVPSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "dyf_", ",", "y0_"}], "}"}], ",", "TMax_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "J", ",", " ", 
      RowBox[{"n", "=", " ", 
       RowBox[{"Length", "[", "y0", "]"}]}]}], "}"}], ",", 
    RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"f", "[", 
          RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
         RowBox[{
          RowBox[{"dyf", "[", 
           RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
          RowBox[{"J", "[", "t", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", " ", 
        RowBox[{
         RowBox[{"J", "[", "0", "]"}], "==", 
         RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"y", ",", "J"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], " ", 
   "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.000538459847807*^9, 4.0005386125703583`*^9}, {
