    ";", "\[IndentingNewLine]", 
    RowBox[{"Dg", "=", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{"(", "\[NoBreak]", GridBox[{
         {"Dp1", 
          RowBox[{"-", "Id"}]},
         {
          RowBox[{"-", "Id"}], "Dp2"}
        }], "\[NoBreak]", ")"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u1", ",", "u2"}], "}"}], "=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u1", ",", "u2"}], "}"}], "-", 
      RowBox[{"Partition", "[", 
       RowBox[{
        RowBox[{"LinearSolve", "[", 
         RowBox[{"Dg", ",", 
          RowBox[{"Flatten", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"p1", "\[LeftDoubleBracket]", 
               RowBox[{"{", 
                RowBox[{"2", ",", "3"}], "}"}], "\[RightDoubleBracket]"}], 
              "-", "u2"}], ",", 
             RowBox[{
              RowBox[{"p2", "\[LeftDoubleBracket]", 
               RowBox[{"{", 
                RowBox[{"2", ",", "3"}], "}"}], "\[RightDoubleBracket]"}], 
              "-", "u1"}]}], "}"}], "]"}]}], "]"}], ",", "2"}], "]"}]}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{"u2", "-", 
         RowBox[{"p1", "\[LeftDoubleBracket]", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}], "\[RightDoubleBracket]"}]}], "]"}],
        ",", 
       RowBox[{"Norm", "[", 
        RowBox[{"u1", "-", 
         RowBox[{"p2", "\[LeftDoubleBracket]", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}], "\[RightDoubleBracket]"}]}], 
        "]"}]}], "}"}], "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", "5", "}"}]}], "]"}]}], "Input",
