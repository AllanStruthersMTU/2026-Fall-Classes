Cell[BoxData[{
 RowBox[{
  RowBox[{"TMax", "=", 
   SuperscriptBox["10", "4"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"-", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "0"}], "}"}]}]}], ";", " ", 
  RowBox[{"p0", "=", 
