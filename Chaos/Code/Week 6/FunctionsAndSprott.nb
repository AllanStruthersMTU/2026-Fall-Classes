  4.000906125091796*^9}, {4.000908479061401*^9, 4.000908491797946*^9}, {
  4.00090855929982*^9, 4.0009086911723304`*^9}, {4.0009087377247334`*^9, 
  4.000908860076598*^9}, {4.0009117552394905`*^9, 4.0009118266611814`*^9}, {
  4.000911911239241*^9, 4.0009120899819345`*^9}, {4.0009125222623835`*^9, 
  4.00091253135845*^9}, {4.00091287313315*^9, 4.0009128784812813`*^9}},
 CellLabel->
