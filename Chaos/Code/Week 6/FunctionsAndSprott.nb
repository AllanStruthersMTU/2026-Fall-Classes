Cell[CellGroupData[{

Cell["Newtons Method for Loops", "Subsection",
 CellChangeTimes->{{4.000460884491954*^9, 4.000460901648095*^9}, {
  4.000538289798253*^9, 4.0005382950039787`*^9}, {4.000538924981372*^9, 
  4.0005389289451847`*^9}, {4.0006291977359333`*^9, 4.0006292078830175`*^9}, {
  4.0007221225217295`*^9, 4.000722133123322*^9}, {4.000722860128234*^9, 
  4.0007228628644648`*^9}, {4.0007241491771555`*^9, 
  4.0007241502552156`*^9}},ExpressionUUID->"d51b3bdd-61e1-430a-b399-\
dbe79363d00b"],

Cell[CellGroupData[{

Cell["Single Loop", "Subsubsection",
 CellChangeTimes->{{4.000460884491954*^9, 4.000460901648095*^9}, {
  4.000538289798253*^9, 4.0005382950039787`*^9}, {4.000538924981372*^9, 
  4.0005389289451847`*^9}, {4.0006291977359333`*^9, 4.0006292078830175`*^9}, {
  4.0007221225217295`*^9, 4.000722133123322*^9}, {4.000722860128234*^9, 
  4.0007228628644648`*^9}, {4.0007241403062162`*^9, 
  4.000724143723923*^9}},ExpressionUUID->"8fb351e9-2054-41be-9770-\
d0696f78bed1"],

Cell[TextData[{
 "For a single loop we want to solve \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"u", "=", 
    RowBox[{"p", "(", "u", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ef346a7f-0e63-4fc1-a368-4fa9610dcab3"],
 "\nfor the return map p.  We can compute the derivative of P with respect to \
the parameters u.   We apply Newton\[CloseCurlyQuote]s method to \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", "u", ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"p", "(", "u", ")"}], "-", "u"}], "=", "0"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8f2d5099-c092-4240-ad6f-cbe8c8fda9fb"],
 "\nto get the iteration \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "new"], "=", 
    RowBox[{
     SubscriptBox["u", "old"], "-", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Dg", "(", 
        SubscriptBox["u", "old"], ")"}], 
       RowBox[{"-", "1"}]], 
      RowBox[{"g", "(", 
       SubscriptBox["u", "old"], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ea289227-c71b-41d6-845c-60ad9b9bc503"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Dg", "=", 
    RowBox[{"Dp", "-", 
     SubscriptBox["I", "2"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6a482f16-dc19-47cd-bd50-abe44e05a77f"],
 ".  Computing the return loop we saw above with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "1.0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dd57798d-7e11-4f99-a643-8ae4ef72c339"],
 " looks something like this."
}], "Text",
 CellChangeTimes->{{4.0005614722004504`*^9, 4.0005615343739376`*^9}, {
  4.000561590772004*^9, 4.000561760468672*^9}, {4.0006300071500416`*^9, 
