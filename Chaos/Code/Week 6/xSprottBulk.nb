Cell["Define the defined  functions and their derivatives", "Text",
 CellChangeTimes->{{4.0003709939920015`*^9, 4.0003710049763856`*^9}, {
  4.0003713843365307`*^9, 
  4.0003713854145517`*^9}},ExpressionUUID->"7af25558-97b5-46cf-85ca-\
747d6ff32f6d"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "Di", ",", "Dip", ",", "Rd", ",", "Rdp", ",", "Sa", ",", "Sap", ",", "Sg", 
   ",", "Sgp", ",", "He", ",", "HEp", ",", "Absp", ",", "m"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Di", "[", "u_", "]"}], ":=", 
   RowBox[{"Max", "[", 
    RowBox[{"u", ",", "0"}], "]"}]}], ";", " ", 
  RowBox[{
   RowBox[{"Dip", "[", "u_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"u", ">", "0"}], ",", "1", ",", "0"}], "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Rd", "[", "u_", "]"}], ":=", 
   RowBox[{"Min", "[", 
    RowBox[{"u", ",", "0"}], "]"}]}], ";", " ", 
  RowBox[{
   RowBox[{"Rdp", "[", "u_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"u", "<", "0"}], ",", "1", ",", "0"}], "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Sa", "[", "u_", "]"}], ":=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"u", "<", 
         RowBox[{"-", "1"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"u", ",", " ", 
        RowBox[{
         RowBox[{"-", "1"}], "<", "u", "<", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "True"}], "}"}]}], "}"}], "]"}]}], ";", " ", 
  RowBox[{
   RowBox[{"Sap", "[", "u_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", "u", "]"}], "<", "1"}], ",", "1", ",", "0"}], 
    "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Sg", "[", "m_", "]"}], "[", "u_", "]"}], ":=", 
   RowBox[{"Tanh", "[", 
    RowBox[{"m", " ", "u"}], "]"}]}], ";", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Sgp", "[", "m_", "]"}], "[", "u_", "]"}], ":=", 
   RowBox[{"m", " ", 
    SuperscriptBox[
     RowBox[{"Sech", "[", 
      RowBox[{"m", " ", "u"}], "]"}], "2"]}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"He", "[", "m_", "]"}], "[", "u_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"Tanh", "[", 
       RowBox[{"m", " ", "u"}], "]"}]}], ")"}], "/", "2"}]}], ";", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Hep", "[", "m_", "]"}], "[", "u_", "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", "m", " ", 
    SuperscriptBox[
     RowBox[{"Sech", "[", 
      RowBox[{"m", " ", "u"}], "]"}], "2"]}]}]}], "\n", 
 RowBox[{
  RowBox[{"Absp", "[", "u_", "]"}], ":=", " ", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"u", "<", "0"}], ",", 
    RowBox[{"-", "1"}], ",", "1"}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.000371027086153*^9, 4.00037103591358*^9}, {
  4.000371351413945*^9, 4.000371390824068*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"b407f3f4-cd40-4db6-97f8-ed091eae7c85"],

Cell["\<\
I put them in an association rather than a list.  The delayed assignment \
\[RuleDelayed] means the right hand side is not evaluated until called. An \
association means you can call things out by name.  This matches up directly \
with dictionaries in Julia, Python, and MATLAB.   All also have some type of \
lower level \[OpenCurlyDoubleQuote]struct\[CloseCurlyDoubleQuote] \
construction. \
\>", "Text",
 CellChangeTimes->{{4.0001956970688405`*^9, 4.0001957540613422`*^9}, {
  4.0001969109263287`*^9, 4.000196941961935*^9}, {4.000202689793105*^9, 
  4.0002027411719456`*^9}, {4.0002027882734413`*^9, 4.000202828254903*^9}, {
  4.000212253333036*^9, 
  4.0002122584612885`*^9}},ExpressionUUID->"1f01e76b-f404-4cab-a833-\
79d24c910925"],

Cell[TextData[{
 "I added definitions of the derivatives of all the functions (and their \
derivatives) beside where they were defined.  Mma was doing most (maybe all) \
of the derivatives correctly.  I changed the variables to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"y", ",", "yp", ",", "ypp"}], "}"}], TraditionalForm]],
  ExpressionUUID->"10aaa2d8-a3b1-47bc-8975-49ffc1f28b0a"],
 ".  "
}], "ItemNumbered",
 CellChangeTimes->{{4.00021226227333*^9, 4.0002123792133408`*^9}, {
  4.0002124772079144`*^9, 4.0002125093483133`*^9}, {4.0003692942744637`*^9, 
  4.0003692942899113`*^9}, {4.000371559133675*^9, 
  4.000371570868827*^9}},ExpressionUUID->"ac9f4c99-d07b-4571-a290-\
1793c462f688"],

