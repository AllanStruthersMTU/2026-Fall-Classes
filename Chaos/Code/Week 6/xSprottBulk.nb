 CellChangeTimes->{{4.0004617904802027`*^9, 
  4.00046179080297*^9}},ExpressionUUID->"ef42a6c7-7cf2-4a2e-b986-\
78ad778054c7"],

Cell["", "Text",ExpressionUUID->"e28f46cb-15f2-4075-9e91-e31ed5109af8"],

Cell[TextData[{
 "These use the top ",
 Cell[BoxData[
  FormBox["\[PlusMinus]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e5b71c12-036e-4cd0-bb98-6307e2f6affd"],
 " definition from Sprott when there is a choice. The ancillary functions and \
derivatives are defined.  Jump discontinuities are smoothe using ",
 Cell[BoxData[
  FormBox[
   RowBox[{"tanh", "(", 
    RowBox[{"m", " ", "x"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ddf892f0-3435-4c68-9012-293153deb0c2"],
 " with a default value of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "50."}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0504fa03-24bf-4447-a8a3-64670a51098c"],
 "  All problems have parameters ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "m"}], "}"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "92b51785-bcc5-44ff-bb8f-e73a93cd6461"],
 ".  The smoothing parameter is only active in problems 11, 12, and 13.  The \
functions fSprott[p][y], dyfSprott[p][y] and dpfSprott[p][y] are defined and \
protected at the bottom of the initialization cell.  "
}], "Text",
 CellChangeTimes->{{4.000383818225066*^9, 4.0003838442348366`*^9}, {
   4.000383884718256*^9, 4.0003838999221478`*^9}, {4.0003841876964064`*^9, 
   4.0003842200577126`*^9}, 4.000459383028818*^9, {4.0004609111993303`*^9, 
   4.000461240209152*^9}},ExpressionUUID->"4df56422-b2f9-4b39-976a-\
e4e2ff8cb9f1"],

Cell["Here are a bunch of useful functions", "Text",
 CellChangeTimes->{{3.999855743934202*^9, 3.999855893891206*^9}, {
  4.000123071232369*^9, 4.0001232343900614`*^9}, {4.0001934737168045`*^9, 
  4.0001935042310762`*^9}, {4.000193847204818*^9, 4.0001938523079543`*^9}, {
  4.000194390733529*^9, 4.000194473969513*^9}, {4.0001954028650312`*^9, 
  4.0001954426473503`*^9}, {4.0003840235595617`*^9, 
  4.0003840473905096`*^9}},ExpressionUUID->"6804a1f1-275c-43ae-8189-\
fe9d33960021"],

Cell["\<\
I put them in an association rather than a list.  The delayed assignment \
\[RuleDelayed] means the right hand side is not evaluated until called. An \
association means you can call things out by name.  This matches up directly \
with dictionaries in Julia, Python, and MATLAB.   All also have some type of \
lower level \[OpenCurlyDoubleQuote]struct\[CloseCurlyDoubleQuote] \
construction. \
\>", "Text",
 CellChangeTimes->{{4.0001956970688405`*^9, 4.0001957540613422`*^9}, {
  4.0001969109263287`*^9, 4.000196941961935*^9}, {4.000202689793105*^9, 
  4.0002027411719456`*^9}, {4.0002027882734413`*^9, 4.000202828254903*^9}, {
  4.000212253333036*^9, 
  4.0002122584612885`*^9}},ExpressionUUID->"1f01e76b-f404-4cab-a833-\
79d24c910925"],

Cell[TextData[{
 "I added definitions of the derivatives of all the functions (and their \
derivatives) beside where they were defined.  Mma was doing most (maybe all) \
of the derivatives correctly.  I changed the variables to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"y", ",", "yp", ",", "ypp"}], "}"}], TraditionalForm]],
  ExpressionUUID->"10aaa2d8-a3b1-47bc-8975-49ffc1f28b0a"],
 ".  "
}], "ItemNumbered",
 CellChangeTimes->{{4.00021226227333*^9, 4.0002123792133408`*^9}, {
  4.0002124772079144`*^9, 4.0002125093483133`*^9}, {4.0003692942744637`*^9, 
  4.0003692942899113`*^9}, {4.000371559133675*^9, 
  4.000371570868827*^9}},ExpressionUUID->"ac9f4c99-d07b-4571-a290-\
1793c462f688"],

Cell["\<\
Request for Equilibrium Solver.   We need to think about what we are going to \
do with the parameters\
\>", "ItemNumbered",
 CellChangeTimes->{{4.00021226227333*^9, 4.0002123792133408`*^9}, {
  4.0002124772079144`*^9, 4.0002125093483133`*^9}, {4.0003692972339582`*^9, 
  4.0003693409111195`*^9}, {4.0003694176585317`*^9, 4.0003694594026747`*^9}, {
  4.0003717411187096`*^9, 
  4.0003717812111454`*^9}},ExpressionUUID->"d912b06f-f86e-43fe-9cc1-\
a94002d83b4f"],

Cell[TextData[{
 "Request for y and J solver.  I am added the derivative of the defining \
function wrt ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"y", ",", "yp", ",", "ypp"}], "}"}], TraditionalForm]],
  ExpressionUUID->"587bc9f7-fc0f-4fd5-aaaa-6be10286d6ac"],
 " to the structure. "
}], "ItemNumbered",
 CellChangeTimes->{{4.00021226227333*^9, 4.0002123792133408`*^9}, {
  4.0002124772079144`*^9, 4.0002125093483133`*^9}, {4.0003692972339582`*^9, 
