Cell[CellGroupData[{

Cell["ODE Functions", "Subsection",
 CellChangeTimes->{{4.000460884491954*^9, 4.000460901648095*^9}, {
  4.0004612701494446`*^9, 4.0004612728721027`*^9}, {4.000461653332133*^9, 
  4.000461658281066*^9}},ExpressionUUID->"46de5901-686f-4774-9af6-\
aec233a24f9c"],

Cell["\<\
These functions are going to work for more than the Sprott functions\
\>", "Text",
 CellChangeTimes->{{4.000461660487952*^9, 
  4.000461696749477*^9}},ExpressionUUID->"c4c40619-bb41-41ff-82ca-\
17d96dc2485f"],

Cell[CellGroupData[{

Cell["Basic Solvers", "Subsubsection",
 CellChangeTimes->{{4.0004617000299253`*^9, 
  4.000461704084298*^9}},ExpressionUUID->"ecebe80d-f902-48f2-ab88-\
5c50bcf57d48"],

Cell["\<\
I built f, dyf and dpf (assumed linear dependence) for the Sprott problems.  \
I want to solve our different sensitivity problems (only the y needs an \
initial condition) and return interpolating functions!  Following the \
discussion we want to be able to choose TMax.\
\>", "Text",
 CellChangeTimes->{{4.0004617120782304`*^9, 
  4.000461968124925*^9}},ExpressionUUID->"e6b7701c-7629-4013-ad31-\
645a428d9c1d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ODERun", "[", 
   RowBox[{"f_", ",", "y0_", ",", "TMax_"}], "]"}], ":=", 
  RowBox[{"NDSolveValue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
       RowBox[{"f", "[", 
        RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], "}"}], ",", 
    "\[IndentingNewLine]", "y", ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ODERun", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "dyf_"}], "}"}], ",", "y0_", ",", "TMax_"}], "]"}], ":=", 
  RowBox[{"NDSolveValue", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
       RowBox[{"f", "[", 
        RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"dyf", "[", 
         RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
        RowBox[{"J", "[", "t", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"J", "[", "0", "]"}], "=", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"Length", "[", "y0", "]"}], "]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"y", ",", "J"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ODERun", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "dyf_", ",", "dpf_"}], "}"}], ",", "y0_", ",", 
    "TMax_"}], "]"}], ":=", 
  RowBox[{"NDSolveValue", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
       RowBox[{"f", "[", 
        RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"dyf", "[", 
         RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
        RowBox[{"J", "[", "t", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"J", "[", "0", "]"}], "=", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"Length", "[", "y0", "]"}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"p", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"dpf", "[", 
         RowBox[{"y", "[", "t", "]"}], "]"}], "+", 
        RowBox[{
         RowBox[{"dyf", "[", 
          RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
         RowBox[{
          RowBox[{"p", "'"}], "[", "t", "]"}]}]}]}], ",", " ", 
      RowBox[{
       RowBox[{"p", "[", "0", "]"}], "==", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.0", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"dpf", "[", "y0", "]"}], "]"}]}], "]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"y", ",", "J", ",", "p"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.0004618706380825`*^9, 4.0004618868196445`*^9}, {
  4.0004619303236275`*^9, 4.0004619368862996`*^9}, {4.0004619748261585`*^9, 
  4.000462228734641*^9}, {4.000462447875944*^9, 4.000462513012766*^9}},
 CellLabel->"In[82]:=",ExpressionUUID->"1855e04a-6ff5-4af8-952e-9c64248e7ebc"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
