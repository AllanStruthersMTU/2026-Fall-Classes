Cell["This is my problem now. ", "Text",
 CellChangeTimes->{{4.0005426449998784`*^9, 
  4.0005426541644087`*^9}},ExpressionUUID->"19b73869-d5b9-409b-a225-\
200365c8155a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TMax", "=", 
   SuperscriptBox["10", "4"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"-", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "0"}], "}"}]}]}], ";", " ", 
  RowBox[{"p0", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0.1"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"M", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SectionPic", "=", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"n", ".", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}], "-", "p0"}], ")"}]}], "==",
       "0"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "M"}], ",", "M"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "M"}], ",", "M"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{"-", "M"}], ",", "M"}], "}"}], ",", 
     RowBox[{"ContourStyle", "\[Rule]", 
      RowBox[{"Opacity", "[", "0.5", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k", "=", "12"}], ";", 
  RowBox[{"y0", "=", 
   RowBox[{
    RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<IC\>\"", "]"}]}], ";", 
  RowBox[{"p", "=", 
   RowBox[{
    RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<par\>\"", "]"}]}], ";", 
  RowBox[{"f", "=", 
   RowBox[{"fSprott", "[", 
    RowBox[{"k", ",", "p"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ySol", ",", 
     RowBox[{"{", "yPts", "}"}]}], "}"}], "=", 
   RowBox[{"BasicSectionSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f", ",", "y0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "p0"}], "}"}], ",", "TMax"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<Sol\>\"", "->", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ParametricPlot3D", "[", 
        RowBox[{
         RowBox[{"ySol", "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "TMax"}], "}"}], ",", 
         RowBox[{"PlotPoints", "->", 
          SuperscriptBox["10", "3"]}], ",", 
         RowBox[{"PlotStyle", "->", "Thin"}], ",", 
         RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], ",", 
       "SectionPic"}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<3D Section\>\"", "->", 
     RowBox[{"Show", "[", 
      RowBox[{"SectionPic", ",", "\[IndentingNewLine]", 
       RowBox[{"ListPointPlot3D", "[", 
        RowBox[{"yPts", ",", 
         RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotLabel", "\[Rule]", 
        RowBox[{"StringForm", "[", 
         RowBox[{"\"\<`` points\>\"", ",", 
          RowBox[{"Length", "[", "yPts", "]"}]}], "]"}]}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<2D Section\>\"", "->", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"yPts", "\[LeftDoubleBracket]", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3"}], "}"}]}], "\[RightDoubleBracket]"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"AxesLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "\"\<\!\(\*SubscriptBox[\(y\), \(1\)]\)\>\"", ",", 
          "\"\<\!\(\*SubscriptBox[\(y\), \(3\)]\)\>\""}], "}"}]}]}], "]"}]}], 
    ",", "\[IndentingNewLine]", 
