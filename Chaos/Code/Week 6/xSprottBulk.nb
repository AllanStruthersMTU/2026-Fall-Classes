         RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<par\>\"", "]"}]}], 
       "]"}], "[", 
      RowBox[{"{", 
       RowBox[{"y", ",", "yp", ",", "ypp"}], "}"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"dyfSprott", "[", "k", "]"}], "[", 
      RowBox[{"{", 
       RowBox[{"y_", ",", "yp_", ",", "ypp_"}], "}"}], "]"}], "=", 
     RowBox[{
      RowBox[{"dyfSprott", "[", 
       RowBox[{"k", ",", 
        RowBox[{
         RowBox[{"Sprott", "[", "k", "]"}], "[", "\"\<par\>\"", "]"}]}], 
       "]"}], "[", 
      RowBox[{"{", 
       RowBox[{"y", ",", "yp", ",", "ypp"}], "}"}], "]"}]}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"k", ",", "22"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
