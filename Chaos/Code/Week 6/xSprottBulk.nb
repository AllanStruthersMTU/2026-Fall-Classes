Cell[CellGroupData[{

Cell["Basic yJ Solver", "Subsection",
 CellChangeTimes->{{4.000372110338453*^9, 4.0003721162102737`*^9}, {
  4.0003725400335455`*^9, 
  4.000372544506009*^9}},ExpressionUUID->"883b9437-eb90-4c3d-956f-\
c90d75e624c5"],

Cell["\<\
Thinking about the basic solver.   We need to know what to do with the \
parameters.  In some ways this is much easier than the equilibrium \
computation.  We will always have values for the parameters.  The first thing \
I would do is build and example out of one of the problems\
\>", "Text",
 CellChangeTimes->{{4.0003719561038175`*^9, 4.000371969137442*^9}, {
  4.0003721252421384`*^9, 4.0003721391038895`*^9}, {4.0003725579795227`*^9, 
  4.0003725693789263`*^9}, {4.0003727103073874`*^9, 4.000372758354866*^9}, {
  4.000373198308343*^9, 
  4.00037323283213*^9}},ExpressionUUID->"1335e58e-9235-496d-840e-\
f32bc06b5e21"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_", ",", "m_"}], "}"}], "]"}],
    "[", 
   RowBox[{"{", 
    RowBox[{"y_", ",", "yp_", ",", "ypp_"}], "}"}], "]"}], "=", 
  RowBox[{"{", 
   RowBox[{"yp", ",", "ypp", ",", 
    RowBox[{
     RowBox[{"NewSprott", "[", "k", "]"}], "[", "\"\<fun\>\"", "]"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"df", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_", ",", "m_"}], "}"}], "]"}],
    "[", 
   RowBox[{"{", 
    RowBox[{"y_", ",", "yp_", ",", "ypp_"}], "}"}], "]"}], "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
    RowBox[{
     RowBox[{"NewSprott", "[", "k", "]"}], "[", "\"\<der\>\"", "]"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"p", "=", 
  RowBox[{
   RowBox[{"NewSprott", "[", "k", "]"}], "[", "\"\<par\>\"", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"u0", "=", 
  RowBox[{
   RowBox[{"NewSprott", "[", "k", "]"}], "[", "\"\<IC\>\"", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "123"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"uSol", ",", "JSol"}], "}"}], "=", 
  RowBox[{"NDSolveValue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"u", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"f", "[", "p", "]"}], "[", 
        RowBox[{"u", "[", "t", "]"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{
         RowBox[{"df", "[", "p", "]"}], "[", 
         RowBox[{"u", "[", "t", "]"}], "]"}], ".", 
        RowBox[{"J", "[", "t", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"u", "[", "0", "]"}], "==", "u0"}], ",", 
      RowBox[{
       RowBox[{"J", "[", "0", "]"}], "==", 
       RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"u", ",", "J"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot3D", "[", 
  RowBox[{
   RowBox[{"uSol", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"JSol", "[", "1", "]"}], "\[IndentingNewLine]", 
 RowBox[{"SingularValueList", "[", 
  RowBox[{
   RowBox[{"JSol", "[", "TMax", "]"}], ",", 
   RowBox[{"Tolerance", "->", "0"}]}], "]"}]}], "Input",
