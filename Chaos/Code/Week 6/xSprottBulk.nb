              "Rows" -> {0.2, {0.4}, 0.2}, "RowsIndexed" -> {}}], "\:f3a2", 
           ")"}],
          Function[BoxForm`e$, 
           MatrixForm[BoxForm`e$]]], ".", 
         RowBox[{"y", "[", "x", "]"}]}]}], "==", "0"}], ",", 
