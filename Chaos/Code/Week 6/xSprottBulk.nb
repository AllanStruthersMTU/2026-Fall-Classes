ed935df64727"],

Cell[TextData[{
 "These use the top ",
 Cell[BoxData[
  FormBox["\[PlusMinus]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7aa2f3fa-0417-409a-8333-390080a104ec"],
 " definition from Sprott when there is a choice. The ancillary functions and \
derivatives are defined.  Jump discontinuities are smoothe using ",
 Cell[BoxData[
  FormBox[
   RowBox[{"tanh", "(", 
    RowBox[{"m", " ", "x"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2dbd71ea-f7bb-488d-813c-e3a491e63c47"],
 " with a default value of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "50."}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "361f9b39-d604-4ef7-9059-933a4cd73e72"],
 "  All problems have parameters ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "m"}], "}"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d6211ecb-b299-4deb-bb7b-6cdf17fce4e4"],
 ".  The smoothing parameter is only active in problems 11, 12, and 13.  The \
functions fSprott[p][y], dyfSprott[p][y] and dpfSprott[p][y] are defined and \
protected at the bottom of the initialization cell.  "
}], "Text",
 CellChangeTimes->{{4.000383818225066*^9, 4.0003838442348366`*^9}, {
   4.000383884718256*^9, 4.0003838999221478`*^9}, {4.0003841876964064`*^9, 
