Cell[TextData[{
 "I guess we want to solve the twice around system \n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{GridBox[{
         {
          SubscriptBox["q", "2"], "=", 
          RowBox[{"p", "(", 
           SubscriptBox["q", "1"], ")"}]},
         {
          SubscriptBox["q", "1"], "=", 
          RowBox[{"p", "(", 
           SubscriptBox["q", "2"], ")"}]}
        }], "\[DoubleLongRightArrow]"}], 
      RowBox[{
       RowBox[{GridBox[{
          {
           RowBox[{
            RowBox[{"p", "(", 
             SubscriptBox["q", "1"], ")"}], "-", 
            SubscriptBox["q", "2"]}], "=", "0"},
          {
           RowBox[{
            RowBox[{"p", "(", 
             SubscriptBox["q", "2"], ")"}], "-", 
            SubscriptBox["q", "1"]}], "=", "0"}
         }], "\[DoubleLongRightArrow]", 
        RowBox[{"f", "(", "q", ")"}]}], "=", "0"}]}
    }], TraditionalForm]],ExpressionUUID->
  "0b755d04-063a-456e-a1d6-b069ead30fad"],
 "\nwhere \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", "=", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["q", "1"]},
       {
        SubscriptBox["q", "2"]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "abdebb82-4283-45ce-a7b8-b88250ef2b13"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "q", ")"}], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         RowBox[{"p", "(", 
          SubscriptBox["q", "1"], ")"}], "-", 
         SubscriptBox["q", "2"]}]},
       {
        RowBox[{
         RowBox[{"p", "(", 
          SubscriptBox["q", "2"], ")"}], "-", 
         SubscriptBox["q", "1"]}]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "77662101-fda8-4177-b5db-1ddd3e63a166"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Df", "(", "q", ")"}], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"Dp", "(", 
         SubscriptBox["q", "1"], ")"}], 
        RowBox[{"-", 
         SubscriptBox["I", "2"]}]},
       {
        RowBox[{"-", 
         SubscriptBox["I", "2"]}], 
        RowBox[{"Dp", 
         RowBox[{"(", 
          SubscriptBox["q", "2"], ")"}]}]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "cdfe3a3b-3301-44d8-898f-335d93a36da8"],
 "  \nNewton\[CloseCurlyQuote]s method (where ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["q", "k"], TraditionalForm]],ExpressionUUID->
  "368eef94-79d5-41f8-b3d0-389b229f62a0"],
 " indicates the kth iteration of the stack) is\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["q", 
     RowBox[{"k", "+", "1"}]], "=", 
    RowBox[{
     SuperscriptBox["q", "k"], "-", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Df", "(", 
        SuperscriptBox["q", "k"], ")"}], 
       RowBox[{"-", "1"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"f", "(", 
         SuperscriptBox["q", "k"], ")"}], "-", 
        SuperscriptBox["q", "k"]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"4464ed01-ecb0-49f2-9872-6e36e746b471"],
 "\nThis is easy enough to implement.  I am going to try to compute the c=3.5 \
twice around blue orbit.   A rough estimate of a starting point is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2.0", ",", "8.0"}], "}"}], TraditionalForm]],ExpressionUUID->
  "9b92105e-b571-4506-b05c-ec48c1fe5799"],
 " for the high section point and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"3.0", ",", "1.0"}], "}"}], TraditionalForm]],ExpressionUUID->
  "b04fe22a-54cc-4018-86ba-4e3eb4925a61"],
 " for the low section point. "
}], "Text",
 CellChangeTimes->{{4.0002933125183687`*^9, 4.000293320085085*^9}, {
  4.000293354548213*^9, 4.00029428733659*^9}, {4.000294848390086*^9, 
  4.0002949094463096`*^9}, {4.0002950758295164`*^9, 4.0002952011420383`*^9}, {
  4.000296254967075*^9, 4.0002962638361797`*^9}, {4.0002963535183177`*^9, 
  4.000296377420882*^9}, {4.0002964622186427`*^9, 
  4.000296473419772*^9}},ExpressionUUID->"2cbdee22-c902-4a34-a029-\
3452cf2e11ec"],

