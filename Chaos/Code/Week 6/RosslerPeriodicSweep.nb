         RowBox[{"p1", "-", 
          RowBox[{"u", "\[LeftDoubleBracket]", 
           RowBox[{"{", 
            RowBox[{"3", ",", "4"}], "}"}], "\[RightDoubleBracket]"}]}], ",", 
         RowBox[{"p2", "-", 
          RowBox[{"u", "\[LeftDoubleBracket]", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}], "\[RightDoubleBracket]"}]}]}], 
        "}"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", "2", " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
