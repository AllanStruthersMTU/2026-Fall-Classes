Cell[TextData[{
 "The previous notebook implemented return maps, their section derivatives, \
and a Newton solve on the vertical section  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalSigma]", "-"], "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["y", "1"], "=", "c"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          SubscriptBox["y", "2"]}], "-", 
         SubscriptBox["y", "3"]}], "<", "0"}]}], "}"}], "\[Subset]", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "3"]}]}], TraditionalForm]],
  ExpressionUUID->"3f1e56a4-c867-43be-bd6b-c04868b91d85"],
 " for Rossler.  This notebook uses these tools to explore the behavior of \
orbits for  a range of values of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "1debcd5a-adf4-4dfe-900f-2d7939391718"],
 ".   The code cell below contains many of the functions we have built so far."
}], "Text",
 CellChangeTimes->{{3.999855743934202*^9, 3.999855893891206*^9}, {
  4.000123071232369*^9, 4.0001232343900614`*^9}, {4.0002832840361414`*^9, 
  4.000283373572794*^9}, {4.000283476981671*^9, 
  4.0002835595020776`*^9}},ExpressionUUID->"6804a1f1-275c-43ae-8189-\
fe9d33960021"],

Cell[CellGroupData[{

Cell["Code", "Subsection",
 CellChangeTimes->{{4.0002835764381742`*^9, 
  4.000283576867496*^9}},ExpressionUUID->"2e7e5a06-8aa5-4944-a173-\
e91962e2456d"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "dyf", ",", "ReturnMapAndTimeAndJ"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", 
    RowBox[{"x", " ", "+", " ", 
     RowBox[{"a", " ", "y"}]}], ",", 
    RowBox[{"b", " ", "+", " ", 
     RowBox[{"z", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dyf", "[", 
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
   RowBox[{"(", GridBox[{
      {"0", 
       RowBox[{"-", "1"}], 
       RowBox[{"-", "1"}]},
      {"1", "a", "0"},
      {"z", "0", 
       RowBox[{"x", "-", "c"}]}
     }], ")"}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dcf", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"0", ",", "0", ",", 
    RowBox[{"-", "z"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ReturnMapAndTimeAndJ", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"f_", ",", "dyf_"}], "}"}]}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"u1_", ",", "u2_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y0", ",", 
      RowBox[{"TMin", "=", "0.001"}], ",", 
      RowBox[{"TMax", "=", "123"}], ",", "\[IndentingNewLine]", "tVal", ",", 
      "yVal", ",", "JVal", ",", "ySol", ",", "JSol", ",", "y", ",", "J", ",", 
      "t"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"y0", "=", 
      RowBox[{"{", 
       RowBox[{"c", ",", "u1", ",", "u2"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tVal", ",", "yVal", ",", "JVal"}], "}"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"Reap", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ySol", ",", "JSol"}], "}"}], "=", " ", 
          RowBox[{"NDSolveValue", "[", " ", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
               RowBox[{
                RowBox[{"f", "[", 
                 RowBox[{"{", 
                  RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", 
                RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
               RowBox[{
                RowBox[{
                 RowBox[{"dyf", "[", 
                  RowBox[{"{", 
                   RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "[", 
                 RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
                RowBox[{"J", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
              RowBox[{
               RowBox[{"J", "[", "0", "]"}], "==", 
               RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"WhenEvent", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"Indexed", "[", 
                   RowBox[{
                    RowBox[{"y", "[", "t", "]"}], ",", "1"}], "]"}], "-", 
                  "c"}], " ", "<", "0"}], ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"t", ">", "TMin"}], ",", " ", 
                  RowBox[{
                   RowBox[{"Sow", "[", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", 
                    RowBox[{"y", "[", "t", "]"}], ",", 
                    RowBox[{"J", "[", "t", "]"}]}], "}"}], "]"}], ";", " ", 
                   "\"\<StopIntegration\>\""}]}], "]"}]}], "]"}]}], 
             "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{
              "I", " ", "have", " ", "no", " ", "idea", " ", "why", " ", "I", 
               " ", "had", " ", "to", " ", "use", " ", "indexed", " ", 
               "instead", " ", 
               RowBox[{"of", " ", "[", 
                RowBox[{"[", "]"}], "]"}], " ", "in", " ", 
               RowBox[{"here", "!"}]}], " ", "*)"}], "\[IndentingNewLine]", 
             "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"y", ",", "J"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], "]"}]}], ";"}], 
        "\[IndentingNewLine]", "]"}], "\[LeftDoubleBracket]", 
       RowBox[{"2", ",", "1", ",", "1"}], "\[RightDoubleBracket]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9999347480842705`*^9, 3.9999348321501694`*^9}, {
   3.9999349255868273`*^9, 3.9999351569467325`*^9}, {3.9999352480481567`*^9, 
