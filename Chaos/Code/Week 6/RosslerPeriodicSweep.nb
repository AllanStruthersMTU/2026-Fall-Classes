  4.000289842910284*^9, 4.00029299720151*^9, 4.0020215697379465`*^9},
 CellLabel->
  "Out[103]=",ExpressionUUID->"0b7ffdf0-5d7c-4a3c-b700-ac2edbd188fe"]
}, Open  ]],

Cell[TextData[{
 "Newton\[CloseCurlyQuote]s method will fill this in more without waiting \
forever!  The plot shows a single loop solution with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "2.0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ad68a7f4-74fe-4816-9837-61e7246936ab"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "3"], "\[TildeTilde]", "2.6"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e673ce7c-ce52-403f-9272-d4879d18b773"],
 ".  We could work out a better guess for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c59cee1b-6062-49cd-84ba-db18b277fc81"],
 " but we will just use ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "2"], "=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "562ee527-33e8-4942-ae2f-681580a8ad5d"],
 " and run Newton\[CloseCurlyQuote]s method"
}], "Text",
 CellChangeTimes->{{4.0002897810265093`*^9, 4.000289843117202*^9}, {
  4.000289935628119*^9, 
  4.0002900652856183`*^9}},ExpressionUUID->"5dc9c298-7655-4198-9e11-\
8280090e8496"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"0.2", ",", "0.2", ",", "2.0"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dc", "=", "0.01"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u0", "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2.6"}], "}"}]}], ";", " ", 
  RowBox[{"Tol", "=", 
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"n", ",", "u", ",", " ", "err"}], "}"}], "=", 
  RowBox[{
   RowBox[{"FPNewt", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"f", ",", "dyf"}], "}"}], ",", "Tol"}], "]"}], "[", "u0", 
   "]"}]}]}], "Input",
 CellChangeTimes->{{4.0002931671920137`*^9, 4.0002931792891345`*^9}},
 CellLabel->
  "In[104]:=",ExpressionUUID->"da70fb8f-ef73-477d-ae88-0c8baab48c0f"],

