Cell[CellGroupData[{

Cell["1st Order ODE System with Parameters", "Subsection",
 CellChangeTimes->{{3.9998557312934685`*^9, 3.9998557347141314`*^9}, {
  3.99985592353244*^9, 3.999855930985836*^9}, {3.9998562764285994`*^9, 
  3.9998562820218644`*^9}},ExpressionUUID->"d9a6e1a0-a160-4e7c-8164-\
b46364fd6ba8"],

Cell[TextData[{
 "The default #12 ODE is \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", GridBox[{
        {
         SubscriptBox["y", "1"]},
        {
         SubscriptBox["y", "2"]},
        {
         SubscriptBox["y", "3"]}
       }], ")"}], "'"], "=", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["y", "2"]},
       {
        SubscriptBox["y", "3"]},
       {
        RowBox[{
         RowBox[{
          RowBox[{"-", "0.5"}], " ", 
          SubscriptBox["y", "3"]}], "-", 
         SubscriptBox["y", "2"], "+", 
         SubscriptBox["y", "1"], " ", "-", 
         RowBox[{"Sign", "[", 
          SubscriptBox["y", "1"], "]"}]}]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "21ba9ad4-ccea-4675-88ee-d843bed974a2"],
 "\nI am going to add parameters a, b, c, and d in the last equation. For \
convenience I am going to pass the parameters at the front of the function.  \
The default values of the parameters are going to be ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{"0.5", ",", "1", ",", "1", ",", "1"}], "}"}]}], 
   TraditionalForm]],ExpressionUUID->"0a636625-0fac-4c0f-842e-06ccb771be9f"],
 ".  The function is \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], "]"}], "[", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["y", "1"], ",", 
       SubscriptBox["y", "2"], ",", 
       SubscriptBox["y", "3"]}], "}"}], "]"}], "=", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["y", "2"]},
       {
        SubscriptBox["y", "3"]},
       {
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], " ", 
          SubscriptBox["y", "3"]}], "-", 
         RowBox[{"b", " ", 
          SubscriptBox["y", "2"]}], "+", 
         RowBox[{"c", " ", 
          SubscriptBox["y", "1"]}], " ", "-", 
         RowBox[{"d", " ", 
          RowBox[{"Sign", "[", 
           SubscriptBox["y", "1"], "]"}]}]}]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "c275494c-e1b6-4f71-9f4c-e289dd1053ab"],
 " \nThe function is defined below. The first test has the default parameters \
called p0.  The second has nearby parameters called p1. "
}], "Text",
 CellChangeTimes->{{3.997366603162095*^9, 3.9973668652926683`*^9}, {
  3.999855954345003*^9, 3.9998559682521048`*^9}, {3.999856291023569*^9, 
  3.999856593516858*^9}, {3.999856693126961*^9, 3.999856730168309*^9}, {
  3.999857022009712*^9, 3.9998570555260487`*^9}, {3.999857291376608*^9, 
  3.999857302411169*^9}},ExpressionUUID->"e71fe476-5dc4-4b78-b4f7-\
e003af90930b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "w"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"y1_", ",", "y2_", ",", "y3_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{"y2", ",", "y3", ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "a"}], " ", "y3"}], "-", 
     RowBox[{"b", " ", "y2"}], "+", 
     RowBox[{"c", " ", "y1"}], " ", "-", 
     RowBox[{"d", " ", 
      RowBox[{"Sign", "[", "y1", "]"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p0", "=", 
   RowBox[{"{", 
    RowBox[{"0.5", ",", "1", ",", "1", ",", "1"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p1", "=", 
   RowBox[{"{", 
    RowBox[{"0.5", ",", "1", ",", "1", ",", "0.9"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "123"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ySol0", "=", " ", 
   RowBox[{"NDSolveValue", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"f", "[", "p0", "]"}], "[", 
         RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], "}"}], ",", "y", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ySol1", "=", " ", 
   RowBox[{"NDSolveValue", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"f", "[", "p1", "]"}], "[", 
         RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], "}"}], ",", "y", ",", 
