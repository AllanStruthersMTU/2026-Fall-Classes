Cell[TextData[{
 "Our smoothed function is \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["y", "1"], ",", 
       SubscriptBox["y", "2"], ",", 
       SubscriptBox["y", "3"]}], "}"}], ")"}], "=", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["y", "2"]},
       {
        SubscriptBox["y", "3"]},
       {
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], " ", 
          SubscriptBox["y", "3"]}], "-", 
         RowBox[{"b", " ", 
          SubscriptBox["y", "2"]}], "+", 
         RowBox[{"c", " ", 
          SubscriptBox["y", "1"]}], " ", "-", 
         RowBox[{"d", " ", 
          RowBox[{"tanh", "(", 
           RowBox[{"m", " ", 
            SubscriptBox["y", "1"]}], ")"}]}]}]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "74636328-9d49-41bd-9cf9-ed8e2f42525a"],
 " \nDifferentiate ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{"f", "(", "y", ")"}]}], TraditionalForm]],ExpressionUUID->
  "4b5b9a0b-9319-4c7f-9570-7b7b2ea31185"],
 "  and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "(", "0", ")"}], "=", "x"}], TraditionalForm]],
  ExpressionUUID->"6eae74a5-2f7d-47b0-9149-f40158747ae5"],
 " with respect to ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "a7eff762-fbf4-4dbb-889e-6995bb47c88d"],
 " to get\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "x"], 
     RowBox[{"y", "'"}]}], "=", 
    RowBox[{
     RowBox[{"df", "(", "y", ")"}], " ", 
     RowBox[{
      SubscriptBox["\[Del]", "x"], "y"}]}]}], TraditionalForm]],
  ExpressionUUID->"4649c43d-003e-4a26-92a3-68a00b258e42"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "x"], 
     RowBox[{"y", "(", "0", ")"}]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Del]", "x"], "x"}], "=", 
     SubscriptBox["I", "3"]}]}], TraditionalForm]],ExpressionUUID->
  "ceeba135-50a5-4c89-b34d-cc302e5abea1"],
 "\nwhere the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "3"}], TraditionalForm]],ExpressionUUID->
  "35216a9c-5084-4f7f-a895-c0690e511313"],
 " derivative of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "75f7a4d3-0052-46fa-9c0c-b00712e9c0a1"],
 " with respect to y is \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"df", "(", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["y", "1"], ",", 
       SubscriptBox["y", "2"], ",", 
       SubscriptBox["y", "3"]}], "}"}], ")"}], "=", 
    RowBox[{"(", GridBox[{
       {"0", "1", "0"},
       {"0", "0", "1"},
       {
        RowBox[{"c", " ", "-", " ", 
         RowBox[{"d", " ", "m", " ", 
          RowBox[{
           SuperscriptBox["sech", "2"], "(", 
           RowBox[{"m", " ", "y"}], ")"}]}]}], 
        RowBox[{"-", "b"}], 
        RowBox[{"-", "a"}]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "e9ba2308-80c0-424d-b843-d7f47447191b"],
 ".\nThe ODE for the sensitivity matrix ",
 Cell[BoxData[
  FormBox[
   FormBox[
    RowBox[{"J", "=", 
     RowBox[{
      SubscriptBox["\[Del]", "x"], "y"}]}],
    TraditionalForm], TraditionalForm]],ExpressionUUID->
  "b27cc4dd-8f70-4a2f-b972-8c58f64e64bc"],
 "  \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"J", "'"}], "=", 
    RowBox[{
     RowBox[{"df", "(", "y", ")"}], " ", "J"}]}], TraditionalForm]],
  ExpressionUUID->"88310c5d-21e9-472d-886c-de48b975b632"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"J", "(", "0", ")"}], "=", 
    SubscriptBox["I", "3"]}], TraditionalForm]],ExpressionUUID->
  "f798f53c-e2df-4263-9016-62794ac31b55"],
 "\nnaturally contains a matrix-matrix product.  I am going to add \
\[OpenCurlyDoubleQuote]m\[CloseCurlyDoubleQuote] to the parameter list and \
pick a default value of 30."
}], "Text",
 CellChangeTimes->{{3.997366603162095*^9, 3.9973668652926683`*^9}, {
  3.999855954345003*^9, 3.9998559682521048`*^9}, {3.999856291023569*^9, 
  3.999856593516858*^9}, {3.999856693126961*^9, 3.999856730168309*^9}, {
  3.999857022009712*^9, 3.9998570555260487`*^9}, {3.999857291376608*^9, 
  3.999857302411169*^9}, {3.9998573493778906`*^9, 3.999857715110833*^9}, {
  3.999857943912201*^9, 3.999857954197857*^9}, {3.9998580214271746`*^9, 
  3.9998580394966955`*^9}, {3.9998580803725395`*^9, 3.9998583613301163`*^9}, {
  3.999858601349631*^9, 3.99985863652503*^9}, {3.999858726388894*^9, 
  3.999858740384104*^9}},ExpressionUUID->"31499842-bf56-440f-a889-\
48e7f4378c02"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "w"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_", ",", "m_"}], "}"}], "]"}],
    "[", 
   RowBox[{"{", 
    RowBox[{"y1_", ",", "y2_", ",", "y3_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{"y2", ",", "y3", ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "a"}], " ", "y3"}], "-", 
     RowBox[{"b", " ", "y2"}], "+", 
     RowBox[{"c", " ", "y1"}], " ", "-", 
     RowBox[{"d", " ", 
      RowBox[{"Tanh", "[", 
       RowBox[{"m", " ", "y1"}], "]"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"df", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_", ",", "m_"}], "}"}], "]"}],
    "[", 
   RowBox[{"{", 
    RowBox[{"y1_", ",", "y2_", ",", "y3_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"(", GridBox[{
     {"0", "1", "0"},
     {"0", "0", "1"},
     {
      RowBox[{"c", " ", "-", " ", 
       RowBox[{"d", " ", "m", " ", 
        SuperscriptBox[
         RowBox[{"Sech", "[", 
          RowBox[{"m", " ", "y1"}], "]"}], "2"]}]}], 
      RowBox[{"-", "b"}], 
      RowBox[{"-", "a"}]}
    }], ")"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p0", "=", 
   RowBox[{"{", 
    RowBox[{"0.5", ",", "1", ",", "1", ",", "1", ",", "30"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p1", "=", 
   RowBox[{"{", 
    RowBox[{"0.5", ",", "1", ",", "1", ",", "0.9", ",", "30"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "123"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"J0", "=", 
   RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ySol0", ",", "JSol0"}], "}"}], "=", " ", 
   RowBox[{"NDSolveValue", "[", " ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"f", "[", "p0", "]"}], "[", 
         RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"df", "[", "p0", "]"}], "[", 
          RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
         RowBox[{"J", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
       RowBox[{
        RowBox[{"J", "[", "0", "]"}], "==", "J0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "J"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ySol1", ",", "JSol1"}], "}"}], "=", " ", 
   RowBox[{"NDSolveValue", "[", " ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"f", "[", "p1", "]"}], "[", 
         RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"df", "[", "p1", "]"}], "[", 
          RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
         RowBox[{"J", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
       RowBox[{
        RowBox[{"J", "[", "0", "]"}], "==", "J0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "J"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot3D", "[", 
