Cell[CellGroupData[{

Cell[TextData[{
 "Smooth Parameterized 1st Order ODE System with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"J", "=", 
    RowBox[{
     SubscriptBox["\[Del]", "x"], "y"}]}], TraditionalForm]],ExpressionUUID->
  "281c59fe-414c-4475-bbaa-0809f1fc6267"]
}], "Subsection",
 CellChangeTimes->{{3.9998557312934685`*^9, 3.9998557347141314`*^9}, {
  3.99985592353244*^9, 3.999855930985836*^9}, {3.9998562764285994`*^9, 
  3.9998562820218644`*^9}, {3.9998573174884915`*^9, 3.9998573364776707`*^9}, {
  3.9998672066359243`*^9, 
  3.999867208999847*^9}},ExpressionUUID->"8850f303-ff32-460d-ae83-\
b3fda8a88a81"],

Cell[TextData[{
 "Our function is not smooth enough for our ",
 Cell[BoxData[
  FormBox["J", TraditionalForm]],ExpressionUUID->
  "f333e2ed-eb15-4a56-ad19-9f0aa908a4f2"],
 " trick! I am going to cheat and replace the non-smooth term with a smoothed \
out variant.\n\t "
}], "Text",
 CellChangeTimes->{{3.9998577406011653`*^9, 3.9998578314617095`*^9}, {
  3.9998578944233904`*^9, 
  3.9998578958784213`*^9}},ExpressionUUID->"358004a2-d942-400e-80e9-\
3af83633415e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sign", "[", "y", "]"}], ",", 
     RowBox[{"Tanh", "[", "y", "]"}], ",", 
     RowBox[{"Tanh", "[", 
      RowBox[{"3", "y"}], "]"}], ",", 
     RowBox[{"Tanh", "[", 
      RowBox[{"10", " ", "y"}], "]"}], ",", 
     RowBox[{"Tanh", "[", 
      RowBox[{"20", "y"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "\[Rule]", "\"\<Expressions\>\""}]}], 
  "]"}]], "Input",
