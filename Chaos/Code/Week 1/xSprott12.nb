Notebook[{

Cell[CellGroupData[{
Cell["Sprott #12", "Title",
 CellChangeTimes->{{3.997354396199274*^9, 
  3.9973544008679843`*^9}},ExpressionUUID->"ee41a007-0d2f-4b6e-9991-\
30a592e66adf"],

Cell[TextData[{
 "The ODE is\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"y", "'''"}], "[", "t", "]"}], "==", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "0.5"}], 
      RowBox[{
       RowBox[{"y", "''"}], "[", "t", "]"}]}], "-", 
     RowBox[{
      RowBox[{"y", "'"}], "[", "t", "]"}], "+", 
     RowBox[{"y", "[", "t", "]"}], "-", 
     RowBox[{"Sign", "[", 
      RowBox[{"y", "[", "t", "]"}], "]"}]}]}], TraditionalForm]],
  ExpressionUUID->"7fe7af36-16a1-4f1e-8ec1-8ade334b936e"],
 "\nIt (and it\[CloseCurlyQuote]s companion #11) are not quite smooth enough \
for our standard \[OpenCurlyDoubleQuote]Lipschitz\[CloseCurlyDoubleQuote] \
existence and uniqueness theorem!  This was addressed in a lecture. For now \
we are just going to approximate the solution numerically."
}], "Text",
 CellChangeTimes->{{3.999855743934202*^9, 
  3.999855893891206*^9}},ExpressionUUID->"6804a1f1-275c-43ae-8189-\
fe9d33960021"],

Cell[CellGroupData[{

Cell["3rd Order ODE", "Subsection",
 CellChangeTimes->{{3.9998557312934685`*^9, 
  3.9998557347141314`*^9}},ExpressionUUID->"9d23d565-ba0d-48ba-aa52-\
3ece77ad1809"],

Cell["\<\
The natural way to solve the 3rd order ODE in Mathematica.  The corners in \
the solution are directly from the jump in \[OpenCurlyDoubleQuote]Sign\
\[CloseCurlyDoubleQuote].\
\>", "Text",
 CellChangeTimes->{{3.9998556949171233`*^9, 3.9998557163865547`*^9}, {
  3.9998559015626097`*^9, 3.999855908094535*^9}, {3.999856059190877*^9, 
  3.9998560977077622`*^9}},ExpressionUUID->"1b6b6156-2531-41d4-ad74-\
a902efa8c80a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TMax", "=", "123"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ySol", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "'''"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "0.5"}], 
          RowBox[{
           RowBox[{"y", "''"}], "[", "t", "]"}]}], "-", 
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}], "+", 
         RowBox[{"y", "[", "t", "]"}], "-", 
         RowBox[{"Sign", "[", 
          RowBox[{"y", "[", "t", "]"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "0", "]"}], "==", "1"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "''"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", " ",
      "y", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<y, y', y'' vs t\>\"", "->", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ySol", "[", "t", "]"}], ",", 
         RowBox[{
          RowBox[{"ySol", "'"}], "[", "t", "]"}], ",", 
         RowBox[{
          RowBox[{"ySol", "''"}], "[", "t", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<Phase Plot\>\"", "->", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ySol", "[", "t", "]"}], ",", 
         RowBox[{
          RowBox[{"ySol", "'"}], "[", "t", "]"}], ",", 
         RowBox[{
          RowBox[{"ySol", "''"}], "[", "t", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotPoints", "->", "100"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "}"}], "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.997354405262052*^9, 3.9973546354232903`*^9}, {
  3.997354768784474*^9, 3.997354840355563*^9}, {3.9973548729879723`*^9, 
  3.9973548767711415`*^9}, {3.9973549785700808`*^9, 3.9973550358227863`*^9}, {
  3.9973550707600174`*^9, 3.9973551038666735`*^9}, {3.999855985700227*^9, 
  3.9998560511910496`*^9}},
 CellLabel->
  "In[959]:=",ExpressionUUID->"64a878b8-47c3-4982-92b4-a9b4dc2876f8"],

