Cell[CellGroupData[{

Cell["1st Order ODE System", "Subsection",
 CellChangeTimes->{{3.9998557312934685`*^9, 3.9998557347141314`*^9}, {
  3.99985592353244*^9, 
  3.999855930985836*^9}},ExpressionUUID->"5d0a03bd-96c6-4cdc-803b-\
449fa590d3fd"],

Cell[TextData[{
 "We can write this as a first order system for the vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"w", "=", 
    RowBox[{"(", GridBox[{
       {"y"},
       {"v"},
       {"a"}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "e1c3a381-d478-4ece-be76-6ac322357e5c"],
 "  where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", "y"}], TraditionalForm]],ExpressionUUID->
  "dd2a850b-b4f9-4011-a766-2e278a20c2d4"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    RowBox[{"y", "'"}]}], TraditionalForm]],ExpressionUUID->
  "d8f66b48-0c43-43d3-ba1a-6ec9eae46f8f"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", 
    RowBox[{
     RowBox[{"v", "'"}], "=", 
     RowBox[{"y", "''"}]}]}], TraditionalForm]],ExpressionUUID->
  "f2553cfd-a488-4826-8d22-6234fe9ba910"],
 ".\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", GridBox[{
        {"y"},
        {"v"},
        {"a"}
       }], ")"}], "'"], "=", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{"y", "'"}]},
        {
         RowBox[{"v", "'"}]},
        {
         RowBox[{"a", "'"}]}
       }], ")"}], "=", 
     RowBox[{
      RowBox[{"(", GridBox[{
         {"v"},
         {"a"},
         {
          RowBox[{"y", "'''"}]}
        }], ")"}], "=", 
      RowBox[{"(", GridBox[{
         {"v"},
         {"a"},
         {
          RowBox[{
           RowBox[{
            RowBox[{"-", "0.5"}], " ", "a"}], "-", "v", "+", "y", " ", "-", 
           RowBox[{"Sign", "[", "y", "]"}]}]}
        }], ")"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "94e59310-f720-41ed-9e52-6e76c6248444"],
 "\nThe cell below defines a function and solve the ODE as the first order \
system\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"w", "'"}], "=", 
    RowBox[{"f", "(", "w", ")"}]}], TraditionalForm]],ExpressionUUID->
  "cc6dc7cd-25d9-4005-81b0-dc3659168a1c"],
 "\nIf I want different colors I need to \t"
}], "Text",
 CellChangeTimes->{{3.997366603162095*^9, 3.9973668652926683`*^9}, {
  3.999855954345003*^9, 
  3.9998559682521048`*^9}},ExpressionUUID->"efe826e4-af5a-4c01-90a4-\
cf5fe2adadfb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"w", ",", "f"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "123"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"{", 
    RowBox[{"y_", ",", "v_", ",", "a_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{"v", ",", "a", ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "0.5"}], " ", "a"}], "-", "v", "+", "y", " ", "-", 
     RowBox[{"Sign", "[", "y", "]"}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wSol", "=", " ", 
   RowBox[{"NDSolveValue", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"w", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"f", "[", 
         RowBox[{"w", "[", "t", "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"w", "[", "0", "]"}], "==", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}]}]}], "}"}], ",", "w", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<Phase Plot\>\"", "->", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"wSol", "[", "t", "]"}], ",", 
       RowBox[{"{", 
