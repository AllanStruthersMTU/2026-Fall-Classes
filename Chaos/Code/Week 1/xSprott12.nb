Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Pic", "=", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ySol0", "[", "t", "]"}], ",", 
       RowBox[{"ySol1", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<p0\>\"", ",", "\"\<p1\>\""}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"AxesLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "\"\<\!\(\*SubscriptBox[\(y\), \(1\)]\)\>\"", ",", 
        "\"\<\!\(\*SubscriptBox[\(y\), \(2\)]\)\>\"", ",", 
        "\"\<\!\(\*SubscriptBox[\(y\), \(3\)]\)\>\""}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotLabel", "\[Rule]", "\"\<Smoothed Sprott #12\>\""}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"SetDirectory", "[", 
  "\"\<C:\\\\Users\\\\AllanStruthers\\\\Desktop\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{"\"\<AASPic.jpg\>\"", ",", "Pic"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9998590153573666`*^9, 3.9998590510195403`*^9}, {
  3.9998591348194757`*^9, 3.9998591580034285`*^9}, {3.9999478263547773`*^9, 
