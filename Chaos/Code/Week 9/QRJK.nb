     RowBox[{"{", 
      RowBox[{"1", ",", "0.2", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", 
       RowBox[{"x", "-", "5.7"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LTSk", "[", 
    RowBox[{"M_", "?", "MatrixQ"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"L", "=", 
       RowBox[{"LowerTriangularize", "[", 
        RowBox[{"M", ",", 
         RowBox[{"-", "1"}]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"L", "-", 
      RowBox[{"L", "\[Transpose]"}]}]}], "]"}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Dia", "[", 
    RowBox[{"M_", "?", "MatrixQ"}], "]"}], ":=", 
   RowBox[{"Diagonal", "[", "M", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], ";", " ", 
  RowBox[{"Id", "=", 
