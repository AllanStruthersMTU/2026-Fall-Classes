Notebook[{
Cell["\<\
Hi Bella:
I turned the a parameter up until it became one around.  Grabbed a point on \
the once around loop and stuck the point on the graph of the loop.\
\>", "Text",
 CellChangeTimes->{{4.0023824898971567`*^9, 4.002382541474045*^9}, {
  4.002382616072524*^9, 
  4.0023826407127867`*^9}},ExpressionUUID->"548e5465-d1c1-464b-ba5f-\
7839df465aaf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "TMax", ",", "f", ",", "t", ",", "y", ",", "ySol", ",", " ", "yEnd"}], 
  "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"y1_", ",", "y2_", ",", "y3_"}], "}"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"y2", ",", "y3", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "a"}], "*", "y3"}], "+", 
      RowBox[{"b", "*", "y2"}], "-", 
      RowBox[{"c", "*", 
       RowBox[{
        RowBox[{"(", "y2", ")"}], "^", "3"}]}], "-", "y1"}]}], "}"}]}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "I", " ", "am", " ", "going", " ", "to", " ", "turn", " ", "the", " ", "a",
     " ", "parameter", " ", "up"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{"1.8", ",", "2.8", ",", "1"}], "}"}]}]}], ";", 
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ";", 
  RowBox[{"TMax", "=", "287.75"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ySol", "=", 
   RowBox[{"NDSolveValue", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"f", "[", "p", "]"}], "[", 
         RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], "}"}], ",", "y", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"yEnd", "=", 
   RowBox[{"ySol", "[", "TMax", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"ySol", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{".8", "*", "TMax"}], ",", "TMax"}], "}"}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<Phase Plot - Once Around\>\""}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<y\>\"", ",", "\"\<y'\>\"", ",", "\"\<y''\>\""}], "}"}]}], 
     ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<y\>\"", ",", "\"\<y'\>\"", ",", "\"\<y''\>\""}], "}"}]}], 
     ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotPoints", "->", "100"}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Graphics3D", "[", 
    RowBox[{"{", 
     RowBox[{"Red", ",", " ", 
      RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
      RowBox[{"Point", "[", "yEnd", "]"}]}], "}"}], "]"}]}], "]"}]}], "Input",\

 CellChangeTimes->{{4.002378504923108*^9, 4.0023789689541907`*^9}, {
  4.002379022844159*^9, 4.002379024929349*^9}, {4.002382383395174*^9, 
