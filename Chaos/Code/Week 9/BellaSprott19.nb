Cell["\<\
I started from the point on the single loop and turned the a parameter down \
slowly.  It was really twitchy but I think I can see the separation here :)\
\>", "Text",
 CellChangeTimes->{{4.0023824898971567`*^9, 4.002382580514965*^9}, {
  4.002382730471895*^9, 4.002382755542197*^9}, {4.00238320732045*^9, 
  4.0023832384712343`*^9}},ExpressionUUID->"2cad4630-b25c-47ff-a802-\
412a97388c25"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"TMax", ",", "t", ",", "y", ",", "ySol", ",", " ", "yEnd"}], "]"}],
   "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "I", " ", "am", " ", "going", " ", "to", " ", "turn", " ", "the", " ", "a",
     " ", "parameter", " ", "down"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "0.13463260400447719`"}], ",", 
     RowBox[{"-", "1.5240250978074863`"}], ",", "0.3312838194748726`"}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{"0.661", ",", "2.8", ",", "1"}], "}"}]}]}], ";", 
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ";", 
  RowBox[{"TMax", "=", "512"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ySol", "=", 
   RowBox[{"NDSolveValue", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"f", "[", "p", "]"}], "[", 
         RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], "}"}], ",", "y", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot3D", "[", 
  RowBox[{
   RowBox[{"ySol", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"0.8", "TMax"}], ",", "TMax"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.002378504923108*^9, 4.0023789689541907`*^9}, {
  4.002379022844159*^9, 4.002379024929349*^9}, {4.002382383395174*^9, 
