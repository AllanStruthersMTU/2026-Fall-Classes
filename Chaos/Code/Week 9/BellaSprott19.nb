Cell[BoxData[
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"ySol", "[", "t", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", 
      RowBox[{"0.8", " ", "TMax"}], ",", "TMax"}], "}"}]}], "]"}], 
  ";"}]], "Input",ExpressionUUID->"24255db4-5b5a-48d5-87f1-20ef34404cfe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"y1sol", ",", "y2sol", ",", "y3sol"}], "}"}], "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"y1", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"y2", "[", "t", "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"y2", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"y3", "[", "t", "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"y3", "'"}], "[", "t", "]"}], "==", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "a"}], "*", 
            RowBox[{"y3", "[", "t", "]"}]}], "+", 
           RowBox[{"b", "*", 
            RowBox[{"y2", "[", "t", "]"}]}], "-", 
           RowBox[{"c", "*", 
            RowBox[{
             RowBox[{"y2", "[", "t", "]"}], "^", "3"}]}], "-", 
           RowBox[{"y1", "[", "t", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"y1", "[", "0", "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{"y2", "[", "0", "]"}], "==", "1"}], ",", 
         RowBox[{
          RowBox[{"y3", "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y1", ",", "y2", ",", "y3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"y1sol", "[", "t", "]"}], ",", 
       RowBox[{"y2sol", "[", "t", "]"}], ",", 
       RowBox[{"y3sol", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{".8", "*", "TMax"}], ",", "TMax"}], "}"}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<Phase Plot - Once Around\>\""}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<y\>\"", ",", "\"\<y'\>\"", ",", "\"\<y''\>\""}], "}"}]}], 
     ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<y\>\"", ",", "\"\<y'\>\"", ",", "\"\<y''\>\""}], "}"}]}], 
     ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotPoints", "->", "100"}]}], "]"}], "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"y1sol", "[", "t", "]"}], ",", 
       RowBox[{"y2sol", "[", "t", "]"}], ",", 
       RowBox[{"y3sol", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"0.8", " ", "TMax"}], ",", "TMax"}], "}"}]}], 
    "]"}]}]}]], "Input",
