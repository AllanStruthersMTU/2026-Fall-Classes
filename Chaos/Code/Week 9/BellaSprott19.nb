Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"TMax", ",", "f", ",", "dF", ",", "t", ",", "y"}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"y1_", ",", "y2_", ",", "y3_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"y2", ",", "y3", ",", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "a"}], "*", "y3"}], "+", 
     RowBox[{"b", "*", "y2"}], "-", 
     RowBox[{"c", "*", 
      RowBox[{
       RowBox[{"(", "y2", ")"}], "^", "3"}]}], "-", "y1"}]}], "}"}]}], "\n", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{".6", ",", "2.8", ",", "1"}], "}"}]}]}], ";", 
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ";", 
  RowBox[{"TMax", "=", "287.75"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ySol", "=", 
   RowBox[{"NDSolveValue", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"f", "[", "p", "]"}], "[", 
         RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], "}"}], ",", "y", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"ParametricPlot3D", "[", 
  RowBox[{
   RowBox[{"ySol", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{".8", "*", "TMax"}], ",", "TMax"}], "}"}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Phase Plot - Once Around\>\""}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<y\>\"", ",", "\"\<y'\>\"", ",", "\"\<y''\>\""}], "}"}]}], 
   ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<y\>\"", ",", "\"\<y'\>\"", ",", "\"\<y''\>\""}], "}"}]}], 
   ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotPoints", "->", "100"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.002378504923108*^9, 4.0023789689541907`*^9}, {
  4.002379022844159*^9, 4.002379024929349*^9}},
