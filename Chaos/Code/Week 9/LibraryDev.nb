Cell["Tests", "Text",
 CellChangeTimes->{{4.0023546071441803`*^9, 
  4.002354608517452*^9}},ExpressionUUID->"54b8a31b-cad5-4863-8a34-\
c4abfbfe2d55"],

Cell["", "Text",ExpressionUUID->"f23b1c4a-b681-4074-ab5b-6c78f51f6a1c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Poincare Sections", "Section",
 CellChangeTimes->{{4.0023529414207945`*^9, 4.002352956122697*^9}, {
  4.0023557581525545`*^9, 
  4.0023557644928875`*^9}},ExpressionUUID->"4bafe008-a377-4cf3-8891-\
3c6c62c41193"],

Cell[TextData[{
 "Restrict attention to hyperplane sections ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"p", "-", 
       SubscriptBox["p", "0"]}], ")"}], ".", "n"}], "=", "0"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1c05f9b7-13b8-4282-9098-20a0ddedca99"],
 ".\n\tIn 2D this is a line perpendicular to the normal ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8deb6797-361f-4bf9-88b5-176bdec95bf2"],
 " through ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2c48105f-2c5b-4e7f-bc83-b8abab10474f"],
 ".\n\tIn 3D this is a plane perpendicular to the normal ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a312b1a6-1659-4a98-b88d-3f0be47aad68"],
 " through ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0383d07f-26d7-4592-bb01-e3b940795170"],
 ".\n\tIn 4D this is a hyperplane perpendicular to the normal ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9be3ba41-6ea3-4cec-9c49-388ada1c6e0f"],
 " through ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4aff54ed-cc00-41a3-a148-829cda90f9b0"],
 ".\nThe advantage of a plane is that it is parameterized by a set of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6096ccf9-fd2c-4bfa-8c70-36bd0bb48472"],
 " directions.  These tangent directions are perpendicular to the normal ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7dee2497-1056-4a44-8ff1-f98fb5246a97"],
 ". We can choose them to be orthogonal. "
}], "Text",
 CellChangeTimes->{{4.002355772945616*^9, 
  4.00235603449431*^9}},ExpressionUUID->"90febafa-566a-4d9a-9429-\
d92e208041d5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox["T", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1f1ba399-679a-4330-807d-e14957cf0e75"],
 " is going to be an ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "\[Times]", 
    RowBox[{"(", 
     RowBox[{"n", "-", "1"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "caf15e2f-102e-4924-8cd7-4bda2ac2246c"],
 " matrix of the tangent vectors ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "=", 
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["t", "1"], "|", 
      SubscriptBox["t", "2"], "|", "\[Ellipsis]", "|", 
      SubscriptBox["t", 
       RowBox[{"n", "-", "1"}]]}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e619e10b-9e89-46b1-855e-43f81e876986"],
 ".  So ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"T", "\[Transpose]"}], ".", "T"}], "=", 
    SubscriptBox["Id", 
     RowBox[{"n", "-", "1"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1d95da8c-ca7f-4ead-b21f-7558dccf49ee"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"T", "\[Transpose]"}], ".", "n"}], "=", 
    SubscriptBox["0", 
     RowBox[{"n", "-", "1"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8cbcd136-abf4-4488-b26d-e13f6612ad24"],
 ".  The section plane in all our codes is going to be described by the list\n\
\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"p0", ",", "n", ",", "T"}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9281b486-014d-4545-b355-33939100a04e"],
 "\nSwitching ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "\[Rule]", 
    RowBox[{"-", "n"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "17858722-2d46-4639-a684-cfd61e0e3f1c"],
 " gives the same hyperplane with the opposite orientation.  "
}], "Text",
 CellChangeTimes->{{4.0023560396429276`*^9, 
  4.0023563476323905`*^9}},ExpressionUUID->"41992002-d240-43a1-96b2-\
2e92705d10f8"],

Cell["\<\
We want to compute a bunch of points on Poincare sections for various \
systems.  We want to ignore the transients and focus on the long term \
behaviour.\
\>", "Text",
 CellChangeTimes->{{4.0023563574570637`*^9, 
  4.002356436856989*^9}},ExpressionUUID->"7989586d-543e-42c0-9dc2-\
c8fd1038fff4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PoincarePoints", "[", 
   RowBox[{"f_", ",", 
    RowBox[{"{", 
     RowBox[{"p0_", ",", "n_", ",", "T_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"TMin_", ",", " ", "TMax_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "y", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Reap", "[", " ", 
      RowBox[{"NDSolveValue", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
           RowBox[{"f", "[", 
            RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"WhenEvent", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"n", ".", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"y", "[", "t", "]"}], "-", "p0"}], ")"}]}], ">", 
             "0"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"t", ">", "TMin"}], ",", " ", 
              RowBox[{"Sow", "[", 
               RowBox[{"y", "[", "t", "]"}], "]"}]}], "]"}]}], "]"}]}], "}"}],
         ",", 
        RowBox[{"{", "y", "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}], "]"}], 
     "\[LeftDoubleBracket]", 
     RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.00235644031324*^9, 4.002356589842659*^9}, 
   4.002356624233579*^9, {4.0023566760177093`*^9, 4.0023566770835953`*^9}, {
   4.002356870356779*^9, 4.0023568754219356`*^9}, {4.002356906540469*^9, 
