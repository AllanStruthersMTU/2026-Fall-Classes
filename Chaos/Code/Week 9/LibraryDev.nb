Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"TMin", ",", "TMax"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     SuperscriptBox["10", 
      RowBox[{"-", "6"}]], ",", "123"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p", "=", 
    RowBox[{"{", 
     RowBox[{"0.2", ",", "0.2", ",", "5.7"}], "}"}]}], ";"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T", "=", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"0", "0"},
      {"1", "0"},
      {"0", "1"}
     }], "\[NoBreak]", ")"}]}], ";", 
  RowBox[{"n", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}], ";", " ", 
  RowBox[{"p0", "=", 
   RowBox[{"{", 
    RowBox[{"5.7", ",", "0", ",", "0"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x0", "=", 
   RowBox[{"{", 
    RowBox[{"1.1", ",", "2.2"}], "}"}]}], ";", " ", 
  RowBox[{"y0", "=", 
   RowBox[{"p0", "+", 
    RowBox[{"T", ".", "x0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Tau]Val", ",", "yVal", ",", "JVal", ",", "xVal", ",", "DVal"}],
     "}"}], "=", 
   RowBox[{"\[Tau]yJxDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Ross", "[", "p", "]"}], ",", 
       RowBox[{"dRoss", "[", "p", "]"}]}], "}"}], ",", "x0", ",", 
     RowBox[{"{", 
      RowBox[{"p0", ",", "n", ",", "T"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"TMin", ",", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Eigenvalues", "[", "DVal", "]"}]}], "Input",
 CellChangeTimes->{{4.0023566650784984`*^9, 4.0023568568650045`*^9}, {
   4.0023568868898125`*^9, 4.0023570511286573`*^9}, 4.0023677040688486`*^9, {
   4.002370274995686*^9, 4.0023704471074495`*^9}, {4.002372260644775*^9, 
   4.002372264800413*^9}, {4.002376535291092*^9, 4.002376637969181*^9}, {
   4.002376757956295*^9, 4.002376950423112*^9}, {4.002377350266425*^9, 
   4.0023773821581373`*^9}, {4.0024612965808706`*^9, 4.002461309054553*^9}, {
   4.0024614965428443`*^9, 4.0024617202348948`*^9}, {4.0024623741880846`*^9, 
   4.0024624169559236`*^9}, {4.002469359775876*^9, 4.0024693960117846`*^9}, {
