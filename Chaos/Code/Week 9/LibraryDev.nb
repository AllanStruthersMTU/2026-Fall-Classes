Cell[CellGroupData[{

Cell["Poincare Maps", "Section",
 CellChangeTimes->{{4.0023529414207945`*^9, 4.002352956122697*^9}, {
  4.0023557581525545`*^9, 4.0023557644928875`*^9}, {4.002373758117463*^9, 
  4.0023737588125124`*^9}},ExpressionUUID->"579655c5-7620-4dba-a0ab-\
92e97bd5f6b7"],

Cell[TextData[{
 "As before, the section hyperplane in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]", "n"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "72384422-c39e-4181-be50-fd6a7f823868"],
 " is described by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"p0", ",", "n", ",", "T"}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "64ddd207-53f3-4b01-a467-14cbc4bb9fac"],
 "  with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", ".", "n"}], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "42ff4e3e-f9bd-465a-981b-93e91ded0737"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"T", "\[Transpose]"}], ".", "T"}], "=", 
    SubscriptBox["Id", 
     RowBox[{"n", "-", "1"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c0c4835e-e4d7-4a60-9193-d4f43e49909d"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"T", "\[Transpose]"}], ".", "n"}], "=", 
    SubscriptBox["0", 
     RowBox[{"n", "-", "1"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5ee3b120-877f-4b49-8da2-7cc6e18fe48d"],
 ".  As before, the flow is described by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", ":", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}], "\[Rule]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c84387f2-a56c-4f54-92d4-3c4a347acec8"],
 " and its derivative ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"df", ":", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}], "\[Rule]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", 
     RowBox[{"n", "\[Times]", "n"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "50e4e5c4-6ef5-4617-8cce-fcc276160df6"],
 ". The plan is to take a single step from the section back to the section \
and record the return time \[Tau], return map ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "(", "\[Tau]", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "17e55619-c232-4b4e-a0fd-a54b910167bd"],
 ", return sensitivity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"J", "(", "\[Tau]", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "811aed39-124a-431f-9f10-f7437d85770d"],
 ", and the in-plane sensitivity of the return map using the parameterization \
described by ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9d1643a7-8e23-4fa9-9e4f-1be4f8941c1d"],
 " and ",
 Cell[BoxData[
  FormBox["p0", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ac3f7cbf-c888-467f-a3d4-277861dd231e"],
 ".  "
}], "Text",
 CellChangeTimes->{{4.0023560396429276`*^9, 4.0023563476323905`*^9}, {
  4.002369413297683*^9, 4.0023694344481516`*^9}, {4.002369565563963*^9, 
  4.0023697996610203`*^9}, {4.002370169429494*^9, 4.0023701810492196`*^9}, {
  4.0023737741188293`*^9, 
  4.0023741252616854`*^9}},ExpressionUUID->"80bee67d-ad18-4c6b-a5dc-\
eb5063ddc277"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Tau]pJ", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"f_", ",", "df_"}], "}"}], ",", "x0_", ","}], "]"}], 
    "\[IndentingNewLine]", 
    RowBox[{"PoincarePoints", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"f_", ",", "y0_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"p0_", ",", "n_", ",", "T_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"TMin_", ",", " ", "TMax_"}], "}"}]}], "]"}]}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"y", ",", "SecPts"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SecPts", "=", 
       RowBox[{
        RowBox[{"Reap", "[", " ", 
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
              RowBox[{"f", "[", 
               RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
             RowBox[{
              RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"WhenEvent", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"n", ".", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"y", "[", "t", "]"}], "-", "p0"}], ")"}]}], ">", 
                "0"}], ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"t", ">", "TMin"}], ",", " ", 
                 RowBox[{"Sow", "[", 
                  RowBox[{"y", "[", "t", "]"}], "]"}]}], "]"}]}], "]"}]}], 
            "}"}], ",", 
           RowBox[{"{", "y", "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}], "]"}], 
        "\[LeftDoubleBracket]", 
        RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"SecPts", ",", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"T", "\[Transpose]"}], ".", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
             "SecPts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
              "-", "p0"}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "SecPts", "]"}]}], "}"}]}], "]"}]}], 
       "}"}]}]}], "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{{4.0023741390466623`*^9, 
  4.002374192800575*^9}},ExpressionUUID->"87065fbb-bbee-43bb-a311-\
d13ed2818757"],

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]PoincarePoints\[CloseCurlyDoubleQuote] takes the \
function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a6b7f524-6067-422c-8427-f6e258a0bad9"],
 " and initial condition ",
 Cell[BoxData[
  FormBox["y0", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dde615e7-82e8-4cfd-85b6-e0ee20749d6d"],
 ", the parameters ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"p0", ",", "n", ",", "T"}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "39b576c4-618f-4587-897e-c4e1aedf0c81"],
 " of the plane and a capture range ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"TMin", ",", "TMax"}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "98485cf0-1b28-4e30-a68c-c0deaf67ae94"],
 " and returns a list of the the points on the plane in the ambient space \
together with a list of the parameters for those points.    "
}], "Text",
 InitializationCell->True,
 CellChangeTimes->{{4.0023699680977077`*^9, 4.002370156356265*^9}, {
  4.00237222073306*^9, 
  4.00237223673263*^9}},ExpressionUUID->"fce453e2-99db-4c70-9a15-\
c458dfb26c3b"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "PoincarePoints", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PoincarePoints", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "y0_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"p0_", ",", "n_", ",", "T_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"TMin_", ",", " ", "TMax_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y", ",", "SecPts"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SecPts", "=", 
      RowBox[{
       RowBox[{"Reap", "[", " ", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
             RowBox[{"f", "[", 
              RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"WhenEvent", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"n", ".", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"y", "[", "t", "]"}], "-", "p0"}], ")"}]}], ">", 
               "0"}], ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"t", ">", "TMin"}], ",", " ", 
                RowBox[{"Sow", "[", 
                 RowBox[{"y", "[", "t", "]"}], "]"}]}], "]"}]}], "]"}]}], 
           "}"}], ",", 
          RowBox[{"{", "y", "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}], "]"}], 
       "\[LeftDoubleBracket]", 
       RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"SecPts", ",", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"T", "\[Transpose]"}], ".", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
            "SecPts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
            "-", "p0"}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "SecPts", "]"}]}], "}"}]}], "]"}]}], 
      "}"}]}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.00235644031324*^9, 4.002356589842659*^9}, 
   4.002356624233579*^9, {4.0023566760177093`*^9, 4.0023566770835953`*^9}, {
   4.002356870356779*^9, 4.0023568754219356`*^9}, {4.002356906540469*^9, 
   4.002356920044693*^9}, {4.002357062056324*^9, 4.0023570735106215`*^9}, 
   4.0023698132505984`*^9, {4.0023699316319942`*^9, 4.002369951688055*^9}, {
   4.002370190868557*^9, 4.0023702645555477`*^9}, {4.002372207969453*^9, 
   4.0023722150482645`*^9}, {4.002372249057065*^9, 4.002372253645116*^9}},
 CellLabel->
  "In[152]:=",ExpressionUUID->"f6256b9c-7adb-4c9d-a761-8560808ff56d"],

Cell["Test", "Text",
 CellChangeTimes->{{4.002356629566238*^9, 
  4.0023566301355066`*^9}},ExpressionUUID->"9bbe9383-7fb3-41b5-9ec5-\
0503092e5415"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"TMin", ",", "TMax"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"12", ",", "123"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{"{", 
    RowBox[{"0.2", ",", "0.2", ",", "5.7"}], "}"}]}], ";", " ", 
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ySol", ",", "JSol"}], "}"}], "=", 
   RowBox[{"yJSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Ross", "[", "p", "]"}], ",", 
       RowBox[{"dRoss", "[", "p", "]"}]}], "}"}], ",", "y0", ",", "TMax"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T", "=", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"0", "0"},
      {"1", "0"},
      {"0", "1"}
     }], "\[NoBreak]", ")"}]}], ";", 
  RowBox[{"n", "=", 
   RowBox[{"{", 
    RowBox[{
