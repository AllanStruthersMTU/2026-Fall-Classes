Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", 
    RowBox[{"w", "+", "x", "+", 
     RowBox[{"a", " ", "y"}]}], ",", 
    RowBox[{"b", "+", 
     RowBox[{"x", " ", "z"}]}], ",", 
    RowBox[{
     RowBox[{"d", " ", "w"}], "-", 
     RowBox[{"c", " ", "z"}]}]}], "}"}], "\[Equal]", 
  RowBox[{"{", 
   RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}]], "Output",
