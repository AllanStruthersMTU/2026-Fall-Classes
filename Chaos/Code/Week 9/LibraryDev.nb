Cell[CellGroupData[{

Cell["Poincare Maps and Derivatives. ", "Section",
 CellChangeTimes->{{4.0023529414207945`*^9, 4.002352956122697*^9}, {
  4.0023557581525545`*^9, 4.0023557644928875`*^9}, {4.002373758117463*^9, 
  4.0023737588125124`*^9}, {4.002466967487645*^9, 
  4.002466975205451*^9}},ExpressionUUID->"579655c5-7620-4dba-a0ab-\
92e97bd5f6b7"],

Cell[TextData[{
 "As before, the section hyperplane in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]", "n"], TraditionalForm]],
  ExpressionUUID->"72384422-c39e-4181-be50-fd6a7f823868"],
 " is described by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"p0", ",", "n", ",", "T"}], "}"}], TraditionalForm]],
  ExpressionUUID->"64ddd207-53f3-4b01-a467-14cbc4bb9fac"],
 "  with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", ".", "n"}], "=", "1"}], TraditionalForm]],ExpressionUUID->
  "42ff4e3e-f9bd-465a-981b-93e91ded0737"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"T", "\[Transpose]"}], ".", "T"}], "=", 
    SubscriptBox["Id", 
     RowBox[{"n", "-", "1"}]]}], TraditionalForm]],ExpressionUUID->
  "c0c4835e-e4d7-4a60-9193-d4f43e49909d"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"T", "\[Transpose]"}], ".", "n"}], "=", 
    SubscriptBox["0", 
     RowBox[{"n", "-", "1"}]]}], TraditionalForm]],ExpressionUUID->
  "5ee3b120-877f-4b49-8da2-7cc6e18fe48d"],
 ".  As before, the flow is described by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", ":", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}], "\[Rule]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}], TraditionalForm]],
  ExpressionUUID->"c84387f2-a56c-4f54-92d4-3c4a347acec8"],
 " and its derivative ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"df", ":", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}], "\[Rule]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", 
     RowBox[{"n", "\[Times]", "n"}]]}], TraditionalForm]],ExpressionUUID->
  "50e4e5c4-6ef5-4617-8cce-fcc276160df6"],
 ". The plan is to take a single step from the section back to the section. \
For an initial condition\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "(", "0", ")"}], "=", 
    RowBox[{"y0", "=", 
     RowBox[{"p0", "+", "Tx0"}]}]}], TraditionalForm]],ExpressionUUID->
  "b02b7f67-3bff-496a-a682-c7920560e45d"],
 "\non the plane described by the parameters x0.  The function \[Tau]yJ gives \
the the first positive crossing time of the orbit, along with the point ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "(", "\[Tau]", ")"}], TraditionalForm]],ExpressionUUID->
  "17e55619-c232-4b4e-a0fd-a54b910167bd"],
 ", and full sensitivity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"J", "(", "\[Tau]", ")"}], TraditionalForm]],ExpressionUUID->
  "811aed39-124a-431f-9f10-f7437d85770d"],
 ".  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"TMin", ">", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9f291846-18ad-44ea-8b83-df378a81a02d"],
 " but small is to prevent premature triggering of the condition because y0 \
is on (or at very-very near) the plane.  I made sure to start this on a \
positive crossing. "
}], "Text",
 CellChangeTimes->{{4.0023560396429276`*^9, 4.0023563476323905`*^9}, {
  4.002369413297683*^9, 4.0023694344481516`*^9}, {4.002369565563963*^9, 
  4.0023697996610203`*^9}, {4.002370169429494*^9, 4.0023701810492196`*^9}, {
  4.0023737741188293`*^9, 4.0023741252616854`*^9}, {4.002376286706821*^9, 
  4.0023765128903213`*^9}, {4.0024613292629886`*^9, 4.0024613788130856`*^9}, {
  4.0024614094795647`*^9, 4.0024614840782347`*^9}, {4.002461739806458*^9, 
  4.0024617687661057`*^9}},ExpressionUUID->"80bee67d-ad18-4c6b-a5dc-\
eb5063ddc277"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "\[Tau]yJSolve", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Tau]yJSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "df_"}], "}"}], ",", "y0_", ",", 
    RowBox[{"{", 
     RowBox[{"p0_", ",", "n_", ",", "T_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"TMin_", ",", " ", "TMax_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y", ",", "J", ",", "\[Tau]yJ"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"f", "[", 
           RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
          RowBox[{
           RowBox[{"df", "[", 
            RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
           RowBox[{"J", "[", "t", "]"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"J", "[", "0", "]"}], "==", 
          RowBox[{"IdentityMatrix", "[", 
           RowBox[{"Length", "[", "y0", "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"WhenEvent", "[", 
          RowBox[{
           RowBox[{"And", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"n", ".", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"y", "[", "t", "]"}], "-", "p0"}], ")"}]}], ">", 
              "0"}], ",", 
             RowBox[{"t", ">", "TMin"}]}], "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Tau]yJ", "=", 
              RowBox[{"{", 
               RowBox[{"t", ",", 
                RowBox[{"y", "[", "t", "]"}], ",", 
                RowBox[{"J", "[", "t", "]"}]}], "}"}]}], ",", 
             "\"\<StopIntegration\>\""}], "}"}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], ",", 
       RowBox[{"{", "y", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[Tau]yJ"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.0023741390466623`*^9, 4.002374192800575*^9}, {
  4.0023759833545475`*^9, 4.002376261107402*^9}, {4.0023764495291915`*^9, 
  4.0023764534171677`*^9}, {4.0023765426414757`*^9, 4.0023765474760942`*^9}, {
  4.002376673812842*^9, 4.002376712563933*^9}, {4.002377019156798*^9, 
  4.0023770216257997`*^9}, {4.002377104188117*^9, 4.0023771118914967`*^9}, {
  4.002377287109763*^9, 4.0023773283128777`*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"87065fbb-bbee-43bb-a311-d13ed2818757"],

Cell["As always test.", "Text",
 InitializationCell->True,
 CellChangeTimes->{{4.0023699680977077`*^9, 4.002370156356265*^9}, {
  4.00237222073306*^9, 4.00237223673263*^9}, {4.0023762024851055`*^9, 
  4.0023762093087034`*^9}, {4.0023765243459125`*^9, 
  4.002376524652833*^9}},ExpressionUUID->"fce453e2-99db-4c70-9a15-\
c458dfb26c3b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"TMin", ",", "TMax"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     SuperscriptBox["10", 
      RowBox[{"-", "6"}]], ",", "123"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p", "=", 
    RowBox[{"{", 
     RowBox[{"0.2", ",", "0.2", ",", "5.7"}], "}"}]}], ";"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T", "=", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"0", "0"},
      {"1", "0"},
      {"0", "1"}
     }], "\[NoBreak]", ")"}]}], ";", 
  RowBox[{"n", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}], ";", " ", 
  RowBox[{"p0", "=", 
   RowBox[{"{", 
    RowBox[{"5.7", ",", "0", ",", "0"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x0", "=", 
   RowBox[{"{", 
    RowBox[{"1.1", ",", "2.2"}], "}"}]}], ";", " ", 
  RowBox[{"y0", "=", 
   RowBox[{"p0", "+", 
    RowBox[{"T", ".", "x0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"\[Tau]Val", ",", "yVal", ",", "JVal"}], "}"}], "=", 
  RowBox[{"\[Tau]yJSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Ross", "[", "p", "]"}], ",", 
      RowBox[{"dRoss", "[", "p", "]"}]}], "}"}], ",", "y0", ",", 
    RowBox[{"{", 
     RowBox[{"p0", ",", "n", ",", "T"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"TMin", ",", "TMax"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ySol", ",", "JSol"}], "}"}], "=", 
   RowBox[{"yJSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Ross", "[", "p", "]"}], ",", 
       RowBox[{"dRoss", "[", "p", "]"}]}], "}"}], ",", "y0", ",", 
     "\[Tau]Val"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<3D\>\"", "->", 
     RowBox[{"Show", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ParametricPlot3D", "[", 
        RowBox[{
         RowBox[{"ySol", "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", " ", "\[Tau]Val"}], "}"}]}], "]"}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"ParametricPlot3D", "[", 
