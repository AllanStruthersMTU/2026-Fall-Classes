        RowBox[{"b", " ", "yp"}], "-", 
        RowBox[{"c", " ", "y"}], "+", 
        RowBox[{"d", " ", 
         SuperscriptBox["y", "3"]}]}]}], ",", 
      RowBox[{"\<\"par\"\>", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"0.35`", ",", "1", ",", "1", ",", "1", ",", "50"}], "}"}]}], 
      ",", 
      RowBox[{"\<\"IC\"\>", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ",", 
      RowBox[{"\<\"der\"\>", "\[RuleDelayed]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "c"}], "+", 
          RowBox[{"3", " ", "d", " ", 
           SuperscriptBox["y", "2"]}]}], ",", 
         RowBox[{"-", "b"}], ",", 
         RowBox[{"-", "a"}]}], "}"}]}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"22", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"fun\"\>", "\[RuleDelayed]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "a"}], " ", "ypp"}], "-", 
        RowBox[{"b", " ", "yp"}], "+", 
        RowBox[{"c", " ", "y"}], "+", 
        RowBox[{"d", " ", 
         RowBox[{"Sin", "[", "y", "]"}]}]}]}], ",", 
      RowBox[{"\<\"par\"\>", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"0.2`", ",", "1", ",", "0", ",", "1", ",", "50"}], "}"}]}], 
      ",", 
      RowBox[{"\<\"IC\"\>", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ",", 
      RowBox[{"\<\"der\"\>", "\[RuleDelayed]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"c", "+", 
          RowBox[{"d", " ", 
           RowBox[{"Cos", "[", "y", "]"}]}]}], ",", 
         RowBox[{"-", "b"}], ",", 
         RowBox[{"-", "a"}]}], "}"}]}]}], "\[RightAssociation]"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 InitializationGroup->True,
