Cell[CellGroupData[{

Cell["Poincare Sections", "Section",
 CellChangeTimes->{{4.0023529414207945`*^9, 4.002352956122697*^9}, {
  4.0023557581525545`*^9, 
  4.0023557644928875`*^9}},ExpressionUUID->"4bafe008-a377-4cf3-8891-\
3c6c62c41193"],

Cell[TextData[{
 "Restrict attention to hyperplane sections ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"p", "-", 
       SubscriptBox["p", "0"]}], ")"}], ".", "n"}], "=", "0"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1c05f9b7-13b8-4282-9098-20a0ddedca99"],
 ".\n\tIn 2D this is a line perpendicular to the normal ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8deb6797-361f-4bf9-88b5-176bdec95bf2"],
 " through ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2c48105f-2c5b-4e7f-bc83-b8abab10474f"],
 ".\n\tIn 3D this is a plane perpendicular to the normal ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a312b1a6-1659-4a98-b88d-3f0be47aad68"],
 " through ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0383d07f-26d7-4592-bb01-e3b940795170"],
 ".\n\tIn 4D this is a hyperplane perpendicular to the normal ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9be3ba41-6ea3-4cec-9c49-388ada1c6e0f"],
 " through ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4aff54ed-cc00-41a3-a148-829cda90f9b0"],
 ".\nThe advantage of a plane is that it is parameterized by a set of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6096ccf9-fd2c-4bfa-8c70-36bd0bb48472"],
 " directions.  These tangent directions are perpendicular to the normal ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7dee2497-1056-4a44-8ff1-f98fb5246a97"],
 ". We can choose them to be orthogonal. "
}], "Text",
 CellChangeTimes->{{4.002355772945616*^9, 
  4.00235603449431*^9}},ExpressionUUID->"90febafa-566a-4d9a-9429-\
d92e208041d5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox["T", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1f1ba399-679a-4330-807d-e14957cf0e75"],
 " is going to be an ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "\[Times]", 
    RowBox[{"(", 
     RowBox[{"n", "-", "1"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "caf15e2f-102e-4924-8cd7-4bda2ac2246c"],
 " matrix of the tangent vectors ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "=", 
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["t", "1"], "|", 
      SubscriptBox["t", "2"], "|", "\[Ellipsis]", "|", 
      SubscriptBox["t", 
       RowBox[{"n", "-", "1"}]]}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e619e10b-9e89-46b1-855e-43f81e876986"],
 ".  So ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"T", "\[Transpose]"}], ".", "T"}], "=", 
    SubscriptBox["Id", 
     RowBox[{"n", "-", "1"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1d95da8c-ca7f-4ead-b21f-7558dccf49ee"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"T", "\[Transpose]"}], ".", "n"}], "=", 
    SubscriptBox["0", 
     RowBox[{"n", "-", "1"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8cbcd136-abf4-4488-b26d-e13f6612ad24"],
 ".  The section plane in all our codes is going to be described by the list\n\
\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"p0", ",", "n", ",", "T"}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9281b486-014d-4545-b355-33939100a04e"],
 "\nSwitching ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "\[Rule]", 
    RowBox[{"-", "n"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "17858722-2d46-4639-a684-cfd61e0e3f1c"],
 " gives the same hyperplane with the opposite orientation.  The mapping from \
the parameter space ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[Element]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", 
     RowBox[{"n", "-", "1"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fc630072-7134-4cb8-842c-814da2d191ef"],
 " to the ambient space is  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "->", 
    RowBox[{
     RowBox[{"T", " ", "x"}], " ", "+", " ", "p0"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "22de2735-7895-4bbd-be31-be95d2c53774"],
 ".  The projection from the ambient space ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "\[Element]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6723052b-0c54-48ba-a1c3-e7cce56e0c7f"],
 " to the parameter space is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "\[Rule]", 
    RowBox[{
     RowBox[{"T", "\[Transpose]"}], 
     RowBox[{"(", 
      RowBox[{"y", "-", "p0"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c7be9351-48f6-4275-8310-3f18e17684e4"],
 ".  You can (and should) check that this matches the use of the word \
projector in other math contexts. "
}], "Text",
 CellChangeTimes->{{4.0023560396429276`*^9, 4.0023563476323905`*^9}, {
  4.002369413297683*^9, 4.0023694344481516`*^9}, {4.002369565563963*^9, 
  4.0023697996610203`*^9}, {4.002370169429494*^9, 
  4.0023701810492196`*^9}},ExpressionUUID->"41992002-d240-43a1-96b2-\
2e92705d10f8"],

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]PoincarePoints\[CloseCurlyDoubleQuote] takes the \
function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2fcd956b-cbc0-4849-b8b2-7a7c3c16be9c"],
 " and initial condition ",
 Cell[BoxData[
  FormBox["y0", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bddf710f-5108-452a-9410-5e7c3e72e7a9"],
 ", the parameters ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"p0", ",", "n", ",", "T"}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "056fe0ab-b285-47a1-b0dd-0b9c5a4fdd0f"],
 " of the plane and a capture range ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"TMin", ",", "TMax"}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cd8a65bd-826e-44be-82ab-0a3101ed2983"],
 " and returns a list of the the points on the plane in the ambient space \
together with a list of the parameters for those points.    "
}], "Text",
 InitializationCell->True,
 CellChangeTimes->{{4.0023699680977077`*^9, 4.002370156356265*^9}, {
  4.00237222073306*^9, 
  4.00237223673263*^9}},ExpressionUUID->"9df45fed-4c25-4aac-aad7-\
f7ebf0d300a2"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "PoincarePoints", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PoincarePoints", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "y0_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"p0_", ",", "n_", ",", "T_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"TMin_", ",", " ", "TMax_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y", ",", "SecPts"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SecPts", "=", 
      RowBox[{
       RowBox[{"Reap", "[", " ", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
             RowBox[{"f", "[", 
              RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"WhenEvent", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"n", ".", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"y", "[", "t", "]"}], "-", "p0"}], ")"}]}], ">", 
               "0"}], ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"t", ">", "TMin"}], ",", " ", 
                RowBox[{"Sow", "[", 
                 RowBox[{"y", "[", "t", "]"}], "]"}]}], "]"}]}], "]"}]}], 
           "}"}], ",", 
          RowBox[{"{", "y", "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}], "]"}], 
       "\[LeftDoubleBracket]", 
       RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"SecPts", ",", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"T", "\[Transpose]"}], ".", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
            "SecPts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
            "-", "p0"}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "SecPts", "]"}]}], "}"}]}], "]"}]}], 
      "}"}]}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.00235644031324*^9, 4.002356589842659*^9}, 
   4.002356624233579*^9, {4.0023566760177093`*^9, 4.0023566770835953`*^9}, {
   4.002356870356779*^9, 4.0023568754219356`*^9}, {4.002356906540469*^9, 
   4.002356920044693*^9}, {4.002357062056324*^9, 4.0023570735106215`*^9}, 
   4.0023698132505984`*^9, {4.0023699316319942`*^9, 4.002369951688055*^9}, {
   4.002370190868557*^9, 4.0023702645555477`*^9}, {4.002372207969453*^9, 
   4.0023722150482645`*^9}, {4.002372249057065*^9, 4.002372253645116*^9}},
 CellLabel->
  "In[152]:=",ExpressionUUID->"22ace53d-0695-4494-8dd0-475e2f13afba"],

Cell["Test", "Text",
 CellChangeTimes->{{4.002356629566238*^9, 
  4.0023566301355066`*^9}},ExpressionUUID->"d195e82f-ef5f-4f19-b331-\
8f179268115b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"TMin", ",", "TMax"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"12", ",", "123"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{"{", 
    RowBox[{"0.2", ",", "0.2", ",", "5.7"}], "}"}]}], ";", " ", 
  RowBox[{"y0", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ySol", ",", "JSol"}], "}"}], "=", 
   RowBox[{"yJSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Ross", "[", "p", "]"}], ",", 
       RowBox[{"dRoss", "[", "p", "]"}]}], "}"}], ",", "y0", ",", "TMax"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T", "=", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"0", "0"},
      {"1", "0"},
      {"0", "1"}
     }], "\[NoBreak]", ")"}]}], ";", 
  RowBox[{"n", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}], ";", " ", 
  RowBox[{"p0", "=", 
   RowBox[{"{", 
    RowBox[{"5.7", ",", "0", ",", "0"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"SecPts", ",", "ProjSecPts"}], "}"}], "=", 
   RowBox[{"PoincarePoints", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Ross", "[", "p", "]"}], ",", "y0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"p0", ",", "n", ",", "T"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"TMin", ",", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<3D\>\"", "->", 
     RowBox[{"Show", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ParametricPlot3D", "[", 
        RowBox[{
         RowBox[{"ySol", "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ListPointPlot3D", "[", 
        RowBox[{"SecPts", ",", 
         RowBox[{"PlotStyle", "->", "Red"}]}], "]"}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<\!\(\*SubscriptBox[\(y\), \(1\)]\)\>\"", ",", 
          "\"\<\!\(\*SubscriptBox[\(y\), \(2\)]\)\>\"", ",", 
          "\"\<\!\(\*SubscriptBox[\(y\), \(3\)]\)\>\""}], "}"}]}]}], "]"}]}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<2D\>\"", "->", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"ProjSecPts", ",", 
       RowBox[{"PlotStyle", "->", "Red"}], ",", 
       RowBox[{"AxesLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "\"\<\!\(\*SubscriptBox[\(x\), \(1\)]\)\>\"", ",", 
          "\"\<\!\(\*SubscriptBox[\(x\), \(2\)]\)\>\""}], "}"}]}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "}"}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
 CellChangeTimes->{{4.0023566650784984`*^9, 4.0023568568650045`*^9}, {
   4.0023568868898125`*^9, 4.0023570511286573`*^9}, 4.0023677040688486`*^9, {
