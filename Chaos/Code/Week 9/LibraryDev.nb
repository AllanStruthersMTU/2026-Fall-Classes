f8e806630d1c"],

Cell["\<\
For small polynomial systems Mathematica can find all real equilibria?  \
Apparently there are two for the Hyper Chaos system\
\>", "Text",
 CellChangeTimes->{{4.002355772945616*^9, 4.00235603449431*^9}, {
  4.0023635004664307`*^9, 4.0023635365497913`*^9}, {4.0023638014311175`*^9, 
  4.0023638631902676`*^9}},ExpressionUUID->"5105a0cc-a9e3-4d7b-8a86-\
1b7afeecd883"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"HRoss", "[", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], "]"}], "[", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z", ",", "w"}], "}"}], "]"}], "==", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z", ",", "w"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.0023635431732416`*^9, 4.0023635808814197`*^9}},
 CellLabel->
  "In[216]:=",ExpressionUUID->"1b2facf8-8b87-4d94-adae-7e6ed4891e99"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", 
      FractionBox[
       RowBox[{
        FractionBox[
         RowBox[{
          SqrtBox["b"], " ", "c", " ", 
          SqrtBox["d"]}], 
         SqrtBox[
          RowBox[{"c", "-", 
           RowBox[{"a", " ", "d"}]}]]], "-", 
        FractionBox[
         RowBox[{"a", " ", 
          SqrtBox["b"], " ", 
          SuperscriptBox["d", 
           RowBox[{"3", "/", "2"}]]}], 
         SqrtBox[
          RowBox[{"c", "-", 
           RowBox[{"a", " ", "d"}]}]]]}], "d"]}], ",", 
     RowBox[{"y", "\[Rule]", 
      FractionBox[
       RowBox[{
        SqrtBox["b"], " ", 
        SqrtBox["d"]}], 
       SqrtBox[
        RowBox[{"c", "-", 
         RowBox[{"a", " ", "d"}]}]]]}], ",", 
     RowBox[{"z", "\[Rule]", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         SqrtBox["b"], " ", 
         SqrtBox["d"]}], 
        SqrtBox[
         RowBox[{"c", "-", 
          RowBox[{"a", " ", "d"}]}]]]}]}], ",", 
     RowBox[{"w", "\[Rule]", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         SqrtBox["b"], " ", "c"}], 
        RowBox[{
         SqrtBox["d"], " ", 
         SqrtBox[
          RowBox[{"c", "-", 
           RowBox[{"a", " ", "d"}]}]]}]]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", 
      FractionBox[
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{
           SqrtBox["b"], " ", "c", " ", 
           SqrtBox["d"]}], 
          SqrtBox[
           RowBox[{"c", "-", 
            RowBox[{"a", " ", "d"}]}]]]}], "+", 
        FractionBox[
         RowBox[{"a", " ", 
          SqrtBox["b"], " ", 
          SuperscriptBox["d", 
           RowBox[{"3", "/", "2"}]]}], 
         SqrtBox[
          RowBox[{"c", "-", 
           RowBox[{"a", " ", "d"}]}]]]}], "d"]}], ",", 
     RowBox[{"y", "\[Rule]", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         SqrtBox["b"], " ", 
         SqrtBox["d"]}], 
        SqrtBox[
         RowBox[{"c", "-", 
          RowBox[{"a", " ", "d"}]}]]]}]}], ",", 
     RowBox[{"z", "\[Rule]", 
      FractionBox[
       RowBox[{
        SqrtBox["b"], " ", 
        SqrtBox["d"]}], 
       SqrtBox[
        RowBox[{"c", "-", 
         RowBox[{"a", " ", "d"}]}]]]}], ",", 
     RowBox[{"w", "\[Rule]", 
      FractionBox[
       RowBox[{
        SqrtBox["b"], " ", "c"}], 
       RowBox[{
        SqrtBox["d"], " ", 
        SqrtBox[
         RowBox[{"c", "-", 
          RowBox[{"a", " ", "d"}]}]]}]]}]}], "}"}]}], "}"}]], "Output",
