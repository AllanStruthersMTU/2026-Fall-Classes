Cell["Define the defined  functions and their derivatives", "Text",
 InitializationGroup->True,
 CellChangeTimes->{{4.0003709939920015`*^9, 4.0003710049763856`*^9}, {
  4.0003713843365307`*^9, 
  4.0003713854145517`*^9}},ExpressionUUID->"7af25558-97b5-46cf-85ca-\
747d6ff32f6d"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "Di", ",", "Dip", ",", "Rd", ",", "Rdp", ",", "Sa", ",", "Sap", ",", "Sg", 
   ",", "Sgp", ",", "He", ",", "HEp", ",", "Absp", ",", "m"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Di", "[", "u_", "]"}], ":=", 
   RowBox[{"Max", "[", 
    RowBox[{"u", ",", "0"}], "]"}]}], ";", " ", 
  RowBox[{
   RowBox[{"Dip", "[", "u_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"u", ">", "0"}], ",", "1", ",", "0"}], "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Rd", "[", "u_", "]"}], ":=", 
   RowBox[{"Min", "[", 
    RowBox[{"u", ",", "0"}], "]"}]}], ";", " ", 
  RowBox[{
   RowBox[{"Rdp", "[", "u_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"u", "<", "0"}], ",", "1", ",", "0"}], "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Sa", "[", "u_", "]"}], ":=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"u", "<", 
         RowBox[{"-", "1"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"u", ",", " ", 
        RowBox[{
         RowBox[{"-", "1"}], "<", "u", "<", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "True"}], "}"}]}], "}"}], "]"}]}], ";", " ", 
  RowBox[{
   RowBox[{"Sap", "[", "u_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", "u", "]"}], "<", "1"}], ",", "1", ",", "0"}], 
    "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Sg", "[", "m_", "]"}], "[", "u_", "]"}], ":=", 
   RowBox[{"Tanh", "[", 
    RowBox[{"m", " ", "u"}], "]"}]}], ";", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Sgp", "[", "m_", "]"}], "[", "u_", "]"}], ":=", 
   RowBox[{"m", " ", 
    SuperscriptBox[
     RowBox[{"Sech", "[", 
      RowBox[{"m", " ", "u"}], "]"}], "2"]}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"He", "[", "m_", "]"}], "[", "u_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"Tanh", "[", 
       RowBox[{"m", " ", "u"}], "]"}]}], ")"}], "/", "2"}]}], ";", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Hep", "[", "m_", "]"}], "[", "u_", "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", "m", " ", 
    SuperscriptBox[
     RowBox[{"Sech", "[", 
      RowBox[{"m", " ", "u"}], "]"}], "2"]}]}]}], "\n", 
 RowBox[{
  RowBox[{"Absp", "[", "u_", "]"}], ":=", " ", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"u", "<", "0"}], ",", 
    RowBox[{"-", "1"}], ",", "1"}], "]"}]}]}], "Input",
 InitializationGroup->True,
 CellChangeTimes->{{4.000371027086153*^9, 4.00037103591358*^9}, {
  4.000371351413945*^9, 4.000371390824068*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"b407f3f4-cd40-4db6-97f8-ed091eae7c85"]
}, Closed]],

Cell[CellGroupData[{

Cell["Rosseller and Lorenz Systems", "Subsection",
 CellChangeTimes->{{3.997354396199274*^9, 3.9973544008679843`*^9}, {
   3.9999346233602753`*^9, 3.9999346251770563`*^9}, {4.0001934647115793`*^9, 
   4.000193468010045*^9}, {4.000195283391547*^9, 4.00019528985012*^9}, {
   4.002352766986825*^9, 4.002352782732126*^9}, {4.002352829466396*^9, 
   4.002352922667449*^9}, 
   4.002355131147093*^9},ExpressionUUID->"990b9b05-079b-4aa7-93cd-\
c6fdedb7be19"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "Ross", ",", "dRoss", ",", "HRoss", ",", "dHRoss", ",", "Lor", ",", " ", 
    "dLor"}], "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", "Rossler", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}], " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{"0.2", ",", "0.2", ",", "5.7"}], "}"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Ross", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", 
    RowBox[{"x", "+", 
     RowBox[{"a", " ", "y"}]}], ",", 
    RowBox[{"b", "+", 
     RowBox[{"z", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dRoss", "[", 
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "a", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", 
       RowBox[{"x", "-", "c"}]}], "}"}]}], "}"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Hyperchaotic", " ", "Rossler"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{"0.25", ",", "3", ",", "0.5", ",", "0.05"}], "}"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HRoss", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "}"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_", ",", "w_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "y"}], "-", "z"}], ",", 
    RowBox[{"x", "+", 
     RowBox[{"a", " ", "y"}], "+", "w"}], ",", 
    RowBox[{"b", "+", 
     RowBox[{"x", " ", "z"}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "c"}], " ", "z"}], "+", 
     RowBox[{"d", " ", "w"}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dHRoss", "[", 
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "}"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_", ",", "w_"}], "}"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "a", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", "x", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{"-", "c"}], ",", "d"}], "}"}]}], "}"}]}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "Lorenz", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sigma", ",", " ", "rho", ",", " ", "beta"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{"10", ",", "28", ",", 
      RowBox[{"8", "/", "3"}]}], "}"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Lor", "[", 
     RowBox[{"{", 
      RowBox[{"sigma_", ",", "rho_", ",", "beta_"}], "}"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"sigma", " ", 
      RowBox[{"(", 
       RowBox[{"y", "-", "x"}], ")"}]}], ",", 
     RowBox[{
      RowBox[{"x", " ", 
       RowBox[{"(", 
        RowBox[{"rho", "-", "z"}], ")"}]}], "-", "y"}], ",", 
     RowBox[{
      RowBox[{"x", " ", "y"}], "-", 
      RowBox[{"beta", " ", "z"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dLor", "[", 
     RowBox[{"{", 
      RowBox[{"sigma_", ",", "rho_", ",", "beta_"}], "}"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "sigma"}], ",", "sigma", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rho", "-", "z"}], ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "x"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "x", ",", 
       RowBox[{"-", "beta"}]}], "}"}]}], "}"}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.0023548080248284`*^9, 4.002355257534893*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"0b5c22b5-ae1f-4e46-b03e-9b04fd431e8c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Basic Solvers", "Section",
 CellChangeTimes->{{4.0023529414207945`*^9, 
  4.002352956122697*^9}},ExpressionUUID->"c132f041-8b39-4227-b3da-\
9ddddabd7e02"],

Cell[TextData[{
 "Assume the systems are all defined by an autonomous ODE \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{"f", "(", "y", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d88cc207-2bc8-45a1-96c5-c470f8fe9095"],
 " \nwith ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", " ", ":", " ", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}], " ", "\[Rule]", " ", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b82b772a-3a28-47c7-9848-118862cba0f1"],
 " and a provided derivative ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"df", " ", ":", " ", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}], " ", "\[Rule]", " ", 
    SuperscriptBox["\[DoubleStruckCapitalR]", 
     RowBox[{"n", "\[Times]", "n"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "245effbd-5bca-41b3-97b6-989d27a391f2"],
 " for the sensitivity computation\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"J", "'"}], "=", 
    RowBox[{
     RowBox[{"df", "(", "y", ")"}], ".", "J"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "44dbea89-ca0a-4813-a010-db446dd322a7"]
}], "Text",
 CellChangeTimes->{{4.0023529869371133`*^9, 4.002353041167055*^9}, {
  4.0023540178297796`*^9, 
  4.002354141459337*^9}},ExpressionUUID->"726c42ee-d41b-4cc2-9749-\
8b1d6f1bebb3"],

Cell[TextData[{
 "Our basic solver is going to simultaneously approximate \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{"f", "(", "y", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0218e0e7-3078-4266-8a75-a78a35222a53"],
 "  and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"J", "'"}], "=", 
    RowBox[{
     RowBox[{"df", "(", "y", ")"}], ".", "J"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e69575f9-0dd9-49c5-802c-ad9b316a4609"],
 "\nfrom an initial condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "(", "0", ")"}], "=", "y0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "63f59463-a6ea-4dd5-b44c-c520d67a4d67"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"J", "(", "0", ")"}], "=", 
    RowBox[{
     SubscriptBox["Id", "n"], "."}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "127a3455-35ee-48a8-899b-bec3ecf6d0d6"],
 "  The solver returns a list containing interpolating functions for ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "09d9d1d6-60e0-4c85-b17c-9603f8c0f894"],
 " and ",
 Cell[BoxData[
  FormBox["J", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a616d384-4302-4d6a-9c9b-418c4e280bbd"],
 " "
}], "Text",
 CellChangeTimes->{{4.002354144159813*^9, 
  4.0023542855268264`*^9}},ExpressionUUID->"536912f1-676f-4b6a-a1b5-\
12d6643759b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"yJSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "df_"}], "}"}], ",", "y0_", ",", "TMax_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "y0", "]"}]}], ",", "Id", ",", "y", ",", "J"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Id", "=", 
      RowBox[{"IdentityMatrix", "[", "n", "]"}]}], ";", "\[IndentingNewLine]",
      " ", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"f", "[", 
           RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"J", "'"}], "[", "t", "]"}], "==", 
          RowBox[{
           RowBox[{"df", "[", 
            RowBox[{"y", "[", "t", "]"}], "]"}], ".", 
           RowBox[{"J", "[", "t", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"J", "[", "0", "]"}], "==", "Id"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "J"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{4.0023542886192656`*^9, 4.0023544444210515`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"e72e2ba8-ca04-4d60-92b7-2ba1083c041e"],

