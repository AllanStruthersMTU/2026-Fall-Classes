Cell[TextData[{
 "Now we want to have the map from the input parameterization ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[Element]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", 
     RowBox[{"n", "-", "1"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ab65970d-9273-4e2f-b14b-f9ef7e4d3d35"],
 " to the output parametrization ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"T", "\[Transpose]"}], ".", 
     RowBox[{"(", 
      RowBox[{"y", "-", "p0"}], ")"}]}], "\[Element]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", 
     RowBox[{"n", "-", "1"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1566c1c8-9a76-4c20-9a9b-03e15ba9c3ca"],
 ".  As we saw before (in 3D) there are two things we need to address.  The \
first is that the flight time \[Tau] depends on the input parameterization ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "86f82e5f-1c62-4845-b73e-311dd522f385"],
 ".  The second is that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"J", "(", "\[Tau]", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c3ffa96c-1ef7-471f-a170-81504b173b61"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "\[Times]", "n"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f70cf5d1-54ae-4073-a2d3-979de05d2007"],
 " and the derivative with respect to x0 of the parameterized first return \
map\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "->", 
    RowBox[{
     RowBox[{"T", "\[Transpose]"}], ".", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"ySol", "(", "\[Tau]", ")"}], "-", "p0"}], ")"}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b341beaa-807f-4639-828c-a975282e4f74"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "(", "0", ")"}], "=", 
    RowBox[{"p0", "+", 
     RowBox[{"T", ".", "x0"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "62aae151-6a06-48e9-85de-ce43528fbf96"],
 " is an (n-1)\[Times](n-1) matrix.  I am going to redo the derivation that \
we have done before by writing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Phi]", "(", 
    RowBox[{"t", ",", "y0"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e33176bd-0b5e-4a1d-93f7-3de2e4ea15ac"],
 " for the solution of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "'"}], "=", 
    RowBox[{"f", "(", "y", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "54bf3ea7-ad2b-49a4-8b1d-6619041ba81e"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "(", "0", ")"}], "=", 
    RowBox[{"y0", "."}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "509dc882-7ddb-4175-a630-85350dbfd4d1"],
 "  The chain rule gives that\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], 
     RowBox[{"(", 
      RowBox[{"\[Phi]", "(", 
       RowBox[{"t", ",", 
        RowBox[{"p0", "+", 
         RowBox[{"T", " ", "x"}]}]}], ")"}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "y"], 
       RowBox[{"\[Phi]", "(", 
        RowBox[{"t", ",", 
         RowBox[{"p0", "+", 
          RowBox[{"T", " ", "x"}]}]}], ")"}]}], "T"}], "=", 
     RowBox[{
      RowBox[{"J", "(", "t", ")"}], "T"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "637ea219-ee65-48e1-8b47-b88d4a4cb863"],
 "\nFor the first return map we stop on our plane when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "\[Tau]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "351469c7-9ebf-47dd-b8ff-64f65d12d140"],
 " so we have\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", ".", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Phi]", "(", 
        RowBox[{"\[Tau]", ",", 
         RowBox[{"p0", "+", 
          RowBox[{"T", " ", "x"}]}]}], ")"}], "-", "p0"}], ")"}]}], "=", 
    "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5b320775-349a-4991-816e-358135fbda43"],
 ".\nDifferentiate with respect to x to get\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", ".", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Phi]", "t"], "\[CircleTimes]", 
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], "\[Tau]"}]}], "+", 
       RowBox[{
        SubscriptBox["\[Phi]", "y"], "T"}]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"0", " ", "\[DoubleLongRightArrow]", " ", "n"}], ".", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"f", "\[CircleTimes]", 
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], "\[Tau]"}]}], "+", 
        RowBox[{"J", " ", "T"}]}], ")"}]}], "=", "0."}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "13d838a0-f87a-43d8-87c0-4818618b440e"],
 "\nWhat we actually want to do is differentiate the parameterized return map \
\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"T", "\[Transpose]"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Phi]", "(", 
       RowBox[{
        RowBox[{"\[Tau]", "(", "x", ")"}], ",", 
        RowBox[{"p0", "+", 
         RowBox[{"T", " ", "x"}]}]}], ")"}], "-", "p0"}], ")"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8de759b9-1261-4c57-8968-c597f5c93dea"],
 "\nwith respect to the parameter ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "76a2b18e-e81a-4aef-9efa-432f01c992b6"],
 ".  We get\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"T", "\[Transpose]"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Phi]", "(", 
          RowBox[{
           RowBox[{"\[Tau]", "(", "x", ")"}], ",", 
           RowBox[{"p0", "+", 
            RowBox[{"T", " ", "x"}]}]}], ")"}], "-", "p0"}], ")"}]}], ")"}]}],
     "=", 
    RowBox[{
     RowBox[{"T", "\[Transpose]"}], 
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Phi]", "(", 
         RowBox[{
          RowBox[{"\[Tau]", "(", "x", ")"}], ",", 
          RowBox[{"p0", "+", 
           RowBox[{"T", " ", "x"}]}]}], ")"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"T", "\[Transpose]"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              SubscriptBox["\[PartialD]", "t"], "\[Phi]"}], "\[CircleTimes]", 
             RowBox[{
              SubscriptBox["\[PartialD]", "x"], "\[Tau]"}]}], " ", "+", 
            RowBox[{
             RowBox[{
              SubscriptBox["\[PartialD]", "y"], "\[Phi]"}], " ", "T"}]}], 
           ")"}]}], "=", 
         RowBox[{
          RowBox[{"T", "\[Transpose]"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"f", "\[CircleTimes]", 
             RowBox[{
              SubscriptBox["\[PartialD]", "x"], "\[Tau]"}]}], " ", "+", 
            RowBox[{"J", " ", "T"}]}], ")"}]}]}]}]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6c6c6b03-cad3-4b4c-86c0-077997a6d551"],
 "\nI need to explain the \[CircleTimes] but maybe I can avoid it. \n\nThe \
final recipe is \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"T", "\[Transpose]"}], 
    RowBox[{"(", 
     RowBox[{"I", "-", 
      FractionBox[
       RowBox[{"f", "\[CircleTimes]", "n"}], 
       RowBox[{"f", ".", "n"}]]}], ")"}], "J", " ", "T"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7ae5f72b-cf15-41d9-9ee5-7a30c061865b"],
 "\nAll I really need to do is add this onto the \[Tau], y, J solver. I am \
going to return a list of \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"\[Tau]", ",", "y", ",", "J", ",", "x", ",", 
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], "x"}]}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "69420a3d-8f39-44ef-a24f-9b0fdbd29f7d"],
 "\t"
}], "Text",
 CellChangeTimes->{{4.0024670063278027`*^9, 4.002468039917206*^9}, {
  4.0024682996585174`*^9, 4.002468686551401*^9}, {4.002468748375207*^9, 
  4.002468840074233*^9}, {4.0024688749770193`*^9, 
  4.0024690035073953`*^9}},ExpressionUUID->"6255ecac-9b92-495e-b7c1-\
24796619ce8c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Tau]yJxDSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f_", ",", "df_"}], "}"}], ",", "x0_", ",", 
    RowBox[{"{", 
     RowBox[{"p0_", ",", "n_", ",", "T_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"TMin_", ",", " ", "TMax_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Id", "=", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"Length", "[", "n", "]"}], "]"}]}], ",", 
      RowBox[{"y0", "=", 
       RowBox[{"p0", "+", 
        RowBox[{"T", ".", "x0"}]}]}], ",", "\[Tau]", ",", "y", ",", "J", ",", 
      "fy"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Tau]", ",", "y", ",", "J"}], "}"}], "=", 
      RowBox[{"\[Tau]yJSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"f", ",", "df"}], "}"}], ",", "y0", ",", 
        RowBox[{"{", 
         RowBox[{"p0", ",", "n", ",", "T"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"TMin", ",", " ", "TMax"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fy", "=", 
      RowBox[{"f", "[", "y", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"\[Tau]", ",", "y", ",", "J", ",", 
       RowBox[{
        RowBox[{"T", "\[Transpose]"}], ".", 
        RowBox[{"(", 
         RowBox[{"y", "-", "p0"}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"T", "\[Transpose]"}], ".", 
        RowBox[{"(", 
         RowBox[{"Id", "-", 
          FractionBox[
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"fy", ",", "n"}], "]"}], 
           RowBox[{"fy", ".", "n"}]]}], ")"}], ".", "J", ".", "T"}]}], 
      "}"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{4.0024690402772627`*^9, 4.002469308887122*^9}, {
  4.002469445618976*^9, 4.002469559407381*^9}},
 CellLabel->
  "In[360]:=",ExpressionUUID->"6c0dc137-41b9-4f32-a773-0d00fa5a75a5"],

Cell["Test", "Text",
 CellChangeTimes->{{4.0024693183882494`*^9, 
  4.0024693189728165`*^9}},ExpressionUUID->"db99bf59-f5d2-4a8d-8fc1-\
