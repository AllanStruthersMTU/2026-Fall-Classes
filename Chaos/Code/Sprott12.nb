Cell[TextData[{
 "We can write this as a first order system for the vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"w", "=", 
    RowBox[{"(", GridBox[{
       {"y"},
       {"v"},
       {"a"}
      }], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e1c3a381-d478-4ece-be76-6ac322357e5c"],
 "  where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", "y"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dd2a850b-b4f9-4011-a766-2e278a20c2d4"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    RowBox[{"y", "'"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d8f66b48-0c43-43d3-ba1a-6ec9eae46f8f"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", 
    RowBox[{
     RowBox[{"v", "'"}], "=", 
     RowBox[{"y", "''"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f2553cfd-a488-4826-8d22-6234fe9ba910"],
 ".\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", GridBox[{
        {"y"},
        {"v"},
        {"a"}
       }], ")"}], "'"], "=", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{"y", "'"}]},
        {
         RowBox[{"v", "'"}]},
        {
         RowBox[{"a", "'"}]}
       }], ")"}], "=", 
     RowBox[{
      RowBox[{"(", GridBox[{
         {"v"},
         {"a"},
         {
          RowBox[{"y", "'''"}]}
        }], ")"}], "=", 
      RowBox[{"(", GridBox[{
         {"v"},
         {"a"},
         {
          RowBox[{
           RowBox[{
            RowBox[{"-", "0.5"}], " ", "a"}], "-", "v", "+", "y", " ", "-", 
           RowBox[{"Sign", "[", "y", "]"}]}]}
        }], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "94e59310-f720-41ed-9e52-6e76c6248444"],
 "\nThe cell below defines a function and solve the ODE as the first order \
system\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"w", "'"}], "=", 
    RowBox[{"f", "(", "w", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cc6dc7cd-25d9-4005-81b0-dc3659168a1c"],
 "\t"
}], "Text",
 CellChangeTimes->{{3.997366603162095*^9, 
  3.9973668652926683`*^9}},ExpressionUUID->"efe826e4-af5a-4c01-90a4-\
cf5fe2adadfb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "w", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"{", 
    RowBox[{"y_", ",", "v_", ",", "a_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{"v", ",", "a", ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "0.5"}], " ", "a"}], "-", "v", "+", "y", " ", "-", 
     RowBox[{"Sign", "[", "y", "]"}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wSol", "=", " ", 
   RowBox[{"NDSolveValue", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"w", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"f", "[", 
         RowBox[{"w", "[", "t", "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"w", "[", "0", "]"}], "==", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}]}]}], "}"}], ",", "w", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ParametricPlot3D", "[", 
   RowBox[{
    RowBox[{"wSol", "[", "t", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
    RowBox[{"PlotPoints", "->", "100"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"wSol", "[", "t", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{"wSol", "[", "t", "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{"wSol", "[", "t", "]"}], "[", 
      RowBox[{"[", "3", "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", " ", 
     RowBox[{"TMax", "/", "100"}]}], "}"}], ",", 
   RowBox[{"PlotPoints", "->", "100"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", "\"\< \>\""}], "}"}]}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9973561272664976`*^9, 3.9973561584379663`*^9}, {
  3.9973561972985973`*^9, 3.997356366972727*^9}, {3.9973565111319265`*^9, 
  3.997356640103677*^9}, {3.997356677807105*^9, 
  3.99735668691706*^9}},ExpressionUUID->"63d877aa-110e-4be5-a816-\
57a9ed8232c6"],

