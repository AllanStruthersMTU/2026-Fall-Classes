Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "g", ",", "x1", ",", "x2", ",", "x3"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"{", 
    RowBox[{"x1_", ",", "x2_", ",", "x3_"}], "}"}], "]"}], ":=", 
  RowBox[{"Sin", "[", 
   RowBox[{
    SuperscriptBox["x1", "2"], "+", 
    RowBox[{"x2", " ", 
     RowBox[{"Cos", "[", " ", 
      RowBox[{"x2", " ", "+", 
       RowBox[{"3", "x1"}], " ", "+", 
       RowBox[{"x3", " ", "x2"}]}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"{", 
     RowBox[{"x1_", ",", "x2_", ",", "x3_"}], "}"}], "]"}], "=", 
   RowBox[{"Grad", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"{", 
       RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"SliceContourPlot3D", "[", 
