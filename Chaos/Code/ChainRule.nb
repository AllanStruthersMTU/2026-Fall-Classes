     "\"\<CenterPlanes\>\"", ",", 
     RowBox[{"{", 
      RowBox[{"x1", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x2", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x3", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"Contours", "->", "20"}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"SliceVectorPlot3D", "[", 
    RowBox[{
     RowBox[{"g", "[", 
      RowBox[{"{", 
       RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}], "]"}], ",", 
