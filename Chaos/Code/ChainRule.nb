Notebook[{

Cell[CellGroupData[{
Cell["Chain Rule from Calculus 3", "Title",
 CellChangeTimes->{{3.997354396199274*^9, 3.9973544008679843`*^9}, {
   3.9973640967271757`*^9, 3.997364101554268*^9}, 3.997364137222814*^9, {
   3.9977881367147083`*^9, 3.9977881710199957`*^9}, {3.997789975430049*^9, 
   3.997789995676383*^9}},ExpressionUUID->"ee41a007-0d2f-4b6e-9991-\
30a592e66adf"],

Cell[CellGroupData[{

Cell[TextData[{
 "Gradient of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", ":", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}], "\[Rule]", 
    "\[DoubleStruckCapitalR]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cf80a8f8-ed1b-4132-9a33-eadbb3a1a779"],
 " "
}], "Section",
 CellChangeTimes->{{3.9977900036514683`*^9, 3.9977900051887493`*^9}, {
  3.9977902580467815`*^9, 
  3.9977902598444233`*^9}},ExpressionUUID->"b9ff55b6-f61e-4625-8661-\
8e39fbb584b0"],

Cell[TextData[{
 "A function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", ":", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}], "\[Rule]", 
    "\[DoubleStruckCapitalR]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0246a308-87bc-4d10-a776-73c1b21fad74"],
 " is of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "1"], "(", 
    RowBox[{
     SubscriptBox["x", "1"], ",", "\[Ellipsis]", ",", 
     SubscriptBox["x", "n"]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "45f9aecd-3af7-4730-934d-7e582a2c0b58"],
 " and the gradient is the function\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "x"], "f"}], "=", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["f", "1"]}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["x", "1"]}]], ",", "\[Ellipsis]", ",", 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["f", "1"]}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["x", "n"]}]]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7813d29d-3e2a-4342-b8c3-18eb44e3b723"],
 "\nin other words ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "x"], 
     RowBox[{"f", ":", 
      SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}]}], "\[Rule]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c428dad4-3d3f-476b-b5b5-a22a85f2d025"],
 ".  The gradient is the straight uphill direction it is perpendicular to \
contour lines and surfaces."
}], "Text",
 CellChangeTimes->{{3.997790017382206*^9, 
  3.997790246490567*^9}},ExpressionUUID->"5e481f18-e8e2-41de-92f4-\
845de8f16469"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "g", ",", "x1", ",", "x2"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"{", 
    RowBox[{"x1_", ",", "x2_"}], "}"}], "]"}], ":=", 
  RowBox[{"Sin", "[", 
   RowBox[{
    SuperscriptBox["x1", "2"], "+", 
    RowBox[{"x2", " ", 
     RowBox[{"Cos", "[", " ", 
      RowBox[{"x2", " ", "+", 
       RowBox[{"3", "x1"}]}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"{", 
     RowBox[{"x1_", ",", "x2_"}], "}"}], "]"}], "=", 
   RowBox[{"Grad", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"{", 
       RowBox[{"x1", ",", "x2"}], "}"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x1", ",", "x2"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"{", 
       RowBox[{"x1", ",", "x2"}], "}"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x1", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x2", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"Contours", "->", "40"}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"VectorPlot", "[", 
    RowBox[{
     RowBox[{"g", "[", 
      RowBox[{"{", 
       RowBox[{"x1", ",", "x2"}], "}"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x1", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x2", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", " ", 
     RowBox[{"PlotLegends", "\[Rule]", "Automatic"}]}], "]"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9977902627865086`*^9, 3.9977903553749313`*^9}, {
  3.9977903862694016`*^9, 3.997790653866768*^9}},
 CellLabel->
  "In[162]:=",ExpressionUUID->"dc4a5cc4-e093-4a7f-9a28-cacd0540c818"],

