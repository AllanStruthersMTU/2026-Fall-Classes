Cell[CellGroupData[{

Cell[TextData[{
 "Gradient of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", ":", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}], "\[Rule]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "m"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c5533d4b-d1ab-4088-80f2-f157679af861"],
 " "
}], "Section",
 CellChangeTimes->{{3.9977900036514683`*^9, 3.9977900051887493`*^9}, {
  3.9977902580467815`*^9, 3.9977902598444233`*^9}, {3.9977909969771614`*^9, 
  3.9977909978009143`*^9}},ExpressionUUID->"f51ba1f1-354d-4867-be7e-\
c150344cab35"],

Cell[TextData[{
 "A function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", ":", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}], "\[Rule]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "m"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fe723672-ddf0-4687-a187-993042c89a3d"],
 " is of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        SubscriptBox["f", "1"], 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["x", "1"], ",", "\[Ellipsis]", ",", 
          SubscriptBox["x", "n"]}], ")"}], " "}]},
      {
       RowBox[{
        SubscriptBox["f", "2"], 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["x", "1"], ",", "\[Ellipsis]", ",", 
          SubscriptBox["x", "n"]}], ")"}]}]},
      {"\[VerticalEllipsis]"},
      {
       RowBox[{
        SubscriptBox["f", "m"], 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["x", "1"], ",", "\[Ellipsis]", ",", 
          SubscriptBox["x", "n"]}], ")"}]}]}
     }], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "139546df-5fc2-42cd-a344-b6e3fe51741a"],
 "and the gradient is the function\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "x"], "f"}], "=", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{
          FractionBox[
           RowBox[{"\[PartialD]", 
            SubscriptBox["f", "1"]}], 
           RowBox[{"\[PartialD]", 
            SubscriptBox["x", "1"]}]], ",", "\[Ellipsis]", ",", 
          FractionBox[
           RowBox[{"\[PartialD]", 
            SubscriptBox["f", "1"]}], 
           RowBox[{"\[PartialD]", 
            SubscriptBox["x", "n"]}]]}]},
        {
         RowBox[{
          FractionBox[
           RowBox[{"\[PartialD]", 
            SubscriptBox["f", "2"]}], 
           RowBox[{"\[PartialD]", 
            SubscriptBox["x", "1"]}]], ",", "\[Ellipsis]", ",", 
          FractionBox[
           RowBox[{"\[PartialD]", 
            SubscriptBox["f", "2"]}], 
           RowBox[{"\[PartialD]", 
            SubscriptBox["x", "n"]}]]}]},
        {"\[VerticalEllipsis]"},
        {
         RowBox[{
          FractionBox[
           RowBox[{"\[PartialD]", 
            SubscriptBox["f", "m"]}], 
           RowBox[{"\[PartialD]", 
            SubscriptBox["x", "1"]}]], ",", "\[Ellipsis]", ",", 
          FractionBox[
           RowBox[{"\[PartialD]", 
            SubscriptBox["f", "m"]}], 
           RowBox[{"\[PartialD]", 
            SubscriptBox["x", "n"]}]]}]}
       }], ")"}], "=", 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["f", "i"]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["x", "j"]}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "625be679-0fbc-4d44-adcb-385a12df278c"],
 "\nin other words ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "x"], 
     RowBox[{"f", ":", 
      SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}]}], "\[Rule]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", 
     RowBox[{"m", "\[Times]", "n"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5da31a29-bb93-4840-bcd0-a9ba0226eee3"],
 ".  The gradient is the local linearization.  The gradient is an ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "\[Times]", "n"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "82be975e-7dcc-42c2-8e25-35cb3136aabf"],
 " matrix which is usually called the Jacobian!   See \
https://en.wikipedia.org/wiki/Jacobian_matrix_and_determinant for more \
reminders! "
}], "Text",
 CellChangeTimes->{{3.997790017382206*^9, 3.997790246490567*^9}, {
  3.997791007641938*^9, 3.9977913129007626`*^9}, {3.997791360349973*^9, 
  3.997791381446479*^9}},ExpressionUUID->"c94f0f83-c568-44e4-b483-\
fe6383ca6af6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Multivariable Chain Rules", "Section",
 CellChangeTimes->{{3.9977900036514683`*^9, 3.9977900051887493`*^9}, {
  3.9977902580467815`*^9, 3.9977902598444233`*^9}, {3.9977909969771614`*^9, 
  3.9977909978009143`*^9}, {3.997791416126901*^9, 3.99779141947093*^9}, {
  3.9977915064111032`*^9, 
  3.997791516836979*^9}},ExpressionUUID->"18057b4b-b40f-47a5-96a2-\
432eea8f375d"],

Cell[TextData[{
 "Chain rules let us differentiate compositions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", 
    RowBox[{"g", "(", "x", ")"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8e1314fe-d3a7-449e-953b-c48f9f8f5348"],
 " see https://en.wikipedia.org/wiki/Chain_rule#Multivariable_case for more \
words. "
}], "Text",
 CellChangeTimes->{{3.9977914770997963`*^9, 
  3.9977915490777407`*^9}},ExpressionUUID->"807c93b8-ec12-4f7f-88f5-\
90f57879a58a"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", ":", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "p"]}], "\[Rule]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "m"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "53869e86-1526-4ef2-9add-b17f4b91bf9d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", ":", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}], "\[Rule]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "p"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7f79bcd9-0a01-48e2-8bad-33b8496725d3"],
 " so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"h", "=", 
    RowBox[{
     RowBox[{"f", "\[SmallCircle]", 
      RowBox[{"g", ":", 
       SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}]}], "\[Rule]", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "m"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a1c357a0-3996-4480-97ec-8fda06fa1a7e"]
}], "Subsection",
 CellChangeTimes->{{3.997791568711862*^9, 
  3.9977917356861544`*^9}},ExpressionUUID->"873d8995-13d9-48bb-aba8-\
45e7abf74043"],

Cell[TextData[{
 "So ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "x"], 
     RowBox[{"h", ":", 
      SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}]}], "\[Rule]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", 
     RowBox[{"m", "\[Times]", "n"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "345f530d-9ec5-42b8-a464-dd73d1ec4035"],
 " and has to be some combination of the partials of the constituent \
functions.  In Calculus 3 you probably gave the middle variable a name say ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", 
    RowBox[{"g", "(", "x", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5a883e32-89bb-4de1-8cbf-c34e789f527c"],
 " and thought about adding up all the appropriate chain rule fragments. It \
is simply\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "x"], 
     RowBox[{"h", "(", "x", ")"}]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Del]", "y"], 
      RowBox[{"f", "(", 
       RowBox[{"g", "(", "x", ")"}], ")"}]}], " ", 
     RowBox[{
      SubscriptBox["\[Del]", "x"], 
      RowBox[{"g", "(", "x", ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6bf71617-5de2-4945-bae0-5daefec6990b"],
 "\nIn words, differentiate the outside function (evaluate at the inside \
function) and multiply by the derivative of the inside function.  The \
multiplication is a matrix-matrix multiplication and because matrix \
multiplication does not commute the order matters. "
}], "Text",
 CellChangeTimes->{{3.997790017382206*^9, 3.997790246490567*^9}, {
  3.997791007641938*^9, 3.9977913129007626`*^9}, {3.997791360349973*^9, 
  3.997791381446479*^9}, {3.997791740904687*^9, 
  3.997792226803541*^9}},ExpressionUUID->"7823eddf-0bb2-476e-a022-\
eebfb80f9b89"],

Cell["The way to check this \[Ellipsis]", "Text",
 CellChangeTimes->{{3.997792262039528*^9, 
  3.997792277492173*^9}},ExpressionUUID->"b2c888b3-0a9a-42c5-b9ee-\
2cb7adce6cd7"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
},
