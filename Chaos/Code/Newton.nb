Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 "Newton Solve for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2957b243-825d-48ed-a62b-3f53c01f1537"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", 
     RowBox[{"k", "+", "1"}]], "=", 
    RowBox[{
     SubscriptBox["x", "k"], "-", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"J", "(", 
        SubscriptBox["x", "k"], ")"}], 
       RowBox[{"-", "1"}]], 
      RowBox[{"f", "(", 
       SubscriptBox["x", "k"], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a59783c1-6d18-436c-b6e2-8de09ee12d00"]
}], "Title",
 CellChangeTimes->{{3.997354396199274*^9, 3.9973544008679843`*^9}, {
   3.9973640967271757`*^9, 3.997364101554268*^9}, 3.997364137222814*^9, {
   3.9977881367147083`*^9, 3.9977881710199957`*^9}, {3.997789975430049*^9, 
   3.997789995676383*^9}, {3.9983954078791037`*^9, 3.998395454346006*^9}, {
   3.9984698291933975`*^9, 
   3.998469829718734*^9}},ExpressionUUID->"ee41a007-0d2f-4b6e-9991-\
30a592e66adf"],

Cell["\<\
Lets just look at some pictures about Newton.
Turn the top menus Off/On and make some cells.  \
\>", "Text",
 CellChangeTimes->{{3.9983975951492605`*^9, 3.99839762474194*^9}, {
  3.998469768629325*^9, 
  3.998469804302995*^9}},ExpressionUUID->"dcb40977-15a5-422f-9da8-\
c3e945dca278"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"x1", ",", "x2", ",", "f"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"{", 
    RowBox[{"x1_", ",", "x2_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"x1", " ", "+", 
       SuperscriptBox["x2", "2"]}], "]"}], 
     RowBox[{"Cos", "[", 
      RowBox[{"x1", "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox["x2", "3"]}], ")"}]}], "]"}]}], ",", 
    RowBox[{"Sin", "[", " ", 
     RowBox[{
      SuperscriptBox["x2", "2"], "-", 
      RowBox[{"Cos", "[", 
       RowBox[{"x1", " ", "x2"}], "]"}], "-", 
      SuperscriptBox["x1", "2"]}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<\!\(\*SubscriptBox[\(f\), \(1\)]\)\>\"", "->", 
     RowBox[{"ContourPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"{", 
          RowBox[{"x1", ",", "x2"}], "}"}], "]"}], "\[LeftDoubleBracket]", 
        "1", "\[RightDoubleBracket]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x1", ",", 
         RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x2", ",", "0", ",", "3"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ContourStyle", "\[Rule]", "LightRed"}], ",", 
       RowBox[{"ContourLabels", "\[Rule]", "True"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<\!\(\*SubscriptBox[\(f\), \(2\)]\)\>\"", "->", 
     RowBox[{"ContourPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"{", 
          RowBox[{"x1", ",", "x2"}], "}"}], "]"}], "\[LeftDoubleBracket]", 
        "2", "\[RightDoubleBracket]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x1", ",", 
         RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x2", ",", "0", ",", "3"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ContourStyle", "\[Rule]", "LightBlue"}], ",", 
       RowBox[{"ContourLabels", "\[Rule]", "True"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
    "\"\<\!\(\*SubscriptBox[\(f\), \(1\)]\)=\!\(\*SubscriptBox[\(f\), \
\(2\)]\)=0\>\"", "->", 
     RowBox[{"ContourPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"f", "[", 
            RowBox[{"{", 
             RowBox[{"x1", ",", "x2"}], "}"}], "]"}], "\[LeftDoubleBracket]", 
           "1", "\[RightDoubleBracket]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"f", "[", 
            RowBox[{"{", 
             RowBox[{"x1", ",", "x2"}], "}"}], "]"}], "\[LeftDoubleBracket]", 
           "2", "\[RightDoubleBracket]"}], "==", "0"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x1", ",", 
         RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x2", ",", "0", ",", "3"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ContourStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"LightRed", ",", "LightBlue"}], "}"}]}], ",", 
       RowBox[{"ContourLabels", "\[Rule]", "True"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "}"}], "]"}]}], "Input",
