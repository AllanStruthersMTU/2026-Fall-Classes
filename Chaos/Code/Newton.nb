Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"z", ",", "J", ",", "Lin"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"z", "[", "0", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"1.41", ",", "1.43"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"J", "[", 
    RowBox[{"{", 
     RowBox[{"x1_", ",", "x2_"}], "}"}], "]"}], "=", 
   RowBox[{"Grad", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"{", 
       RowBox[{"x1", ",", "x2"}], "}"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x1", ",", "x2"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"z", "[", "k_", "]"}], ":=", 
  RowBox[{
   RowBox[{"z", "[", "k", "]"}], "=", 
   RowBox[{
    RowBox[{"z", "[", 
     RowBox[{"k", "-", "1"}], "]"}], "-", 
    RowBox[{"LinearSolve", "[", 
     RowBox[{
      RowBox[{"J", "[", 
       RowBox[{"z", "[", 
        RowBox[{"k", "-", "1"}], "]"}], "]"}], ",", 
      RowBox[{"f", "[", 
       RowBox[{"z", "[", 
        RowBox[{"k", "-", "1"}], "]"}], "]"}]}], 
     "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Lin", "[", "k_", "]"}], "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"z", "[", "k", "]"}], "]"}], "+", 
   RowBox[{
    RowBox[{"J", "[", 
     RowBox[{"z", "[", "k", "]"}], "]"}], ".", 
    RowBox[{"(", 
     RowBox[{"x", "-", 
      RowBox[{"z", "[", "k", "]"}]}], ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "\"\<\!\(\*SubscriptBox[\(f\), \(1\)]\)=\!\(\*SubscriptBox[\(f\), \
\(2\)]\)=0\>\"", "->", 
     RowBox[{"ContourPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"f", "[", 
            RowBox[{"{", 
             RowBox[{"x1", ",", "x2"}], "}"}], "]"}], "\[LeftDoubleBracket]", 
           "1", "\[RightDoubleBracket]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"f", "[", 
            RowBox[{"{", 
             RowBox[{"x1", ",", "x2"}], "}"}], "]"}], "\[LeftDoubleBracket]", 
           "2", "\[RightDoubleBracket]"}], "==", "0"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x1", ",", 
         RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x2", ",", "0", ",", "3"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ContourStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"LightRed", ",", "LightBlue"}], "}"}]}], ",", 
       RowBox[{"Epilog", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Point", "[", 
           RowBox[{"z", "[", "0", "]"}], "]"}], ",", 
          RowBox[{"Circle", "[", 
           RowBox[{
            RowBox[{"z", "[", "0", "]"}], ",", "r"}], "]"}]}], "}"}]}]}], 
      "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<\!\(\*SubscriptBox[\(Lin\), \(1\)]\)\>\"", "->", 
     RowBox[{"Show", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ContourPlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{"{", 
            RowBox[{"x1", ",", "x2"}], "}"}], "]"}], "\[LeftDoubleBracket]", 
          "1", "\[RightDoubleBracket]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x1", ",", 
           RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x2", ",", "0", ",", "3"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"ContourStyle", "\[Rule]", "None"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
